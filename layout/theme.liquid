<!doctype html>
{% assign rtls = 'ar,he,fa,ur,ps,syr,sd,ug,ku,yi,nqo,ckb,dv,mzn' | split: ',' %}
{% if rtls contains request.locale.iso_code %}
  {% assign rtl_suffix = '-rtl' %}
{% endif %}
<html class="no-js" lang="{{ request.locale.iso_code }}"{% if rtls contains request.locale.iso_code %} dir="rtl"{% endif %}>

<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <meta name="theme-color" content="">


  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  {%- unless settings.heading_library_font.system? and settings.default_library_font.system? and settings.special_library_font.system? -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  {%- endunless -%}


  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- liquid
    assign meta_desc = page_description
    if meta_desc == blank and template.name == 'page'
      case page.handle
        when 'contact'
          assign meta_desc = 'Contact TOOSA in Richmond, BC: call 778-939-9494, email sales@toosa.ca, send a message or book a showroom visit to see the tool storage lineup in person.'
        when 'our-story'
          assign meta_desc = 'How TOOSA started: a Richmond, BC shop building modular tool chests, hutches, lockers and foam inserts for people who work with their hands every day.'
        when 'why-toosa'
          assign meta_desc = 'Why workshops choose TOOSA: welded heavy-gauge steel, modular add-ons that bolt on later, Canadian support and showroom pricing without the dealer markup.'
        when 'faqs'
          assign meta_desc = 'Answers about TOOSA tool chests, modules, foam inserts, delivery across Canada, financing and warranty, straight from the Richmond, BC showroom.'
        when 'toosa-gallery'
          assign meta_desc = 'Photos of TOOSA tool storage in real garages, auto shops and industrial workshops across Canada: Mega Max, Ultra Task, hutches, lockers and foam.'
        when 'book-appointments'
          assign meta_desc = 'Book a free 30-minute visit to the TOOSA showroom in Richmond, BC. See every size side by side, test the drawers and leave with a layout and a quote.'
        when 'tool-storage'
          assign meta_desc = 'TOOSA modular tool storage: Mega Max 72 and Ultra Task 56 rolling tool chests with hutches, lockers, side drawers and lighting that bolt on as you grow.'
        when 'air-compressor'
          assign meta_desc = 'The TOOSA TS-20 rotary screw air compressor: 20 HP, integrated dryer and 500 L tank in one UL-certified package built for busy shops, delivered in Canada.'
        when 'custom-foam-inquiry'
          assign meta_desc = 'Custom-cut foam tool inserts from TOOSA: send us your drawer size and tools, get a quote, and keep every tool in its place. Shipped across Canada.'
        when 'delivery-returns'
          assign meta_desc = 'TOOSA delivery and returns: shipping across Canada, free over $3,000, pickup in Richmond, BC, and how returns and exchanges work.'
      endcase
    endif
    if meta_desc == blank and template.name == 'page' and page.content != blank
      assign meta_desc = page.content | strip_html | strip_newlines | truncate: 158
    endif
    if meta_desc == blank
      assign meta_desc = shop.description
    endif
  -%}
  {% if meta_desc != blank %}
    <meta name="description" content="{{ meta_desc | escape }}">
  {% endif %}
  {% if template.name == 'product' %}{% render 'tx-product-schema', product: product %}{% endif %}

  {% render 'meta-tags' %}


  {{ content_for_header }}

  <!-- Insert dynamic styles -->

  {% liquid 
      assign body_font_family = settings.default_library_font
      assign heading_font_family = settings.heading_library_font
      assign special_font_family = settings.special_library_font


      assign body_font_bold = settings.default_library_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.default_library_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'

      assign heading_font_bold = settings.heading_library_font | font_modify: 'weight', 'bold'
      assign heading_font_italic = settings.heading_library_font | font_modify: 'style', 'italic'
      assign heading_font_bold_italic = heading_font_bold | font_modify: 'style', 'italic'

      assign special_font_bold = settings.special_library_font | font_modify: 'weight', 'bold'
      assign special_font_italic = settings.special_library_font | font_modify: 'style', 'italic'
      assign special_font_bold_italic = special_font_bold | font_modify: 'style', 'italic'

  %}


  {% style %}

    {{ settings.default_library_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}

    {{ settings.heading_library_font | font_face: font_display: 'swap' }}
    {{ heading_font_bold | font_face: font_display: 'swap' }}
    {{ heading_font_italic | font_face: font_display: 'swap' }}
    {{ heading_font_bold_italic | font_face: font_display: 'swap' }}

    {{ settings.special_library_font | font_face: font_display: 'swap' }}
    {{ special_font_bold | font_face: font_display: 'swap' }}
    {{ special_font_italic | font_face: font_display: 'swap' }}
    {{ special_font_bold_italic | font_face: font_display: 'swap' }}
    

    :root{
      --theme-body-font-family: {{ body_font_family.family }}, {{ body_font_family.fallback_families }};
      --theme-heading-font-family: {{ heading_font_family.family }}, {{ heading_font_family.fallback_families }};
      --theme-special-heading-font-family: {{ special_font_family.family }}, {{ special_font_family.fallback_families }};

      --theme-heading-font-weight: {{ heading_font_family.weight }};

      --theme-special-heading-font-weight: {{ special_font_family.weight }};

      --theme-logo-font-weight: {{ heading_font_family.weight }};

      --theme-font-weight-regular: {{ body_font_family.weight }};
      --theme-font-weight-bold: {{ body_font_bold.weight }};


      --theme-body-font-size-base: {{ settings.default_font_size_base | divided_by: 100.00 }}; 
      --theme-heading-font-size-base: {{ settings.heading_font_size_base | divided_by: 100.00 }}; 
      --theme-special-heading-font-size-base: {{ settings.special_font_size_base | divided_by: 100.00 }};


      --theme-body-letter-spacing: {{ settings.default_letter_spacing }}; 
      --theme-body-line-height: {{ settings.default_line_height }};
      --theme-body-text-transform: {{ settings.default_text_transform }};

      --theme-heading-letter-spacing: {{ settings.heading_letter_spacing }}; 
      --theme-heading-line-height: {{ settings.heading_line_height }};
      --theme-heading-text-transform: {{ settings.heading_text_transform }};

      --theme-special-heading-letter-spacing: {{ settings.special_letter_spacing }}; 
      --theme-special-heading-line-height: {{ settings.special_line_height }};
      --theme-special-heading-text-transform: {{ settings.special_text_transform }};


      --theme-layout-background-color: {{ settings.color_layout_background_main }};


      {% assign scheme = settings.color_schemes['scheme_1'] %}
      
      --theme-lines-color-primary: {{ scheme.settings.primary_line }};
      --theme-lines-color-secondary: {{ scheme.settings.secondary_line }};

      --theme-button-background-color-primary: {{ scheme.settings.primary_button_background }};
      --theme-button-color-primary: {{ scheme.settings.primary_button }};
      --theme-button-background-color-secondary: {{ scheme.settings.secondary_button_background }};
      --theme-button-color-secondary: {{ scheme.settings.secondary_button }};

      --theme-color-primary: {{ scheme.settings.text }};
      --theme-color-heading: {{ scheme.settings.heading }};
      --theme-color-links: {{ scheme.settings.links }};


      --theme-button-padding-base: {{ settings.buttons_padding | append: "px" }};

      --theme-button-border-radius: {{ settings.buttons_border_radius | append: 'px' }};
      --theme-button-border-width: {{ settings.buttons_border_thickness | append: 'px' }};

      --theme-product-thumbail-aspect-ratio: {{ settings.collection_image_aspect_ratio }};
      
    }

    {% for scheme in settings.color_schemes %}
      {% liquid
        if request.design_mode
          capture scheme_background
            echo scheme.settings.background | json
          endcapture
          capture scheme_background_gradient
            echo scheme.settings.backgroundgradient | json
          endcapture

        endif
      %}
      .{{ scheme.id }}{

        {% if request.design_mode %}
          {% if scheme.settings.background != blank and scheme_background != '""' %}
          --theme-background-color:{{ scheme.settings.background }};
          {% endif %}
          {% if scheme.settings.background_gradient != blank and scheme_background_gradient != '""' %}
          --theme-background-gradient:{{ scheme.settings.background }};
          {% endif %}
        {% else %}
          {% if scheme.settings.background != blank %}
          --theme-background-color:{{ scheme.settings.background }};
          {% endif %}
          {% if scheme.settings.background_gradient != blank %}
          --theme-background-gradient:{{ scheme.settings.background_gradient }};
          {% endif %}
        {% endif %}

        --theme-lines-color-primary: {{ scheme.settings.primary_line }};
        --theme-lines-color-secondary: {{ scheme.settings.secondary_line }};

        --theme-button-background-color-primary: {{ scheme.settings.primary_button_background }};
        --theme-button-color-primary: {{ scheme.settings.primary_button }};
        --theme-button-background-color-secondary: {{ scheme.settings.secondary_button_background }};
        --theme-button-color-secondary: {{ scheme.settings.secondary_button }};

        --theme-color-primary: {{ scheme.settings.text }};
        --theme-color-heading: {{ scheme.settings.heading }};
        --theme-color-links: {{ scheme.settings.links }};

      }
    {% endfor %}

  {% endstyle %}

  <!-- Header hook for plugins -->
  {{ 'normalize' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag }}

  {{ 'splide.min' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag }}
  {{ 'splide-core.min' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag }}

  <!-- 3D Model Viewer UI -->
  {{ 'model-viewer-ui' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag }}


  <!-- Animation styles -->
  {{ 'animista' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag }}


  <!-- All theme styles -->
  {{ 'theme' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag }}

  {{ 'photoswipe' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag }}
  {% if request.page_type == 'index' or request.page_type == 'product' %}
    {{ 'tx.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'tx.js' | asset_url }}" defer></script>
  {% endif %}
  {% if request.page_type == 'page' or request.page_type == 'blog' or request.page_type == 'article' or request.page_type == '404' or request.page_type == 'search' or request.page_type == 'product' %}
    {{ 'tx-pages.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'tx-pages.js' | asset_url }}" defer></script>
  {% endif %}
  {% if request.page_type == 'product' %}
    {{ 'tx-product.css' | asset_url | stylesheet_tag }}
  {% endif %}
  {% if request.page_type == 'collection' or request.page_type == 'list-collections' %}
    {{ 'tx-collection.css' | asset_url | stylesheet_tag }}
  {% endif %}
  {{ 'tx-footer.css' | asset_url | stylesheet_tag }}


  {% liquid 

  if template == '404'
    echo '404' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag
  endif
  
  if template == 'article'
    echo 'article' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag
  endif

  if template == 'blog' or template == 'search'
    echo 'blog' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag
  endif

  if template contains 'collection' or template == 'search'
    echo 'filters' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag
  endif

  if template == 'list-collections'
    echo 'collections' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag
  endif


  if template == 'cart'
    echo 'cart' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag
  endif


  if template == 'customers/account' or template == 'customers/activate_account' or template == 'customers/addresses' or template == 'customers/login' or template == 'customers/order' or template == 'customers/register' or template == 'customers/reset_password'
    echo 'customers' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag
  endif 
  %}


  <!-- CSS file for custom styles -->
  {{ 'custom.css' | asset_url | stylesheet_tag }}

{% include 'hulk_po_vd' %}</head>

<body class="template-{{ template }}" data-money-format="{{ shop.money_format }}">

  {% sections 'header-group' %}

  <main class="main content-for-layout" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <div tabindex="0">
  {% sections 'overlay-group' %}
  </div>

  <script> 
    // No script "no-js" removal
    document.documentElement.className = 'js';

    var Shopify = Shopify || {};

    Shopify.recentlyviewed_cookie_name = 'recentlyviewed'
    Shopify.recentlyviewed_cookie_expiration = 30

    {% if template contains 'product' %}
      Shopify.product_id = {{ product.id }}
    {% endif %}
  </script>

  <script src="{{ 'splide.min.js' | asset_url }}" defer></script>
  <script src="{{ 'photoswipe-lightbox.umd.min.js' | asset_url }}" defer></script>
  <script src="{{ 'photoswipe.umd.min.js' | asset_url }}" defer></script>
  <script src="{{ 'js.cookie.min.js' | asset_url }}" defer></script>

  <script src="{{ 'base.js' | asset_url }}" defer></script>
  
  <script src="{{ 'product.js' | asset_url }}" defer></script>
  <script src="{{ 'product-options-picker.js' | asset_url }}" defer></script>
  <script src="{{ 'pickup-availability.js' | asset_url }}" defer></script>

  {% if settings.predictive_search_enabled %}
    <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
  {% endif %}
  
  
  <!-- JS file for custom scripts -->
  <script src="{{ 'custom.js' | asset_url }}" defer></script>


  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer></script>
  {%- endif -%}

</body>

</html>