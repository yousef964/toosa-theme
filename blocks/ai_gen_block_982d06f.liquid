      "default": "Call Us"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+1 (604) 123-4567"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email",
      "default": true
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email Us"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "Sales@toosa.ca"
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show business hours",
      "default": true
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Business Hours"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Business hours",
