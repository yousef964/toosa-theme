        {% endif %}
        <div class="ai-brand-journey-challenges-grid-{{ ai_gen_id }}">
          {% if block.settings.challenge_1_title != blank %}
            <div class="ai-brand-journey-challenge-card-{{ ai_gen_id }}">
              <div class="ai-brand-journey-challenge-icon-{{ ai_gen_id }}">{{ block.settings.challenge_1_icon }}</div>
              <h4 class="ai-brand-journey-challenge-heading-{{ ai_gen_id }}">{{ block.settings.challenge_1_title }}</h4>
              <div class="ai-brand-journey-challenge-text-{{ ai_gen_id }}">{{ block.settings.challenge_1_description }}</div>
