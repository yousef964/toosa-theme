              <h4 class="ai-brand-journey-challenge-heading-{{ ai_gen_id }}">{{ block.settings.challenge_2_title }}</h4>
              <div class="ai-brand-journey-challenge-text-{{ ai_gen_id }}">{{ block.settings.challenge_2_description }}</div>
              {% if block.settings.challenge_2_solution != blank %}
                <div class="ai-brand-journey-challenge-solution-{{ ai_gen_id }}">
                  <div class="ai-brand-journey-challenge-solution-label-{{ ai_gen_id }}">Solution</div>
                  <div class="ai-brand-journey-challenge-solution-text-{{ ai_gen_id }}">{{ block.settings.challenge_2_solution }}</div>
