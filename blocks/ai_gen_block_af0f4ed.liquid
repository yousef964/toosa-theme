                <h4 class="ai-brand-journey-timeline-heading-{{ ai_gen_id }}">{{ block.settings.milestone_5_title }}</h4>
                <div class="ai-brand-journey-timeline-text-{{ ai_gen_id }}">{{ block.settings.milestone_5_description }}</div>
