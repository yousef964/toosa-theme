          {% if block.settings.challenge_3_title != blank %}
            <div class="ai-brand-journey-challenge-card-{{ ai_gen_id }}">
              <div class="ai-brand-journey-challenge-icon-{{ ai_gen_id }}">{{ block.settings.challenge_3_icon }}</div>
              <h4 class="ai-brand-journey-challenge-heading-{{ ai_gen_id }}">{{ block.settings.challenge_3_title }}</h4>
              <div class="ai-brand-journey-challenge-text-{{ ai_gen_id }}">{{ block.settings.challenge_3_description }}</div>
              {% if block.settings.challenge_3_solution != blank %}
                <div class="ai-brand-journey-challenge-solution-{{ ai_gen_id }}">
                  <div class="ai-brand-journey-challenge-solution-label-{{ ai_gen_id }}">Solution</div>
