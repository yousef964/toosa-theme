{% doc %}
  @prompt
    Create a premium, storytelling-focused Brand Journey section for the TOOSA About Us page that highlights the company's growth, milestones, achievements, challenges, and future vision. The section should feel modern, engaging, and trustworthy while matching TOOSA's industrial premium branding.
    
    The design should combine animated statistics, an interactive timeline, challenge & solution cards, and a company growth journey into a seamless experience. Everything must be editable through the Shopify Theme Editor and fully responsive. give proper section name
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-journey-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-brand-journey-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-brand-journey-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-brand-journey-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.accent_color }};
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
    font-weight: 600;
  }

  .ai-brand-journey-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-brand-journey-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
    opacity: 0.9;
  }

  .ai-brand-journey-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    margin-bottom: 80px;
    padding: 60px 40px;
    background-color: {{ block.settings.stats_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-brand-journey-stat-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-brand-journey-stat-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.stat_number_size }}px;
    color: {{ block.settings.accent_color }};
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1;
  }

  .ai-brand-journey-stat-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.stat_label_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-brand-journey-timeline-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: 80px;
  }

  .ai-brand-journey-timeline-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: center;
    margin-bottom: 60px;
    font-weight: 700;
  }

  .ai-brand-journey-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: {{ block.settings.timeline_line_color }};
    transform: translateX(-50%);
        margin-top: 50px;
  }

  .ai-brand-journey-timeline-items-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-brand-journey-timeline-item-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: 60px;
    display: grid;
    grid-template-columns: 1fr 80px 1fr;
    gap: 40px;
    align-items: center;
  }

  .ai-brand-journey-timeline-content-{{ ai_gen_id }} {
    padding: 30px;
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-brand-journey-timeline-content-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .ai-brand-journey-timeline-item-{{ ai_gen_id }}:nth-child(odd) .ai-brand-journey-timeline-content-{{ ai_gen_id }} {
    grid-column: 1;
  }

  .ai-brand-journey-timeline-item-{{ ai_gen_id }}:nth-child(even) .ai-brand-journey-timeline-content-{{ ai_gen_id }} {
    grid-column: 3;
  }

  .ai-brand-journey-timeline-dot-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    background-color: {{ block.settings.accent_color }};
    border-radius: 50%;
    border: 4px solid {{ block.settings.background_color }};
    grid-column: 2;
    justify-self: center;
    z-index: 2;
  }

  .ai-brand-journey-timeline-year-{{ ai_gen_id }} {
    font-size: {{ block.settings.timeline_year_size }}px;
    color: {{ block.settings.accent_color }};
    font-weight: 700;
    margin-bottom: 12px;
  }

  .ai-brand-journey-timeline-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.timeline_heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-brand-journey-timeline-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.timeline_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    opacity: 0.9;
  }

  .ai-brand-journey-challenges-{{ ai_gen_id }} {
    margin-bottom: 80px;
  }

  .ai-brand-journey-challenges-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: center;
    margin-bottom: 60px;
    font-weight: 700;
  }

  .ai-brand-journey-challenges-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }

  .ai-brand-journey-challenge-card-{{ ai_gen_id }} {
    padding: 40px;
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-brand-journey-challenge-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .ai-brand-journey-challenge-icon-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    background-color: {{ block.settings.accent_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    color: {{ block.settings.icon_color }};
    font-size: 28px;
    font-weight: 700;
  }

  .ai-brand-journey-challenge-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.challenge_heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-brand-journey-challenge-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.challenge_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 20px;
    opacity: 0.9;
  }

  .ai-brand-journey-challenge-solution-{{ ai_gen_id }} {
    padding-top: 20px;
    border-top: 1px solid {{ block.settings.border_color }};
  }

  .ai-brand-journey-challenge-solution-label-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.accent_color }};
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 8px;
    font-weight: 600;
  }

  .ai-brand-journey-challenge-solution-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.challenge_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    opacity: 0.9;
  }

  .ai-brand-journey-vision-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 40px;
    background-color: {{ block.settings.vision_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-brand-journey-vision-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 24px;
    font-weight: 700;
  }

  .ai-brand-journey-vision-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.vision_text_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.7;
    opacity: 0.9;
  }

  @media screen and (max-width: 989px) {
    .ai-brand-journey-timeline-item-{{ ai_gen_id }} {
      grid-template-columns: 40px 1fr;
      gap: 20px;
    }

    .ai-brand-journey-timeline-line-{{ ai_gen_id }} {
      left: 20px;
    }

    .ai-brand-journey-timeline-dot-{{ ai_gen_id }} {
      grid-column: 1;
    }

    .ai-brand-journey-timeline-item-{{ ai_gen_id }}:nth-child(odd) .ai-brand-journey-timeline-content-{{ ai_gen_id }},
    .ai-brand-journey-timeline-item-{{ ai_gen_id }}:nth-child(even) .ai-brand-journey-timeline-content-{{ ai_gen_id }} {
      grid-column: 2;
    }

    .ai-brand-journey-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-brand-journey-stats-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 30px;
      padding: 40px 20px;
    }

    .ai-brand-journey-stat-number-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.stat_number_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-brand-journey-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-brand-journey-header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .ai-brand-journey-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-brand-journey-stats-{{ ai_gen_id }} {
      margin-bottom: 60px;
    }

    .ai-brand-journey-timeline-{{ ai_gen_id }},
    .ai-brand-journey-challenges-{{ ai_gen_id }} {
      margin-bottom: 60px;
    }

    .ai-brand-journey-challenges-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-brand-journey-vision-{{ ai_gen_id }} {
      padding: 40px 24px;
    }
    .ai-brand-journey-subtitle-{{ ai_gen_id }} {
    font-size: 16px;
    }
    .ai-brand-journey-timeline-title-{{ ai_gen_id }} {
    font-size: 28px;
    }
     .ai-brand-journey-timeline-year-{{ ai_gen_id }} {
    font-size: 18px;
  }

  .ai-brand-journey-timeline-heading-{{ ai_gen_id }} {
    font-size: 18px;
  }
  
  .ai-brand-journey-challenges-title-{{ ai_gen_id }} {
    font-size: 28px;
  }
   .ai-brand-journey-challenge-icon-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    font-size: 18px;
   }
   
  .ai-brand-journey-challenge-heading-{{ ai_gen_id }} {
    font-size: 20px;
  }
    .ai-brand-journey-vision-title-{{ ai_gen_id }} {
    font-size: 28px;
    }
    
  .ai-brand-journey-vision-text-{{ ai_gen_id }} {
    font-size: 16px;
  }
  }
{% endstyle %}

<brand-journey-{{ ai_gen_id }} class="ai-brand-journey-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-journey-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-brand-journey-header-{{ ai_gen_id }}">
        {% if block.settings.eyebrow != blank %}
          <div class="ai-brand-journey-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
        {% endif %}
        {% if block.settings.title != blank %}
          <h2 class="ai-brand-journey-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-brand-journey-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_stats %}
      <div class="ai-brand-journey-stats-{{ ai_gen_id }}">
        {% if block.settings.stat_1_number != blank %}
          <div class="ai-brand-journey-stat-{{ ai_gen_id }}">
            <div class="ai-brand-journey-stat-number-{{ ai_gen_id }}" data-target="{{ block.settings.stat_1_number }}">0</div>
            <div class="ai-brand-journey-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</div>
          </div>
        {% endif %}
        {% if block.settings.stat_2_number != blank %}
          <div class="ai-brand-journey-stat-{{ ai_gen_id }}">
            <div class="ai-brand-journey-stat-number-{{ ai_gen_id }}" data-target="{{ block.settings.stat_2_number }}">0</div>
            <div class="ai-brand-journey-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</div>
          </div>
        {% endif %}
        {% if block.settings.stat_3_number != blank %}
          <div class="ai-brand-journey-stat-{{ ai_gen_id }}">
            <div class="ai-brand-journey-stat-number-{{ ai_gen_id }}" data-target="{{ block.settings.stat_3_number }}">0</div>
            <div class="ai-brand-journey-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</div>
          </div>
        {% endif %}
        {% if block.settings.stat_4_number != blank %}
          <div class="ai-brand-journey-stat-{{ ai_gen_id }}">
            <div class="ai-brand-journey-stat-number-{{ ai_gen_id }}" data-target="{{ block.settings.stat_4_number }}">0</div>
            <div class="ai-brand-journey-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_4_label }}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_timeline %}
      <div class="ai-brand-journey-timeline-{{ ai_gen_id }}">
        {% if block.settings.timeline_title != blank %}
          <h3 class="ai-brand-journey-timeline-title-{{ ai_gen_id }}">{{ block.settings.timeline_title }}</h3>
        {% endif %}
        <div class="ai-brand-journey-timeline-line-{{ ai_gen_id }}"></div>
        <div class="ai-brand-journey-timeline-items-{{ ai_gen_id }}">
          {% if block.settings.milestone_1_year != blank %}
            <div class="ai-brand-journey-timeline-item-{{ ai_gen_id }}">
              <div class="ai-brand-journey-timeline-content-{{ ai_gen_id }}">
                <div class="ai-brand-journey-timeline-year-{{ ai_gen_id }}">{{ block.settings.milestone_1_year }}</div>
                <h4 class="ai-brand-journey-timeline-heading-{{ ai_gen_id }}">{{ block.settings.milestone_1_title }}</h4>
                <div class="ai-brand-journey-timeline-text-{{ ai_gen_id }}">{{ block.settings.milestone_1_description }}</div>
              </div>
              <div class="ai-brand-journey-timeline-dot-{{ ai_gen_id }}"></div>
            </div>
          {% endif %}
          {% if block.settings.milestone_2_year != blank %}
            <div class="ai-brand-journey-timeline-item-{{ ai_gen_id }}">
              <div class="ai-brand-journey-timeline-content-{{ ai_gen_id }}">
                <div class="ai-brand-journey-timeline-year-{{ ai_gen_id }}">{{ block.settings.milestone_2_year }}</div>
                <h4 class="ai-brand-journey-timeline-heading-{{ ai_gen_id }}">{{ block.settings.milestone_2_title }}</h4>
                <div class="ai-brand-journey-timeline-text-{{ ai_gen_id }}">{{ block.settings.milestone_2_description }}</div>
              </div>
              <div class="ai-brand-journey-timeline-dot-{{ ai_gen_id }}"></div>
            </div>
          {% endif %}
          {% if block.settings.milestone_3_year != blank %}
            <div class="ai-brand-journey-timeline-item-{{ ai_gen_id }}">
              <div class="ai-brand-journey-timeline-content-{{ ai_gen_id }}">
                <div class="ai-brand-journey-timeline-year-{{ ai_gen_id }}">{{ block.settings.milestone_3_year }}</div>
                <h4 class="ai-brand-journey-timeline-heading-{{ ai_gen_id }}">{{ block.settings.milestone_3_title }}</h4>
                <div class="ai-brand-journey-timeline-text-{{ ai_gen_id }}">{{ block.settings.milestone_3_description }}</div>
              </div>
              <div class="ai-brand-journey-timeline-dot-{{ ai_gen_id }}"></div>
            </div>
          {% endif %}
          {% if block.settings.milestone_4_year != blank %}
            <div class="ai-brand-journey-timeline-item-{{ ai_gen_id }}">
              <div class="ai-brand-journey-timeline-content-{{ ai_gen_id }}">
                <div class="ai-brand-journey-timeline-year-{{ ai_gen_id }}">{{ block.settings.milestone_4_year }}</div>
                <h4 class="ai-brand-journey-timeline-heading-{{ ai_gen_id }}">{{ block.settings.milestone_4_title }}</h4>
                <div class="ai-brand-journey-timeline-text-{{ ai_gen_id }}">{{ block.settings.milestone_4_description }}</div>
              </div>
              <div class="ai-brand-journey-timeline-dot-{{ ai_gen_id }}"></div>
