      "default": 14
    },
    {
      "type": "range",
      "id": "value_size",
      "label": "Value size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "label_text_transform",
      "label": "Label text transform",
      "options": [
