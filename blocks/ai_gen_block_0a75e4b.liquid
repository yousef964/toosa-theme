    },
    {
      "type": "url",
      "id": "card_3_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Card 4 - Hours"
    },
    {
      "type": "checkbox",
      "id": "show_card_4",
      "label": "Show card 4",
      "default": true
