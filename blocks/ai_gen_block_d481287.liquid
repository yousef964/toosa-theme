{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-video-gallery-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-gallery-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 400;
  }

  .ai-video-gallery-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin: 0 -10px;
  }

  .ai-video-gallery-slider-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.video_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 10px 20px;
  }

  .ai-video-gallery-slider-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-video-gallery-slide-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.video_width }}px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-video-gallery-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.video_height }}px;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-video-gallery-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-video-gallery-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-align: center;
    margin: 0;
    line-height: 1.4;
        cursor: none;
  }

  .ai-video-gallery-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
  }

  .ai-video-gallery-nav-button-{{ ai_gen_id }} {
     width: 30px;
    height: 30px;
    padding:10px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease, transform 0.2s ease;
  }

  .ai-video-gallery-nav-button-{{ ai_gen_id }}:hover {
    {% comment %} opacity: 0.8;
    transform: scale(1.05); {% endcomment %}
        background-color: #ff6f3c;
  }

  .ai-video-gallery-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: scale(1);
  }

  .ai-video-gallery-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.nav_icon_color }};
  }

  .ai-video-gallery-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 768px) {
    .ai-video-gallery-slide-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_video_width }}%;
    }

    .ai-video-gallery-video-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_video_height }}px;
    }

    .ai-video-gallery-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-video-gallery-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<video-gallery-{{ ai_gen_id }} class="ai-video-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-gallery-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-video-gallery-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% assign has_videos = false %}
    {% for i in (1..8) %}
      {% assign video_key = 'video_' | append: i %}
      {% if block.settings[video_key] != blank %}
        {% assign has_videos = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_videos %}
      <div class="ai-video-gallery-slider-wrapper-{{ ai_gen_id }}">
        <div class="ai-video-gallery-slider-{{ ai_gen_id }}" data-slider>
          {% for i in (1..8) %}
            {% assign video_key = 'video_' | append: i %}
            {% assign title_key = 'video_' | append: i | append: '_title' %}
            {% assign video_url = block.settings[video_key] %}
            {% assign video_title = block.settings[title_key] %}

            {% if video_url != blank %}
              <div class="ai-video-gallery-slide-{{ ai_gen_id }}">
                <div class="ai-video-gallery-video-wrapper-{{ ai_gen_id }}">
                  <video
                    class="ai-video-gallery-video-{{ ai_gen_id }}"
                    controls
                    preload="metadata"
                  >
                    <source src="{{ video_url }}" type="video/mp4">
                    Your browser does not support the video tag.
                  </video>
                </div>
                {% if video_title != blank %}
                  <h3 class="ai-video-gallery-title-{{ ai_gen_id }}">{{ video_title }}</h3>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="ai-video-gallery-nav-{{ ai_gen_id }}">
        <button
          class="ai-video-gallery-nav-button-{{ ai_gen_id }}"
          data-prev
          aria-label="Previous videos"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </button>
        <button
          class="ai-video-gallery-nav-button-{{ ai_gen_id }}"
          data-next
          aria-label="Next videos"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
          </svg>
        </button>
      </div>
    {% else %}
      <div class="ai-video-gallery-empty-{{ ai_gen_id }}">
        Add videos to display your gallery
      </div>
    {% endif %}
  </div>
</video-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.slider = this.querySelector('[data-slider]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.scrollAmount = {{ block.settings.video_width | plus: block.settings.video_gap }};
      }

      connectedCallback() {
        if (!this.slider) return;

        this.updateButtons();
        this.slider.addEventListener('scroll', () => this.updateButtons());

        this.prevButton.addEventListener('click', () => this.scroll('prev'));
        this.nextButton.addEventListener('click', () => this.scroll('next'));

        let isDown = false;
        let startX;
        let scrollLeft;

        this.slider.addEventListener('mousedown', (e) => {
          isDown = true;
          this.slider.style.cursor = 'grabbing';
          startX = e.pageX - this.slider.offsetLeft;
          scrollLeft = this.slider.scrollLeft;
        });

        this.slider.addEventListener('mouseleave', () => {
          isDown = false;
          this.slider.style.cursor = 'grab';
        });

        this.slider.addEventListener('mouseup', () => {
          isDown = false;
          this.slider.style.cursor = 'grab';
        });

        this.slider.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.slider.offsetLeft;
          const walk = (x - startX) * 2;
          this.slider.scrollLeft = scrollLeft - walk;
        });
      }

      scroll(direction) {
        const scrollDistance = direction === 'next' ? this.scrollAmount : -this.scrollAmount;
        this.slider.scrollBy({
          left: scrollDistance,
          behavior: 'smooth'
        });
      }

      updateButtons() {
        const isAtStart = this.slider.scrollLeft <= 0;
        const isAtEnd = this.slider.scrollLeft + this.slider.clientWidth >= this.slider.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('video-gallery-{{ ai_gen_id }}', VideoGallery{{ ai_gen_id }});
  })();
</script>

