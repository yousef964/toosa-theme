{% doc %}
  @prompt
    Create a premium, modern, and conversion-focused Mission & Vision section for the TOOSA About Us page. The design should communicate the company's purpose, values, and long-term vision while maintaining a clean industrial aesthetic. The section should be visually engaging with modern cards, subtle animations, premium typography, and excellent readability.
    
    The section must be built using Shopify Online Store 2.0, support dynamic content blocks, and be fully customizable through the Theme Editor without editing code.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-mission-vision-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-mission-vision-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-mission-vision-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-mission-vision-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: 16px;
    display: block;
  }

  .ai-mission-vision-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .ai-mission-vision-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 auto;
    max-width: 800px;
    line-height: 1.6;
  }

  .ai-mission-vision-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-mission-vision-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .ai-mission-vision-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.card_hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_hover_lift | times: 2 }}px {{ block.settings.card_hover_lift | times: 4 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    border-color: {{ block.settings.card_border_hover_color }};
  }

  .ai-mission-vision-card-accent-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: {{ block.settings.accent_width }}px;
    height: 100%;
    background-color: {{ block.settings.accent_color }};
    transition: width 0.3s ease;
  }

  .ai-mission-vision-card-{{ ai_gen_id }}:hover .ai-mission-vision-card-accent-{{ ai_gen_id }} {
    width: {{ block.settings.accent_hover_width }}px;
  }

  .ai-mission-vision-card-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
  }

  .ai-mission-vision-card-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-mission-vision-card-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size | times: 0.5 }}px;
    height: {{ block.settings.icon_size | times: 0.5 }}px;
    stroke-width: 2;
  }

  .ai-mission-vision-card-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
    margin-bottom: 16px;
    display: block;
  }

  .ai-mission-vision-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .ai-mission-vision-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.card_description_color }};
    line-height: 1.7;
    margin: 0;
  }

  .ai-mission-vision-card-description-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-mission-vision-card-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-mission-vision-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-mission-vision-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-mission-vision-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 0 {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-mission-vision-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.7 }}px;
    }

    .ai-mission-vision-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-mission-vision-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
    .ai-mission-vision-card-title-{{ ai_gen_id }} {
    font-size: 18px;
    }
      .ai-mission-vision-card-description-{{ ai_gen_id }} {
    font-size: 14px;
      }
       .ai-mission-vision-subtitle-{{ ai_gen_id }} {
    font-size: 16px;
       }
  }
{% endstyle %}

<mission-vision-{{ ai_gen_id }} class="ai-mission-vision-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-mission-vision-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-mission-vision-header-{{ ai_gen_id }}">
        {% if block.settings.eyebrow != blank %}
          <span class="ai-mission-vision-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</span>
        {% endif %}
        
        {% if block.settings.title != blank %}
          <h2 class="ai-mission-vision-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        
        {% if block.settings.subtitle != blank %}
          <div class="ai-mission-vision-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-mission-vision-grid-{{ ai_gen_id }}">
      {% if block.settings.show_mission %}
        <div class="ai-mission-vision-card-{{ ai_gen_id }}">
          {% if block.settings.show_accent %}
            <div class="ai-mission-vision-card-accent-{{ ai_gen_id }}"></div>
          {% endif %}
          
          <div class="ai-mission-vision-card-content-{{ ai_gen_id }}">
            {% if block.settings.show_icons %}
              <div class="ai-mission-vision-card-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
            {% endif %}

            {% if block.settings.mission_label != blank %}
              <span class="ai-mission-vision-card-label-{{ ai_gen_id }}">{{ block.settings.mission_label }}</span>
            {% endif %}

            {% if block.settings.mission_title != blank %}
              <h3 class="ai-mission-vision-card-title-{{ ai_gen_id }}">{{ block.settings.mission_title }}</h3>
            {% endif %}

            {% if block.settings.mission_description != blank %}
              <div class="ai-mission-vision-card-description-{{ ai_gen_id }}">
                {{ block.settings.mission_description }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_vision %}
        <div class="ai-mission-vision-card-{{ ai_gen_id }}">
          {% if block.settings.show_accent %}
            <div class="ai-mission-vision-card-accent-{{ ai_gen_id }}"></div>
          {% endif %}
          
          <div class="ai-mission-vision-card-content-{{ ai_gen_id }}">
            {% if block.settings.show_icons %}
              <div class="ai-mission-vision-card-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
            {% endif %}

            {% if block.settings.vision_label != blank %}
              <span class="ai-mission-vision-card-label-{{ ai_gen_id }}">{{ block.settings.vision_label }}</span>
            {% endif %}

            {% if block.settings.vision_title != blank %}
              <h3 class="ai-mission-vision-card-title-{{ ai_gen_id }}">{{ block.settings.vision_title }}</h3>
            {% endif %}

            {% if block.settings.vision_description != blank %}
              <div class="ai-mission-vision-card-description-{{ ai_gen_id }}">
                {{ block.settings.vision_description }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_values %}
        <div class="ai-mission-vision-card-{{ ai_gen_id }}">
          {% if block.settings.show_accent %}
            <div class="ai-mission-vision-card-accent-{{ ai_gen_id }}"></div>
          {% endif %}
          
          <div class="ai-mission-vision-card-content-{{ ai_gen_id }}">
            {% if block.settings.show_icons %}
              <div class="ai-mission-vision-card-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                </svg>
              </div>
            {% endif %}

            {% if block.settings.values_label != blank %}
              <span class="ai-mission-vision-card-label-{{ ai_gen_id }}">{{ block.settings.values_label }}</span>
            {% endif %}

            {% if block.settings.values_title != blank %}
