{% doc %}
  @prompt
    Create a lightweight responsive Shopify Refine theme blog article section for TOOSA.
    
    Include:
    Featured image, breadcrumb, article title, category, author/date, article content, sticky desktop TOC, social sharing, related articles, previous/next post and CTA.
    
    Use dynamic Shopify article data.
    
    Design: premium, clean, modern, white background, dark text, TOOSA orange #F15A29.
    
    Desktop: article + TOC.
    Mobile: single column + collapsible TOC.
    
    Use only Liquid, CSS and minimal JavaScript.
    No external libraries.
    No horizontal overflow.
    SEO and accessibility friendly.
    Add essential Theme Editor settings only.
    Generate complete valid Liquid section code with schema.
    Return only the code.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-article-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    color: #1e2a38;
  }

  .ai-blog-article-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .ai-blog-breadcrumb-{{ ai_gen_id }} {
    font-size: 14px;
    margin-bottom: 30px;
    color: #666;
  }

  .ai-blog-breadcrumb-{{ ai_gen_id }} a {
    color: #F15A29;
    text-decoration: none;
  }

  .ai-blog-breadcrumb-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-blog-breadcrumb-{{ ai_gen_id }} span {
    margin: 0 8px;
  }

  .ai-blog-featured-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 40px;
    border-radius: 8px;
    overflow: hidden;
  }

  .ai-blog-featured-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-blog-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
  }

  .ai-blog-main-content-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-blog-header-{{ ai_gen_id }} {
    margin-bottom: 40px;
  }

  .ai-blog-category-{{ ai_gen_id }} {
    display: inline-block;
    background-color: #F15A29;
    color: #ffffff;
    padding: 6px 16px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    text-decoration: none;
  }

  .ai-blog-title-{{ ai_gen_id }} {
    font-size: 42px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 20px;
    color: #1e2a38;
  }

  .ai-blog-meta-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 15px;
    color: #666;
    margin-bottom: 30px;
  }

  .ai-blog-meta-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-blog-social-share-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    padding: 20px 0;
    border-top: 1px solid #e0e0e0;
    border-bottom: 1px solid #e0e0e0;
    margin-bottom: 40px;
  }

  .ai-blog-social-share-label-{{ ai_gen_id }} {
    font-weight: 600;
    margin-right: 8px;
    color: #1e2a38;
  }

  .ai-blog-social-btn-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #f5f5f5;
    color: #1e2a38;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-blog-social-btn-{{ ai_gen_id }}:hover {
    background-color: #F15A29;
    color: #ffffff;
  }

  .ai-blog-social-btn-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  .ai-blog-content-{{ ai_gen_id }} {
    font-size: 17px;
    line-height: 1.8;
    color: #333;
  }

  .ai-blog-content-{{ ai_gen_id }} h2 {
    font-size: 32px;
    font-weight: 700;
    margin: 40px 0 20px;
    color: #1e2a38;
  }

  .ai-blog-content-{{ ai_gen_id }} h3 {
    font-size: 26px;
    font-weight: 600;
    margin: 32px 0 16px;
    color: #1e2a38;
  }

  .ai-blog-content-{{ ai_gen_id }} p {
    margin-bottom: 20px;
  }

  .ai-blog-content-{{ ai_gen_id }} ul,
  .ai-blog-content-{{ ai_gen_id }} ol {
    margin: 20px 0;
    padding-left: 30px;
  }

  .ai-blog-content-{{ ai_gen_id }} li {
    margin-bottom: 10px;
  }

  .ai-blog-content-{{ ai_gen_id }} a {
    color: #F15A29;
    text-decoration: underline;
  }

  .ai-blog-content-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 30px 0;
  }

  .ai-blog-toc-wrapper-{{ ai_gen_id }} {
    display: none;
  }

  .ai-blog-toc-{{ ai_gen_id }} {
    background-color: #f9f9f9;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 24px;
  }

  .ai-blog-toc-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 16px;
    color: #1e2a38;
  }

  .ai-blog-toc-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-blog-toc-list-{{ ai_gen_id }} li {
    margin-bottom: 12px;
  }

  .ai-blog-toc-list-{{ ai_gen_id }} a {
    color: #666;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.5;
    display: block;
    transition: color 0.3s ease;
  }

  .ai-blog-toc-list-{{ ai_gen_id }} a:hover,
  .ai-blog-toc-list-{{ ai_gen_id }} a.active {
    color: #F15A29;
  }

  .ai-blog-toc-mobile-toggle-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #f9f9f9;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 16px 20px;
    text-align: left;
    font-size: 16px;
    font-weight: 600;
    color: #1e2a38;
    cursor: pointer;
    margin-bottom: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ai-blog-toc-mobile-toggle-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .ai-blog-toc-mobile-toggle-{{ ai_gen_id }}.active svg {
    transform: rotate(180deg);
  }

  .ai-blog-toc-mobile-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-blog-toc-mobile-content-{{ ai_gen_id }}.active {
    max-height: 1000px;
    margin-bottom: 30px;
  }

  .ai-blog-navigation-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 60px 0;
    padding: 40px 0;
    border-top: 2px solid #e0e0e0;
    border-bottom: 2px solid #e0e0e0;
  }

  .ai-blog-nav-item-{{ ai_gen_id }} {
    text-decoration: none;
    padding: 20px;
    background-color: #f9f9f9;
    border-radius: 8px;
    transition: background-color 0.3s ease;
  }

  .ai-blog-nav-item-{{ ai_gen_id }}:hover {
    background-color: #f0f0f0;
  }

  .ai-blog-nav-label-{{ ai_gen_id }} {
    font-size: 13px;
    text-transform: uppercase;
    color: #F15A29;
    font-weight: 600;
    margin-bottom: 8px;
    display: block;
  }

  .ai-blog-nav-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: #1e2a38;
    line-height: 1.4;
  }

  .ai-blog-nav-item-{{ ai_gen_id }}--next {
    text-align: right;
  }

  .ai-blog-related-{{ ai_gen_id }} {
    margin: 60px 0;
  }

  .ai-blog-related-title-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 30px;
    color: #1e2a38;
  }

  .ai-blog-related-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .ai-blog-related-card-{{ ai_gen_id }} {
    text-decoration: none;
    display: block;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f9f9f9;
    transition: transform 0.3s ease;
  }

  .ai-blog-related-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-blog-related-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .ai-blog-related-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blog-related-content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-blog-related-card-title-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 600;
    color: #1e2a38;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .ai-blog-related-card-excerpt-{{ ai_gen_id }} {
    font-size: 15px;
    color: #666;
    line-height: 1.6;
  }

  .ai-blog-cta-{{ ai_gen_id }} {
    background-color: #F15A29;
    color: #ffffff;
    padding: 60px 40px;
    border-radius: 12px;
    text-align: center;
    margin: 60px 0;
  }

  .ai-blog-cta-title-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 16px;
  }

  .ai-blog-cta-text-{{ ai_gen_id }} {
    font-size: 18px;
    margin-bottom: 30px;
    opacity: 0.95;
  }

  .ai-blog-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: #ffffff;
    color: #F15A29;
    padding: 16px 40px;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-blog-cta-button-{{ ai_gen_id }}:hover {
    background-color: #1e2a38;
    color: #ffffff;
  }

  @media screen and (min-width: 750px) {
    .ai-blog-container-{{ ai_gen_id }} {
      padding: 60px 40px;
    }

    .ai-blog-title-{{ ai_gen_id }} {
      font-size: 52px;
    }

    .ai-blog-related-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .ai-blog-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr 300px;
    }

    .ai-blog-toc-wrapper-{{ ai_gen_id }} {
      display: block;
    }

    .ai-blog-toc-{{ ai_gen_id }} {
      position: sticky;
      top: 100px;
    }

    .ai-blog-toc-mobile-toggle-{{ ai_gen_id }},
    .ai-blog-toc-mobile-content-{{ ai_gen_id }} {
      display: none;
    }

    .ai-blog-related-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstyle %}

<article-blog-{{ ai_gen_id }} class="ai-blog-article-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-article-container-{{ ai_gen_id }}">
    {% if block.settings.show_breadcrumb %}
      <nav class="ai-blog-breadcrumb-{{ ai_gen_id }}" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="{{ blog.url }}">{{ blog.title }}</a>
        <span>/</span>
        <span>{{ article.title }}</span>
      </nav>
    {% endif %}

    {% if block.settings.show_featured_image and article.image %}
      <div class="ai-blog-featured-image-{{ ai_gen_id }}">
        <img
          src="{{ article.image | image_url: width: 1400 }}"
          alt="{{ article.image.alt | escape }}"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          loading="eager"
        >
      </div>
    {% endif %}

    <div class="ai-blog-layout-{{ ai_gen_id }}">
      <div class="ai-blog-main-content-{{ ai_gen_id }}">
        <header class="ai-blog-header-{{ ai_gen_id }}">
          {% if block.settings.show_category and article.tags.size > 0 %}
            <a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}" class="ai-blog-category-{{ ai_gen_id }}">
              {{ article.tags.first }}
            </a>
          {% endif %}

          <h1 class="ai-blog-title-{{ ai_gen_id }}">{{ article.title }}</h1>

          <div class="ai-blog-meta-{{ ai_gen_id }}">
            {% if block.settings.show_author %}
              <div class="ai-blog-meta-item-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span>{{ article.author }}</span>
              </div>
            {% endif %}

            {% if block.settings.show_date %}
              <div class="ai-blog-meta-item-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%B %d, %Y' }}
                </time>
              </div>
            {% endif %}
          </div>
        </header>

        {% if block.settings.show_social_share %}
          <div class="ai-blog-social-share-{{ ai_gen_id }}">
            <span class="ai-blog-social-share-label-{{ ai_gen_id }}">Share:</span>
            <a
              href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}"
              target="_blank"
              rel="noopener"
              class="ai-blog-social-btn-{{ ai_gen_id }}"
              aria-label="Share on Facebook"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a
              href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title | url_encode }}"
              target="_blank"
              rel="noopener"
              class="ai-blog-social-btn-{{ ai_gen_id }}"
              aria-label="Share on Twitter"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
            </a>
            <a
              href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ article.url }}&media={{ article.image | image_url: width: 1000 }}&description={{ article.title | url_encode }}"
              target="_blank"
              rel="noopener"
              class="ai-blog-social-btn-{{ ai_gen_id }}"
              aria-label="Share on Pinterest"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/></svg>
            </a>
            <a
              href="https://www.linkedin.com/shareArticle?mini=true&url={{ shop.url }}{{ article.url }}&title={{ article.title | url_encode }}"
              target="_blank"
              rel="noopener"
              class="ai-blog-social-btn-{{ ai_gen_id }}"
              aria-label="Share on LinkedIn"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          </div>
        {% endif %}

        <button class="ai-blog-toc-mobile-toggle-{{ ai_gen_id }}" aria-expanded="false">
          Table of Contents
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <div class="ai-blog-toc-mobile-content-{{ ai_gen_id }}">
          <div class="ai-blog-toc-{{ ai_gen_id }}">
            <h2 class="ai-blog-toc-title-{{ ai_gen_id }}">Table of Contents</h2>
            <ul class="ai-blog-toc-list-{{ ai_gen_id }}"></ul>
          </div>
        </div>

        <div class="ai-blog-content-{{ ai_gen_id }}">
          {{ article.content }}
        </div>

        {% if block.settings.show_cta %}
          <div class="ai-blog-cta-{{ ai_gen_id }}">
            <h2 class="ai-blog-cta-title-{{ ai_gen_id }}">{{ block.settings.cta_title }}</h2>
            <p class="ai-blog-cta-text-{{ ai_gen_id }}">{{ block.settings.cta_text }}</p>
            {% if block.settings.cta_button_text != blank and block.settings.cta_button_link != blank %}
              <a href="{{ block.settings.cta_button_link }}" class="ai-blog-cta-button-{{ ai_gen_id }}">
                {{ block.settings.cta_button_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.show_navigation %}
          <nav class="ai-blog-navigation-{{ ai_gen_id }}">
            {% if blog.previous_article %}
              <a href="{{ blog.previous_article.url }}" class="ai-blog-nav-item-{{ ai_gen_id }} ai-blog-nav-item-{{ ai_gen_id }}--prev">
                <span class="ai-blog-nav-label-{{ ai_gen_id }}">← Previous</span>
                <span class="ai-blog-nav-title-{{ ai_gen_id }}">{{ blog.previous_article.title }}</span>
              </a>
            {% else %}
              <div></div>
            {% endif %}

            {% if blog.next_article %}
              <a href="{{ blog.next_article.url }}" class="ai-blog-nav-item-{{ ai_gen_id }} ai-blog-nav-item-{{ ai_gen_id }}--next">
                <span class="ai-blog-nav-label-{{ ai_gen_id }}">Next →</span>
                <span class="ai-blog-nav-title-{{ ai_gen_id }}">{{ blog.next_article.title }}</span>
              </a>
            {% endif %}
          </nav>
        {% endif %}

        {% if block.settings.show_related and blog.articles.size > 1 %}
          <section class="ai-blog-related-{{ ai_gen_id }}">
            <h2 class="ai-blog-related-title-{{ ai_gen_id }}">Related Articles</h2>
            <div class="ai-blog-related-grid-{{ ai_gen_id }}">
              {% for related_article in blog.articles limit: 3 %}
                {% if related_article.id != article.id %}
                  <a href="{{ related_article.url }}" class="ai-blog-related-card-{{ ai_gen_id }}">
                    <div class="ai-blog-related-image-{{ ai_gen_id }}">
                      {% if related_article.image %}
                        <img
                          src="{{ related_article.image | image_url: width: 600 }}"
                          alt="{{ related_article.image.alt | escape }}"
                          width="600"
                          height="338"
                          loading="lazy"
                        >
                      {% else %}
                        {{ 'image' | placeholder_svg_tag }}
                      {% endif %}
                    </div>
                    <div class="ai-blog-related-content-{{ ai_gen_id }}">
                      <h3 class="ai-blog-related-card-title-{{ ai_gen_id }}">{{ related_article.title }}</h3>
                      {% if related_article.excerpt != blank %}
                        <p class="ai-blog-related-card-excerpt-{{ ai_gen_id }}">
                          {{ related_article.excerpt | strip_html | truncate: 100 }}
                        </p>
                      {% endif %}
                    </div>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </section>
        {% endif %}
      </div>

      {% if block.settings.show_toc %}
        <aside class="ai-blog-toc-wrapper-{{ ai_gen_id }}">
          <nav class="ai-blog-toc-{{ ai_gen_id }}" aria-label="Table of Contents">
            <h2 class="ai-blog-toc-title-{{ ai_gen_id }}">Table of Contents</h2>
            <ul class="ai-blog-toc-list-{{ ai_gen_id }}"></ul>
          </nav>
        </aside>
      {% endif %}
    </div>
  </div>
</article-blog-{{ ai_gen_id }}>

<script>
  (function() {
    class ArticleBlog{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.content = this.querySelector('.ai-blog-content-{{ ai_gen_id }}');
        this.tocLists = this.querySelectorAll('.ai-blog-toc-list-{{ ai_gen_id }}');
        this.mobileToggle = this.querySelector('.ai-blog-toc-mobile-toggle-{{ ai_gen_id }}');
        this.mobileContent = this.querySelector('.ai-blog-toc-mobile-content-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.generateTOC();
        this.setupMobileToggle();
        this.setupScrollSpy();
      }

      generateTOC() {
        if (!this.content || this.tocLists.length === 0) return;

        const headings = this.content.querySelectorAll('h2, h3');
        if (headings.length === 0) return;

        headings.forEach((heading, index) => {
          const id = 'heading-' + index;
          heading.id = id;

          const link = document.createElement('a');
          link.href = '#' + id;
          link.textContent = heading.textContent;
          link.addEventListener('click', (e) => {
            e.preventDefault();
            heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
            if (window.innerWidth < 990 && this.mobileContent) {
              this.mobileContent.classList.remove('active');
              this.mobileToggle.classList.remove('active');
              this.mobileToggle.setAttribute('aria-expanded', 'false');
            }
          });

          const li = document.createElement('li');
          li.appendChild(link);

          this.tocLists.forEach(tocList => {
            const clonedLi = li.cloneNode(true);
            const clonedLink = clonedLi.querySelector('a');
            clonedLink.addEventListener('click', (e) => {
              e.preventDefault();
              heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
              if (window.innerWidth < 990 && this.mobileContent) {
                this.mobileContent.classList.remove('active');
                this.mobileToggle.classList.remove('active');
                this.mobileToggle.setAttribute('aria-expanded', 'false');
              }
            });
            tocList.appendChild(clonedLi);
          });
        });
      }

      setupMobileToggle() {
        if (!this.mobileToggle || !this.mobileContent) return;

        this.mobileToggle.addEventListener('click', () => {
          const isActive = this.mobileContent.classList.toggle('active');
          this.mobileToggle.classList.toggle('active');
          this.mobileToggle.setAttribute('aria-expanded', isActive);
        });
      }

      setupScrollSpy() {
        if (!this.content || this.tocLists.length === 0) return;

        const headings = this.content.querySelectorAll('h2, h3');
        if (headings.length === 0) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                this.tocLists.forEach(tocList => {
                  tocList.querySelectorAll('a').forEach((link) => {
                    link.classList.remove('active');
                    if (link.getAttribute('href') === '#' + entry.target.id) {
                      link.classList.add('active');
                    }
                  });
                });
              }
            });
          },
          { rootMargin: '-100px 0px -66%' }
        );

        headings.forEach((heading) => observer.observe(heading));
      }
    }

    customElements.define('article-blog-{{ ai_gen_id }}', ArticleBlog{{ ai_gen_id }});
  })();
</script>

