{% doc %}
  @prompt
    Create a modern, premium Shopify video stories section inspired by the provided screenshot.
    
    * Use a **horizontal Swiper carousel** with large vertical video cards.
    * Desktop: show **3–4 full cards + part of the next card** for a continuous peek effect.
    * Each card should have a **portrait aspect ratio**, rounded corners, and `object-fit: cover`.
    * Add a **dark gradient overlay** at the bottom of each video.
    * Display the **video title** in bold white text at the bottom-left with a small **“LEARN MORE →”** link below it.
    * Add **left/right navigation arrows** positioned over the cards.
    * Add a **subtle scrollbar/progress indicator** below the carousel.
    * Videos should support **MP4 URLs** and autoplay muted/loop on mobile and desktop where appropriate.
    * Desktop cards should feel spacious and premium; avoid the small horizontal video layout from the previous version.
    * Mobile: show **1 full card + a small portion of the next card**, with smooth touch/swipe support.
    * Make all spacing, card width, typography, arrows, border radius, and overlay settings responsive.
    * Add Shopify **section schema settings** for heading, subheading, card width, card height/aspect ratio, spacing, autoplay, loop, navigation, colors, and video/title blocks.
    * Keep the design clean, minimal, white-background, and fully responsive.
    * Use **Swiper.js**, scoped CSS, and vanilla JavaScript. Ensure the section works independently without affecting other Shopify sections.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

{% style %}
  .ai-video-stories-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-video-stories-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.container_padding }}px;
  }

  .ai-video-stories-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-video-stories-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-video-stories-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-video-stories-swiper-wrapper-{{ ai_gen_id }} {
    position: relative;
    padding: 0 {{ block.settings.arrow_offset }}px;
  }

  .ai-video-stories-swiper-{{ ai_gen_id }} {
    overflow: visible;
    padding-bottom: {{ block.settings.scrollbar_spacing }}px;
  }

  .ai-video-stories-swiper-{{ ai_gen_id }} .swiper-wrapper {
    align-items: stretch;
  }

  .ai-video-stories-slide-{{ ai_gen_id }} {
    height: auto;
  }

  .ai-video-stories-card-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.card_height }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background-color: #000;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-video-stories-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-video-stories-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-video-stories-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: {{ block.settings.overlay_height }}%;
    background: linear-gradient(to top, {{ block.settings.overlay_color }}, transparent);
    pointer-events: none;
  }

  .ai-video-stories-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.content_padding }}px;
    left: {{ block.settings.content_padding }}px;
    right: {{ block.settings.content_padding }}px;
    z-index: 2;
  }

  .ai-video-stories-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 700;
    margin: 0 0 {{ block.settings.link_spacing }}px;
    line-height: 1.3;
  }

  .ai-video-stories-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-weight: 500;
    transition: gap 0.3s ease;
  }

  .ai-video-stories-link-{{ ai_gen_id }}:hover {
    gap: 10px;
  }

  .ai-video-stories-arrow-{{ ai_gen_id }} {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    background-color: {{ block.settings.arrow_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    border: none;
    padding: 0;
  }

  .ai-video-stories-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-video-stories-arrow-{{ ai_gen_id }}.swiper-button-disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-stories-arrow-{{ ai_gen_id }}.swiper-button-disabled:hover {
    transform: translateY(-50%) scale(1);
  }

  .ai-video-stories-arrow-prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-video-stories-arrow-next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-video-stories-arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.arrow_color }};
  }

  .ai-video-stories-scrollbar-{{ ai_gen_id }} {
    position: relative;
    height: {{ block.settings.scrollbar_height }}px;
    background-color: {{ block.settings.scrollbar_background }};
    border-radius: {{ block.settings.scrollbar_height | divided_by: 2 }}px;
    margin-top: {{ block.settings.scrollbar_spacing }}px;
  }

  .ai-video-stories-scrollbar-{{ ai_gen_id }} .swiper-scrollbar-drag {
    background-color: {{ block.settings.scrollbar_drag_color }};
    border-radius: {{ block.settings.scrollbar_height | divided_by: 2 }}px;
    cursor: grab;
  }

  .ai-video-stories-scrollbar-{{ ai_gen_id }} .swiper-scrollbar-drag:active {
    cursor: grabbing;
  }

  @media screen and (max-width: 749px) {
    .ai-video-stories-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-video-stories-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-video-stories-card-{{ ai_gen_id }} {
      height: {{ block.settings.card_height_mobile }}px;
    }

    .ai-video-stories-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-video-stories-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.link_size | times: 0.85 }}px;
    }

    .ai-video-stories-arrow-{{ ai_gen_id }} {
      width: {{ block.settings.arrow_size | times: 0.8 }}px;
      height: {{ block.settings.arrow_size | times: 0.8 }}px;
    }

    .ai-video-stories-swiper-wrapper-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.arrow_offset | times: 0.5 }}px;
    }
  }
{% endstyle %}

<ai-video-stories-{{ ai_gen_id }} class="ai-video-stories-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-stories-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-video-stories-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-stories-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-video-stories-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-video-stories-swiper-wrapper-{{ ai_gen_id }}">
      <div class="swiper ai-video-stories-swiper-{{ ai_gen_id }}">
        <div class="swiper-wrapper">
          {% for i in (1..10) %}
            {% liquid
              assign video_url_key = 'video_url_' | append: i
              assign video_title_key = 'video_title_' | append: i
              assign video_link_key = 'video_link_' | append: i
              assign video_link_text_key = 'video_link_text_' | append: i

              assign video_url = block.settings[video_url_key]
              assign video_title = block.settings[video_title_key]
              assign video_link = block.settings[video_link_key]
              assign video_link_text = block.settings[video_link_text_key]
            %}

            {% if video_url != blank %}
              <div class="swiper-slide ai-video-stories-slide-{{ ai_gen_id }}">
                <div class="ai-video-stories-card-{{ ai_gen_id }}">
                  <video
                    class="ai-video-stories-video-{{ ai_gen_id }}"
                    {% if block.settings.autoplay %}autoplay{% endif %}
                    {% if block.settings.loop %}loop{% endif %}
                    {% if block.settings.muted %}muted{% endif %}
                    playsinline
                    preload="metadata"
                  >
                    <source src="{{ video_url }}" type="video/mp4">
                  </video>

                  <div class="ai-video-stories-overlay-{{ ai_gen_id }}"></div>

                  <div class="ai-video-stories-content-{{ ai_gen_id }}">
                    {% if video_title != blank %}
                      <h3 class="ai-video-stories-title-{{ ai_gen_id }}">{{ video_title }}</h3>
                    {% endif %}

                    {% if video_link != blank and video_link_text != blank %}
                      <a href="{{ video_link }}" class="ai-video-stories-link-{{ ai_gen_id }}">
                        {{ video_link_text }}
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {% if block.settings.show_arrows %}
        <button class="ai-video-stories-arrow-{{ ai_gen_id }} ai-video-stories-arrow-prev-{{ ai_gen_id }}" aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </button>
        <button class="ai-video-stories-arrow-{{ ai_gen_id }} ai-video-stories-arrow-next-{{ ai_gen_id }}" aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
          </svg>
        </button>
      {% endif %}

      {% if block.settings.show_scrollbar %}
        <div class="ai-video-stories-scrollbar-{{ ai_gen_id }}"></div>
      {% endif %}
    </div>
  </div>
</ai-video-stories-{{ ai_gen_id }}>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  (function() {
    class AIVideoStories{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.swiper = null;
      }

      connectedCallback() {
        this.initSwiper();
        this.setupVideoPlayback();
      }

      initSwiper() {
        const swiperEl = this.querySelector('.ai-video-stories-swiper-{{ ai_gen_id }}');
        if (!swiperEl) return;

        const isMobile = window.innerWidth < 750;
        const slidesPerView = isMobile ? {{ block.settings.slides_per_view_mobile }} : {{ block.settings.slides_per_view_desktop }};
        const spaceBetween = isMobile ? {{ block.settings.space_between_mobile }} : {{ block.settings.space_between_desktop }};

        this.swiper = new Swiper(swiperEl, {
          slidesPerView: slidesPerView,
          spaceBetween: spaceBetween,
          {% if block.settings.show_scrollbar %}
          scrollbar: {
            el: '.ai-video-stories-scrollbar-{{ ai_gen_id }}',
            draggable: true,
            dragSize: 'auto',
          },
          {% endif %}
          {% if block.settings.show_arrows %}
          navigation: {
            nextEl: '.ai-video-stories-arrow-next-{{ ai_gen_id }}',
            prevEl: '.ai-video-stories-arrow-prev-{{ ai_gen_id }}',
          },
          {% endif %}
          {% if block.settings.enable_grab_cursor %}
          grabCursor: true,
          {% endif %}
          watchSlidesProgress: true,
          breakpoints: {
            750: {
              slidesPerView: {{ block.settings.slides_per_view_desktop }},
              spaceBetween: {{ block.settings.space_between_desktop }},
            },
            0: {
              slidesPerView: {{ block.settings.slides_per_view_mobile }},
              spaceBetween: {{ block.settings.space_between_mobile }},
            }
          }
        });

        window.addEventListener('resize', () => {
          if (this.swiper) {
            this.swiper.update();
          }
        });
      }

      setupVideoPlayback() {
        const videos = this.querySelectorAll('.ai-video-stories-video-{{ ai_gen_id }}');
        
        videos.forEach(video => {
          video.addEventListener('click', (e) => {
            e.preventDefault();
            if (video.paused) {
              video.play();
            } else {
              video.pause();
            }
          });

          {% if block.settings.pause_on_hover %}
          const card = video.closest('.ai-video-stories-card-{{ ai_gen_id }}');
          if (card) {
            card.addEventListener('mouseenter', () => {
              if (!video.paused) {
                video.pause();
              }
            });
            card.addEventListener('mouseleave', () => {
              if (video.paused && {{ block.settings.autoplay | json }}) {
                video.play();
              }
            });
          }
          {% endif %}
        });
      }

      disconnectedCallback() {
        if (this.swiper) {
          this.swiper.destroy(true, true);
        }
      }
    }

    customElements.define('ai-video-stories-{{ ai_gen_id }}', AIVideoStories{{ ai_gen_id }});
  })();
</script>

