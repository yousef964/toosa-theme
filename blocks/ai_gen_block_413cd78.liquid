          <h2 class="ai-blog-cta-title-{{ ai_gen_id }}">{{ block.settings.cta_title }}</h2>
          <p class="ai-blog-cta-text-{{ ai_gen_id }}">{{ block.settings.cta_text }}</p>
          <a href="{{ block.settings.cta_link }}" class="ai-blog-cta-button-{{ ai_gen_id }}">
            {{ block.settings.cta_button_text }}
          </a>
        </div>
      {% endif %}
    </div>

    <aside class="ai-blog-sidebar-{{ ai_gen_id }}">
      <div class="ai-blog-sidebar-sticky-{{ ai_gen_id }}">
        {% if block.settings.show_toc %}
          <div class="ai-blog-toc-{{ ai_gen_id }}" data-toc>
            <h3 class="ai-blog-toc-title-{{ ai_gen_id }}" data-toc-toggle>
              Table of Contents
              <span class="ai-blog-toc-toggle-{{ ai_gen_id }}">▼</span>
            </h3>
            <ul class="ai-blog-toc-list-{{ ai_gen_id }}" data-toc-list>
              <li><a href="#introduction">Introduction</a></li>
              <li><a href="#main-content">Main Content</a></li>
              <li><a href="#conclusion">Conclusion</a></li>
            </ul>
          </div>
        {% endif %}

        {% if block.settings.show_related and blog.articles.size > 1 %}
          <div class="ai-blog-related-{{ ai_gen_id }}">
            <h3 class="ai-blog-related-title-{{ ai_gen_id }}">Related Articles</h3>
            {% assign related_count = 0 %}
            {% for related_article in blog.articles limit: 4 %}
              {% if related_article.id != article.id and related_count < 3 %}
                <div class="ai-blog-related-article-{{ ai_gen_id }}">
                  <a href="{{ related_article.url }}">{{ related_article.title }}</a>
                  <div class="ai-blog-related-date-{{ ai_gen_id }}">
                    {{ related_article.published_at | date: '%B %d, %Y' }}
                  </div>
                </div>
                {% assign related_count = related_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </aside>
  </div>
</article-blog-{{ ai_gen_id }}>

<script>
  (function() {
    class ArticleBlog{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupCopyLink();
        this.setupTOC();
        this.generateTOC();
      }

      setupCopyLink() {
        const copyBtn = this.querySelector('[data-copy-link]');
        if (!copyBtn) return;

        copyBtn.addEventListener('click', function() {
          const url = this.getAttribute('data-copy-link');
          navigator.clipboard.writeText(url).then(function() {
            const originalHTML = copyBtn.innerHTML;
            copyBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>';
            setTimeout(function() {
              copyBtn.innerHTML = originalHTML;
            }, 2000);
          });
        });
      }

      setupTOC() {
        const tocToggle = this.querySelector('[data-toc-toggle]');
        const toc = this.querySelector('[data-toc]');
        
        if (!tocToggle || !toc) return;

        tocToggle.addEventListener('click', function() {
          toc.classList.toggle('active');
        });
      }

      generateTOC() {
        const content = this.querySelector('.ai-blog-article-content-{{ ai_gen_id }}');
        const tocList = this.querySelector('[data-toc-list]');
        
        if (!content || !tocList) return;

        const headings = content.querySelectorAll('h2, h3');
        
        if (headings.length === 0) return;

        tocList.innerHTML = '';

        headings.forEach(function(heading, index) {
          const id = 'heading-' + index;
          heading.id = id;

          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = '#' + id;
          a.textContent = heading.textContent;
          
          if (heading.tagName === 'H3') {
            a.style.paddingLeft = '16px';
            a.style.fontSize = '13px';
          }

          li.appendChild(a);
          tocList.appendChild(li);
        });
      }
    }

    customElements.define('article-blog-{{ ai_gen_id }}', ArticleBlog{{ ai_gen_id }});
  })();
</script>

