{% doc %}
  @prompt
    Create a premium, modern and fully responsive Shopify blog article/inner-post section for TOOSA using the Refine theme.
    
    Redesign the individual blog post page with a clean editorial layout and better readability.
    
    - Add a breadcrumb: Home / Blog / Article
    - Create a large article hero with category/tag, article title, author, published date and featured image.
    - Use a centered content container with a two-column desktop layout:
      left = article content,
      right = sticky Table of Contents / related articles.
    - Make article typography highly readable with optimized heading sizes, line height, paragraph spacing and responsive images.
    - Support Shopify article richtext content including headings, paragraphs, lists, quotes, images and videos.
    - Add a highlighted intro/summary box below the hero.
    - Add social sharing buttons for Facebook, X, LinkedIn, Pinterest and copy-link.
    - Add “Related Articles” cards below the article.
    - Add Previous / Next Article navigation.
    - Add a strong CTA banner such as “Explore TOOSA Products” / “Contact Us”.
    - Add optional author information section.
    - Add article tags/categories.
    - Desktop: 2-column layout; Tablet: optimized 2-column; Mobile: single-column layout.
    - On mobile, move Table of Contents above the article and make it collapsible.
    - Use TOOSA styling: clean white/light background, dark typography, orange accent (#F15A29), subtle borders, soft shadows and modern spacing.
    - Add hover effects and subtle animations without heavy JavaScript.
    - Make every element customizable through Shopify Theme Editor.
    - Include settings for colors, typography, container width, image ratio, spacing, social icons, TOC, author, related posts, CTA and mobile layout.
    - Use dynamic Shopify article/blog objects; do not hard-code article content.
    - Use semantic HTML, accessible links, proper H1/H2/H3 hierarchy and SEO-friendly structure.
    - Ensure no horizontal scrolling and perfect mobile responsiveness.
    - Use only Liquid, HTML, CSS and minimal vanilla JavaScript; no external libraries.
    - Namespace all CSS to avoid conflicts with the Refine theme.
    - Generate complete production-ready Shopify Liquid section code with valid {% schema %}
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-article-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-blog-breadcrumb-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_spacing }}px 20px;
    font-size: 14px;
  }

  .ai-blog-breadcrumb-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: none;
  }

  .ai-blog-breadcrumb-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.accent_color }};
  }

  .ai-blog-breadcrumb-{{ ai_gen_id }} span {
    margin: 0 8px;
    color: {{ block.settings.text_color }};
    opacity: 0.5;
  }

  .ai-blog-hero-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px {{ block.settings.section_spacing }}px;
  }

  .ai-blog-category-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.accent_color }};
    color: {{ block.settings.category_text_color }};
    padding: 6px 16px;
    border-radius: {{ block.settings.border_radius }}px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
  }

  .ai-blog-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
    margin: 0 0 24px;
    color: {{ block.settings.heading_color }};
    font-weight: 700;
  }

  .ai-blog-meta-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    margin-bottom: 32px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-blog-meta-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-blog-featured-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.section_spacing }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-blog-featured-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    aspect-ratio: {{ block.settings.image_ratio }};
    object-fit: cover;
    display: block;
  }

  .ai-blog-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
  }

  @media (min-width: 990px) {
    .ai-blog-container-{{ ai_gen_id }} {
      grid-template-columns: 2fr 1fr;
    }
  }

  .ai-blog-content-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-blog-summary-{{ ai_gen_id }} {
    background-color: {{ block.settings.summary_bg_color }};
    border-left: 4px solid {{ block.settings.accent_color }};
    padding: 24px;
    margin-bottom: 40px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-blog-summary-{{ ai_gen_id }} h3 {
    margin: 0 0 12px;
    font-size: 18px;
    color: {{ block.settings.heading_color }};
  }

  .ai-blog-summary-{{ ai_gen_id }} p {
    margin: 0;
    line-height: 1.6;
  }

  .ai-blog-article-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.line_height }};
    color: {{ block.settings.text_color }};
  }

  .ai-blog-article-content-{{ ai_gen_id }} h1,
  .ai-blog-article-content-{{ ai_gen_id }} h2,
  .ai-blog-article-content-{{ ai_gen_id }} h3,
  .ai-blog-article-content-{{ ai_gen_id }} h4,
  .ai-blog-article-content-{{ ai_gen_id }} h5,
  .ai-blog-article-content-{{ ai_gen_id }} h6 {
    color: {{ block.settings.heading_color }};
    margin: 40px 0 20px;
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-blog-article-content-{{ ai_gen_id }} h2 {
    font-size: 32px;
  }

  .ai-blog-article-content-{{ ai_gen_id }} h3 {
    font-size: 24px;
  }

  .ai-blog-article-content-{{ ai_gen_id }} h4 {
    font-size: 20px;
  }

  .ai-blog-article-content-{{ ai_gen_id }} p {
    margin: 0 0 24px;
  }

  .ai-blog-article-content-{{ ai_gen_id }} ul,
  .ai-blog-article-content-{{ ai_gen_id }} ol {
    margin: 0 0 24px;
    padding-left: 24px;
  }

  .ai-blog-article-content-{{ ai_gen_id }} li {
    margin-bottom: 12px;
  }

  .ai-blog-article-content-{{ ai_gen_id }} blockquote {
    border-left: 4px solid {{ block.settings.accent_color }};
    padding: 20px 24px;
    margin: 32px 0;
    background-color: {{ block.settings.summary_bg_color }};
    font-style: italic;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-blog-article-content-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
    border-radius: {{ block.settings.border_radius }}px;
    margin: 32px 0;
  }

  .ai-blog-article-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-blog-article-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.accent_color }};
  }

  .ai-blog-sidebar-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-blog-sidebar-sticky-{{ ai_gen_id }} {
    position: sticky;
    top: 100px;
  }

  .ai-blog-toc-{{ ai_gen_id }} {
    background-color: {{ block.settings.sidebar_bg_color }};
    padding: 24px;
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
    margin-bottom: 32px;
  }

  .ai-blog-toc-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 16px;
    color: {{ block.settings.heading_color }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .ai-blog-toc-toggle-{{ ai_gen_id }} {
    display: none;
    font-size: 20px;
    transition: transform 0.3s ease;
  }

  .ai-blog-toc-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-blog-toc-list-{{ ai_gen_id }} li {
    margin-bottom: 12px;
  }

  .ai-blog-toc-list-{{ ai_gen_id }} a {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: 14px;
    display: block;
    transition: color 0.2s ease;
  }

  .ai-blog-toc-list-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.accent_color }};
  }

  .ai-blog-share-{{ ai_gen_id }} {
    margin: 60px 0;
    padding: 32px 0;
    border-top: 1px solid {{ block.settings.border_color }};
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-blog-share-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 16px;
    color: {{ block.settings.heading_color }};
  }

  .ai-blog-share-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
.ai-blog-share-buttons-{{ ai_gen_id }} .footer-social-list__item-label {
  display:none;
}
.ai-blog-share-buttons-{{ ai_gen_id }}  .footer-social-list{
        margin-top: 0;
        gap: 16px;
}
.ai-blog-share-buttons-{{ ai_gen_id }}  .footer-social-list li a:hover{
    color: #000!important;
}
  .ai-blog-share-btn-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.share_button_bg }};
    color: {{ block.settings.share_button_color }};
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-blog-share-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.accent_color }};
    color: #ffffff;
    transform: translateY(-2px);
  }

  .ai-blog-share-btn-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-blog-tags-{{ ai_gen_id }} {
    margin: 40px 0;
  }

  .ai-blog-tags-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 16px;
    color: {{ block.settings.heading_color }};
  }

  .ai-blog-tags-list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ai-blog-tag-{{ ai_gen_id }} {
    display: inline-block;
    padding: 8px 16px;
    background-color: {{ block.settings.tag_bg_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
    font-size: 14px;
    text-decoration: none;
    border: 1px solid {{ block.settings.border_color }};
    transition: all 0.3s ease;
  }

  .ai-blog-tag-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.accent_color }};
    color: #ffffff;
    border-color: {{ block.settings.accent_color }};
  }

  .ai-blog-author-{{ ai_gen_id }} {
    background-color: {{ block.settings.sidebar_bg_color }};
    padding: 32px;
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
    margin: 60px 0;
  }

  .ai-blog-author-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 16px;
    color: {{ block.settings.heading_color }};
  }

  .ai-blog-author-name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.heading_color }};
  }

  .ai-blog-author-bio-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-blog-related-{{ ai_gen_id }} {
    background-color: {{ block.settings.sidebar_bg_color }};
    padding: 24px;
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-blog-related-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 20px;
    color: {{ block.settings.heading_color }};
  }

  .ai-blog-related-article-{{ ai_gen_id }} {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-blog-related-article-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .ai-blog-related-article-{{ ai_gen_id }} a {
    text-decoration: none;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
    font-size: 14px;
    display: block;
    margin-bottom: 8px;
    transition: color 0.2s ease;
  }

  .ai-blog-related-article-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.accent_color }};
  }

  .ai-blog-related-date-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-blog-navigation-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 60px 0;
  }

  .ai-blog-nav-item-{{ ai_gen_id }} {
    padding: 24px;
    background-color: {{ block.settings.sidebar_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-blog-nav-item-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.accent_color }};
    transform: translateY(-2px);
  }

  .ai-blog-nav-label-{{ ai_gen_id }} {
    font-size: 12px;
    text-transform: uppercase;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin-bottom: 8px;
    display: block;
  }

  .ai-blog-nav-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-blog-cta-{{ ai_gen_id }} {
    background: {{ block.settings.cta_bg_color }};
    padding: 60px 40px;
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
    margin: 60px 0;
  }

  .ai-blog-cta-title-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 16px;
    color: {{ block.settings.cta_text_color }};
  }

  .ai-blog-cta-text-{{ ai_gen_id }} {
    font-size: 16px;
    margin: 0 0 24px;
    color: {{ block.settings.cta_text_color }};
    opacity: 0.9;
  }

  .ai-blog-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background-color: {{ block.settings.cta_button_bg }};
    color: {{ block.settings.cta_button_color }};
    text-decoration: none;
    border-radius: {{ block.settings.border_radius }}px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .ai-blog-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_button_hover_bg }};
    transform: translateY(-2px);
  }

  @media (max-width: 989px) {
    .ai-blog-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-blog-sidebar-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-blog-sidebar-sticky-{{ ai_gen_id }} {
      position: static;
    }

    .ai-blog-toc-toggle-{{ ai_gen_id }} {
      display: block;
    }

    .ai-blog-toc-list-{{ ai_gen_id }} {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .ai-blog-toc-{{ ai_gen_id }}.active .ai-blog-toc-list-{{ ai_gen_id }} {
      max-height: 1000px;
    }

    .ai-blog-toc-{{ ai_gen_id }}.active .ai-blog-toc-toggle-{{ ai_gen_id }} {
      transform: rotate(180deg);
    }

    .ai-blog-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-blog-navigation-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-blog-cta-title-{{ ai_gen_id }} {
      font-size: 24px;
    }
  }

  @media (max-width: 749px) {
    .ai-blog-breadcrumb-{{ ai_gen_id }},
    .ai-blog-hero-{{ ai_gen_id }},
    .ai-blog-container-{{ ai_gen_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    .ai-blog-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-blog-cta-{{ ai_gen_id }} {
      padding: 40px 24px;
    }
  }
{% endstyle %}

<article-blog-{{ ai_gen_id }} class="ai-blog-article-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_breadcrumb %}
    <nav class="ai-blog-breadcrumb-{{ ai_gen_id }}" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="{{ blog.url }}">{{ blog.title }}</a>
      <span>/</span>
      <span>{{ article.title }}</span>
    </nav>
  {% endif %}

  <header class="ai-blog-hero-{{ ai_gen_id }}">
    {% if block.settings.show_category and article.tags.size > 0 %}
      <div class="ai-blog-category-{{ ai_gen_id }}">
        {{ article.tags.first }}
      </div>
    {% endif %}

    <h1 class="ai-blog-title-{{ ai_gen_id }}">{{ article.title }}</h1>

    <div class="ai-blog-meta-{{ ai_gen_id }}">
      {% if block.settings.show_author %}
        <div class="ai-blog-meta-item-{{ ai_gen_id }}">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 8C10.21 8 12 6.21 12 4C12 1.79 10.21 0 8 0C5.79 0 4 1.79 4 4C4 6.21 5.79 8 8 8ZM8 10C5.33 10 0 11.34 0 14V16H16V14C16 11.34 10.67 10 8 10Z" fill="currentColor"/>
          </svg>
          <span>{{ article.author }}</span>
        </div>
      {% endif %}

      {% if block.settings.show_date %}
        <div class="ai-blog-meta-item-{{ ai_gen_id }}">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14 2H13V0H11V2H5V0H3V2H2C0.89 2 0 2.9 0 4V14C0 15.1 0.89 16 2 16H14C15.1 16 16 15.1 16 14V4C16 2.9 15.1 2 14 2ZM14 14H2V7H14V14ZM2 5V4H14V5H2Z" fill="currentColor"/>
          </svg>
          <span>{{ article.published_at | date: block.settings.date_format }}</span>
        </div>
      {% endif %}

      {% if block.settings.show_reading_time %}
        <div class="ai-blog-meta-item-{{ ai_gen_id }}">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 0C3.58 0 0 3.58 0 8C0 12.42 3.58 16 8 16C12.42 16 16 12.42 16 8C16 3.58 12.42 0 8 0ZM8 14C4.69 14 2 11.31 2 8C2 4.69 4.69 2 8 2C11.31 2 14 4.69 14 8C14 11.31 11.31 14 8 14ZM8.5 4H7V9L11.25 11.52L12 10.27L8.5 8.25V4Z" fill="currentColor"/>
          </svg>
          <span>{{ article.content | strip_html | split: ' ' | size | divided_by: 200 }} min read</span>
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_featured_image and article.image %}
      <div class="ai-blog-featured-image-{{ ai_gen_id }}">
        <img
          src="{{ article.image | image_url: width: 1400 }}"
          alt="{{ article.image.alt | escape }}"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          loading="eager"
        >
      </div>
    {% endif %}
  </header>

  <div class="ai-blog-container-{{ ai_gen_id }}">
    <div class="ai-blog-content-{{ ai_gen_id }}">
      {% if block.settings.show_summary and article.excerpt != blank %}
        <div class="ai-blog-summary-{{ ai_gen_id }}">
          <h3>Summary</h3>
          <p>{{ article.excerpt }}</p>
        </div>
      {% endif %}

      <div class="ai-blog-article-content-{{ ai_gen_id }}">
        {{ article.content }}
      </div>

      {% if block.settings.show_tags and article.tags.size > 0 %}
        <div class="ai-blog-tags-{{ ai_gen_id }}">
          <h3 class="ai-blog-tags-title-{{ ai_gen_id }}">Tags</h3>
          <div class="ai-blog-tags-list-{{ ai_gen_id }}">
            {% for tag in article.tags %}
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="ai-blog-tag-{{ ai_gen_id }}">
                {{ tag }}
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_share %}
        <div class="ai-blog-share-{{ ai_gen_id }}">
          <h3 class="ai-blog-share-title-{{ ai_gen_id }}">Share this article</h3>
          <div class="ai-blog-share-buttons-{{ ai_gen_id }}">
            {% comment %} <a
              href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}"
              target="_blank"
              rel="noopener"
              class="ai-blog-share-btn-{{ ai_gen_id }}"
              aria-label="Share on Facebook"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>

            <a
              href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title | url_encode }}"
              target="_blank"
              rel="noopener"
