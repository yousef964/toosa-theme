            </a>
          {% else %}
            <div></div>
          {% endif %}

          {% if blog.next_article %}
            <a href="{{ blog.next_article.url }}" class="ai-blog-nav-item-{{ ai_gen_id }}" style="text-align: right;">
              <span class="ai-blog-nav-label-{{ ai_gen_id }}">Next →</span>
              <h4 class="ai-blog-nav-title-{{ ai_gen_id }}">{{ blog.next_article.title }}</h4>
            </a>
          {% endif %}
        </nav>
      {% endif %}

      {% if block.settings.show_cta %}
