{% doc %}
  @prompt
    Create a premium Our Story section for the TOOSA About Us page that tells the company's journey through alternating image and text blocks. The section should create an engaging storytelling experience rather than simply displaying text beside images.
    
    The design should feel modern, spacious, trustworthy, and premium while matching TOOSA's industrial brand identity. Every element must be editable through the Shopify Theme Editor and optimized for desktop, tablet, and mobile devices.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-story-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
  }

  .ai-story-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-story-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    align-items: center;
  }

  .ai-story-grid-{{ ai_gen_id }}.ai-story-reverse-{{ ai_gen_id }} {
    direction: rtl;
  }

  .ai-story-grid-{{ ai_gen_id }}.ai-story-reverse-{{ ai_gen_id }} > * {
    direction: ltr;
  }

  .ai-story-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-story-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
  }

  .ai-story-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-story-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
    opacity: 0.3;
  }

  .ai-story-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-story-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-story-eyebrow-{{ ai_gen_id }} {
    font-family: {{ block.settings.eyebrow_font.family }}, {{ block.settings.eyebrow_font.fallback_families }};
    font-weight: {{ block.settings.eyebrow_font.weight }};
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: {{ block.settings.eyebrow_transform }};
    letter-spacing: {{ block.settings.eyebrow_spacing }}em;
    margin-bottom: {{ block.settings.eyebrow_margin }}px;
    display: block;
  }

  .ai-story-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin }}px;
  }

  .ai-story-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-story-text-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-story-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-story-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-story-grid-{{ ai_gen_id }}.ai-story-reverse-{{ ai_gen_id }} {
      direction: ltr;
    }

    .ai-story-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-story-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.8);
    }

    .ai-story-content-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_content_padding }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-story-block-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_spacing_top }}px 0 {{ block.settings.mobile_spacing_bottom }}px;
    }

    .ai-story-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-story-eyebrow-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.eyebrow_size }}px * 0.9);
    }
  }
{% endstyle %}

<our-story-block-{{ ai_gen_id }} class="ai-story-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-story-container-{{ ai_gen_id }}">
    <div class="ai-story-grid-{{ ai_gen_id }} {% if block.settings.image_position == 'right' %}ai-story-reverse-{{ ai_gen_id }}{% endif %}">
      <div class="ai-story-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-story-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-story-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-story-empty-state-{{ ai_gen_id }}">
              Add an image to tell your story
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-story-content-{{ ai_gen_id }}">
        {% if block.settings.eyebrow != blank %}
          <span class="ai-story-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</span>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-story-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-story-text-{{ ai_gen_id }}">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</our-story-block-{{ ai_gen_id }}>

<script>
  (function() {
    class OurStoryBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initObserver();
      }

      initObserver() {
        if (!window.IntersectionObserver) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
          }
        );

        const content = this.querySelector('.ai-story-content-{{ ai_gen_id }}');
        const image = this.querySelector('.ai-story-image-wrapper-{{ ai_gen_id }}');

        if (content) {
          content.style.opacity = '0';
          content.style.transform = 'translateY(30px)';
          content.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
          observer.observe(content);
        }

        if (image) {
          image.style.opacity = '0';
          image.style.transform = 'translateY(30px)';
          image.style.transition = 'opacity 0.8s ease 0.2s, transform 0.8s ease 0.2s';
          observer.observe(image);
        }
      }
    }

    customElements.define('our-story-block-{{ ai_gen_id }}', OurStoryBlock{{ ai_gen_id }});
  })();
</script>

