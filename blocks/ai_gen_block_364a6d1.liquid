{% doc %}
  @prompt
    Update the existing "Our Story" homepage section in the Shopify Refine theme.
    
    Replace the current image with a professional supplied TOOSA photo while keeping the existing Our Story heading, text and About Us button.
    
    Create a premium image + text split layout:
    - Desktop: 50/50
    - Tablet: 45/55
    - Mobile: image above text
    - Use dynamic Shopify image_picker
    - Image: responsive, object-fit: cover
    - Add image position and aspect-ratio controls
    - Add customization for heading, text, button, colors, spacing and border radius
    - Keep the existing content unchanged
    - Match TOOSA's clean premium style
    - Fully mobile responsive with no horizontal overflow
    - Use only Liquid + CSS
    - Scope CSS to this section
    - Generate valid Shopify schema
    - Return only the updated Shopify Liquid section code.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-our-story-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-our-story-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-our-story-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.gap }}px;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .ai-our-story-grid-{{ ai_gen_id }} {
      grid-template-columns: {% if block.settings.image_position == 'left' %}{{ block.settings.desktop_image_width }}% {{ 100 | minus: block.settings.desktop_image_width }}%{% else %}{{ 100 | minus: block.settings.desktop_image_width }}% {{ block.settings.desktop_image_width }}%{% endif %};
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-our-story-grid-{{ ai_gen_id }} {
      grid-template-columns: {% if block.settings.image_position == 'left' %}{{ block.settings.tablet_image_width }}% {{ 100 | minus: block.settings.tablet_image_width }}%{% else %}{{ 100 | minus: block.settings.tablet_image_width }}% {{ block.settings.tablet_image_width }}%{% endif %};
    }
  }

  @media screen and (max-width: 749px) {
    .ai-our-story-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }

  .ai-our-story-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-our-story-image-wrapper-{{ ai_gen_id }}::before {
    content: '';
    display: block;
    padding-bottom: {% if block.settings.image_aspect_ratio == 'auto' %}100%{% elsif block.settings.image_aspect_ratio == '1/1' %}100%{% elsif block.settings.image_aspect_ratio == '2/3' %}150%{% elsif block.settings.image_aspect_ratio == '3/4' %}133.33%{% elsif block.settings.image_aspect_ratio == '4/5' %}125%{% elsif block.settings.image_aspect_ratio == '3/2' %}66.67%{% elsif block.settings.image_aspect_ratio == '4/3' %}75%{% elsif block.settings.image_aspect_ratio == '5/4' %}80%{% elsif block.settings.image_aspect_ratio == '16/9' %}56.25%{% endif %};
  }

  .ai-our-story-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position_x }}% {{ block.settings.image_position_y }}%;
  }

  .ai-our-story-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-our-story-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-our-story-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  @media screen and (min-width: 990px) {
    .ai-our-story-content-{{ ai_gen_id }} {
      order: {% if block.settings.image_position == 'left' %}2{% else %}1{% endif %};
    }

    .ai-our-story-image-wrapper-{{ ai_gen_id }} {
      order: {% if block.settings.image_position == 'left' %}1{% else %}2{% endif %};
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-our-story-content-{{ ai_gen_id }} {
      order: {% if block.settings.image_position == 'left' %}2{% else %}1{% endif %};
    }

    .ai-our-story-image-wrapper-{{ ai_gen_id }} {
      order: {% if block.settings.image_position == 'left' %}1{% else %}2{% endif %};
    }
  }

  .ai-our-story-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-our-story-text-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.text_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-our-story-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    font-size: {{ block.settings.button_text_size }}px;
    transition: all 0.3s ease;
  }

  .ai-our-story-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }
{% endstyle %}

<ai-our-story-{{ ai_gen_id }} class="ai-our-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-our-story-container-{{ ai_gen_id }}">
    <div class="ai-our-story-grid-{{ ai_gen_id }}">
      <div class="ai-our-story-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 2000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-our-story-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-our-story-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-our-story-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-our-story-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-our-story-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}

        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-our-story-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</ai-our-story-{{ ai_gen_id }}>

<script>
  (function() {
    class AiOurStory{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('ai-our-story-{{ ai_gen_id }}', AiOurStory{{ ai_gen_id }});
  })();
</script>

{% schema %}
