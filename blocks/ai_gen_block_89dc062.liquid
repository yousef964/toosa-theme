{% doc %}
  @prompt
    Create a premium, modern, highly readable Delivery & Returns section for the TOOSA Shopify store.
    
    The section should communicate delivery information and return/exchange policies in a visually appealing way. Do not create a basic text-heavy two-column layout. Instead, create a structured Policy Hub with clear cards, icons, highlighted information, expandable policy details, and strong visual hierarchy.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-policy-hub-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  .ai-policy-hub-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-policy-hub-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-policy-hub-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-policy-hub-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 50px;
  }

  .ai-policy-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-policy-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .ai-policy-card-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .ai-policy-card-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.icon_color }};
  }

  .ai-policy-card-title-{{ ai_gen_id }} {
   
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    line-height: 1.3;
  }

  .ai-policy-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-policy-highlight-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.highlight_color }};
  }

  .ai-policy-details-{{ ai_gen_id }} {
    background: {{ block.settings.details_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px;
    margin-top: 30px;
  }

  .ai-policy-details-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.details_title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 24px;
    text-align: center;
  }

  .ai-policy-accordion-{{ ai_gen_id }} {
    border-top: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-policy-accordion-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-policy-accordion-button-{{ ai_gen_id }} {
    width: 100%;
    background: none;
    border: none;
    padding: 20px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    text-align: left;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.accordion_title_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-policy-accordion-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .ai-policy-accordion-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.heading_color }};
  }

  .ai-policy-accordion-button-{{ ai_gen_id }}[aria-expanded="true"] .ai-policy-accordion-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-policy-accordion-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-policy-accordion-content-{{ ai_gen_id }}.active {
    max-height: 1000px;
  }

  .ai-policy-accordion-body-{{ ai_gen_id }} {
    padding: 0 0 20px 0;
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.7;
  }

  .ai-policy-accordion-body-{{ ai_gen_id }} ul {
    margin: 12px 0;
    padding-left: 20px;
  }

  .ai-policy-accordion-body-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-policy-cta-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 50px;
  }

  .ai-policy-cta-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.text_color }};
    margin-bottom: 20px;
  }

  .ai-policy-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    font-size: 16px;
    transition: background 0.2s ease;
  }

  .ai-policy-cta-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 768px) {
    .ai-policy-hub-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-policy-hub-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  .ai-policy-card-title-{{ ai_gen_id }} {
     font-size: 18px;
     }
    .ai-policy-hub-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  .ai-policy-card-icon-{{ ai_gen_id }} {
        width: 40px;
    height: 40px;
  }
    .ai-policy-card-icon-{{ ai_gen_id }} svg {
      width: 20px;
    height: 20px;
  }
    .ai-policy-card-{{ ai_gen_id }} {
      padding: 24px;
    }
 .ai-policy-details-title-{{ ai_gen_id }} {
    font-size: 28px;
 }
    .ai-policy-details-{{ ai_gen_id }} {
      padding: 24px;
    }
     .ai-policy-accordion-button-{{ ai_gen_id }} {
       font-size: 14px;
     }
  }
{% endstyle %}

<policy-hub-{{ ai_gen_id }} class="ai-policy-hub-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
