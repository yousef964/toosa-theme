                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="ai-policy-accordion-content-{{ ai_gen_id }}">
            <div class="ai-policy-accordion-body-{{ ai_gen_id }}">
              {{ block.settings.accordion_1_content }}
            </div>
          </div>
        </div>

        <div class="ai-policy-accordion-item-{{ ai_gen_id }}">
          <button 
            class="ai-policy-accordion-button-{{ ai_gen_id }}"
            aria-expanded="false"
            data-accordion-trigger
          >
            <span>{{ block.settings.accordion_2_title }}</span>
            <span class="ai-policy-accordion-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="ai-policy-accordion-content-{{ ai_gen_id }}">
            <div class="ai-policy-accordion-body-{{ ai_gen_id }}">
              {{ block.settings.accordion_2_content }}
            </div>
          </div>
        </div>

        <div class="ai-policy-accordion-item-{{ ai_gen_id }}">
          <button 
            class="ai-policy-accordion-button-{{ ai_gen_id }}"
            aria-expanded="false"
            data-accordion-trigger
          >
            <span>{{ block.settings.accordion_3_title }}</span>
            <span class="ai-policy-accordion-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="ai-policy-accordion-content-{{ ai_gen_id }}">
            <div class="ai-policy-accordion-body-{{ ai_gen_id }}">
              {{ block.settings.accordion_3_content }}
            </div>
          </div>
        </div>

        <div class="ai-policy-accordion-item-{{ ai_gen_id }}">
          <button 
            class="ai-policy-accordion-button-{{ ai_gen_id }}"
            aria-expanded="false"
            data-accordion-trigger
          >
            <span>{{ block.settings.accordion_4_title }}</span>
            <span class="ai-policy-accordion-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="ai-policy-accordion-content-{{ ai_gen_id }}">
            <div class="ai-policy-accordion-body-{{ ai_gen_id }}">
