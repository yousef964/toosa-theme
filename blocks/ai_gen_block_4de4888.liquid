{% doc %}
  @prompt
    Create a premium, modern, and storytelling-focused Our Story section for the TOOSA About Us page. The section should visually communicate TOOSA's journey, passion, craftsmanship, innovation, and commitment to professionals. Instead of a traditional image and text layout, use a dynamic storytelling design with alternating image and content blocks, layered cards, subtle animations, and premium spacing.
    
    The section should create an emotional connection while maintaining TOOSA's industrial and modern brand identity.
    
    The entire section must be built using Shopify Online Store 2.0, support dynamic content blocks, and be fully customizable through the Theme Editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-story-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-story-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-story-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-story-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    margin-bottom: 16px;
    display: block;
  }

  .ai-story-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    line-height: 1.2;
    margin: 0 0 24px;
    font-weight: 700;
  }

  .ai-story-intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_size }}px;
    color: {{ block.settings.intro_color }};
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-story-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-story-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.row_gap }}px;
    align-items: center;
    position: relative;
  }

  .ai-story-row-{{ ai_gen_id }}.reverse {
    direction: rtl;
  }

  .ai-story-row-{{ ai_gen_id }}.reverse > * {
    direction: ltr;
  }

  .ai-story-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
  }

  .ai-story-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-story-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-story-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-story-text-content-{{ ai_gen_id }} {
    padding: {{ block.settings.text_padding }}px;
  }

  .ai-story-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border-left: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    margin-bottom: 24px;
  }

  .ai-story-card-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_label_size }}px;
    color: {{ block.settings.card_label_color }};
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-bottom: 12px;
    display: block;
  }

  .ai-story-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    line-height: 1.3;
    margin: 0 0 12px;
    font-weight: 700;
  }

  .ai-story-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-story-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 32px;
    margin-top: 32px;
  }

  .ai-story-stat-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-story-stat-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.stat_number_size }}px;
    color: {{ block.settings.stat_number_color }};
    font-weight: 700;
    line-height: 1;
    margin-bottom: 8px;
    display: block;
  }

  .ai-story-stat-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.stat_label_size }}px;
    color: {{ block.settings.stat_label_color }};
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  @media screen and (max-width: 989px) {
    .ai-story-row-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-story-row-{{ ai_gen_id }}.reverse {
      direction: ltr;
    }

    .ai-story-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-story-text-content-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-story-stats-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-story-block-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 0 {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-story-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.5);
    }

    .ai-story-stats-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<toosa-story-{{ ai_gen_id }} class="ai-story-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-story-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-story-header-{{ ai_gen_id }}">
        {% if block.settings.eyebrow_text != blank %}
          <span class="ai-story-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</span>
        {% endif %}
        {% if block.settings.heading != blank %}
          <h2 class="ai-story-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.intro_text != blank %}
          <div class="ai-story-intro-{{ ai_gen_id }}">{{ block.settings.intro_text }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-story-content-{{ ai_gen_id }}">
      {% if block.settings.show_row_1 %}
        <div class="ai-story-row-{{ ai_gen_id }} {% if block.settings.row_1_reverse %}reverse{% endif %}">
          <div class="ai-story-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.row_1_image %}
              <img
                src="{{ block.settings.row_1_image | image_url: width: 1200 }}"
                alt="{{ block.settings.row_1_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.row_1_image.width }}"
                height="{{ block.settings.row_1_image.height }}"
                class="ai-story-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-story-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-story-text-content-{{ ai_gen_id }}">
            {% if block.settings.row_1_card_label != blank or block.settings.row_1_card_title != blank or block.settings.row_1_card_text != blank %}
              <div class="ai-story-card-{{ ai_gen_id }}">
                {% if block.settings.row_1_card_label != blank %}
                  <span class="ai-story-card-label-{{ ai_gen_id }}">{{ block.settings.row_1_card_label }}</span>
                {% endif %}
                {% if block.settings.row_1_card_title != blank %}
                  <h3 class="ai-story-card-title-{{ ai_gen_id }}">{{ block.settings.row_1_card_title }}</h3>
                {% endif %}
                {% if block.settings.row_1_card_text != blank %}
                  <div class="ai-story-card-text-{{ ai_gen_id }}">{{ block.settings.row_1_card_text }}</div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.row_1_show_stats %}
              <div class="ai-story-stats-{{ ai_gen_id }}">
                {% if block.settings.row_1_stat_1_number != blank %}
                  <div class="ai-story-stat-{{ ai_gen_id }}">
                    <span class="ai-story-stat-number-{{ ai_gen_id }}">{{ block.settings.row_1_stat_1_number }}</span>
                    <span class="ai-story-stat-label-{{ ai_gen_id }}">{{ block.settings.row_1_stat_1_label }}</span>
                  </div>
                {% endif %}
                {% if block.settings.row_1_stat_2_number != blank %}
                  <div class="ai-story-stat-{{ ai_gen_id }}">
                    <span class="ai-story-stat-number-{{ ai_gen_id }}">{{ block.settings.row_1_stat_2_number }}</span>
                    <span class="ai-story-stat-label-{{ ai_gen_id }}">{{ block.settings.row_1_stat_2_label }}</span>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_row_2 %}
        <div class="ai-story-row-{{ ai_gen_id }} {% if block.settings.row_2_reverse %}reverse{% endif %}">
          <div class="ai-story-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.row_2_image %}
              <img
                src="{{ block.settings.row_2_image | image_url: width: 1200 }}"
                alt="{{ block.settings.row_2_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.row_2_image.width }}"
                height="{{ block.settings.row_2_image.height }}"
                class="ai-story-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-story-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-story-text-content-{{ ai_gen_id }}">
            {% if block.settings.row_2_card_label != blank or block.settings.row_2_card_title != blank or block.settings.row_2_card_text != blank %}
              <div class="ai-story-card-{{ ai_gen_id }}">
                {% if block.settings.row_2_card_label != blank %}
                  <span class="ai-story-card-label-{{ ai_gen_id }}">{{ block.settings.row_2_card_label }}</span>
                {% endif %}
                {% if block.settings.row_2_card_title != blank %}
                  <h3 class="ai-story-card-title-{{ ai_gen_id }}">{{ block.settings.row_2_card_title }}</h3>
                {% endif %}
                {% if block.settings.row_2_card_text != blank %}
                  <div class="ai-story-card-text-{{ ai_gen_id }}">{{ block.settings.row_2_card_text }}</div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.row_2_show_stats %}
              <div class="ai-story-stats-{{ ai_gen_id }}">
                {% if block.settings.row_2_stat_1_number != blank %}
                  <div class="ai-story-stat-{{ ai_gen_id }}">
                    <span class="ai-story-stat-number-{{ ai_gen_id }}">{{ block.settings.row_2_stat_1_number }}</span>
                    <span class="ai-story-stat-label-{{ ai_gen_id }}">{{ block.settings.row_2_stat_1_label }}</span>
                  </div>
                {% endif %}
                {% if block.settings.row_2_stat_2_number != blank %}
                  <div class="ai-story-stat-{{ ai_gen_id }}">
                    <span class="ai-story-stat-number-{{ ai_gen_id }}">{{ block.settings.row_2_stat_2_number }}</span>
                    <span class="ai-story-stat-label-{{ ai_gen_id }}">{{ block.settings.row_2_stat_2_label }}</span>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_row_3 %}
        <div class="ai-story-row-{{ ai_gen_id }} {% if block.settings.row_3_reverse %}reverse{% endif %}">
          <div class="ai-story-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.row_3_image %}
              <img
                src="{{ block.settings.row_3_image | image_url: width: 1200 }}"
                alt="{{ block.settings.row_3_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.row_3_image.width }}"
                height="{{ block.settings.row_3_image.height }}"
                class="ai-story-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-story-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-story-text-content-{{ ai_gen_id }}">
            {% if block.settings.row_3_card_label != blank or block.settings.row_3_card_title != blank or block.settings.row_3_card_text != blank %}
              <div class="ai-story-card-{{ ai_gen_id }}">
                {% if block.settings.row_3_card_label != blank %}
                  <span class="ai-story-card-label-{{ ai_gen_id }}">{{ block.settings.row_3_card_label }}</span>
                {% endif %}
                {% if block.settings.row_3_card_title != blank %}
                  <h3 class="ai-story-card-title-{{ ai_gen_id }}">{{ block.settings.row_3_card_title }}</h3>
                {% endif %}
                {% if block.settings.row_3_card_text != blank %}
                  <div class="ai-story-card-text-{{ ai_gen_id }}">{{ block.settings.row_3_card_text }}</div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.row_3_show_stats %}
              <div class="ai-story-stats-{{ ai_gen_id }}">
                {% if block.settings.row_3_stat_1_number != blank %}
                  <div class="ai-story-stat-{{ ai_gen_id }}">
                    <span class="ai-story-stat-number-{{ ai_gen_id }}">{{ block.settings.row_3_stat_1_number }}</span>
                    <span class="ai-story-stat-label-{{ ai_gen_id }}">{{ block.settings.row_3_stat_1_label }}</span>
                  </div>
                {% endif %}
                {% if block.settings.row_3_stat_2_number != blank %}
                  <div class="ai-story-stat-{{ ai_gen_id }}">
                    <span class="ai-story-stat-number-{{ ai_gen_id }}">{{ block.settings.row_3_stat_2_number }}</span>
                    <span class="ai-story-stat-label-{{ ai_gen_id }}">{{ block.settings.row_3_stat_2_label }}</span>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</toosa-story-{{ ai_gen_id }}>

<script>
  (function() {
    class ToosaStory{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('toosa-story-{{ ai_gen_id }}', ToosaStory{{ ai_gen_id }});
  })();
</script>

