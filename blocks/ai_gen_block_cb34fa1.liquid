{% doc %}
  @prompt
    Create a modern, premium and fully responsive Shopify Blog/News page for TOOSA, inspired by the existing TOOSA blog structure but with a cleaner and more visually engaging design.
    
    Add a centered “TOOSA Journal” heading with a short subtitle.
    Create a featured blog article section with large image, category, title, excerpt, author/date and “Read Article” button.
    Below it, create a responsive 3-column blog card grid on desktop, 2 columns on tablet and 1 column on mobile.
    Each blog card should include featured image, category/tag, article title, short excerpt, author, published date and Read More link.
    Add blog category filters/tabs such as Workshop Tips, Tool Storage, Product Guides, Company News and Inspiration.
    Add a Load More / View All Articles button.
    Include subtle hover animations, image zoom, clean spacing, rounded corners and premium TOOSA-style typography.
    Use a white/light background with TOOSA brand orange as the primary accent color.
    Add optional sidebar/search/filter controls on desktop, but convert them into a clean dropdown/filter bar on mobile.
    Make all content dynamic using Shopify blog/article Liquid objects, not hardcoded.
    Add customizable Theme Editor settings for heading, subtitle, colors, fonts, container width, number of columns, image aspect ratio, card spacing, excerpt length, button text, border radius, shadows, and mobile spacing.
    Ensure 100% mobile responsive design, no horizontal scrolling, optimized images, accessible buttons, proper heading hierarchy and SEO-friendly semantic HTML.
    Build it as a reusable Shopify section compatible with the Refine theme.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .toosa-blog-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .toosa-blog-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .toosa-blog-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .toosa-blog-title-{{ ai_gen_id }} {
  
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subtitle_spacing }}px;
    line-height: 1.2;
  }

  .toosa-blog-subtitle-{{ ai_gen_id }} {
  
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .toosa-blog-filters-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: {{ block.settings.filter_spacing }}px;
  }

  .toosa-blog-filter-btn-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.filter_bg_color }};
    color: {{ block.settings.filter_text_color }};
    border: {{ block.settings.filter_border_width }}px solid {{ block.settings.filter_border_color }};
    border-radius: {{ block.settings.filter_border_radius }}px;
    cursor: pointer;
   
    font-weight: {{ block.settings.body_font.weight }};
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .toosa-blog-filter-btn-{{ ai_gen_id }}:hover,
  .toosa-blog-filter-btn-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.filter_active_bg }};
    color: {{ block.settings.filter_active_text }};
    border-color: {{ block.settings.filter_active_bg }};
  }

  .toosa-blog-featured-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.featured_spacing }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_bg_color }};
    box-shadow: {{ block.settings.card_shadow }};
  }

  .toosa-blog-featured-inner-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .toosa-blog-featured-image-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ block.settings.featured_image_ratio }};
  }

  .toosa-blog-featured-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .toosa-blog-featured-{{ ai_gen_id }}:hover .toosa-blog-featured-image-{{ ai_gen_id }} img {
    transform: scale(1.05);
  }

  .toosa-blog-featured-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .toosa-blog-category-{{ ai_gen_id }} {
    display: inline-block;
    padding: 6px 16px;
    background-color: {{ block.settings.category_bg_color }};
    color: {{ block.settings.category_text_color }};
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: {{ block.settings.category_border_radius }}px;
    margin-bottom: 16px;
  }

  .toosa-blog-featured-title-{{ ai_gen_id }} {
  
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.featured_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .toosa-blog-featured-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .toosa-blog-featured-title-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .toosa-blog-excerpt-{{ ai_gen_id }} {
  
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.excerpt_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.6;
    margin: 0 0 20px;
  }

  .toosa-blog-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 14px;
    color: {{ block.settings.meta_color }};
    margin-bottom: 24px;
  }

  .toosa-blog-meta-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .toosa-blog-btn-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
   
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .toosa-blog-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
    color: {{ block.settings.button_hover_text }};
    transform: translateY(-2px);
  }

  .toosa-blog-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: {{ block.settings.grid_spacing }}px;
  }

  .toosa-blog-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.card_shadow }};
    transition: all 0.3s ease;
  }

  .toosa-blog-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: {{ block.settings.card_hover_shadow }};
  }

  .toosa-blog-card-image-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ block.settings.card_image_ratio }};
  }

  .toosa-blog-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .toosa-blog-card-{{ ai_gen_id }}:hover .toosa-blog-card-image-{{ ai_gen_id }} img {
    transform: scale(1.08);
  }

  .toosa-blog-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .toosa-blog-card-title-{{ ai_gen_id }} {
 
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px;
    line-height: 1.4;
  }

  .toosa-blog-card-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .toosa-blog-card-title-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .toosa-blog-card-excerpt-{{ ai_gen_id }} {
   
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.card_excerpt_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.6;
    margin: 0 0 16px;
  }

  .toosa-blog-read-more-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s ease;
  }

  .toosa-blog-read-more-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    gap: 10px;
  }

  .toosa-blog-load-more-{{ ai_gen_id }} {
    text-align: center;
    margin-top: {{ block.settings.load_more_spacing }}px;
  }

  .toosa-blog-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toosa-blog-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .toosa-blog-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: {{ block.settings.card_gap_mobile }}px;
    }

    .toosa-blog-featured-inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .toosa-blog-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .toosa-blog-featured-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.featured_title_size }}px * 0.8);
    }

    .toosa-blog-card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.8);
    }

    .toosa-blog-featured-content-{{ ai_gen_id }},
    .toosa-blog-card-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding_mobile }}px;
    }

    .toosa-blog-container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.mobile_padding }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .toosa-blog-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .toosa-blog-filters-{{ ai_gen_id }} {
      gap: 8px;
    }

    .toosa-blog-filter-btn-{{ ai_gen_id }} {
      padding: 10px 18px;
      font-size: 13px;
    }

    .toosa-blog-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }
      .toosa-blog-subtitle-{{ ai_gen_id }} {
            font-size: 16px;
      }
        .toosa-blog-featured-title-{{ ai_gen_id }} {
          font-size: 18px;
        }
         .toosa-blog-meta-{{ ai_gen_id }} {
    gap: 12px;
    font-size: 12px;
         }
  }
{% endstyle %}

<toosa-blog-{{ ai_gen_id }} class="toosa-blog-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="toosa-blog-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="toosa-blog-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h1 class="toosa-blog-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="toosa-blog-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_filters %}
      <div class="toosa-blog-filters-{{ ai_gen_id }}">
        <button class="toosa-blog-filter-btn-{{ ai_gen_id }} active" data-filter="all">
          {{ block.settings.filter_all_text }}
        </button>
        {% if block.settings.filter_1 != blank %}
          <button class="toosa-blog-filter-btn-{{ ai_gen_id }}" data-filter="{{ block.settings.filter_1 | handleize }}">
            {{ block.settings.filter_1 }}
          </button>
        {% endif %}
        {% if block.settings.filter_2 != blank %}
          <button class="toosa-blog-filter-btn-{{ ai_gen_id }}" data-filter="{{ block.settings.filter_2 | handleize }}">
            {{ block.settings.filter_2 }}
          </button>
        {% endif %}
        {% if block.settings.filter_3 != blank %}
          <button class="toosa-blog-filter-btn-{{ ai_gen_id }}" data-filter="{{ block.settings.filter_3 | handleize }}">
            {{ block.settings.filter_3 }}
          </button>
        {% endif %}
        {% if block.settings.filter_4 != blank %}
          <button class="toosa-blog-filter-btn-{{ ai_gen_id }}" data-filter="{{ block.settings.filter_4 | handleize }}">
            {{ block.settings.filter_4 }}
          </button>
        {% endif %}
        {% if block.settings.filter_5 != blank %}
          <button class="toosa-blog-filter-btn-{{ ai_gen_id }}" data-filter="{{ block.settings.filter_5 | handleize }}">
            {{ block.settings.filter_5 }}
          </button>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_featured and block.settings.blog != blank %}
      {% assign featured_article = block.settings.blog.articles.first %}
      {% if featured_article %}
        <article class="toosa-blog-featured-{{ ai_gen_id }}">
          <div class="toosa-blog-featured-inner-{{ ai_gen_id }}">
            <div class="toosa-blog-featured-image-{{ ai_gen_id }}">
              {% if featured_article.image %}
                <img
                  src="{{ featured_article.image | image_url: width: 1200 }}"
                  alt="{{ featured_article.image.alt | escape }}"
                  loading="lazy"
                  width="{{ featured_article.image.width }}"
                  height="{{ featured_article.image.height }}"
                >
              {% else %}
                <div class="toosa-blog-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="toosa-blog-featured-content-{{ ai_gen_id }}">
              {% if featured_article.tags.size > 0 %}
                <span class="toosa-blog-category-{{ ai_gen_id }}">{{ featured_article.tags.first }}</span>
              {% endif %}
              <h2 class="toosa-blog-featured-title-{{ ai_gen_id }}">
                <a href="{{ featured_article.url }}">{{ featured_article.title }}</a>
              </h2>
              {% if block.settings.show_excerpt and featured_article.excerpt != blank %}
                <div class="toosa-blog-excerpt-{{ ai_gen_id }}">
                  {{ featured_article.excerpt | strip_html | truncatewords: block.settings.featured_excerpt_length }}
                </div>
              {% endif %}
              <div class="toosa-blog-meta-{{ ai_gen_id }}">
                {% if block.settings.show_author %}
                  <span class="toosa-blog-meta-item-{{ ai_gen_id }}">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M8 8C9.65685 8 11 6.65685 11 5C11 3.34315 9.65685 2 8 2C6.34315 2 5 3.34315 5 5C5 6.65685 6.34315 8 8 8Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M14 14C14 11.7909 11.3137 10 8 10C4.68629 10 2 11.7909 2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ featured_article.author }}
                  </span>
                {% endif %}
                {% if block.settings.show_date %}
                  <span class="toosa-blog-meta-item-{{ ai_gen_id }}">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.6667 2.66667H3.33333C2.59695 2.66667 2 3.26362 2 4V13.3333C2 14.0697 2.59695 14.6667 3.33333 14.6667H12.6667C13.403 14.6667 14 14.0697 14 13.3333V4C14 3.26362 13.403 2.66667 12.6667 2.66667Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M10.6667 1.33333V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M5.33333 1.33333V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M2 6.66667H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ featured_article.published_at | date: block.settings.date_format }}
                  </span>
                {% endif %}
              </div>
              <a href="{{ featured_article.url }}" class="toosa-blog-btn-{{ ai_gen_id }}">
                {{ block.settings.featured_button_text }}
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.33333 8H12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M8 3.33333L12.6667 8L8 12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
      {% endif %}
    {% endif %}

    {% if block.settings.blog != blank %}
      <div class="toosa-blog-grid-{{ ai_gen_id }}">
        {% assign articles_to_show = block.settings.articles_per_page %}
        {% if block.settings.show_featured %}
          {% assign articles_to_show = articles_to_show | plus: 1 %}
        {% endif %}
        
        {% for article in block.settings.blog.articles limit: articles_to_show offset: 1 %}
          <article class="toosa-blog-card-{{ ai_gen_id }}" data-tags="{{ article.tags | join: ',' | handleize }}">
            <div class="toosa-blog-card-image-{{ ai_gen_id }}">
              {% if article.image %}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | escape }}"
                  loading="lazy"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                >
              {% else %}
                <div class="toosa-blog-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="toosa-blog-card-content-{{ ai_gen_id }}">
              {% if article.tags.size > 0 %}
                <span class="toosa-blog-category-{{ ai_gen_id }}">{{ article.tags.first }}</span>
              {% endif %}
              <h3 class="toosa-blog-card-title-{{ ai_gen_id }}">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>
              {% if block.settings.show_card_excerpt and article.excerpt != blank %}
                <div class="toosa-blog-card-excerpt-{{ ai_gen_id }}">
                  {{ article.excerpt | strip_html | truncatewords: block.settings.card_excerpt_length }}
                </div>
              {% endif %}
              <div class="toosa-blog-meta-{{ ai_gen_id }}">
                {% if block.settings.show_author %}
                  <span class="toosa-blog-meta-item-{{ ai_gen_id }}">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M8 8C9.65685 8 11 6.65685 11 5C11 3.34315 9.65685 2 8 2C6.34315 2 5 3.34315 5 5C5 6.65685 6.34315 8 8 8Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M14 14C14 11.7909 11.3137 10 8 10C4.68629 10 2 11.7909 2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ article.author }}
                  </span>
                {% endif %}
                {% if block.settings.show_date %}
                  <span class="toosa-blog-meta-item-{{ ai_gen_id }}">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.6667 2.66667H3.33333C2.59695 2.66667 2 3.26362 2 4V13.3333C2 14.0697 2.59695 14.6667 3.33333 14.6667H12.6667C13.403 14.6667 14 14.0697 14 13.3333V4C14 3.26362 13.403 2.66667 12.6667 2.66667Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M10.6667 1.33333V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M5.33333 1.33333V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M2 6.66667H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ article.published_at | date: block.settings.date_format }}
                  </span>
                {% endif %}
              </div>
              <a href="{{ article.url }}" class="toosa-blog-read-more-{{ ai_gen_id }}">
                {{ block.settings.read_more_text }}
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.33333 8H12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M8 3.33333L12.6667 8L8 12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if block.settings.show_load_more %}
        <div class="toosa-blog-load-more-{{ ai_gen_id }}">
          <a href="{{ block.settings.blog.url }}" class="toosa-blog-btn-{{ ai_gen_id }}">
            {{ block.settings.load_more_text }}
          </a>
        </div>
      {% endif %}
    {% endif %}
  </div>
</toosa-blog-{{ ai_gen_id }}>

<script>
  (function() {
    class ToosaBlog{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.filterButtons = this.querySelectorAll('.toosa-blog-filter-btn-{{ ai_gen_id }}');
        this.blogCards = this.querySelectorAll('.toosa-blog-card-{{ ai_gen_id }}');
        this.setupFilters();
      }

      setupFilters() {
        this.filterButtons.forEach(button => {
          button.addEventListener('click', () => {
            const filter = button.getAttribute('data-filter');
            
            this.filterButtons.forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');
            
            this.blogCards.forEach(card => {
              const tags = card.getAttribute('data-tags');
              
              if (filter === 'all') {
                card.style.display = 'block';
              } else {
                if (tags && tags.includes(filter)) {
                  card.style.display = 'block';
                } else {
                  card.style.display = 'none';
                }
              }
            });
          });
        });
      }
    }

    customElements.define('toosa-blog-{{ ai_gen_id }}', ToosaBlog{{ ai_gen_id }});
  })();
</script>

