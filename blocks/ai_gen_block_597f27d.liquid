{% doc %}
  @prompt
    Create a premium, modern, fully responsive Shopify Online Store 2.0 custom section named:
    
    "JD – Premium Financing Benefits"
    
    The section will be used on the TOOSA Financing page.
    
    The purpose of this section is to explain the benefits of TOOSA's financing option in a clean, trustworthy, highly readable and visually engaging way.
    
    The design should be inspired by the supplied reference screenshot, but DO NOT copy the screenshot exactly.
    
    Instead, create a significantly more polished and premium financing-benefits section that matches the TOOSA brand identity.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .jd-financing-benefits-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .jd-financing-benefits__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .jd-financing-benefits__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .jd-financing-benefits__eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 600;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
    display: block;
  }

  .jd-financing-benefits__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    line-height: 1.2;
    margin: 0 0 16px;
  }

  .jd-financing-benefits__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    line-height: 1.6;
    margin: 0;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .jd-financing-benefits__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_top_spacing }}px;
  }

  .jd-financing-benefits__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.card_text_alignment }};
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .jd-financing-benefits__card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: {{ block.settings.card_accent_height }}px;
    background-color: {{ block.settings.card_accent_color }};
    opacity: {{ block.settings.card_accent_opacity }};
  }

  {% if block.settings.enable_card_hover %}
    .jd-financing-benefits__card-{{ ai_gen_id }}:hover {
      transform: translateY(-{{ block.settings.card_hover_lift }}px);
      box-shadow: 0 {{ block.settings.card_hover_lift | times: 2 }}px {{ block.settings.card_hover_lift | times: 4 }}px rgba(0, 0, 0, 0.1);
      border-color: {{ block.settings.card_hover_border_color }};
    }
  {% endif %}

  .jd-financing-benefits__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    position: relative;
    z-index: 1;
  }

  .jd-financing-benefits__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size | times: 0.8 }}px;
    height: {{ block.settings.icon_size | times: 0.8 }}px;
    color: {{ block.settings.icon_color }};
  }

  .jd-financing-benefits__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px;
    line-height: 1.3;
  }

  .jd-financing-benefits__card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .jd-financing-benefits__cta-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-top: {{ block.settings.cta_top_spacing }}px;
  }

  .jd-financing-benefits__cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ block.settings.cta_padding_vertical }}px {{ block.settings.cta_padding_horizontal }}px;
    background-color: {{ block.settings.cta_background }};
    color: {{ block.settings.cta_text_color }};
    font-size: {{ block.settings.cta_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    border: {{ block.settings.cta_border_width }}px solid {{ block.settings.cta_border_color }};
    transition: all 0.3s ease;
  }

  .jd-financing-benefits__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_background }};
    color: {{ block.settings.cta_hover_text_color }};
    border-color: {{ block.settings.cta_hover_border_color }};
    transform: translateY(-2px);
  }

  .jd-financing-benefits__cta-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  @media screen and (max-width: 989px) {
    .jd-financing-benefits__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .jd-financing-benefits__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .jd-financing-benefits-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 16px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .jd-financing-benefits__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .jd-financing-benefits__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
     .jd-financing-benefits__card-title-{{ ai_gen_id }} {
    font-size: 18px;
     }

    .jd-financing-benefits__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .jd-financing-benefits__card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="jd-financing-benefits-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="jd-financing-benefits__container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="jd-financing-benefits__header-{{ ai_gen_id }}">
        {% if block.settings.eyebrow_text != blank %}
          <span class="jd-financing-benefits__eyebrow-{{ ai_gen_id }}">
            {{ block.settings.eyebrow_text }}
          </span>
        {% endif %}

        {% if block.settings.title != blank %}
          <h2 class="jd-financing-benefits__title-{{ ai_gen_id }}">
            {{ block.settings.title }}
          </h2>
        {% endif %}

        {% if block.settings.subtitle != blank %}
          <div class="jd-financing-benefits__subtitle-{{ ai_gen_id }}">
            {{ block.settings.subtitle }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="jd-financing-benefits__grid-{{ ai_gen_id }}">
      {% if block.settings.benefit_1_enabled %}
        <div class="jd-financing-benefits__card-{{ ai_gen_id }}">
          <div class="jd-financing-benefits__icon-wrapper-{{ ai_gen_id }}">
            <svg class="jd-financing-benefits__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="jd-financing-benefits__card-title-{{ ai_gen_id }}">
            {{ block.settings.benefit_1_title }}
          </h3>
          <div class="jd-financing-benefits__card-text-{{ ai_gen_id }}">
            {{ block.settings.benefit_1_text }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.benefit_2_enabled %}
        <div class="jd-financing-benefits__card-{{ ai_gen_id }}">
          <div class="jd-financing-benefits__icon-wrapper-{{ ai_gen_id }}">
            <svg class="jd-financing-benefits__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="jd-financing-benefits__card-title-{{ ai_gen_id }}">
            {{ block.settings.benefit_2_title }}
          </h3>
          <div class="jd-financing-benefits__card-text-{{ ai_gen_id }}">
            {{ block.settings.benefit_2_text }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.benefit_3_enabled %}
        <div class="jd-financing-benefits__card-{{ ai_gen_id }}">
          <div class="jd-financing-benefits__icon-wrapper-{{ ai_gen_id }}">
            <svg class="jd-financing-benefits__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="jd-financing-benefits__card-title-{{ ai_gen_id }}">
            {{ block.settings.benefit_3_title }}
          </h3>
          <div class="jd-financing-benefits__card-text-{{ ai_gen_id }}">
            {{ block.settings.benefit_3_text }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.benefit_4_enabled %}
        <div class="jd-financing-benefits__card-{{ ai_gen_id }}">
          <div class="jd-financing-benefits__icon-wrapper-{{ ai_gen_id }}">
            <svg class="jd-financing-benefits__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="jd-financing-benefits__card-title-{{ ai_gen_id }}">
            {{ block.settings.benefit_4_title }}
          </h3>
          <div class="jd-financing-benefits__card-text-{{ ai_gen_id }}">
            {{ block.settings.benefit_4_text }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.benefit_5_enabled %}
        <div class="jd-financing-benefits__card-{{ ai_gen_id }}">
          <div class="jd-financing-benefits__icon-wrapper-{{ ai_gen_id }}">
            <svg class="jd-financing-benefits__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="jd-financing-benefits__card-title-{{ ai_gen_id }}">
            {{ block.settings.benefit_5_title }}
          </h3>
          <div class="jd-financing-benefits__card-text-{{ ai_gen_id }}">
            {{ block.settings.benefit_5_text }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.benefit_6_enabled %}
        <div class="jd-financing-benefits__card-{{ ai_gen_id }}">
          <div class="jd-financing-benefits__icon-wrapper-{{ ai_gen_id }}">
            <svg class="jd-financing-benefits__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="jd-financing-benefits__card-title-{{ ai_gen_id }}">
            {{ block.settings.benefit_6_title }}
          </h3>
          <div class="jd-financing-benefits__card-text-{{ ai_gen_id }}">
            {{ block.settings.benefit_6_text }}
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_cta and block.settings.cta_text != blank %}
      <div class="jd-financing-benefits__cta-wrapper-{{ ai_gen_id }}">
        <a href="{{ block.settings.cta_link }}" class="jd-financing-benefits__cta-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
          <svg class="jd-financing-benefits__cta-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</div>

