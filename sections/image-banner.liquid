


{% style %}
#shopify-section-{{ section.id }} {
  {% if section.settings.content_custom_width %}
    --theme-image-banner-content-width: {{ section.settings.content_width | append: 'px' }};
  {% endif %}

  
  {% if section.settings.background_overlay %}
    --theme-image-banner-overlay-color: {{ section.settings.background_overlay_color }};
    --theme-image-banner-overlay-gradient: {{ section.settings.background_overlay_gradient }};
    --theme-image-banner-overlay-opacity: {{ section.settings.background_overlay_opacity | append: '%' }};

  {% endif %}


    --theme-image-banner-content-padding: var(--theme-block-content-padding-{{ section.settings.inset_choice }});

}
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% if section.settings.height_mobile != 'auto' %}
      --theme-image-banner-custom-height-mobile: {{ section.settings.height_mobile | append: 'px' }};
    {% endif %}

    {% if section.settings.height != 'auto' %}
      --theme-image-banner-custom-height-desktop: {{ section.settings.height | append: 'px' }};
    {% endif %}
  }
{% endstyle %}

{% for block in section.blocks %}
  {% if block.type == 'text' %}

    {% style %}
      #shopify-section-{{ section.id }} .block-{{ block.id }}{
        
      }

    {% endstyle %}

  {% elsif block.type == 'buttons' %}

    {% style %}
      #shopify-section-{{ section.id }} .block-{{ block.id }}{
        {% if block.settings.banner_button_1_custom_width %}
          --theme-image-banner-button-1-width: {{ block.settings.banner_button_1_width | append: 'px' }};
        {% endif %}

        {% if block.settings.banner_button_2_custom_width %}
          --theme-image-banner-button-2-width: {{ block.settings.banner_button_2_width | append: 'px' }};
        {% endif %}
      }

    {% endstyle %}
    
  {% endif %}
{% endfor %}




{% style %}
  #shopify-section-{{ section.id }} {

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


{% liquid 
  assign blocks_count = section.blocks | size 

%}

<div class="section-image-banner{% liquid

  if section.settings.content_position != blank
    echo ' content-position-' | append: section.settings.content_position
  endif 

  if section.settings.content_horizontal_align != blank
    echo ' content-horizontal-align-' | append: section.settings.content_horizontal_align
  endif 

  if section.settings.content_vertical_align != blank
    echo ' content-vertical-align-' | append: section.settings.content_vertical_align
  endif 
  
  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  
  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif
  
%}">
  <div class="section-image-banner-container section-container">
    <div class="section-image-banner-background">
      <div class="section-image-banner-background-media">
        {% if section.settings.background_image != blank or section.settings.background_image_mobile != blank %}
          {% render 'section-image-processor', image: section.settings.background_image, image_mobile: section.settings.background_image_mobile %}
        {% endif %}

        {% if section.settings.background_video != blank %}
          <div class="section-image-banner-background-video">
            {{ section.settings.background_video | video_tag: controls: false, autoplay: true, muted: true, loop: true }}
          </div>
        {% endif %}
        {% if section.settings.background_video == blank and section.settings.background_image == blank and section.settings.background_image_mobile == blank %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder placeholder-image-banner' }}
        {% endif %}
      </div>
      {% if section.settings.background_overlay %}
        <div class="section-image-banner-background-overlay"></div>
      {% endif %}
    </div>
    {% if blocks_count > 0 %}
          {% assign prevLastBlock = blocks_count | minus: 1 %}
      <div class="section-image-banner-content">
        {% for block in section.blocks %}
          {% if forloop.index == 1 %}
            <div class="section-image-banner-content-details">
          {% elsif forloop.index == blocks_count %}
            <div class="section-image-banner-content-bottom">
          {% endif %}
            {% case block.type %}
              {% when 'special-heading' %}
                {% if block.settings.banner_special_heading != blank %}
                  <h2 class="section-image-banner-special-heading special-heading-size-{{ block.settings.banner_special_heading_size }} block-{% echo block.id %}" {{ block.shopify_attributes }}>{{ block.settings.banner_special_heading }}</h2>
                {% endif %}
              {% when 'heading' %}
                {% if block.settings.banner_heading != blank %}
                  <h3 class="section-image-banner-heading heading-size-{{ block.settings.banner_heading_size }} block-{% echo block.id %}" {{ block.shopify_attributes }}>{{ block.settings.banner_heading }}</h3>
                {% endif %}
              {% when 'text' %}
                {% if block.settings.banner_text != blank %}
                  <p class="section-image-banner-text paragraph-size-{{ block.settings.banner_text_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.banner_text }}</p>
                {% endif %}
              {% when 'buttons' %}
                {% if block.settings.banner_button_1_text != blank or block.settings.banner_button_2_text != blank %}
                  <div class="section-image-banner-buttons block-{{ block.id }}" {{ block.shopify_attributes }}>
                    {% if block.settings.banner_button_1_text != blank %}
                      {% render 'button', 
                          button_text: block.settings.banner_button_1_text,  
                          button_url: block.settings.banner_button_1_url,
                          button_style: block.settings.banner_button_1_style,
                          button_custom_width: block.settings.banner_button_1_custom_width,
                          button_classes: 'section-image-banner-button-1',
                          button_target: block.settings.banner_button_1_target
                      %}
                    {% endif %}
                    {% if block.settings.banner_button_2_text != blank %}
                      {% render 'button', 
                          button_text: block.settings.banner_button_2_text,  
                          button_url: block.settings.banner_button_2_url,
                          button_style: block.settings.banner_button_2_style,
                          button_custom_width: block.settings.banner_button_2_custom_width,
                          button_classes: 'section-image-banner-button-2',
                          button_target: block.settings.banner_button_2_target
                      %}
                    {% endif %}
                  </div>
                {% endif %}
              {% when '@app' %}
                {% render block %}
              {% when 'liquid' %}
                <div class="custom-liquid">
                    {{ block.settings.custom_liquid }}
                </div>
            {% endcase %}

          {% if forloop.index == prevLastBlock %}
            </div>
          {% elsif forloop.index == blocks_count %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


