{% comment %}
  USP Four Column Bar
  - Refine Theme compatible
  - Fully responsive
  - Self-contained CSS
  - No external libraries
{% endcomment %}

<section
  id="usp-bar-{{ section.id }}"
  class="usp-four-column-bar"
  aria-label="Store benefits"
>
  <div class="usp-four-column-bar__grid">

    {% for block in section.blocks %}
      <div
        class="usp-four-column-bar__item"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.heading != blank %}
          <div class="usp-four-column-bar__heading">
            {{ block.settings.heading | escape }}
          </div>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="usp-four-column-bar__text">
            {{ block.settings.text | escape }}
          </div>
        {% endif %}
      </div>
    {% endfor %}

  </div>
</section>

<style>
  #usp-bar-{{ section.id }} {
    --usp-border-color: {{ section.settings.border_color }};
    --usp-heading-color: {{ section.settings.heading_color }};
    --usp-text-color: {{ section.settings.text_color }};
    --usp-bg-color: {{ section.settings.background_color }};
    --usp-heading-size: {{ section.settings.heading_size }}px;
    --usp-text-size: {{ section.settings.text_size }}px;
    --usp-item-padding: {{ section.settings.item_padding }}px;

    width: 100%;
    background: var(--usp-bg-color);
    box-sizing: border-box;
  }

  #usp-bar-{{ section.id }} *,
  #usp-bar-{{ section.id }} *::before,
  #usp-bar-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #usp-bar-{{ section.id }} .usp-four-column-bar__grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--usp-border-color);
    border-bottom: 1px solid var(--usp-border-color);
  }

  #usp-bar-{{ section.id }} .usp-four-column-bar__item {
    min-width: 0;
    min-height: 88px;
    padding: var(--usp-item-padding) 16px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;
    background: var(--usp-bg-color);
  }

  #usp-bar-{{ section.id }} .usp-four-column-bar__item + .usp-four-column-bar__item {
    border-left: 1px solid var(--usp-border-color);
  }

  #usp-bar-{{ section.id }} .usp-four-column-bar__heading {
    margin: 0;
    padding: 0;
    color: var(--usp-heading-color);
    font-size: var(--usp-heading-size);
    font-weight: 700;
        text-transform: capitalize;
  }

  #usp-bar-{{ section.id }} .usp-four-column-bar__text {
    margin-top: 7px;
    padding: 0;

    color: var(--usp-text-color);
    font-size: var(--usp-text-size);
    line-height: 1.35;
    font-weight: 400;
    letter-spacing: 0;
  }

  /* Tablet */
  @media screen and (max-width: 749px) {
    #usp-bar-{{ section.id }} .usp-four-column-bar__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #usp-bar-{{ section.id }} .usp-four-column-bar__item {
      min-height: 78px;
      padding: 13px 10px;
    }

    /*
      Left/right border correction for 2-column layout
    */
    #usp-bar-{{ section.id }} .usp-four-column-bar__item + .usp-four-column-bar__item {
      border-left: 0;
    }

    #usp-bar-{{ section.id }} .usp-four-column-bar__item:nth-child(odd) {
      border-right: 1px solid var(--usp-border-color);
    }

    #usp-bar-{{ section.id }} .usp-four-column-bar__item:nth-child(n + 3) {
      border-top: 1px solid var(--usp-border-color);
    }

    #usp-bar-{{ section.id }} .usp-four-column-bar__heading {
      font-size: 14px;
    }

    #usp-bar-{{ section.id }} .usp-four-column-bar__text {
      margin-top: 5px;
      font-size: 11px;
      line-height: 1.3;
    }
  }

  /* Large screens */
  @media screen and (min-width: 1500px) {
    #usp-bar-{{ section.id }} .usp-four-column-bar__item {
      min-height: 88px;
    }
  }
</style>

{% schema %}
{
  "name": "USP Four Column Bar",
  "tag": "section",
  "class": "section-usp-four-column-bar",
  "settings": [
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#dddddd"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#263238"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6b6b6b"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Vertical padding",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heavy-gauge welded steel"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Not folded sheet metal"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "USP Four Column Bar",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "heading": "Heavy-gauge welded steel",
            "text": "Not folded sheet metal"
          }
        },
        {
          "type": "usp",
          "settings": {
            "heading": "Financing with RBC",
            "text": "Own it now, pay monthly"
          }
        },
        {
          "type": "usp",
          "settings": {
            "heading": "Richmond, BC showroom",
            "text": "See and test before you buy"
          }
        },
        {
          "type": "usp",
          "settings": {
            "heading": "Canadian support & parts",
            "text": "A person you can call"
          }
        }
      ]
    }
  ]
}
{% endschema %}
