{% comment %} TOOSA redesign: the product line as four big cards {% endcomment %}
<section class="tx tx--light tx-lineup" id="tx-lineup-{{ section.id }}">
  <div class="tx-wrap">
    <div class="tx-lineup__head">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="tx-eyebrow tx-reveal">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 class="tx-h2 tx-reveal" data-delay="1">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.link_text != blank %}
        <a class="tx-btn tx-btn--ghost tx-btn--sm tx-reveal" data-delay="2" href="{{ section.settings.link_url | default: '/collections/all' }}">{{ section.settings.link_text }}</a>
      {% endif %}
    </div>
    <div class="tx-lineup__grid">
      {% for block in section.blocks %}
        {%- liquid
          assign product = all_products[block.settings.product_handle]
          assign img = block.settings.image | default: product.featured_image
          assign url = block.settings.link | default: product.url
          assign title = block.settings.title | default: product.title
          assign pts = block.settings.points | split: '|'
        -%}
        <a class="tx-card tx-reveal" data-delay="{{ forloop.index0 }}" href="{{ url }}" {{ block.shopify_attributes }}>
          <div class="tx-card__media">
            {% if img != blank %}{{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 760px) 45vw, 92vw', alt: title }}{% endif %}
            {% if block.settings.badge != blank %}<span class="tx-card__badge {% if block.settings.badge_sale %}tx-card__badge--sale{% endif %}">{{ block.settings.badge }}</span>
            {% elsif product != blank and product.compare_at_price > product.price %}<span class="tx-card__badge tx-card__badge--sale">Sale</span>{% endif %}
          </div>
          <div class="tx-card__body">
            <div class="tx-card__row">
              <h3 class="tx-h3">{{ title }}</h3>
              {% if block.settings.price_text != blank %}
                <span class="tx-card__price">{{ block.settings.price_text }}</span>
              {% elsif product != blank and product.price > 0 %}
                <span class="tx-card__price">{% if product.price_varies %}<small>from</small>{% endif %}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}{{ product.price | money_without_trailing_zeros }}</span>
              {% endif %}
            </div>
            {% if block.settings.blurb != blank %}<p style="margin:0;color:#3b434c;font-size:14.5px;line-height:1.5">{{ block.settings.blurb }}</p>{% endif %}
            {% if block.settings.points != blank %}<ul class="tx-card__pts">{% for p in pts %}<li>{{ p | strip }}</li>{% endfor %}</ul>{% endif %}
            <span class="tx-card__cta">{{ block.settings.cta | default: 'Explore' }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TX Product lineup",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The lineup" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two systems. One shop air solution. Endless foam." },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Shop everything" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "product_handle", "label": "Product handle" },
      { "type": "text", "id": "title", "label": "Title (optional, overrides product)" },
      { "type": "text", "id": "price_text", "label": "Price text (optional)" },
      { "type": "text", "id": "badge", "label": "Badge" },
      { "type": "checkbox", "id": "badge_sale", "label": "Badge in orange", "default": false },
      { "type": "textarea", "id": "blurb", "label": "One-line description" },
      { "type": "text", "id": "points", "label": "Chips (separate with |)" },
      { "type": "text", "id": "cta", "label": "Link text", "default": "Explore" },
      { "type": "url", "id": "link", "label": "Link (optional, overrides product)" },
      { "type": "image_picker", "id": "image", "label": "Image (optional, overrides product photo)" }
    ] }
  ],
  "presets": [ { "name": "TX Product lineup", "blocks": [
    { "type": "card", "settings": { "product_handle": "ultra-task-56-modular-rolling-tool-chest", "badge": "Most popular", "blurb": "56-inch double-bank rolling chest. Start with the base, add the hutch, locker and side drawers when you're ready.", "points": "7 drawers | 3 colours | Hutch, locker & drawers bolt on", "cta": "Explore Ultra Task 56" } },
    { "type": "card", "settings": { "product_handle": "ultra-max-72-modular-rolling-tool-box", "badge": "72-inch wide", "blurb": "The big one. A 72-inch rolling base with pegboard, upper cabinets and side lockers that turn one box into a full wall.", "points": "Full wall in one order | Pegboard & upper cabinets | Power tool drawer", "cta": "Explore Mega Max 72" } },
    { "type": "card", "settings": { "product_handle": "20-hp-rotary-screw-air-compressor-with-integrated-dryer-500l-tank", "badge": "New", "blurb": "TS-20: a 20 HP rotary-screw compressor, dryer and 500 L tank in one quiet, CRN-certified unit.", "points": "20 HP VFD | Integrated dryer | CRN tank option", "cta": "Explore the TS-20" } },
    { "type": "card", "settings": { "product_handle": "eva-foam-sheets", "badge": "Made in BC", "blurb": "High-density EVA foam, sheets or CNC-cut to your tools. Every socket gets a labelled home.", "points": "20 or 50 mm | Two-tone colours | Custom CNC inserts", "cta": "Explore foam" } }
  ] } ]
}
{% endschema %}
