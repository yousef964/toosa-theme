{% comment %}
  Collection Cards
  Shopify Refine Theme - OS 2.0
{% endcomment %}

<section
  id="CollectionCards-{{ section.id }}"
  class="collection-cards-section"
>
  <div class="collection-cards-container">

    {% if section.settings.eyebrow != blank %}
      <div class="collection-cards-eyebrow">
        <span class="collection-cards-eyebrow-line"></span>
        <span>{{ section.settings.eyebrow }}</span>
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="collection-cards-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="collection-cards-intro">
        {{ section.settings.description }}
      </div>
    {% endif %}


    <div class="collection-cards-slider-wrapper">

      {% if section.settings.layout == 'slider' and section.settings.show_arrows %}
        <button
          type="button"
          class="collection-cards-arrow collection-cards-arrow-prev"
          data-prev
          aria-label="Previous"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M15 18L9 12L15 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      {% endif %}


      <div
        class="
          collection-cards-track
          {% if section.settings.layout == 'grid' %}
            collection-cards-track-grid
          {% else %}
            collection-cards-track-slider
          {% endif %}
        "
        data-track
      >

        {% for block in section.blocks %}

          {% assign selected_collection = block.settings.collection %}

          {% if selected_collection != blank %}

            {% comment %}
              IMAGE
              Collection image OR manual image
            {% endcomment %}

            {% if block.settings.image_source == 'manual' and block.settings.manual_image != blank %}

              {% assign card_image = block.settings.manual_image %}

            {% else %}

              {% assign card_image = selected_collection.image %}

              {% if card_image == blank %}
                {% assign card_image = selected_collection.products.first.featured_image %}
              {% endif %}

            {% endif %}


            {% comment %}
              TITLE
            {% endcomment %}

            {% if block.settings.title_source == 'custom' and block.settings.custom_title != blank %}

              {% assign card_title = block.settings.custom_title %}

            {% else %}

              {% assign card_title = selected_collection.title %}

            {% endif %}


            {% comment %}
              DESCRIPTION

              IMPORTANT:
              Metafield used here is:

              custom.short_description
            {% endcomment %}

            {% if block.settings.description_source == 'metafield' %}

              {% assign card_metafield = selected_collection.metafields.custom.short_description %}

            {% endif %}


            <article
              class="collection-card"
              {{ block.shopify_attributes }}
            >

              <a
                href="{{ selected_collection.url }}"
                class="collection-card-link"
              >

                <div class="collection-card-image">

                  {% if card_image != blank %}

                    {{
                      card_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '375, 550, 750, 900, 1200',
                        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 90vw',
                        class: 'collection-card-image-img',
                        alt: card_title
                    }}

                  {% else %}

                    <div class="collection-card-placeholder">
                      <span>
                        {{ card_title }}
                      </span>
                    </div>

                  {% endif %}

                </div>


                <div class="collection-card-content">

                  {% if card_title != blank %}
                    <h3 class="collection-card-title">
                      {{ card_title }}
                    </h3>
                  {% endif %}


                  {% if block.settings.description_source == 'collection' %}

                    {% if selected_collection.description != blank %}
                      <div class="collection-card-description">
                        {{ selected_collection.description }}
                      </div>
                    {% endif %}


                  {% elsif block.settings.description_source == 'metafield' %}

                    {% if card_metafield != blank %}
                      <div class="collection-card-description">
                        {{ card_metafield | metafield_tag }}
                      </div>
                    {% endif %}


                  {% elsif block.settings.description_source == 'custom' %}

                    {% if block.settings.custom_description != blank %}
                      <div class="collection-card-description">
                        {{ block.settings.custom_description }}
                      </div>
                    {% endif %}

                  {% endif %}

                </div>

              </a>

            </article>

          {% endif %}

        {% endfor %}

      </div>


      {% if section.settings.layout == 'slider' and section.settings.show_arrows %}
        <button
          type="button"
          class="collection-cards-arrow collection-cards-arrow-next"
          data-next
          aria-label="Next"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M9 6L15 12L9 18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      {% endif %}

    </div>

  </div>
</section>


<style>

  #CollectionCards-{{ section.id }} {

    --cc-background: {{ section.settings.background_color }};
    --cc-heading: {{ section.settings.heading_color }};
    --cc-text: {{ section.settings.text_color }};
    --cc-eyebrow: {{ section.settings.eyebrow_color }};
    --cc-accent: {{ section.settings.accent_color }};
    --cc-border: {{ section.settings.border_color }};
    --cc-card-background: {{ section.settings.card_background }};

    --cc-gap: {{ section.settings.card_gap }}px;
    --cc-image-height: {{ section.settings.image_height }}px;

    background: var(--cc-background);

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    overflow: hidden;
  }


  #CollectionCards-{{ section.id }} .collection-cards-container {

    width: min(
      calc(100% - 40px),
      {{ section.settings.max_width }}px
    );

    margin: 0 auto;
  }


  /* EYEBROW */

  #CollectionCards-{{ section.id }} .collection-cards-eyebrow {

    display: flex;
    align-items: center;

    gap: 8px;

    margin-bottom: 12px;

    color: var(--cc-eyebrow);

    font-size: 11px;
    font-weight: 700;

    line-height: 1.4;

    letter-spacing: 1.5px;

    text-transform: uppercase;
  }


  #CollectionCards-{{ section.id }} .collection-cards-eyebrow-line {

    width: 22px;
    height: 2px;

    flex: 0 0 22px;

    background: var(--cc-accent);
  }


  /* HEADING */

  #CollectionCards-{{ section.id }} .collection-cards-heading {

    margin: 0;

    color: var(--cc-heading);

    font-size: clamp(28px, 3vw, 40px);

    font-weight: 700;

    line-height: 1.15;

    letter-spacing: -0.025em;
  }


  /* INTRO */

  #CollectionCards-{{ section.id }} .collection-cards-intro {

    max-width: 700px;

    margin-top: 12px;
    margin-bottom: 30px;

    color: var(--cc-text);

    font-size: 15px;

    line-height: 1.6;
  }


  #CollectionCards-{{ section.id }} .collection-cards-intro p {
    margin: 0;
  }


  /* SLIDER WRAPPER */

  #CollectionCards-{{ section.id }} .collection-cards-slider-wrapper {

    position: relative;
    padding-top: 40px;
    width: 100%;
  }


  /* TRACK */

  #CollectionCards-{{ section.id }} .collection-cards-track {

    display: flex;

    gap: var(--cc-gap);

    width: 100%;
  }


  /* GRID */

  #CollectionCards-{{ section.id }} .collection-cards-track-grid {

    display: grid;

    grid-template-columns:
      repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
  }


  /* SLIDER */

  #CollectionCards-{{ section.id }} .collection-cards-track-slider {

    overflow-x: auto;

    overflow-y: hidden;

    scroll-behavior: smooth;

    scroll-snap-type: x mandatory;

    scrollbar-width: none;
padding-top: 40px;
    -ms-overflow-style: none;
  }


  #CollectionCards-{{ section.id }} .collection-cards-track-slider::-webkit-scrollbar {
    display: none;
  }


  #CollectionCards-{{ section.id }} .collection-cards-track-slider .collection-card {

    flex: 0 0 calc(
      (
        100% -
        (var(--cc-gap) * ({{ section.settings.columns_desktop }} - 1))
      )
      / {{ section.settings.columns_desktop }}
    );

    scroll-snap-align: start;
  }


  /* CARD */

  #CollectionCards-{{ section.id }} .collection-card {

    min-width: 0;

    border: 1px solid var(--cc-border);

    background: var(--cc-card-background);

    overflow: hidden;
  }


  #CollectionCards-{{ section.id }} .collection-card-link {

    display: block;

    height: 100%;

    color: inherit;

    text-decoration: none;
  }


  /* IMAGE */

  #CollectionCards-{{ section.id }} .collection-card-image {

    position: relative;

    height: var(--cc-image-height);

    overflow: hidden;

    background: #1d2a39;

    border-bottom: 3px solid var(--cc-accent);
  }


  #CollectionCards-{{ section.id }} .collection-card-image-img {

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.4s ease;
  }


  #CollectionCards-{{ section.id }} .collection-card:hover
  .collection-card-image-img {

    transform: scale(1.04);
  }


  /* PLACEHOLDER */

  #CollectionCards-{{ section.id }} .collection-card-placeholder {

    display: flex;

    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    padding: 20px;

    background: #1d2a39;

    color: #8d9aaa;

    text-align: center;

    font-size: 11px;

    font-weight: 500;

    letter-spacing: 1px;

    text-transform: uppercase;
  }


  /* CONTENT */

  #CollectionCards-{{ section.id }} .collection-card-content {

    padding: 14px 17px 18px;

    min-height: 125px;
  }


  #CollectionCards-{{ section.id }} .collection-card-title {

    margin: 0 0 6px;

    color: var(--cc-heading);

    font-size: 16px;

    font-weight: 700;

    line-height: 1.35;
  }


  #CollectionCards-{{ section.id }} .collection-card-description {

    color: var(--cc-text);

    font-size: 13px;

    line-height: 1.6;
  }


  #CollectionCards-{{ section.id }} .collection-card-description p {

    margin: 0 0 5px;
  }


  #CollectionCards-{{ section.id }} .collection-card-description p:last-child {

    margin-bottom: 0;
  }


  #CollectionCards-{{ section.id }} .collection-card-description ul,
  #CollectionCards-{{ section.id }} .collection-card-description ol {

    margin: 5px 0 0;

    padding-left: 18px;
  }


  /* ARROWS */

  #CollectionCards-{{ section.id }} .collection-cards-arrow {

    position: absolute;

    top: 50%;

    z-index: 5;

    display: flex;

    align-items: center;
    justify-content: center;

    width: 42px;
    height: 42px;

    padding: 0;

    border: 1px solid #d8dde2;

    border-radius: 50%;

    background: #ffffff;

    color: var(--cc-heading);

    cursor: pointer;

    transform: translateY(-50%);

    box-shadow:
      0 4px 14px rgba(0, 0, 0, 0.10);

    transition:
      background 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }


  #CollectionCards-{{ section.id }} .collection-cards-arrow:hover {

    background: var(--cc-heading);

    color: #ffffff;
  }


  #CollectionCards-{{ section.id }} .collection-cards-arrow-prev {

    left: -21px;
  }


  #CollectionCards-{{ section.id }} .collection-cards-arrow-next {

    right: -21px;
  }


  #CollectionCards-{{ section.id }} .collection-cards-arrow.is-disabled {

    opacity: 0.35;

    pointer-events: none;
  }


  /* TABLET */

  @media screen and (max-width: 989px) {

    #CollectionCards-{{ section.id }} .collection-cards-container {

      width: calc(100% - 32px);
    }


    #CollectionCards-{{ section.id }} .collection-cards-track-grid {

      grid-template-columns:
        repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }


    #CollectionCards-{{ section.id }} .collection-cards-track-slider .collection-card {

      flex-basis: calc(
        (
          100% -
          (var(--cc-gap) * ({{ section.settings.columns_tablet }} - 1))
        )
        / {{ section.settings.columns_tablet }}
      );
    }


    #CollectionCards-{{ section.id }} .collection-card-image {

      height: 155px;
    }


    #CollectionCards-{{ section.id }} .collection-cards-arrow-prev {

      left: -12px;
    }


    #CollectionCards-{{ section.id }} .collection-cards-arrow-next {

      right: -12px;
    }

  }


  /* MOBILE */

  @media screen and (max-width: 749px) {

    #CollectionCards-{{ section.id }} {

      padding-top: {{ section.settings.padding_top_mobile }}px;

      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }


    #CollectionCards-{{ section.id }} .collection-cards-container {

      width: calc(100% - 30px);
    }


    #CollectionCards-{{ section.id }} .collection-cards-eyebrow {

      font-size: 10px;

      letter-spacing: 1.2px;

      margin-bottom: 10px;
    }


    #CollectionCards-{{ section.id }} .collection-cards-heading {

      font-size: 28px;
    }


    #CollectionCards-{{ section.id }} .collection-cards-intro {

      margin-bottom: 22px;

      font-size: 14px;
    }


    /*
      GRID MOBILE
    */

    #CollectionCards-{{ section.id }} .collection-cards-track-grid {

      grid-template-columns: 1fr;

      gap: 14px;
    }


    /*
      MOBILE SLIDER
    */

    #CollectionCards-{{ section.id }} .collection-cards-track-slider {

      gap: 12px;

      margin-right: -15px;

      padding-right: 15px;
    }


    #CollectionCards-{{ section.id }} .collection-cards-track-slider .collection-card {

      flex: 0 0 86%;

      scroll-snap-align: start;
    }


    #CollectionCards-{{ section.id }} .collection-card-image {

      height: 185px;
    }


    #CollectionCards-{{ section.id }} .collection-card-content {

      min-height: auto;

      padding: 14px 15px 17px;
    }


    #CollectionCards-{{ section.id }} .collection-card-title {

      font-size: 15px;
    }


    #CollectionCards-{{ section.id }} .collection-card-description {

      font-size: 13px;
    }


    /*
      Mobile par arrows hide
      Swipe use hoga
    */

    #CollectionCards-{{ section.id }} .collection-cards-arrow {

      display: none;
    }

  }


  /* SMALL MOBILE */

  @media screen and (max-width: 390px) {

    #CollectionCards-{{ section.id }} .collection-cards-container {

      width: calc(100% - 24px);
    }


    #CollectionCards-{{ section.id }} .collection-cards-heading {

      font-size: 25px;
    }


    #CollectionCards-{{ section.id }} .collection-card-image {

      height: 165px;
    }

  }

</style>


<script>
  (function () {

    var section = document.getElementById(
      'CollectionCards-{{ section.id }}'
    );

    if (!section) return;


    var track = section.querySelector('[data-track]');

    var prev = section.querySelector('[data-prev]');

    var next = section.querySelector('[data-next]');


    if (!track) return;


    function getScrollAmount() {

      var card = track.querySelector('.collection-card');

      if (!card) return 300;


      var styles = window.getComputedStyle(track);

      var gap = parseFloat(styles.gap) || 0;


      return card.getBoundingClientRect().width + gap;
    }


    function updateButtons() {

      if (!prev || !next) return;


      var maxScroll =
        track.scrollWidth - track.clientWidth;


      if (track.scrollLeft <= 5) {

        prev.classList.add('is-disabled');

      } else {

        prev.classList.remove('is-disabled');
      }


      if (track.scrollLeft >= maxScroll - 5) {

        next.classList.add('is-disabled');

      } else {

        next.classList.remove('is-disabled');
      }
    }


    if (prev) {

      prev.addEventListener('click', function () {

        track.scrollBy({
          left: -getScrollAmount(),
          behavior: 'smooth'
        });

      });

    }


    if (next) {

      next.addEventListener('click', function () {

        track.scrollBy({
          left: getScrollAmount(),
          behavior: 'smooth'
        });

      });

    }


    track.addEventListener(
      'scroll',
      updateButtons,
      { passive: true }
    );


    window.addEventListener(
      'resize',
      updateButtons
    );


    updateButtons();

  })();
</script>


{% schema %}
{
  "name": "Collection cards",
  "tag": "section",
  "class": "collection-cards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Build your ideal workshop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start with your setup"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show slider arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 120,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 170
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1d2a39"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#687582"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#1d2a39"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ff4b2b"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#dce1e5"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select collection"
        },
        {
          "type": "select",
          "id": "image_source",
          "label": "Image source",
          "options": [
            {
              "value": "collection",
              "label": "Collection image"
            },
            {
              "value": "manual",
              "label": "Manual image"
            }
          ],
          "default": "collection"
        },
        {
          "type": "image_picker",
          "id": "manual_image",
          "label": "Manual image"
        },
        {
          "type": "select",
          "id": "title_source",
          "label": "Title source",
          "options": [
            {
              "value": "collection",
              "label": "Collection title"
            },
            {
              "value": "custom",
              "label": "Custom title"
            }
          ],
          "default": "collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title"
        },
        {
          "type": "select",
          "id": "description_source",
          "label": "Description source",
          "options": [
            {
              "value": "collection",
              "label": "Collection description"
            },
            {
              "value": "metafield",
              "label": "Collection metafield"
            },
            {
              "value": "custom",
              "label": "Custom text"
            }
          ],
          "default": "custom"
        },
        {
          "type": "textarea",
          "id": "custom_description",
          "label": "Custom description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection cards",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}