
{% style %}
#shopify-section-{{ section.id }} {

  --theme-image-cards-vertcial-alignment: {{ section.settings.vertical_align }};

  {% if section.settings.gap %}
    --theme-image-cards-gap: var(--theme-gap-{{ section.settings.gap_choice }});
    {% else %}
      --theme-image-cards-gap: 0px;
  {% endif %}

}

{% for block in section.blocks %}
  #shopify-section-{{ section.id }} .block-{{ block.id }} {

    --theme-image-cards-card-aspect-ratio: {{ block.settings.image_aspect_ratio }};
    
    {% if block.settings.image_custom_width %}
      --theme-image-cards-card-image-width: {{ block.settings.image_width | append: 'px' }};
    {% endif %}

    {% if block.settings.content_custom_width %}
      --theme-image-cards-card-content-width: {{ block.settings.content_width | append: 'px' }};
    {% endif %}

  }
{% endfor %}

{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-image-cards{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-image-cards-container section-container">
    {% if section.settings.text_1 != blank or section.settings.text_2 != blank or section.settings.button_text != blank %}
      <div class="section-image-cards-header">
        {% if section.settings.text_1 != blank or section.settings.text_2 != blank %}
          <div class="section-image-cards-header__left">
            {% if section.settings.text_1 != blank %}
              <h2 class="section-image-cards-header__heading heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
            {% endif %}

            {% if section.settings.text_2 != blank %}
              <p class="section-image-cards-header__description paragraph-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</p>
            {% endif %}
          </div>
        {% endif %}
        {% if section.settings.button_text != blank %}
          {% render 'button', 
              button_text: section.settings.button_text,  
              button_url: section.settings.button_url,
              button_style: section.settings.button_style,
              button_classes: 'section-image-cards-button',
              button_target: section.settings.button_target
          %}
        {% endif %}
      </div>
    {% endif %}
    <div class="section-image-cards-content">
      {% if section.blocks != blank %}
        {% for block in section.blocks %}
          <div class="section-image-cards-card has-card-{{ block.settings.card_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>
            
            <div class="section-image-cards-card__image">
              {% if block.settings.image != blank %}
                {% render 'section-image-processor', image: block.settings.image %}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder placeholder-image-cards' }}
              {% endif %}
            </div>
            
            <div class="section-image-cards-card__content">
              {% if block.settings.text_1 != blank %}
                <h3 class="section-image-cards-card__heading special-heading-size-{{ block.settings.text_1_size }}">{{ block.settings.text_1 }}</h3>
              {% endif %}
              {% if block.settings.text_2 != blank %}
                <div class="section-image-cards-card__additional-heading heading-size-{{ block.settings.text_2_size }}">{{ block.settings.text_2 }}</div>
              {% endif %}
              {% if block.settings.text_3 != blank %}
                <p class="section-image-cards-card__description paragraph-size-{{ block.settings.text_3_size }}">{{ block.settings.text_3 }}</p>
              {% endif %}

              {% if block.settings.button_text != blank %}
                {% render 'button', 
                    button_text: block.settings.button_text,  
                    button_url: block.settings.button_url,
                    button_style: block.settings.button_style,
                    button_classes: 'section-image-cards-card__button',
                    button_target: block.settings.button_target
                %}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


