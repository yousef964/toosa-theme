{% style %}
  #shopify-section-{{ section.id }} {

    {% if section.settings.gap %}
      --theme-handpicked-products-gap: var(--theme-gap-{{ section.settings.gap_choice }});
    {% else %}
      --theme-handpicked-products-gap: 0px;
    {% endif %}

    --theme-handpicked-products-columns-count: {{ section.settings.columns_count }};

  }
{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


{% liquid 
  assign products_choice = section.settings.products_choice
  
  assign columns_count = section.settings.columns_count | plus: 0

  comment
  for product in products_choice
    assign section_products_size = forloop.index
  endfor
  endcomment
  
  assign section_products_size = products_choice.count

  if section_products_size > 4 and section.settings.carousel
    assign has_carousel = true
  endif

  assign section_padding_classname = 'has-section-padding'
  assign color_scheme = section.settings.color_scheme

  for scheme in settings.color_schemes
    if color_scheme == scheme and scheme.settings.background == blank
      if scheme.settings.background == blank
       assign section_padding_classname = 'has-section-padding-on-sides'
      endif
    endif
  endfor

%}


<div class="section-handpicked-products{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  echo ' ' | append: section_padding_classname

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-handpicked-products-container section-container">

    {% if section.settings.text_1 != blank or section.settings.text_2 != blank or section.settings.button_text != blank %}
      <div class="section-handpicked-products-header">
        {% if section.settings.text_1 != blank or section.settings.text_2 != blank %}
          <div class="section-handpicked-products-header__texts">
            {% if section.settings.text_1 != blank %}
              <h2 class="section-handpicked-products-header__heading special-heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
            {% endif %}

            {% if section.settings.text_2 != blank %}
              <p class="section-handpicked-products-header__description{% liquid 
                if section.settings.text_2_newline
                  echo ' has-fullwidth-description'
                endif
              %} paragraph-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</p>
            {% endif %}
          </div>
        {% endif %}
        {% if section.settings.button_text != blank %}
          {% render 'button', 
              button_text: section.settings.button_text,  
              button_url: section.settings.button_url,
              button_style: section.settings.button_style,
              button_classes: 'section-handpicked-products-header__button',
              button_target: section.settings.button_target
          %}
        {% endif %}
      </div>
    {% endif %}
    <div class="section-handpicked-products-list{% liquid 
      if section.settings.columns_offset
        echo ' has-carousel-columns-offset'
      endif

      if has_carousel
        echo ' has-carousel splide'
      endif
      %}" {% liquid 
      if has_carousel 

        assign carousel_columns_count = columns_count
        if section.settings.columns_offset
          assign carousel_columns_count = columns_count | minus: 1
        endif

        assign data_carousel_offset = 'data-columns-offset="' | append: section.settings.columns_offset | append: '"'

        echo data_carousel_offset

        assign data_options = 'data-options={'
          
        assign data_options = data_options | append: '"rewind":' | append: section.settings.loop | append: ','
        assign data_options = data_options | append: '"perMove":"' | append: section.settings.per_move | append: '",'
        assign data_options = data_options | append: '"perPage":"' | append: carousel_columns_count | append: '",'

        if section.settings.speed != blank
          assign data_options = data_options | append: '"speed":"' | append: section.settings.speed | append: '",'
        endif 
        if section.settings.interval != blank
          assign data_options = data_options | append: '"interval":"' | append: section.settings.interval | append: '",'
        endif 
        
        assign data_options = data_options | append: '"autoplay":' | append: section.settings.autoplay | append: ','
        assign data_options = data_options | append: '"drag":' | append: section.settings.mouse_drag | append: ','
        assign data_options = data_options | append: '"arrows":' | append: section.settings.arrows | append: ','
        assign data_options = data_options | append: '"pagination":' | append: section.settings.dots | append: ','

        assign data_options = data_options | append: '"gap":' | append: '"var(--theme-handpicked-products-gap)"' | append: ','
        
        assign data_options = data_options | append: '"breakpoints":{'
        assign data_options = data_options | append: '"768":{'
        assign data_options = data_options | append: '"perPage":' | append: 2
        assign data_options = data_options | append: '}'
        assign data_options = data_options | append: '}' | append: ','

        assign data_options_count = data_options | size | minus: 1
        assign data_options = data_options | slice: 0, data_options_count
        assign data_options = data_options | append: '}'

        echo data_options

        
      endif

    
    %}>
      {% if has_carousel %}
        {% if section.settings.progress_bar %}
          <div class="splide__progress">
            <div class="splide__progress-bar"></div>
          </div>
        {% endif %}
        <div class="splide__arrows">
          <button class="splide__arrow splide__arrow--prev">
            {% render 'icon-arrow-right' %}
          </button>
          <button class="splide__arrow splide__arrow--next">
            {% render 'icon-arrow-right' %}
          </button>
        </div>
        <div class="splide__track">
            <ul class="splide__list">
      {% endif %}

      {% if products_choice != blank %}
        {% for product in products_choice limit: section_products_size %}
          {% liquid 
            assign tag = 'div'
            if has_carousel
              assign tag = 'li' 
            endif 
          %}
          <{{ tag }} class="section-handpicked-products-product product{% liquid 
            if has_carousel
              echo ' splide__slide'
            endif 

            %}">
            {% render 'section-product-processor', product: product, section_settings: section.settings, prefix: 'section-handpicked-products-product' %}
          </{{ tag }}>
        {% endfor %}
      {% else %}
        {% for i in (1..columns_count) %}
          {% assign placeholder_image = 'product-' | append: forloop.index %}
          {% liquid 
            assign tag = 'div'
            if has_carousel
              assign tag = 'li' 
            endif 
          %}
          <{{ tag }} class="section-handpicked-products-product product{% liquid 
            if has_carousel
              echo ' splide__slide'
            endif 

            %}">
            <div class="product__image">
              {{ placeholder_image | placeholder_svg_tag: 'placeholder placeholder-handpicked-products' }}
            </div>
            <h3 class="product__title">
                {{ 'products.placeholder.title' | t }}
            </h3>
            <p class="product__price">
                <span>{{ 'products.placeholder.price' | t }}</span>
            </p>
          </{{ tag }}>
        {% endfor %}
      {% endif %}
    {% if has_carousel %}
        </ul>
      </div>
    {% endif %}
    </div>
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}



