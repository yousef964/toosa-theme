
{% style %}
#shopify-section-{{ section.id }} {
  --theme-image-gallery-columns: {{ section.settings.columns }};
  
  {% if section.settings.gap %}
    --theme-image-gallery-gap: var(--theme-gap-{{ section.settings.gap_choice }});
    {% else %}
      --theme-image-gallery-gap: 0px;
  {% endif %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

}
{% endstyle %}


{% for block in section.blocks %}

  {% style %}
    #shopify-section-{{ section.id }} .block-{{ block.id }}{
      --theme-image-gallery-image-aspect-ratio: {{ block.settings.aspect_ratio }};
    }

  {% endstyle %}

{% endfor %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-image-gallery{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif
  
%}">
<div class="section-image-gallery-container section-container">

  {% if section.settings.text_1 != blank or section.settings.text_2 != blank %}
    <div class="section-image-gallery-header">
      {% liquid 
        assign text_plain = section.settings.text_1

        if section.settings.text_1_url != blank
            assign text_with_a_tag = '<a href="' | append: section.settings.text_1_url | append: '" class="highlight-with-link">'
            assign text_with_highlight = text_plain | replace_first: '|', text_with_a_tag | replace_last: '|', '</a>'
        else
            assign text_with_highlight = text_plain | replace_first: '|', '<span class="highlight">' | replace_last: '|', '</span>'
        endif
          
      %}
      {% if text_with_highlight != blank %}
        <h2 class="section-image-gallery-header__heading {{ section.settings.text_1_choice }}-size-{{ section.settings.text_1_size }}">{{ text_with_highlight }}</h2>
      {% endif %}

      {% if section.settings.text_2 != blank %}
        <p class="section-image-gallery-header__description paragraph-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</p>
      {% endif %}
    </div>
  {% endif %}
  {% if section.blocks != blank %}
    <div class="section-image-gallery-content">
    {% for block in section.blocks %}
      {% if block.type == 'video' %}
        <div class="section-image-gallery-video block-{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="section-image-gallery-video-player video-player{% liquid 
            if block.settings.video_source == 'internal'
              echo ' has-internal-video'
            else
              echo ' has-external-video'

              if block.settings.video_url.type == 'youtube'
                echo ' has-youtube-video'
              else
                echo ' has-vimeo-video'
              endif

            endif
        
            if block.settings.cover_image != blank 
              echo ' has-cover-image'
            endif

            if block.settings.autoplay_muted
              echo ' playing'
            endif
          %}">
            {% if block.settings.video_source == 'internal' %}
              <div class="section-image-gallery-video-player--internal">
                {% if block.settings.video != blank %}
                  {{ block.settings.video | video_tag: autoplay: block.settings.autoplay_muted, loop: block.settings.loop, muted: block.settings.autoplay_muted  }}
                {% else %}
                  {% liquid
                    assign video_url = '_9VUPq3SxOc'
                    if block.settings.autoplay_muted
                      assign video_url = video_url | append: '?autoplay=1&muted=1'
                    endif
                  %}
                  <div style="--aspect-ratio: 16/9; width: 100%;">
                    <iframe src="https://www.youtube.com/embed/{{ video_url }}" frameborder="0" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen title="{{ block.settings.video_alt | escape }}"></iframe>
                  </div>
                {% endif %}
              </div>
            {% elsif block.settings.video_source == 'external' %}
            {% liquid 
              assign video_url = block.settings.video_url.id
              if video_url == blank
                assign video_url = '_9VUPq3SxOc'
              endif

              if block.settings.autoplay_muted
                assign video_url = video_url | append: '?autoplay=1&muted=1'
              endif
            %}
              <div class="section-image-gallery-video-player--external">
                {% if block.settings.video_url.type == 'vimeo' %}
                  <iframe src="https://player.vimeo.com/video/{{ video_url }}" frameborder="0" allow="autoplay; fullscreen" allowfullscreen title="{{ block.settings.video_alt | escape }}"></iframe>
                {% else %}
                  <iframe src="https://www.youtube.com/embed/{{ video_url }}" frameborder="0" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen title="{{ block.settings.video_alt | escape }}"></iframe>
                {% endif %}
              </div>
            {% endif %}
            
            {% if block.settings.cover_image != blank %}
              <div class="section-image-gallery-video-cover-image">
                {% render 'section-image-processor', image: block.settings.cover_image %}
              </div>
            {% endif %}

            {% if block.settings.cover_image == blank and block.settings.video_url == blank and block.settings.video == blank %}
              <div class="section-image-gallery-video-cover-image">
                {{ 'image' | placeholder_svg_tag: 'placeholder placeholder-video' }}
              </div>
            {% endif %}

            <div class="section-image-gallery-video-player-controls">
              <div class="section-image-gallery-video-player-controls__play video-play">
                {% render 'icon-play' %}
              </div>
            </div>
          </div>
        </div>
      {% elsif block.type == 'image' %}
        <div class="section-image-gallery-image block-{{ block.id }}" {{ block.shopify_attributes }}>
            {% if block.settings.image_url != blank %}
              <a href="{{ block.settings.image_url }}" title="{{ block.settings.image.alt }}">
            {% endif %}
            {% if block.settings.image != blank %}
                {% render 'section-image-processor', image: block.settings.image %}
            {% else %}
                {% echo 'image' | placeholder_svg_tag: 'placeholder placeholder-image-gallery' %}
            {% endif %}
            {% if block.settings.image_url != blank %}
              </a>
            {% endif %}
        </div>
          
      {% endif %}
    {% endfor %}
    </div>
  {% endif %}
</div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


