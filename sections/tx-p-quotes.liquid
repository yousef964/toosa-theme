{% comment %} TOOSA inner pages: customer quotes, photo or video, in a snap carousel {% endcomment %}
{%- liquid
  assign s = section.settings
  assign theme_class = 'txp'
  if s.theme == 'light'
    assign theme_class = 'txp txp--light'
  elsif s.theme == 'paper'
    assign theme_class = 'txp txp--paper'
  endif
-%}
<section class="{{ theme_class }} txp-section txp-quotes" id="txp-quotes-{{ section.id }}" data-txp-quotes>
  <div class="txp-wrap">
    <div class="txp-head txp-head--row">
      <div>
        {%- if s.eyebrow != blank -%}<p class="txp-eyebrow txp-reveal">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="txp-h2 txp-reveal" data-delay="1">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.lead != blank -%}<div class="txp-lead txp-reveal" data-delay="2">{{ s.lead }}</div>{%- endif -%}
      </div>
      <div class="txp-quotes__nav txp-reveal" data-delay="2">
        <button type="button" aria-label="Previous" data-txp-prev>{% render 'tx-p-icon', name: 'arrow-left' %}</button>
        <button type="button" aria-label="Next" data-txp-next>{% render 'tx-p-icon', name: 'arrow' %}</button>
      </div>
    </div>
    <div class="txp-quotes__track" data-txp-track>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <figure class="txp-quote txp-reveal" data-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          {%- if b.image != blank or b.video != blank -%}
            <div class="txp-quote__media">
              {%- if b.video != blank -%}
                <video playsinline preload="none" controls data-txp-video {% if b.image != blank %}poster="{{ b.image | image_url: width: 900 }}"{% endif %}>
                  {%- for source in b.video.sources -%}{%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}{%- endfor -%}
                </video>
                <button type="button" class="txp-quote__play" aria-label="Play video from {{ b.name }}" data-txp-play><span>{% render 'tx-p-icon', name: 'play' %}</span></button>
              {%- else -%}
                {%- assign tx_alt = b.image.alt | default: b.name | escape -%}{{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '420px', alt: tx_alt }}
              {%- endif -%}
            </div>
          {%- endif -%}
          <figcaption class="txp-quote__body">
            <div class="txp-quote__stars" aria-label="5 stars">{% for i in (1..5) %}{% render 'tx-p-icon', name: 'star' %}{% endfor %}</div>
            <blockquote class="txp-quote__text">{{ b.review }}</blockquote>
            <div class="txp-quote__name">{{ b.name }}</div>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TX Customer quotes",
  "settings": [
    { "type": "select", "id": "theme", "label": "Colour", "default": "dark", "options": [
      { "value": "dark", "label": "Dark" }, { "value": "light", "label": "White" }, { "value": "paper", "label": "Paper" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "lead", "label": "Lead" }
  ],
  "blocks": [
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo (or video poster)" },
      { "type": "video", "id": "video", "label": "Video (optional)" },
      { "type": "text", "id": "name", "label": "Customer name" },
      { "type": "richtext", "id": "review", "label": "Review" } ] }
  ],
  "presets": [ { "name": "TX Customer quotes" } ]
}
{% endschema %}
