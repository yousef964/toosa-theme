
{% liquid
  assign section_id = 'testimonial-slider-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="jd-testimonials"
  style="
    --jd-bg: {{ section.settings.background_color }};
    --jd-text: {{ section.settings.text_color }};
    --jd-accent: {{ section.settings.star_color }};
    --jd-card-bg: {{ section.settings.card_background }};
    --jd-radius: {{ section.settings.card_radius }}px;
  "
>
  <div class="jd-testimonials__container">

    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="jd-testimonials__header">
        {% if section.settings.heading != blank %}
          <h2 class="special-heading-size-x-small">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="jd-testimonials__subheading">
            {{ section.settings.subheading }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="jd-testimonials__slider-wrap">

      <div
        class="jd-testimonials__slider"
        data-slider
        data-desktop="{{ section.settings.desktop_columns }}"
        data-mobile="{{ section.settings.mobile_columns }}"
      >
        <div class="jd-testimonials__track" data-track>

          {% for block in section.blocks %}
            {% assign testimonial_image = block.settings.image %}
            {% assign testimonial_alt = testimonial_image.alt | default: block.settings.customer_name | default: 'TOOSA customer workshop' | escape %}

            <article
              class="jd-testimonial-card"
              data-slide
              {{ block.shopify_attributes }}
            >

              <div class="jd-testimonial-card__media">

                {% if block.type == 'image' %}

                  {% if testimonial_image != blank %}
                    <button
                      type="button"
                      class="jd-testimonial-card__media-button"
                      data-open-image
                      data-image="{{ testimonial_image | image_url: width: 1800 }}"
                      data-alt="{{ testimonial_image.alt | escape }}"
                      aria-label="View testimonial image"
                    >
                      {{
                        testimonial_image
                        | image_url: width: 1000
                        | image_tag:
                          loading: 'lazy',
                          widths: '400, 600, 800, 1000',
                          sizes: '(max-width: 749px) 85vw, 33vw',
                          class: 'jd-testimonial-card__image',
                          alt: testimonial_alt
                      }}

                      <span class="jd-testimonial-card__zoom" aria-hidden="true">
                        +
                      </span>
                    </button>
                  {% else %}
                    <div class="jd-testimonial-card__placeholder">
                      Add testimonial image
                    </div>
                  {% endif %}

                {% elsif block.type == 'video' %}

                  {% if testimonial_image != blank %}
                    <button
                      type="button"
                      class="jd-testimonial-card__media-button"
                      data-open-video
                      data-video-id="{{ block.id }}"
                      aria-label="Play testimonial video"
                    >
                      {{
                        testimonial_image
                        | image_url: width: 1000
                        | image_tag:
                          loading: 'lazy',
                          widths: '400, 600, 800, 1000',
                          sizes: '(max-width: 749px) 85vw, 33vw',
                          class: 'jd-testimonial-card__image',
                          alt: testimonial_alt
                      }}

                      <span class="jd-testimonial-card__play" aria-hidden="true">
                        <span></span>
                      </span>
                    </button>
                  {% else %}
                    <button
                      type="button"
                      class="jd-testimonial-card__media-button jd-testimonial-card__media-button--plain"
                      data-open-video
                      data-video-id="{{ block.id }}"
                      aria-label="Play testimonial video"
                    >
                      <span class="jd-testimonial-card__play">
                        <span></span>
                      </span>
                    </button>
                  {% endif %}

                  {% if block.settings.video != blank %}
                    <template id="jd-video-template-{{ block.id }}">
                      <video
                        controls
                        playsinline
                        preload="none"
                        class="jd-testimonial-video"
                      >
                        {% for source in block.settings.video.sources %}
                          <source
                            src="{{ source.url }}"
                            type="{{ source.mime_type }}"
                          >
                        {% endfor %}
                      </video>
                    </template>
                  {% endif %}

                {% endif %}

              </div>

              <div class="jd-testimonial-card__content">

                {% if block.settings.rating > 0 %}
                  <div
                    class="jd-testimonial-card__rating"
                    aria-label="{{ block.settings.rating }} out of 5 stars"
                  >
                    {% for i in (1..5) %}
                      <span class="{% if i <= block.settings.rating %}is-active{% endif %}">
                        ★
                      </span>
                    {% endfor %}
                  </div>
                {% endif %}

                {% if block.settings.review != blank %}
                  <div class="jd-testimonial-card__review">
                    {{ block.settings.review }}
                  </div>
                {% endif %}

                {% if block.settings.customer_name != blank %}
                  <div class="jd-testimonial-card__name">
                    {{ block.settings.customer_name }}
                  </div>
                {% endif %}

              </div>

            </article>
          {% endfor %}

        </div>
      </div>

      {% if section.blocks.size > section.settings.desktop_columns %}
        <button
          type="button"
          class="jd-slider-arrow jd-slider-arrow--prev"
          data-prev
          aria-label="Previous testimonials"
        >
          ‹
        </button>

        <button
          type="button"
          class="jd-slider-arrow jd-slider-arrow--next"
          data-next
          aria-label="Next testimonials"
        >
          ›
        </button>
      {% endif %}

    </div>

    {% if section.settings.show_dots %}
      <div class="jd-testimonials__dots" data-dots></div>
    {% endif %}

  </div>
</section>

<!-- Popup -->
<div
  class="jd-testimonial-modal"
  data-modal
  aria-hidden="true"
>
  <div class="jd-testimonial-modal__overlay" data-close-modal></div>

  <div
    class="jd-testimonial-modal__content"
    role="dialog"
    aria-modal="true"
    aria-label="Testimonial"
  >
    <button
      type="button"
      class="jd-testimonial-modal__close"
      data-close-modal
      aria-label="Close"
    >
      ×
    </button>

    <div class="jd-testimonial-modal__body" data-modal-body></div>
  </div>
</div>

<style>
