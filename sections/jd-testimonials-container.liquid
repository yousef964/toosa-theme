<script>
(function() {
  const section = document.getElementById('{{ section_id }}');
  if (!section) return;

  const slider = section.querySelector('[data-slider]');
  const track = section.querySelector('[data-track]');
  const slides = Array.from(section.querySelectorAll('[data-slide]'));
  const prev = section.querySelector('[data-prev]');
  const next = section.querySelector('[data-next]');
  const dotsContainer = section.querySelector('[data-dots]');

  const modal = document.querySelector('.jd-testimonial-modal');
  const modalBody = modal.querySelector('[data-modal-body]');
  const closeButtons = modal.querySelectorAll('[data-close-modal]');

  let currentIndex = 0;

  function getColumns() {
    return window.innerWidth <= 749
      ? Number(slider.dataset.mobile)
      : Number(slider.dataset.desktop);
  }

  function getMaxIndex() {
    return Math.max(0, slides.length - getColumns());
  }

  function updateSlider() {
    if (!slides.length) return;

    const columns = getColumns();
    const gap = window.innerWidth <= 749 ? 14 : {{ section.settings.card_gap }};
    const slideWidth = (slider.clientWidth - ((columns - 1) * gap)) / columns;

    currentIndex = Math.min(currentIndex, getMaxIndex());

    track.style.transform =
      'translateX(-' + (currentIndex * (slideWidth + gap)) + 'px)';

    updateDots();
  }

  function createDots() {
    if (!dotsContainer) return;

    dotsContainer.innerHTML = '';

    const total = getMaxIndex() + 1;

    for (let i = 0; i < total; i++) {
      const dot = document.createElement('button');

      dot.type = 'button';
      dot.className = 'jd-testimonials__dot';

      dot.setAttribute('aria-label', 'Go to testimonial ' + (i + 1));

      dot.addEventListener('click', function() {
        currentIndex = i;
        updateSlider();
      });

      dotsContainer.appendChild(dot);
    }

    updateDots();
  }

  function updateDots() {
    if (!dotsContainer) return;

    Array.from(dotsContainer.children).forEach(function(dot, index) {
      dot.classList.toggle('is-active', index === currentIndex);
    });
  }

if (prev) {
  prev.addEventListener('click', function() {
    const columns = getColumns();

    currentIndex = Math.max(
      0,
      currentIndex - columns
    );

    updateSlider();
  });
}

  if (next) {
  next.addEventListener('click', function() {
    const columns = getColumns();

    currentIndex = Math.min(
      getMaxIndex(),
      currentIndex + columns
    );

    updateSlider();
  });
}

  function openModal(content) {
    modalBody.innerHTML = '';
    modalBody.appendChild(content);
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('jd-testimonial-modal-open');
  }

  function closeModal() {
    const video = modalBody.querySelector('video');

    if (video) {
      video.pause();
      video.removeAttribute('src');

      video.querySelectorAll('source').forEach(function(source) {
        source.removeAttribute('src');
      });

      video.load();
    }

    modalBody.innerHTML = '';
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('jd-testimonial-modal-open');
  }

  section.querySelectorAll('[data-open-image]').forEach(function(button) {
    button.addEventListener('click', function() {
      const img = document.createElement('img');

      img.src = button.dataset.image;
      img.alt = button.dataset.alt || 'Customer testimonial';

      openModal(img);
    });
  });

  section.querySelectorAll('[data-open-video]').forEach(function(button) {
    button.addEventListener('click', function() {
      const template = document.getElementById(
        'jd-video-template-' + button.dataset.videoId
      );

      if (!template) return;

      const video = template.content.firstElementChild.cloneNode(true);

      /*
        Video source is only inserted into the live DOM after
        the user clicks, preventing initial video loading.
      */

      openModal(video);

      video.play().catch(function() {});
    });
  });

  closeButtons.forEach(function(button) {
    button.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape' && modal.classList.contains('is-open')) {
      closeModal();
    }
  });

  let resizeTimer;

  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);

    resizeTimer = setTimeout(function() {
      createDots();
      updateSlider();
    }, 150);
  });

  createDots();
  updateSlider();
})();
</script>

{% schema %}
{
  "name": "JD Testimonial Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Real experiences from our customers.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop testimonials",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile testimonials",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card spacing",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show slider dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#F5A623"
