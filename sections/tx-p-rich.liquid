{% comment %} TOOSA inner pages: reading column for page content or custom rich text, with optional sticky in-page nav {% endcomment %}
{%- liquid
  assign s = section.settings
  assign theme_class = 'txp txp--light'
  if s.theme == 'paper'
    assign theme_class = 'txp txp--paper'
  endif
  assign body = s.text
  if body == blank and s.use_page
    assign body = page.content
  endif
-%}
<section class="{{ theme_class }} txp-section txp-rich" id="txp-rich-{{ section.id }}">
  <div class="txp-wrap {% if section.blocks.size > 0 %}txp-faq-layout{% else %}txp-wrap--read{% endif %}">
    {%- if section.blocks.size > 0 -%}
      <div class="txp-faq__side">
        <div>
          {%- if s.eyebrow != blank -%}<p class="txp-eyebrow txp-reveal">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="txp-h2 txp-h2--sm txp-reveal" data-delay="1">{{ s.heading }}</h2>{%- endif -%}
        </div>
        <nav class="txp-faq__nav txp-reveal" data-delay="2" aria-label="On this page" data-txp-pagenav>
          {%- for block in section.blocks -%}<a href="#sec-{{ block.id }}">{{ block.settings.title }}</a>{%- endfor -%}
        </nav>
        {%- if s.help_title != blank -%}
          <div class="txp-faq__help txp-reveal" data-delay="3">
            <h3 class="txp-h4">{{ s.help_title }}</h3>
            {%- if s.help_text != blank -%}<p>{{ s.help_text }}</p>{%- endif -%}
            {%- if s.help_btn != blank -%}<a class="txp-btn txp-btn--primary txp-btn--sm" href="{{ s.help_url }}">{{ s.help_btn }}{% render 'tx-p-icon', name: 'arrow' %}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
      <div class="txp-reveal" data-delay="1">
        {%- for block in section.blocks -%}
          <div class="txp-faq__group" id="sec-{{ block.id }}" {{ block.shopify_attributes }}>
            <h3 class="txp-h3">{{ block.settings.title }}</h3>
            <div class="txp-rt">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- if s.show_title -%}<h1 class="txp-h1 txp-reveal">{{ page.title }}</h1>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="txp-h2 txp-h2--sm txp-reveal" style="margin-bottom: 20px;">{{ s.heading }}</h2>{%- endif -%}
      {%- if body != blank -%}<div class="txp-rt txp-reveal" data-delay="1">{{ body }}</div>{%- endif -%}
      {%- if s.meta != blank -%}<p class="txp-rich__meta">{{ s.meta }}</p>{%- endif -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "TX Reading column",
  "settings": [
    { "type": "select", "id": "theme", "label": "Colour", "default": "light", "options": [
      { "value": "light", "label": "White" }, { "value": "paper", "label": "Paper" } ] },
    { "type": "checkbox", "id": "show_title", "label": "Show the page title as H1", "default": false },
    { "type": "checkbox", "id": "use_page", "label": "Use the page content when the text below is empty", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (with sections)" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "meta", "label": "Small note under the text" },
    { "type": "text", "id": "help_title", "label": "Help box title" },
    { "type": "text", "id": "help_text", "label": "Help box text" },
    { "type": "text", "id": "help_btn", "label": "Help box button" },
    { "type": "url", "id": "help_url", "label": "Help box link" }
  ],
  "blocks": [
    { "type": "section", "name": "Section", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "text", "label": "Text" } ] }
  ],
  "presets": [ { "name": "TX Reading column" } ]
}
{% endschema %}
