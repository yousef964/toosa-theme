
{% comment %}
  Financing Product Slider
  Compatible with Shopify Refine Theme
  Responsive product carousel with per-product pricing controls
{% endcomment %}

<section
  id="FinancingProductSlider-{{ section.id }}"
  class="fps-section"
  data-fps-section="{{ section.id }}"
>
  <div class="fps-container">

    <!-- LEFT CONTENT -->
    <div class="fps-content">

      {% if section.settings.eyebrow != blank %}
        <div class="fps-eyebrow">
          <span class="fps-eyebrow-line"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="fps-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="fps-description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="fps-main-button"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}

    </div>

    <!-- RIGHT PRODUCT AREA -->
    <div class="fps-products-area">

      <div class="fps-products-header">

        {% if section.settings.products_heading != blank %}
          <h3 class="fps-products-heading">
            {{ section.settings.products_heading | escape }}
          </h3>
        {% endif %}

        <div class="fps-navigation">
          <button
            type="button"
            class="fps-arrow fps-prev"
            aria-label="Previous products"
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>

          <button
            type="button"
            class="fps-arrow fps-next"
            aria-label="Next products"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>

      </div>

      <div class="fps-slider">
        <div class="fps-track">

          {% for block in section.blocks %}

            {% assign selected_product = block.settings.product %}

            {% if selected_product != blank %}

              {% assign current_price = selected_product.price %}

              {% if block.settings.custom_price != blank %}
                {% assign current_price = block.settings.custom_price | times: 100 | round %}
              {% endif %}

              {% assign compare_price = selected_product.compare_at_price %}

              {% if block.settings.custom_compare_price != blank %}
                {% assign compare_price = block.settings.custom_compare_price | times: 100 | round %}
              {% endif %}

              {% assign financing_months = block.settings.months | default: 24 %}

              {% assign monthly_price = current_price | divided_by: financing_months %}

              <article
                class="fps-product"
                {{ block.shopify_attributes }}
              >

                <!-- PRODUCT IMAGE -->
                <a
                  class="fps-image-link"
                  href="{{ selected_product.url }}"
                  aria-label="{{ selected_product.title | escape }}"
                >

                  <div class="fps-image">

                    {% if block.settings.custom_image != blank %}

                      {{
                        block.settings.custom_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 450, 600, 900',
                          alt: selected_product.title
                      }}

                    {% elsif selected_product.featured_image != blank %}

                      {{
                        selected_product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 450, 600, 900',
                          alt: selected_product.title
                      }}

                    {% else %}

                      {{ 'product-1' | placeholder_svg_tag: 'fps-placeholder' }}

                    {% endif %}

                  </div>

                </a>

                <!-- PRODUCT INFORMATION -->
                <div class="fps-product-info">

                  <a
                    class="fps-product-title"
                    href="{{ selected_product.url }}"
                  >
                    {{ selected_product.title | escape }}
                  </a>

                  <div class="fps-price-row">

                    <span class="fps-monthly-price">
                      {{ monthly_price | money }}
                    </span>

                    <span class="fps-monthly-label">
                      /mo
                    </span>

                  </div>

                  <div class="fps-price-details">

                    {% if compare_price > current_price and current_price > 0 %}
                      <span class="fps-compare-price">
                        {{ compare_price | money }}
                      </span>
                    {% endif %}

                    <span class="fps-term">
                      over {{ financing_months }} months
                    </span>

                    <span class="fps-separator">·</span>

                    <span class="fps-total-price">
                      {{ current_price | money }}
                    </span>

                  </div>

                </div>

              </article>

            {% elsif request.design_mode %}

              <div class="fps-empty-product">
                Select a product in this block to display it here.
              </div>

            {% endif %}

          {% endfor %}

        </div>
      </div>

    </div>

  </div>
</section>

<style>
  #FinancingProductSlider-{{ section.id }} {
    --fps-bg: {{ section.settings.background_color }};
    --fps-text: {{ section.settings.text_color }};
    --fps-accent: {{ section.settings.accent_color }};
    --fps-card-bg: {{ section.settings.card_background }};
    --fps-border: {{ section.settings.border_color }};
    --fps-image-bg: {{ section.settings.image_background }};

    background: var(--fps-bg);
    color: var(--fps-text);
    width: 100%;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #FinancingProductSlider-{{ section.id }} *,
  #FinancingProductSlider-{{ section.id }} *::before,
  #FinancingProductSlider-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #FinancingProductSlider-{{ section.id }} .fps-container {
    width: 100%;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    {% comment %} padding-left: 4%;
    padding-right: 4%; {% endcomment %}
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: center;
    gap: 5%;
  }

  /* LEFT CONTENT */

  #FinancingProductSlider-{{ section.id }} .fps-content {
    min-width: 0;
  }

  #FinancingProductSlider-{{ section.id }} .fps-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    color: var(--fps-accent);
    font-size: 16px;
    text-transform: uppercase;
  }

  #FinancingProductSlider-{{ section.id }} .fps-eyebrow-line {
    display: block;
    width: 24px;
    height: 2px;
    flex-shrink: 0;
    background: var(--fps-accent);
  }

  #FinancingProductSlider-{{ section.id }} .fps-heading {
    margin: 0 0 20px;
    color: var(--fps-text);
    font-size: 36px;
    font-weight: 600;
  }

  #FinancingProductSlider-{{ section.id }} .fps-description {
    color: var(--fps-text);
    font-size: 18px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-description p {
    margin: 0 0 12px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-description p:last-child {
    margin-bottom: 0;
  }

  #FinancingProductSlider-{{ section.id }} .fps-main-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 34px;
    padding: 12px 22px;
    background: var(--fps-accent);
    color: #ffffff;
    text-decoration: none;
    font-size: 16px;
    border: 1px solid var(--fps-accent);
  }

  #FinancingProductSlider-{{ section.id }} .fps-main-button:hover {
    background: transparent;
    color: var(--fps-accent);
  }

  /* PRODUCT HEADER */

  #FinancingProductSlider-{{ section.id }} .fps-products-area {
    min-width: 0;
    width: 100%;
  }

  #FinancingProductSlider-{{ section.id }} .fps-products-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-products-heading {
    margin: 0;
    color: var(--fps-text);
    font-size: 20px;
    font-weight: 500;
  }

  #FinancingProductSlider-{{ section.id }} .fps-navigation {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  #FinancingProductSlider-{{ section.id }} .fps-arrow {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--fps-border);
    background: transparent;
    color: var(--fps-text);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  #FinancingProductSlider-{{ section.id }} .fps-arrow svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #FinancingProductSlider-{{ section.id }} .fps-arrow:hover:not(:disabled) {
    background: var(--fps-accent);
    border-color: var(--fps-accent);
    color: #ffffff;
  }

  #FinancingProductSlider-{{ section.id }} .fps-arrow:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* CAROUSEL */

  #FinancingProductSlider-{{ section.id }} .fps-slider {
    width: 100%;
    overflow: hidden;
  }

  #FinancingProductSlider-{{ section.id }} .fps-track {
    display: flex;
    gap: 20px;
    align-items: stretch;
    transition: transform 0.45s ease;
    will-change: transform;
  }

  #FinancingProductSlider-{{ section.id }} .fps-product {
    flex: 0 0 calc((100% - 20px) / 2);
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--fps-card-bg);
    border: 1px solid var(--fps-border);
  }

  /* PRODUCT IMAGE */

  #FinancingProductSlider-{{ section.id }} .fps-image-link {
    display: block;
    width: 100%;
    text-decoration: none;
  }

  #FinancingProductSlider-{{ section.id }} .fps-image {
    position: relative;
    width: 100%;
    height: {{ section.settings.image_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--fps-image-bg);
  }

  #FinancingProductSlider-{{ section.id }} .fps-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.35s ease;
  }

  #FinancingProductSlider-{{ section.id }} .fps-product:hover .fps-image img {
    transform: scale(1.035);
  }

  #FinancingProductSlider-{{ section.id }} .fps-placeholder {
    width: 70%;
    height: 70%;
    opacity: 0.5;
  }

  /* PRODUCT INFO */

  #FinancingProductSlider-{{ section.id }} .fps-product-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 24px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-product-title {
    display: block;
    min-height: 60px;
    margin: 0 0 18px;
    color: var(--fps-text);
    font-size: 18px;
    font-weight: 500;
    text-decoration: none;
  }

  #FinancingProductSlider-{{ section.id }} .fps-product-title:hover {
    color: var(--fps-accent);
  }

  #FinancingProductSlider-{{ section.id }} .fps-price-row {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin-bottom: 12px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-monthly-price {
    color: var(--fps-accent);
    font-size: 18px;
    font-weight: 500;
  }

  #FinancingProductSlider-{{ section.id }} .fps-monthly-label {
    color: var(--fps-text);
    font-size: 18px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-price-details {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 5px;
    color: var(--fps-text);
    font-size: 16px;
    line-height: 1.5;
  }

  #FinancingProductSlider-{{ section.id }} .fps-compare-price {
    margin-right: 4px;
    opacity: 0.65;
    text-decoration: line-through;
  }

  #FinancingProductSlider-{{ section.id }} .fps-separator {
    opacity: 0.7;
  }

  #FinancingProductSlider-{{ section.id }} .fps-empty-product {
    flex: 0 0 100%;
    padding: 40px;
    border: 1px dashed var(--fps-border);
    color: var(--fps-text);
    text-align: center;
  }

  /* TABLET */

  @media screen and (max-width: 1100px) {
    #FinancingProductSlider-{{ section.id }} .fps-container {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 30px;
    }
    #FinancingProductSlider-{{ section.id }} .fps-product-info {
      padding: 20px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-image {
      height: 220px;
    }
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {
    #FinancingProductSlider-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-container {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 42px;
      padding-left: 20px;
      padding-right: 20px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-content {
      width: 100%;
    }

    #FinancingProductSlider-{{ section.id }} .fps-eyebrow {
      margin-bottom: 14px;
      font-size: 14px;
      gap: 10px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-eyebrow-line {
      width: 16px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-heading {
      margin-bottom: 14px;
      font-size: 28px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-description {
      font-size: 16px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-main-button {
      margin-top: 20px;
      padding: 10px 12px;
      font-size: 14px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-products-area {
      width: 100%;
    }

    #FinancingProductSlider-{{ section.id }} .fps-products-header {
      margin-bottom: 16px;
      gap: 12px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-products-heading {
      font-size: 16px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-navigation {
      gap: 7px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-arrow {
      width: 42px;
      height: 42px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-arrow svg {
      width: 18px;
      height: 18px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-track {
      gap: 14px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-product {
      flex-basis: 100%;
    }

    #FinancingProductSlider-{{ section.id }} .fps-image {
      height: {{ section.settings.mobile_image_height }}px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-product-info {
      padding: 20px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-product-title {
      min-height: 0;
      margin-bottom: 16px;
      font-size: 16px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-monthly-price {
      font-size: 16px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-monthly-label {
      font-size: 14px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-price-details {
      font-size: 14px;
      gap: 4px;
    }
  }



  @media (prefers-reduced-motion: reduce) {
    #FinancingProductSlider-{{ section.id }} .fps-track,
    #FinancingProductSlider-{{ section.id }} .fps-image img {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    'use strict';

    var sectionId = 'FinancingProductSlider-{{ section.id }}';

    function initFinancingSlider() {
      var section = document.getElementById(sectionId);

      if (!section || section.dataset.fpsInitialized === 'true') {
        return;
      }

      section.dataset.fpsInitialized = 'true';

      var slider = section.querySelector('.fps-slider');
      var track = section.querySelector('.fps-track');
      var prevButton = section.querySelector('.fps-prev');
      var nextButton = section.querySelector('.fps-next');

      if (!slider || !track || !prevButton || !nextButton) {
        return;
      }

      var cards = Array.prototype.slice.call(
        track.querySelectorAll('.fps-product')
      );

      var currentIndex = 0;

      if (!cards.length) {
        prevButton.disabled = true;
        nextButton.disabled = true;
        return;
      }

      function getVisibleCards() {
        if (window.matchMedia('(max-width: 749px)').matches) {
          return 1;
        }

        return 2;
      }

      function getMaxIndex() {
        return Math.max(0, cards.length - getVisibleCards());
      }

      function updateSlider() {
        var visibleCards = getVisibleCards();
        var gap = parseFloat(window.getComputedStyle(track).gap) || 0;
        var cardWidth = cards[0].getBoundingClientRect().width;
        var offset = currentIndex * (cardWidth + gap);

        track.style.transform = 'translate3d(-' + offset + 'px, 0, 0)';

        prevButton.disabled = currentIndex <= 0;
        nextButton.disabled = currentIndex >= getMaxIndex();

        prevButton.setAttribute(
          'aria-disabled',
          currentIndex <= 0 ? 'true' : 'false'
        );

        nextButton.setAttribute(
          'aria-disabled',
          currentIndex >= getMaxIndex() ? 'true' : 'false'
        );
      }

      prevButton.addEventListener('click', function () {
        if (currentIndex > 0) {
          currentIndex--;
          updateSlider();
        }
      });

      nextButton.addEventListener('click', function () {
        if (currentIndex < getMaxIndex()) {
          currentIndex++;
          updateSlider();
        }
      });

      var resizeTimer;

      window.addEventListener('resize', function () {
        window.clearTimeout(resizeTimer);

        resizeTimer = window.setTimeout(function () {
          currentIndex = Math.min(currentIndex, getMaxIndex());
          updateSlider();
        }, 120);
      });

      updateSlider();

      if ('ResizeObserver' in window) {
        var resizeObserver = new ResizeObserver(function () {
          updateSlider();
        });

        resizeObserver.observe(slider);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFinancingSlider);
    } else {
      initFinancingSlider();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target && event.target.querySelector('#' + sectionId)) {
        var section = document.getElementById(sectionId);

        if (section) {
          section.dataset.fpsInitialized = 'false';
        }

        initFinancingSlider();
      }
    });

  })();
</script>

{% schema %}
{
  "name": "Financing product slider1",
  "tag": "section",
  "class": "financing-product-slider",
  "settings": [
    {
      "type": "header",
      "content": "Left content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "FINANCING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Own it now. Pay monthly."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>TOOSA has partnered with RBC to offer simple monthly payment plans on tool storage and compressors.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Buy now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Product area"
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Product area heading",
      "default": "Available financing"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#FF5938"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Product card background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Product image background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#292929"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Maximum content width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1800
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Desktop image height",
       "min": 100,
  "max": 500,
  "step": 50,
  "unit": "px",
  "default": 300
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
       "min": 100,
  "max": 500,
  "step": 50,
  "unit": "px",
  "default": 300
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Financing product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom product image",
          "info": "Optional. Leave blank to use the selected product's featured image."
        },
        {
          "type": "text",
