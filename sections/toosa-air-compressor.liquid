{% liquid
  assign section_id = 'toosa-air-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="toosa-air-section"
>
  <div class="toosa-air-section__container">

    <div class="toosa-air-section__content">

      {% if section.settings.eyebrow != blank %}
        <div class="toosa-air-section__eyebrow">
          <span class="toosa-air-section__eyebrow-line"></span>
          <span>{{ section.settings.eyebrow }}</span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="toosa-air-section__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="toosa-air-section__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="toosa-air-section__button"
        >
          <span>{{ section.settings.button_text }}</span>
          <span class="toosa-air-section__button-arrow" aria-hidden="true">→</span>
        </a>
      {% endif %}

    </div>


    <div class="toosa-air-section__features">

      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div
            class="toosa-air-section__feature"
            {{ block.shopify_attributes }}
          >
            <span class="toosa-air-section__bullet" aria-hidden="true"></span>

            <div class="toosa-air-section__feature-text">
              {% if block.settings.title != blank %}
                <strong>{{ block.settings.title }}</strong>
              {% endif %}

              {% if block.settings.description != blank %}
                <span class="toosa-air-section__feature-description">
                  {{ block.settings.description }}
                </span>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}

    </div>

  </div>
</section>


<style>
  #{{ section_id }} {
    --toosa-bg: {{ section.settings.background_color }};
    --toosa-heading: {{ section.settings.heading_color }};
    --toosa-text: {{ section.settings.text_color }};
    --toosa-accent: {{ section.settings.accent_color }};
    --toosa-feature-title: {{ section.settings.feature_title_color }};
    --toosa-max-width: {{ section.settings.max_width }}px;
    --toosa-padding-top: {{ section.settings.padding_top }}px;
    --toosa-padding-bottom: {{ section.settings.padding_bottom }}px;

    width: 100%;
    background: var(--toosa-bg);
    color: var(--toosa-text);
    box-sizing: border-box;
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .toosa-air-section__container {
    width: min(100% - 80px, var(--toosa-max-width));
    margin: 0 auto;
    padding: var(--toosa-padding-top) 0px var(--toosa-padding-bottom);

    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    column-gap: 70px;
    align-items: start;
  }

  /* LEFT SIDE */

  #{{ section_id }} .toosa-air-section__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;

    margin: 0 0 13px;
 font-size: 16px;
    color: var(--toosa-accent);
    {% comment %}
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 1.35px; {% endcomment %}
    text-transform: uppercase;
  }

  #{{ section_id }} .toosa-air-section__eyebrow-line {
    width: 20px;
    height: 2px;
    flex: 0 0 20px;
    background: var(--toosa-accent);
  }

  #{{ section_id }} .toosa-air-section__heading {
    margin: 0 0 3px;
font-size: 36px;
    color: var(--toosa-heading);
    {% comment %} 
    line-height: 1.22;
    font-weight: 700;
    letter-spacing: -0.45px; {% endcomment %}
  }

  #{{ section_id }} .toosa-air-section__description {
    max-width: 520px;

    margin: 0;
 font-size: 18px;
    color: var(--toosa-text);
    {% comment %}
    line-height: 1.62;
    font-weight: 400; {% endcomment %}
  }

  #{{ section_id }} .toosa-air-section__description p {
    margin: 0;
  }

  #{{ section_id }} .toosa-air-section__description p + p {
    margin-top: 8px;
  }

  #{{ section_id }} .toosa-air-section__button {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    margin-top: 22px;

    color: var(--toosa-accent);
    text-decoration: none;

    {% comment %} font-size: 12px;
    line-height: 1.4;
    font-weight: 700; {% endcomment %}

    transition:
      color 0.2s ease,
      gap 0.2s ease;
  }

  #{{ section_id }} .toosa-air-section__button:hover {
    color: var(--toosa-accent);
    gap: 9px;
  }

  #{{ section_id }} .toosa-air-section__button-arrow {
    {% comment %} font-size: 16px;
    line-height: 1; {% endcomment %}
    transform: translateY(-1px);
  }


  /* RIGHT SIDE */

  #{{ section_id }} .toosa-air-section__features {
    display: flex;
    flex-direction: column;
    gap: 13px;

    padding-top: 3px;
  }

  #{{ section_id }} .toosa-air-section__feature {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr);
    column-gap: 9px;
    align-items: start;
  }

  #{{ section_id }} .toosa-air-section__bullet {
    width: 5px;
    height: 5px;

    margin-top: 10px;

    background: var(--toosa-accent);
    transform: rotate(45deg);
  }

  #{{ section_id }} .toosa-air-section__feature-text {
    min-width: 0;
{% comment %} 
    font-size: 12px;
    line-height: 1.5; {% endcomment %}
  }

  #{{ section_id }} .toosa-air-section__feature-text strong {
    color: var(--toosa-feature-title);
    {% comment %} font-weight: 700; {% endcomment %}
  }

  #{{ section_id }} .toosa-air-section__feature-description {
    color: var(--toosa-text);
    {% comment %} font-weight: 400; {% endcomment %}
  }


  /* LARGE TABLETS */

  @media screen and (max-width: 900px) {
    #{{ section_id }} .toosa-air-section__container {
      grid-template-columns: minmax(0, 1fr) minmax(270px, 0.85fr);
      column-gap: 45px;
    }

  
  }


  /* TABLET */

  @media screen and (max-width: 749px) {
    #{{ section_id }} .toosa-air-section__container {
      display: block;
        width: min(100% - 40px, var(--toosa-max-width));
    margin: 0 auto;
      padding-left: 10px;
      padding-right: 10px;
    }

    #{{ section_id }} .toosa-air-section__description {
      max-width: 650px;
    }

    #{{ section_id }} .toosa-air-section__features {
      margin-top: 30px;
      padding-top: 0;
    }
    
  }


  /* MOBILE */

  @media screen and (max-width: 767px) {


    #{{ section_id }} .toosa-air-section__eyebrow {
      margin-bottom: 12px;
      font-size: 14px;
      {% comment %}
      letter-spacing: 1.15px; {% endcomment %}
      gap: 8px;
    }

    #{{ section_id }} .toosa-air-section__eyebrow-line {
      width: 18px;
      flex-basis: 18px;
    }

    #{{ section_id }} .toosa-air-section__heading {
      font-size: 28px;
       {% comment %}line-height: 1.2;
      letter-spacing: -0.3px; {% endcomment %}
      margin-bottom: 6px;
    }

   #{{ section_id }} .toosa-air-section__description {
      font-size: 16px;
    
    } 

    #{{ section_id }} .toosa-air-section__button {
      margin-top: 19px;
      {% comment %} font-size: 12px; {% endcomment %}
    }

    #{{ section_id }} .toosa-air-section__features {
      gap: 14px;
      margin-top: 28px;
    }

    #{{ section_id }} .toosa-air-section__feature {
      grid-template-columns: 8px minmax(0, 1fr);
      column-gap: 8px;
    }

    {% comment %} #{{ section_id }} .toosa-air-section__feature-text {
      font-size: 12px;
      line-height: 1.52;
    } {% endcomment %}
  }

</style>


{% schema %}
{
  "name": "TOOSA Air Compressor",
  "tag": "section",
  "class": "section-toosa-air",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ONE SUPPLIER FOR THE WHOLE SHOP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TOOSA does the air, too"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>The person building out a garage or shop is the same person who needs shop air. TOOSA can outfit the whole workshop — storage, foam, lighting, engraving and a compressor — from one place, with one point of support and one financing plan.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "See the TOOSA Air Compressor"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1D2A38"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#F1F3F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#AEB9C4"
    },
    {
      "type": "color",
      "id": "feature_title_color",
      "label": "Feature title",
      "default": "#F1F3F5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Orange",
      "default": "#FF6638"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 65
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 65
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quiet, continuous shop air"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": " — a rotary-screw compressor with a built-in dryer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TOOSA Air Compressor",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Quiet, continuous shop air",
            "description": " — a rotary-screw compressor with a built-in dryer"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Buy once",
            "description": " — sized to grow with the business, not be replaced in two years"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Pay monthly with RBC",
            "description": " — the same financing as the tool storage"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Canadian support",
            "description": " — sizing help before you buy, parts after"
          }
        }
      ]
    }
  ]
}
{% endschema %}
