
{% style %}
#shopify-section-{{ section.id }} {
  
  {% if section.settings.gap %}
    --theme-image-with-text-gap: var(--theme-gap-{{ section.settings.gap_choice }});
    {% else %}
      --theme-image-with-text-gap: 0px;
  {% endif %}

  {% unless section.settings.fullwidth %}
    --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
  {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}

}
{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }}{
    --theme-image-with-text-image-width: {{ section.settings.image_content_width_split | append: '%' }};
    --theme-image-with-text-image-aspect-ratio: {{ section.settings.image_aspect_ratio }};

    --theme-image-with-text-content-width: calc(100% - {{ section.settings.image_content_width_split | append: '%' }});


    {% if section.settings.content_custom_width %}
      --theme-image-with-text-content-inner-width: {{ section.settings.content_width | append: 'px' }};
    {% endif %}

    {% if section.settings.content_gap %}
    --theme-image-with-text-content-gap: var(--theme-gap-{{ section.settings.content_gap_choice }})
    {% endif %}
    

}
{% endstyle %}

{% for block in section.blocks %}
  {% if block.type == 'image' %}
    {% style %}
      #shopify-section-{{ section.id }} .block-{{ block.id }}{
        
        {% if block.settings.image_custom_width %}
          --theme-image-with-text-content-image-width: {{ block.settings.image_width | append: 'px' }};
        {% endif %}

        --theme-image-with-text-content-image-radius: {{ block.settings.image_radius | append: 'px' }};
        --theme-image-with-text-content-image-aspect-ratio: {{ block.settings.image_aspect_ratio }};

      }
    {% endstyle %}
  {% endif %}

  {% if block.type == 'text' or block.type == 'richtext' or block.type == 'heading' or block.type == 'special-heading' %}
    {% style %}
      #shopify-section-{{ section.id }} .block-{{ block.id }}{

        {% if block.settings.text_custom_width %}
          --theme-image-with-text-content-text-width: {{ block.settings.text_width | append: 'px' }};
        {% endif %}

      }
    {% endstyle %}
  {% endif %}
{% endfor %}


{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-image-with-text{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif

  echo ' has-placement-style-' | append: section.settings.image_content_placement

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif
  
%}">
<div class="section-image-with-text-container section-container">
  <div class="section-image-with-text-media">
        {% liquid 
          if section.settings.video != blank
            echo section.settings.video | video_tag: controls: false, autoplay: true, muted: true, loop: true
          elsif section.settings.image != blank
            render 'section-image-processor', image: section.settings.image
          else 
            echo 'image' | placeholder_svg_tag: 'placeholder placeholder-image-with-text'
          endif
        %}
  </div>
  {% if section.blocks != blank %}
  <div class="section-image-with-text-content{% liquid

    echo ' content-horizontal-align-' | append: section.settings.content_horizontal_align
    echo ' content-vertical-align-' | append: section.settings.content_vertical_align
    echo ' content-text-align-' | append: section.settings.content_text_align

  %}">
    <div class="section-image-with-text-content__inner">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'image' %}
          <div class="section-image-with-text-content__image block-{{ block.id }}" {{ block.shopify_attributes }}>
            {% liquid 
              if block.settings.image != blank
                render 'section-image-processor', image: block.settings.image
              else 
                echo 'image' | placeholder_svg_tag: 'placeholder placeholder-image-with-text'
              endif
            %}
          </div>
        {% when 'special-heading' %}
            <h3 class="section-image-with-text-content__special-heading special-heading-size-{{ block.settings.text_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h3>
        {% when 'heading' %}
            <h3 class="section-image-with-text-content__heading heading-size-{{ block.settings.text_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h3>
        {% when 'text' %}
            <p class="section-image-with-text-content__text paragraph-size-{{ block.settings.text_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {% when 'richtext' %}
          <div class="section-image-with-text-content__richtext block-{{ block.id }}" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {% when 'buttons' %}
          <div class="section-image-with-text-content__buttons block-{{ block.id }}" {{ block.shopify_attributes }}>
            {% if block.settings.button_1_text != blank %}
              {% render 'button', 
                  button_text: block.settings.button_1_text,  
                  button_url: block.settings.button_1_url,
                  button_style: block.settings.button_1_style,
                  button_target: block.settings.button_1_target,
                  button_classes: 'section-image-with-text-content__button'
              %}
            {% endif %}
            {% if block.settings.button_2_text != blank %}
              {% render 'button', 
                  button_text: block.settings.button_2_text,  
                  button_url: block.settings.button_2_url,
                  button_style: block.settings.button_2_style,
                  button_target: block.settings.button_2_target,
                  button_classes: 'section-image-with-text-content__button'
              %}
            {% endif %}
          </div>
      {% endcase %}
      
    {% endfor %}
  </div>
  </div>
  {% endif %}
</div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


