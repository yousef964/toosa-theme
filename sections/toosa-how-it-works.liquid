{% comment %}
  TOOSA - How It Works
  Shopify 2.0 / Refine Theme
  Fully responsive section
{% endcomment %}

<section
  id="toosa-how-it-works-{{ section.id }}"
  class="toosa-how-it-works"
>
  <div class="toosa-how-it-works__container">

    {% if section.settings.eyebrow != blank %}
      <div class="toosa-how-it-works__eyebrow">
        <span class="toosa-how-it-works__eyebrow-line"></span>
        <span>{{ section.settings.eyebrow | escape }}</span>
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="toosa-how-it-works__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="toosa-how-it-works__steps">

      {% for block in section.blocks %}
        <div
          class="toosa-how-it-works__step"
          {{ block.shopify_attributes }}
        >

          <div class="toosa-how-it-works__top-line"></div>

          <div class="toosa-how-it-works__number">
            {{ block.settings.number | escape }}
          </div>

          {% if block.settings.title != blank %}
            <h3 class="toosa-how-it-works__step-title">
              {{ block.settings.title | escape }}
            </h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="toosa-how-it-works__step-text">
              {{ block.settings.text }}
            </div>
          {% endif %}

        </div>
      {% endfor %}

    </div>
  </div>
</section>

<style>
  #toosa-how-it-works-{{ section.id }} {
    --toosa-orange: {{ section.settings.accent_color }};
    --toosa-bg: {{ section.settings.background_color }};
    --toosa-heading: {{ section.settings.heading_color }};
    --toosa-text: {{ section.settings.text_color }};

    width: 100%;
    display: block;
    background: var(--toosa-bg);
    box-sizing: border-box;
  }

  #toosa-how-it-works-{{ section.id }} *,
  #toosa-how-it-works-{{ section.id }} *::before,
  #toosa-how-it-works-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__container {
    width: 100%;
    max-width:  min(100% - 80px, 1400px);
    margin: 0 auto;
    padding: 40px 0px;
  }

  /* Eyebrow */
  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 15px;
    color: var(--toosa-orange);
     font-size: 16px;
    {% comment %} font-family: var(--font-body-family, Arial, sans-serif);
   
    font-weight: 700;
    line-height: 1;
    letter-spacing: 1.6px; {% endcomment %}
    text-transform: uppercase;
  }

  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__eyebrow-line {
    width: 20px;
    height: 2px;
    flex: 0 0 20px;
    display: block;
    background: var(--toosa-orange);
  }

  /* Main heading */
  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__heading {
    margin: 0 0 29px;
    padding: 0;
    color: var(--toosa-heading);
      font-size: 36px;
    {% comment %} font-family: var(
      --font-heading-family,
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      Arial,
      sans-serif
    );
  
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.7px; {% endcomment %}
  }

  /* Steps grid */
  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__steps {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 15px;
  }

  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__step {
    min-width: 0;
    padding: 0;
    margin: 0;
  }

  /* Orange line */
  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__top-line {
    width: 100%;
    height: 2px;
    margin: 0 0 17px;
    background: var(--toosa-orange);
  }

  /* Number */
  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__number {
    margin: 0 0 8px;
    color: var(--toosa-orange);
    {% comment %} font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 1px; {% endcomment %}
  }

  /* Step title */
  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__step-title {
    margin: 0 0 6px;
    padding: 0;
    color: var(--toosa-heading);
    font-size: 20px;
    {% comment %} font-family: var(
      --font-heading-family,
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      Arial,
      sans-serif
    );
    
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.1px; {% endcomment %}
  }

  /* Step description */
  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__step-text {
    margin: 0;
    padding: 0;
    color: var(--toosa-text);
    {% comment %} font-family: var(
      --font-body-family,
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      Arial,
      sans-serif
    );
    font-size: 12px;
    font-weight: 400;
    line-height: 1.55; {% endcomment %}
  }

  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__step-text p {
    margin: 0;
    padding: 0;
  }

  /* ================================
     TABLET
     ================================ */
  @media screen and (max-width: 749px) {

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__container {
     max-width:  min(100% - 40px, 1400px);
      padding: 60px 10px 60px;
    }

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__heading {
      {% comment %} font-size: 25px; {% endcomment %}
       font-size: 28px;
      margin-bottom: 27px;
    }

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 34px;
      column-gap: 30px;
    }
 #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__eyebrow {
  font-size: 14px;
 }
  #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__step-title {
    font-size: 18px; 
    }
  }

  /* ================================
     MOBILE
     ================================ */
  @media screen and (max-width: 480px) {

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__eyebrow {
      margin-bottom: 14px;
      {% comment %} font-size: 8px;
      letter-spacing: 1.45px; {% endcomment %}
    }

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__eyebrow-line {
      width: 19px;
      flex-basis: 19px;
    }

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__heading {
      {% comment %} font-size: 24px;
      line-height: 1.18;
      letter-spacing: -0.55px; {% endcomment %}
      margin-bottom: 28px;
    }

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__steps {
      grid-template-columns: 1fr;
      row-gap: 30px;
    }

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__top-line {
      margin-bottom: 15px;
    }

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__number {
      margin-bottom: 7px;
      {% comment %} font-size: 9px; {% endcomment %}
    }

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__step-title {
      {% comment %} font-size: 14px; {% endcomment %}
      margin-bottom: 6px;
    }

    #toosa-how-it-works-{{ section.id }} .toosa-how-it-works__step-text {
      {% comment %} font-size: 12px;
      line-height: 1.55; {% endcomment %}
      max-width: 420px;
    }
  }

</style>

{% schema %}
{
  "name": "TOOSA: How it works",
  "tag": "section",
  "class": "section-toosa-how-it-works",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HOW IT WORKS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buying a TOOSA setup"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F1F3F4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#FF5A36"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#202C3B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#66717E"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Choose or configure"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Pick a base unit and add modules. Not sure? Send us your span and we'll spec it.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TOOSA: How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Choose or configure",
            "text": "<p>Pick a base unit and add modules. Not sure? Send us your span and we'll spec it.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Free delivery or pickup",
            "text": "<p>Ships free across Canada, or collect in Richmond, Vancouver or Calgary.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Roll it in",
            "text": "<p>Bases arrive assembled where shipping allows; add-ons bolt on with basic tools.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "04",
            "title": "Backed by real support",
            "text": "<p>Talk to a person by phone or in the showroom. Parts and modules stay available.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
