

{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% if section.settings.text_1_custom_width %}
      --theme-section-text-1-width: {{ section.settings.text_1_width | append: 'px' }};
    {% endif %}

    {% if section.settings.text_2_custom_width %}
      --theme-section-text-2-width: {{ section.settings.text_2_width | append: 'px' }};
    {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-collections-links{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif
  
  echo ' has-placement-style-' | append: section.settings.collections_placement

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-collections-links-container section-container">
    {% if section.settings.text_1 != blank or section.settings.text_2 != blank or section.settings.text_3 != blank %}
      <div class="section-collections-links-header">
        <div class="section-collections-links-header__texts">

          {% if section.settings.text_2 != blank %}
            <div class="section-collections-links-header__additional-heading heading-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</div>
          {% endif %}

          {% if section.settings.text_1 != blank %}
            <h2 class="section-collections-links-header__heading special-heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
          {% endif %}

          {% if section.settings.text_3 != blank %}
            <p class="section-collections-links-header__description paragraph-size-{{ section.settings.text_3_size }}">{{ section.settings.text_3 }}</p>
          {% endif %}

        </div>
      </div>
    {% endif %}
    <div class="section-collections-links-content">
      <div class="section-collections-links-images">
        <ul class="section-collections-links-images-list">
          {% for block in section.blocks %}
            {% liquid 

              assign collection_image = block.settings.collection_image

              if collection_image == blank
                assign collection = collections[block.settings.collection_choice] 
                assign collection_image = collection.featured_image
              endif
            
            %}
            <li class="section-collections-links-images-list-item{% liquid 
              if forloop.index == 1
                echo ' active'
              endif
            %} block-{{ block.id }}" {{ block.shopify_attributes }}>
              
              <div class="section-collections-links-images-list-item__image">
                {% if collection_image != blank %}
                  {% render 'section-image-processor', image: collection_image %}
                {% else %}
                  {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder placeholder-collections-links' }}
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="section-collections-links-details">
        <ul class="section-collections-links-details-list">
          {% for block in section.blocks %}
            {% assign collection = collections[block.settings.collection_choice] %}
            <li class="section-collections-links-details-list-item{% liquid 
              if forloop.index == 1
                echo ' active'
              endif
            %}">
              {% if collection.title != blank %}
                <h2 class="section-collections-links-details-list-item__title collection-title special-heading-size-{{ section.settings.collection_title_size }}">
                  {% unless section.settings.collection_button %}
                    <a href="{{ collection.url }}">
                  {% endunless %}
                  {{ collection.title }}
                  {% unless section.settings.collection_button %}
                    </a>
                  {% endunless %}
                </h2>
                {% if section.settings.collection_button_choice != 'none' %}
                  {% liquid 
                    assign collection_text = ''
                    assign icon_choice = ''

                    if section.settings.collection_button_choice == 'text'
                      assign collection_text = 'sections.collection_links_tab.button_text' | t
                    endif

                    if section.settings.collection_button_choice == 'icon'
                      assign icon_choice = 'icon-arrow-top-right'
                    endif
                  
                  %}

                  {% render 'button', 
                    button_text: collection_text,
                    button_url: collection.url, 
                    button_style: 'outline-secondary', 
                    button_title: collection.title,
                    button_classes: 'section-collections-links-details-list-item__button',
                    icon_choice: icon_choice
                  %}
                {% endif %}
              {% else %}
                <h2 class="section-collections-links-details-list-item__title collection-title {{ section.settings.collection_title_choice }}-size-{{ section.settings.collection_title_size }}">
                  {{ 'Collection ' | append: forloop.index }}
                </h2>
                {% if section.settings.collection_button %}
                  {% assign collection_text = 'sections.collection_links_tab.button_text' | t %}
                  {% render 'button', 
                    button_text: collection_text,
                    button_url: '#', 
                    button_style: 'outline-secondary', 
                    button_title: '',
                    button_classes: 'section-collections-links-details-list-item__button'
                  %}
                {% endif %}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}



