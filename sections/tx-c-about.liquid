{% comment %} TOOSA redesign: the collection description, designed. Stays in the DOM for search engines; on phones it is capped with a CSS-only "Read more". {% endcomment %}
{%- if collection != blank and collection.description != blank -%}
<section class="txc txc-about" id="txc-about-{{ section.id }}">
  <div class="txc__wrap">
    <div class="txc-about__grid">
      <aside class="txc-about__side">
        {% if section.settings.eyebrow != blank %}<p class="txc-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 class="txc-h2">{{ section.settings.heading | default: collection.title }}</h2>
        {% if section.blocks.size > 0 %}
          <ul class="txc-about__facts">
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>
                <span class="txc-about__fact-icon" aria-hidden="true">{% render 'tx-c-icon', name: block.settings.icon %}</span>
                <span><b>{{ block.settings.title }}</b>{% if block.settings.text != blank %}<span>{{ block.settings.text }}</span>{% endif %}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if section.settings.button_text != blank %}
          <a class="txc-btn" href="{{ section.settings.button_link | default: '/pages/book-appointments' }}">{{ section.settings.button_text }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {% endif %}
      </aside>
      <div class="txc-about__body">
        <input type="checkbox" id="txc-more-{{ section.id }}" class="txc-about__toggle" aria-hidden="true" tabindex="-1">
        <div class="txc-about__rte txc-rte">{{ collection.description }}</div>
        <label for="txc-more-{{ section.id }}" class="txc-about__more"><span class="txc-about__more-open">{{ section.settings.more_text }}</span><span class="txc-about__more-close">{{ section.settings.less_text }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></label>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "TX Collection description",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About this range" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to the collection title)" },
    { "type": "text", "id": "button_text", "label": "Button", "default": "See it in the showroom" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "more_text", "label": "Read more label (phones)", "default": "Read more" },
    { "type": "text", "id": "less_text", "label": "Show less label (phones)", "default": "Show less" }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
        { "value": "steel", "label": "Steel frame" },
        { "value": "grid", "label": "Modular" },
        { "value": "wrench", "label": "Support" },
        { "value": "truck", "label": "Delivery" },
        { "value": "card", "label": "Financing" },
        { "value": "pin", "label": "Location" },
        { "value": "ul", "label": "Certification shield" },
        { "value": "foam", "label": "Foam" },
        { "value": "air", "label": "Air" },
        { "value": "check", "label": "Check" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Welded heavy-gauge steel" },
      { "type": "text", "id": "text", "label": "Text", "default": "frames welded, not bolted" }
    ] }
  ],
  "presets": [ { "name": "TX Collection description", "blocks": [
    { "type": "fact", "settings": { "icon": "steel", "title": "Welded heavy-gauge steel", "text": "frames welded, not bolted" } },
    { "type": "fact", "settings": { "icon": "grid", "title": "Modular and expandable", "text": "hutches, lockers and drawers bolt on" } },
    { "type": "fact", "settings": { "icon": "wrench", "title": "Canadian support", "text": "modules and parts in stock" } }
  ] } ]
}
{% endschema %}
