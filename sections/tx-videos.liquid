{% comment %} TOOSA redesign: compact video gallery (click to play, first six shown) {% endcomment %}
<section class="tx tx--light tx-videos" id="tx-videos-{{ section.id }}">
  <div class="tx-wrap">
    <div class="tx-videos__head">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="tx-eyebrow tx-reveal">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 class="tx-h2 tx-reveal" data-delay="1">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.lead != blank %}<p class="tx-lead tx-reveal" data-delay="2" style="margin:0;max-width:40ch">{{ section.settings.lead }}</p>{% endif %}
    </div>
    <div class="tx-videos__grid">
      {% for block in section.blocks %}
        {% if block.settings.url == blank %}{% continue %}{% endif %}
        <div class="tx-vid tx-reveal {% if forloop.index > section.settings.visible %}is-hidden{% endif %}" data-delay="{{ forloop.index0 | modulo: 3 }}" {{ block.shopify_attributes }}>
          <video preload="metadata" playsinline muted {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 900 }}"{% endif %}><source src="{{ block.settings.url }}#t=0.5"></video>
          <span class="tx-vid__play"><svg viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg></span>
          <span class="tx-vid__label">{{ block.settings.title }}</span>
        </div>
      {% endfor %}
    </div>
    {% if section.blocks.size > section.settings.visible %}
      <div class="tx-videos__more"><button type="button" class="tx-btn tx-btn--ghost tx-btn--sm" data-tx-more>{{ section.settings.more_text }}</button></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "TX Video gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TOOSA in action" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the shop floor to the show floor." },
    { "type": "text", "id": "lead", "label": "Lead text", "default": "Real drawers, real assembly, real shows. Tap a clip to play." },
    { "type": "range", "id": "visible", "label": "Clips shown before the Show more button", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "more_text", "label": "Show more button", "default": "Show all clips" }
  ],
  "blocks": [
    { "type": "video", "name": "Video", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "url", "label": "Video URL (.mp4 from Content → Files)" },
      { "type": "image_picker", "id": "poster", "label": "Poster image (optional)" }
    ] }
  ],
  "presets": [ { "name": "TX Video gallery" } ],
}
{% endschema %}
