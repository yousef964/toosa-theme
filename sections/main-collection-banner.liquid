{% style %}
#shopify-section-{{ section.id }} {

  
  {% if section.settings.background_overlay %}
    --theme-page-header-overlay-color: {{ section.settings.background_overlay_color }};
    --theme-page-header-overlay-opacity: {{ section.settings.background_overlay_opacity | append: '%' }};

  {% endif %}

}
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}


  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}



{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}

{% liquid 

  assign blocks_count = section.blocks | size 

  assign collections_limit = section.settings.limit

  assign section_collections = section.settings.collection_choice

  if section.settings.collection_choice == blank
    assign section_collections = collections
  endif 

  if section.settings.collection_links == '3' 
    assign display_collection_links = true
  elsif section.settings.collection_links == '2' and collection.handle == 'all'
    assign display_collection_links = true
  else
    assign display_collection_links = false
  endif

  if collection.image != blank 
    assign collection_image = collection.image
  else 
    assign collection_image = section.settings.background_image
  endif

  if section.settings.title != blank and collection.handle == 'all'
    assign collection_title = section.settings.title
  else 
    assign collection_title = collection.title
  endif

  if section.settings.description != blank and collection.handle == 'all'
    assign collection_description = section.settings.description
  else 
    assign collection_description = collection.description
  endif

%}



{% if collection_image != blank and section.settings.background_image_show %}
  

  {% style %}
    #shopify-section-{{ section.id }} {
      {% if section.settings.height_mobile != 'auto' %}
        --theme-page-header-custom-height-mobile: {{ section.settings.height_mobile | append: 'px' }};
      {% endif %}

      {% if section.settings.height != 'auto' %}
        --theme-page-header-custom-height-desktop: {{ section.settings.height | append: 'px' }};
      {% endif %}
    }
  {% endstyle %}


{% endif %}


<div class="main-page-header section-collection-banner page-header{% liquid 


  if section.settings.alignment != 'left' 
      echo ' has-alignment-' | append: section.settings.alignment
  endif

  if collection_image != blank and section.settings.background_image_show
      echo ' has-background'
  endif  


  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.inset

    if collection_image != blank and section.settings.background_image_show
      echo ' has-section-padding'
    else
      echo ' has-section-padding-on-sides'
    endif
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if collection_image != blank and section.settings.background_image_show
    echo ' ' | append: section.settings.color_scheme_background
  else
    echo ' ' | append: section.settings.color_scheme
  endif

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">

    {% if collection_image != blank and section.settings.background_image_show %}
        <div class="main-page-header-background page-header-background">
        {% if collection_image != blank %}
            {% render 'section-image-processor', image: collection_image %}
        {% endif %}
        {% if section.settings.background_overlay %}
            <div class="main-page-header-background-overlay page-header-background-overlay"></div>
        {% endif %}
        </div>
    {% endif %}
    <div class="main-page-header-details page-header-details section-container">
        {% if collection_title != blank %}
            <h2 class="main-page-header-title page-title special-heading-size-{{ section.settings.title_size }}">{{ collection_title }}</h2>
        {% endif %}
        {% if collection_description != blank %}
            <div class="main-page-header-description page-description rte paragraph-size-{{ section.settings.description_size }}">{{ collection_description }}</div>
        {% endif %}

        {% if display_collection_links %}
          <ul class="collections-links-list">
            {% for collection in section_collections limit: collections_limit %}
              <li class="collections-links-list-item">
                {% if collection.title != blank %}
                    <a href="{{ collection.url }}" class="collections-links-list-item__title btn-{{ section.settings.collection_button_style }}" title="{{ collection.title }}">
                      <span data-text="{{ collection.title }}">
                        <span>
                          {{ collection.title }}
                        </span>
                      </span>
                      {% if section.settings.collection_count %}
                        <span>({{ collection.products_count }})</span>
                      {% endif %}
                    </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
    </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


