        "default": true
      },
      {
        "type": "select",
        "id": "spacing_choice",
        "label": "Level",
        "options": [
            {
            "value": "level-1",
            "label": "Extra small"
            },
            {
            "value": "level-2",
            "label": "Small"
            },
            {
            "value": "level-3",
            "label": "Medium"
            },
            {
            "value": "level-4",
            "label": "Large"
            },
            {
            "value": "level-5",
            "label": "Extra large"
            }
        ],
