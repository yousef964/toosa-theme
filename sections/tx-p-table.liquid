{% comment %} TOOSA inner pages: spec / comparison table with a sticky intro {% endcomment %}
{%- liquid
  assign s = section.settings
  assign theme_class = 'txp txp--light'
  if s.theme == 'paper'
    assign theme_class = 'txp txp--paper'
  elsif s.theme == 'dark'
    assign theme_class = 'txp'
  endif
  assign cols = 0
  if s.col1 != blank
    assign cols = 1
  endif
  if s.col2 != blank
    assign cols = 2
  endif
  if s.col3 != blank
    assign cols = 3
  endif
-%}
<section class="{{ theme_class }} txp-section" id="txp-table-{{ section.id }}">
  <div class="txp-wrap {% if s.side %}txp-table-layout{% endif %}">
    <div class="{% if s.side %}txp-table-layout__side{% else %}txp-head{% endif %}">
      {%- if s.eyebrow != blank -%}<p class="txp-eyebrow txp-reveal">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="txp-h2 {% if s.side %}txp-h2--sm{% endif %} txp-reveal" data-delay="1">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.lead != blank -%}<div class="txp-lead txp-reveal" data-delay="2">{{ s.lead }}</div>{%- endif -%}
      {%- if s.link_text != blank -%}<div class="txp-actions txp-reveal" data-delay="3"><a class="txp-btn txp-btn--primary txp-btn--sm" href="{{ s.link_url }}">{{ s.link_text }}{% render 'tx-p-icon', name: 'arrow' %}</a></div>{%- endif -%}
    </div>
    <div class="txp-reveal" data-delay="1">
      <div class="txp-table__wrap">
        <table class="txp-table {% if cols < 2 %}txp-table--specs{% endif %}">
          {%- if cols > 1 or s.row_label != blank -%}
            <thead><tr>
              <th scope="col">{{ s.row_label }}</th>
              {%- if cols >= 1 -%}<th scope="col" class="{% if s.hero_col %}is-hero{% endif %}">{{ s.col1 }}</th>{%- endif -%}
              {%- if cols >= 2 -%}<th scope="col">{{ s.col2 }}</th>{%- endif -%}
              {%- if cols >= 3 -%}<th scope="col">{{ s.col3 }}</th>{%- endif -%}
            </tr></thead>
          {%- endif -%}
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label }}</th>
                <td class="{% if s.hero_col %}is-hero{% endif %}">{{ block.settings.v1 }}</td>
                {%- if cols >= 2 -%}<td>{{ block.settings.v2 }}</td>{%- endif -%}
                {%- if cols >= 3 -%}<td>{{ block.settings.v3 }}</td>{%- endif -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if s.note != blank -%}<div class="txp-table__note">{{ s.note }}</div>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TX Table",
  "settings": [
    { "type": "select", "id": "theme", "label": "Colour", "default": "light", "options": [
      { "value": "light", "label": "White" }, { "value": "paper", "label": "Paper" }, { "value": "dark", "label": "Dark" } ] },
    { "type": "checkbox", "id": "side", "label": "Intro beside the table", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "lead", "label": "Lead" },
    { "type": "text", "id": "link_text", "label": "Button text" },
    { "type": "url", "id": "link_url", "label": "Button link" },
    { "type": "text", "id": "row_label", "label": "First column header" },
    { "type": "text", "id": "col1", "label": "Column 1 header" },
    { "type": "text", "id": "col2", "label": "Column 2 header" },
    { "type": "text", "id": "col3", "label": "Column 3 header" },
    { "type": "checkbox", "id": "hero_col", "label": "Highlight column 1", "default": false },
    { "type": "richtext", "id": "note", "label": "Footnote" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "v1", "label": "Column 1" },
      { "type": "text", "id": "v2", "label": "Column 2" },
      { "type": "text", "id": "v3", "label": "Column 3" } ] }
  ],
  "presets": [ { "name": "TX Table" } ]
}
{% endschema %}
