{% comment %} TOOSA redesign: slim trust strip with icon badges (UL certification, steel, shipping, financing, showroom) {% endcomment %}
<section class="tx tx--light tx-trust" id="tx-trust-{{ section.id }}" aria-label="{{ section.settings.aria_label | default: 'Why buy from TOOSA' }}">
  <div class="tx-wrap">
    <ul class="tx-trust__list">
      {% for block in section.blocks %}
        <li class="tx-trust__item tx-reveal" data-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <span class="tx-trust__icon{% if block.settings.icon == 'ul' %} tx-trust__icon--ul{% endif %}" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'ul' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
              {% when 'steel' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M3 15h18M9 4v16M15 4v16"/></svg>
              {% when 'truck' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
              {% when 'card' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></svg>
              {% when 'pin' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
              {% when 'leaf' %}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.6 3.4 2.6-1-0.6 3.2 3.2-0.4-1.4 2.6 3.4 1.6-2.4 1.8 2.2 2.4-3.2 0.4 0.4 3.2-3-1.2L13 22h-2l-1.8-3.8-3 1.2 0.4-3.2-3.2-0.4 2.2-2.4L3.2 11.4l3.4-1.6L5.2 7.2l3.2 0.4-0.6-3.2 2.6 1z"/></svg>
              {% when 'star' %}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
              {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
            {% endcase %}
          </span>
          <span class="tx-trust__text">
            <b>{{ block.settings.title }}</b>
            {% if block.settings.text != blank %}<span>{{ block.settings.text }}</span>{% endif %}
          </span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "TX Trust strip",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Why buy from TOOSA" }
  ],
  "blocks": [
    { "type": "badge", "name": "Badge", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
        { "value": "ul", "label": "Certification shield" },
        { "value": "steel", "label": "Steel frame" },
        { "value": "truck", "label": "Delivery" },
        { "value": "card", "label": "Financing" },
        { "value": "pin", "label": "Location" },
        { "value": "leaf", "label": "Maple leaf" },
        { "value": "star", "label": "Star" },
        { "value": "check", "label": "Check" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "UL certified" },
      { "type": "text", "id": "text", "label": "Text", "default": "TS-20 compressor package with UL inverter" }
    ] }
  ],
  "presets": [ { "name": "TX Trust strip", "blocks": [
    { "type": "badge", "settings": { "icon": "ul", "title": "UL certified", "text": "TS-20 compressor package with UL inverter" } },
    { "type": "badge", "settings": { "icon": "steel", "title": "Welded heavy-gauge steel", "text": "frames welded, not bolted" } },
    { "type": "badge", "settings": { "icon": "truck", "title": "Free shipping over $3,000", "text": "delivered across Canada" } },
    { "type": "badge", "settings": { "icon": "card", "title": "Pay monthly with RBC", "text": "financing on storage and compressors" } },
    { "type": "badge", "settings": { "icon": "pin", "title": "Richmond, BC showroom", "text": "pickup in Richmond and Calgary" } }
  ] } ]
}
{% endschema %}
