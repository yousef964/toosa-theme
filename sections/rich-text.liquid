

{% style %}
  #shopify-section-{{ section.id }} {
    {% if section.settings.gap %}
      --theme-rich-text-text-gap: var(--theme-gap-{{ section.settings.gap_choice }});
    {% endif %}
  }
{% endstyle %}


{% for block in section.blocks %}
  {% if block.type == 'buttons' %}
    {% style %}
      #shopify-section-{{ section.id }} .block-{{ block.id }}{
        
        {% if block.settings.button_1_custom_width %}
            --theme-rich-text-button-1-width: {{ block.settings.button_1_width | append: 'px' }};
        {% endif %}

        {% if block.settings.button_2_custom_width %}
            --theme-rich-text-button-2-width: {{ block.settings.button_2_width | append: 'px' }};
        {% endif %}

      }
    {% endstyle %}
  {% endif %}

  {% if block.type == 'text' or block.type == 'richtext' or block.type == 'heading' or block.type == 'special-heading' %}
    {% style %}
      #shopify-section-{{ section.id }} .block-{{ block.id }}{

        {% if block.settings.text_custom_width %}
          --theme-rich-text-content-text-width: {{ block.settings.text_width | append: 'px' }};
        {% endif %}

      }
    {% endstyle %}
  {% endif %}
  {% if block.type == 'separator' %}
      {% style %}
          #shopify-section-{{ section.id }} .block-{{ block.id }}{
              --theme-separator-width: {{ block.settings.width | append: '%' }};
              --theme-separator-height: {{ block.settings.height | append: 'px' }};
          }
      {% endstyle %}
  {% endif %}
  {% if block.type == 'spacer' %}
      {% style %}
          #shopify-section-{{ section.id }} .block-{{ block.id }}{
              --theme-spacer-height: {{ block.settings.height | append: 'px' }};    
          }
      {% endstyle %}
  {% endif %}
{% endfor %}


{% style %}
  #shopify-section-{{ section.id }} {

  --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}

  }
{% endstyle %}

{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-rich-text{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

    if section.settings.alignment != 'left' 
        echo ' has-alignment-' | append: section.settings.alignment
    endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

    echo ' has-section-padding'

    echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-rich-text-container section-container">
    {% if section.blocks != blank %}
        {% for block in section.blocks %}
            {% case block.type %}
                {% when 'special-heading' %}
                    <h3 class="section-rich-text-content__special-heading special-heading-size-{{ block.settings.text_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h3>
                {% when 'heading' %}
                    <h3 class="section-rich-text-content__heading heading-size-{{ block.settings.text_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h3>
                {% when 'text' %}
                    <p class="section-rich-text-content__text paragraph-size-{{ block.settings.text_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
                {% when 'richtext' %}
                    <div class="section-rich-text-content__richtext block-{{ block.id }}" {{ block.shopify_attributes }}>
                      {{ block.settings.text }}
                    </div>
                {% when 'buttons' %}
                    <div class="section-rich-text-content__buttons block-{{ block.id }}" {{ block.shopify_attributes }}>
                      {% if block.settings.button_1_text != blank %}
                        {% render 'button', 
                            button_text: block.settings.button_1_text,  
                            button_url: block.settings.button_1_url,
                            button_style: block.settings.button_1_style,
                            button_custom_width: block.settings.button_1_custom_width,
                            button_classes: 'section-rich-text-button-1',
                            button_target: block.settings.button_1_target
                        %}
                      {% endif %}
                      {% if block.settings.button_2_text != blank %}
                        {% render 'button', 
                            button_text: block.settings.button_2_text,  
                            button_url: block.settings.button_2_url,
                            button_style: block.settings.button_2_style,
                            button_custom_width: block.settings.button_2_custom_width,
                            button_classes: 'section-rich-text-button-2',
                            button_target: block.settings.button_2_target
                        %}
                      {% endif %}
                    </div>
                {% when 'separator' %}
                    <div class="section-rich-text-content__separator block-{{ block.id }}" {{ block.shopify_attributes }}>
                        <hr class="separator" />
                    </div>
                {% when 'spacer' %}
                    <div class="section-rich-text-content__spacer block-{{ block.id }}" {{ block.shopify_attributes }}>
                      <div class="spacer"></div>
                    </div>
            {% endcase %}
        {% endfor %}
    {% endif %}
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


