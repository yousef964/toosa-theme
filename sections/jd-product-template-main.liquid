    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin-bottom: 10px;
  }

  .ai-product-variant-options-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ai-product-variant-option-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-product-variant-input-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    
  }

  .ai-product-variant-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    border: 1px solid {{ block.settings.variant_border_color }};
    border-radius: {{ block.settings.variant_border_radius }}px;
