    {
      "type": "range",
      "id": "vendor_font_size",
      "label": "Vendor size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#1e2a38"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1e2a38"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "default": "#1e2a38"
    },
    {
      "type": "color",
      "id": "vendor_color",
      "label": "Vendor",
      "default": "#666666"
