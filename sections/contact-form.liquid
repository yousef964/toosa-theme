{% style %}
#shopify-section-{{ section.id }} {
  
  {% if section.settings.background_overlay %}
    --theme-contact-form-overlay-color: {{ section.settings.background_overlay_color }};
    --theme-contact-form-overlay-opacity: {{ section.settings.background_overlay_opacity | append: '%' }};

  {% endif %}

  --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
}
{% endstyle %}




{% style %}
  #shopify-section-{{ section.id }}{

    {% if section.settings.content_gap %}
    --theme-contact-form-content-gap: var(--theme-gap-{{ section.settings.content_gap_choice }});
    {% endif %}

    {% if section.settings.form_custom_width %}
      --theme-contact-form-content-contact-form-width: {{ section.settings.form_width | append: 'px' }};
    {% endif %}

}
{% endstyle %}


{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}

<div class="section-contact-form{% liquid
  if section.settings.content_position != blank
    echo ' content-align-' | append: section.settings.content_position
  endif 

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  echo ' has-section-padding'
  
  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-contact-form-background">
    <div class="section-contact-form-background-media">
      {% if section.settings.background_image != blank or section.settings.background_image_mobile != blank %}
        {% render 'section-image-processor', image: section.settings.background_image, image_mobile: section.settings.background_image_mobile %}
      {% endif %}
    </div>
    {% if section.settings.background_overlay %}
      <div class="section-contact-form-background-overlay"></div>
    {% endif %}
  </div>
	<div class="section-contact-form-content section-container">
    {% if section.settings.text_1 != blank or section.settings.text_2 != blank %}
      <div class="section-contact-form-content-header">
        {% if section.settings.text_1 != blank %}
          <h2 class="section-contact-form-content-header__heading special-heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
        {% endif %}

        {% if section.settings.text_2 != blank %}
          <p class="section-contact-form-content-header__description paragraph-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</p>
        {% endif %}
      </div>
    {% endif %}
    <div class="section-contact-form-content-contact-form">
      {% render 'contact-form' section: section %}
    </div>
	</div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


