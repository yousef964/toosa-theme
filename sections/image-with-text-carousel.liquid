
{% style %}
#shopify-section-{{ section.id }} {
  
  {% if section.settings.gap %}
    --theme-image-with-text-gap: var(--theme-gap-{{ section.settings.gap_choice }});
    {% else %}
      --theme-image-with-text-gap: 0px;
  {% endif %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

}
{% endstyle %}


{% for block in section.blocks %}
  {% if block.type == 'slide' %}

    {% style %}
      #shopify-section-{{ section.id }} .block-{{ block.id }}{

        --theme-image-with-text-image-1-aspect-ratio: {{ block.settings.image_aspect_ratio }};

        {% if block.settings.content_custom_width %}
          --theme-image-with-text-content-width: {{ block.settings.content_width }};
        {% endif %}
      }

    {% endstyle %}

    {% style %}
      #shopify-section-{{ section.id }} .block-{{ block.id }}{
        --theme-image-with-text-image-width: {{ block.settings.image_content_width_split | append: '%' }};
        --theme-image-with-text-content-width: calc(100% - {{ block.settings.image_content_width_split | append: '%' }});

        --theme-image-with-text-content-horizontal-align: {{ block.settings.content_horizontal_align }};
        --theme-image-with-text-content-vertical-align: {{ block.settings.content_vertical_align }};
        --theme-image-with-text-content-text-align: {{ block.settings.content_text_align }};


        {% if block.settings.content_custom_width %}
          --theme-image-with-text-content-inner-width: {{ block.settings.content_width | append: 'px' }};
        {% endif %}


      }

    {% endstyle %}
    
  {% endif %}
{% endfor %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}

{% liquid

  assign slide_count = section.blocks | size

    if slide_count > 1 and section.settings.carousel
      assign has_carousel = true
    endif

%}

<div class="section-image-with-text-slider{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif
  
%}">
<div class="section-image-with-text-slider-container section-container">

  <div class="section-image-with-text-slider-content{% liquid
    if has_carousel
      echo ' has-carousel splide'
    endif
  %}" {% liquid 
    if has_carousel 

      assign data_options = 'data-options={'
        
      assign data_options = data_options | append: '"rewind":' | append: section.settings.loop | append: ','
      assign data_options = data_options | append: '"perMove":"' | append: 1 | append: '",'
      assign data_options = data_options | append: '"perPage":"' | append: 1 | append: '",'

      if section.settings.speed != blank
        assign data_options = data_options | append: '"speed":"' | append: section.settings.speed | append: '",'
      endif 
      if section.settings.interval != blank
        assign data_options = data_options | append: '"interval":"' | append: section.settings.interval | append: '",'
      endif 
      
      assign data_options = data_options | append: '"autoplay":' | append: section.settings.autoplay | append: ','
      assign data_options = data_options | append: '"drag":' | append: section.settings.mouse_drag | append: ','
      assign data_options = data_options | append: '"arrows":' | append: section.settings.arrows | append: ','
      assign data_options = data_options | append: '"pagination":' | append: false | append: ','
      
      assign data_options = data_options | append: '"breakpoints":{"768":{'
      assign data_options = data_options | append: '"perPage":' | append: 1
      assign data_options = data_options | append: '}}' | append: ','


      assign data_options_count = data_options | size | minus: 1
      assign data_options = data_options | slice: 0, data_options_count
      assign data_options = data_options | append: '}'


      echo data_options
    endif
  
  %}>
    {% if has_carousel %}
      <div class="section-image-with-text-slider-bottom">
        <div class="section-image-with-text-slider-navigation splide__arrows">
          <button class="splide__arrow splide__arrow--prev">
            {% render 'icon-arrow-right' %}
          </button>
          <button class="splide__arrow splide__arrow--next">
            {% render 'icon-arrow-right' %}
          </button>
        </div>
        <div class="section-image-with-text-slider-pagination">
          <span class="section-image-with-text-slider-pagination-current">1</span>
          <span>/</span>
          <span class="section-image-with-text-slider-pagination-total">{{ section.blocks | size }}</span>
        </div>
      </div>
      <div class="splide__track">
    {% endif %}

    {% if section.blocks != blank %}
      <ul class="section-image-with-text-slider-list {% liquid 
        if has_carousel
          echo ' splide__list'
        endif
      %}">
      {% for block in section.blocks %}
        <li class="section-image-with-text-slider-list-item{% liquid

          if has_carousel
            echo ' splide__slide'
          endif 

          echo ' has-justify-' | append: block.settings.content_horizontal_align

          echo ' has-text-align-' | append: block.settings.content_text_align

          echo ' has-image-on-' | append: block.settings.image_placement

        %} block-{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="section-image-with-text-slider-list-item-content">
            <div class="section-image-with-text-slider-list-item-content__inner">
              {% if block.settings.text_2 != blank %}
                <div class="section-image-with-text-slider-list-item-content__additional-heading heading-size-{{ block.settings.text_2_size }}">{{ block.settings.text_2 }}</div>
              {% endif %}
              {% if block.settings.text_1 != blank %}
                <h2 class="section-image-with-text-slider-list-item-content__heading special-heading-size-{{ block.settings.text_1_size }}">{{ block.settings.text_1 }}</h2>
              {% endif %}
              {% if block.settings.text_3 != blank %}
                <p class="section-image-with-text-slider-list-item-content__description paragraph-size-{{ block.settings.text_3_size }}">{{ block.settings.text_3 }}</p>
              {% endif %}

              {% if block.settings.button_text != blank %}
                {% render 'button', 
                    button_text: block.settings.button_text,  
                    button_url: block.settings.button_url,
                    button_style: block.settings.button_style,
                    button_target: block.settings.button_target,
                    button_classes: 'section-image-with-text-slider-list-item-content__button'
                %}
              {% endif %}
            </div>
          </div>
          <div class="section-image-with-text-slider-list-item-images">

            <div class="section-image-with-text-slider-list-item-images__image">
              {% liquid 
                if block.settings.image != blank
                  render 'section-image-processor', image: block.settings.image
                else 
                  echo 'image' | placeholder_svg_tag: 'placeholder placeholder-image-with-text'
                endif
              %}
              </div>
          </div>
        </li>
      {% endfor %}
        </ul>
    {% endif %}

    {% if has_carousel %}
        </div>
    {% endif %}
  </div>
</div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


