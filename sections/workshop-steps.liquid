{% comment %}
  Workshop Steps / Build Your Workshop
  Responsive Shopify 2.0 Section
{% endcomment %}

<section
  id="workshop-steps-{{ section.id }}"
  class="workshop-steps-section"
>
  <div class="workshop-steps__container">

    {% if section.settings.eyebrow != blank %}
      <div class="workshop-steps__eyebrow">
        <span class="workshop-steps__eyebrow-line"></span>
        <span>{{ section.settings.eyebrow }}</span>
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="workshop-steps__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="workshop-steps__description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="workshop-steps__grid">
        {% for block in section.blocks %}
          <div
            class="workshop-step"
            {{ block.shopify_attributes }}
          >
            <div class="workshop-step__top-line"></div>

            <div class="workshop-step__number">
              {{ block.settings.number }}
            </div>

            {% if block.settings.title != blank %}
              <h3 class="workshop-step__title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="workshop-step__text">
                {{ block.settings.text }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  #workshop-steps-{{ section.id }} {
    --ws-orange: {{ section.settings.accent_color }};
    --ws-heading: {{ section.settings.heading_color }};
    --ws-text: {{ section.settings.text_color }};
    --ws-bg: {{ section.settings.background_color }};

    background: var(--ws-bg);
    width: 100%;
    box-sizing: border-box;

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #workshop-steps-{{ section.id }} *,
  #workshop-steps-{{ section.id }} *::before,
  #workshop-steps-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #workshop-steps-{{ section.id }} .workshop-steps__container {
    width: 100%;
   width: min(100% - 80px, 1400px);
    margin: 0 auto;

  }

  /* Eyebrow */
  #workshop-steps-{{ section.id }} .workshop-steps__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;

    margin: 0 0 13px;
 font-size: 16px;
    color: var(--ws-orange);
    {% comment %} font-family: var(--font-body-family, Arial, sans-serif);
   
    font-weight: 700;
    line-height: 1;
    letter-spacing: 1.5px; {% endcomment %}
    text-transform: uppercase;
  }

  #workshop-steps-{{ section.id }} .workshop-steps__eyebrow-line {
    display: block;
    width: 20px;
    height: 2px;
    flex: 0 0 20px;
    background: var(--ws-orange);
  }

  /* Heading */
  #workshop-steps-{{ section.id }} .workshop-steps__heading {
    margin: 0;
 font-size: 36px;
    color: var(--ws-heading);
    {% comment %} font-family: var(
      --font-heading-family,
      var(--font-body-family, Arial, sans-serif)
    );
   
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.8px; {% endcomment %}
  }

  /* Description */
  #workshop-steps-{{ section.id }} .workshop-steps__description {
    max-width: 465px;
    margin-top: 13px;

    color: var(--ws-text);
      font-size: 18px;
    {% comment %} font-family: var(--font-body-family, Arial, sans-serif);
  
    font-weight: 400;
    line-height: 1.65; {% endcomment %}
  }

  #workshop-steps-{{ section.id }} .workshop-steps__description p {
    margin: 0;
  }

  /* Five columns */
  #workshop-steps-{{ section.id }} .workshop-steps__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: 16px;

    margin-top: 32px;
  }

  /* Individual step */
  #workshop-steps-{{ section.id }} .workshop-step {
    min-width: 0;
  }

  /* Orange line */
  #workshop-steps-{{ section.id }} .workshop-step__top-line {
    width: 100%;
    height: 2px;
    margin-bottom: 17px;

    background: var(--ws-orange);
  }

  /* Number */
  #workshop-steps-{{ section.id }} .workshop-step__number {
    margin-bottom: 7px;

    color: var(--ws-orange);
    {% comment %} font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.8px; {% endcomment %}
  }

  /* Title */
  #workshop-steps-{{ section.id }} .workshop-step__title {
    margin: 0 0 7px;
 font-size: 20px;
    color: var(--ws-heading);
    {% comment %} font-family: var(
      --font-heading-family,
      var(--font-body-family, Arial, sans-serif)
    );
   
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.1px; {% endcomment %}
  }

  /* Text */
  #workshop-steps-{{ section.id }} .workshop-step__text {
    color: var(--ws-text);
    {% comment %} font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.55; {% endcomment %}
  }

  #workshop-steps-{{ section.id }} .workshop-step__text p {
    margin: 0;
  }

  /* =========================
     TABLET
     ========================= */
  @media screen and (max-width: 900px) {
    #workshop-steps-{{ section.id }} .workshop-steps__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 28px;
    }
  }

  /* =========================
     MOBILE
     ========================= */
  @media screen and (max-width: 749px) {
 

    #workshop-steps-{{ section.id }} .workshop-steps__container {
      max-width: 100%;
      width: min(100% - 40px);
    margin: 0 auto;
      padding-left: 10px;
      padding-right: 10px;
    }

    #workshop-steps-{{ section.id }} .workshop-steps__eyebrow {
      margin-bottom: 12px;
      font-size: 14px;
     {% comment %}  letter-spacing: 1.3px; {% endcomment %}
    }

    #workshop-steps-{{ section.id }} .workshop-steps__eyebrow-line {
      width: 18px;
      flex-basis: 18px;
    }

    #workshop-steps-{{ section.id }} .workshop-steps__heading {
      font-size: 28px;
     {% comment %}  line-height: 1.2;
      letter-spacing: -0.6px;{% endcomment %}
    } 

    #workshop-steps-{{ section.id }} .workshop-steps__description {
      max-width: 100%;
      margin-top: 11px;
         font-size: 16px;
      {% comment %} font-size: 13px;
      line-height: 1.6; {% endcomment %}
    }

    #workshop-steps-{{ section.id }} .workshop-steps__grid {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 28px;
    }

    #workshop-steps-{{ section.id }} .workshop-step {
      padding-bottom: 25px;
      margin-bottom: 25px;
      {% comment %} border-bottom: 1px solid rgba(31, 42, 55, 0.10); {% endcomment %}
    }

    #workshop-steps-{{ section.id }} .workshop-step:last-child {
      padding-bottom: 0;
      margin-bottom: 0;
      border-bottom: 0;
    }

    #workshop-steps-{{ section.id }} .workshop-step__top-line {
      margin-bottom: 15px;
    }

    #workshop-steps-{{ section.id }} .workshop-step__number {
      {% comment %} font-size: 9px; {% endcomment %}
      margin-bottom: 6px;
    }

    #workshop-steps-{{ section.id }} .workshop-step__title {
      margin-bottom: 6px;
       font-size: 18px;
    }

    {% comment %} #workshop-steps-{{ section.id }} .workshop-step__text {
      font-size: 13px;
      line-height: 1.55;
    } {% endcomment %}
  }


</style>

{% schema %}
{
  "name": "Workshop steps",
  "tag": "section",
  "class": "section-workshop-steps",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BUILD YOUR WORKSHOP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One setup, built up in steps"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Most customers start with storage and add to it over time. Here's the path.</p>"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#FF5B3F"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#243142"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#667383"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 65
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 65
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Storage unit"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Start with a tool box or rolling chest sized to your space.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Workshop steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Storage unit",
            "text": "<p>Start with a tool box or rolling chest sized to your space.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Custom foam inserts",
            "text": "<p>CNC-cut foam so every tool has a labelled place.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Lighting & engraving",
            "text": "<p>Task lighting on the hutch, plus laser engraving to make it yours.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "04",
            "title": "Accessories",
            "text": "<p>Bench vises, side lockers, upper cabinets — bolt straight on.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "05",
            "title": "Air compressor",
            "text": "<p>Add shop air, matched to how you'll use the space.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
