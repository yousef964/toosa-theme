
{% liquid 

  assign cookie_name = section.settings.cookie_name
  assign popup_expiry = section.settings.expiry
  assign popup_delay = section.settings.delay

%}


<popup-modal class="section-popup popup-modal inactive{% liquid 
    if section.settings.display_position == 'bottom-right'
        echo ' display-in-corner'
    endif 
    if section.settings.image != blank
        echo ' has-image'
    endif 
%}" data-popup-type="onload" data-popup-delay="{{ popup_delay }}" data-popup-expiry="{{ popup_expiry }}" data-popup-cookie-name="{{ cookie_name }}" style="display: none;">
    <div class="popup-modal__overlay"></div>
    <div class="popup-modal__inner {{ section.settings.color_scheme }}">
        <div class="popup-modal__content">
            {% if section.settings.image != blank %}
                <div class="section-popup-image">
                    {% render 'section-image-processor', image: section.settings.image %}
                </div>
            {% endif %}
            <div class="section-popup-content">
            {% if section.settings.text_1 != blank %}
              <h2 class="section-popup-content__heading special-heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
            {% endif %}

            {% if section.settings.text_2 != blank %}
              <p class="section-popup-content__description paragraph-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</p>
            {% endif %}

            {% if section.settings.type == 'newsletter' %}
              {% render 'newsletter-form' section_id: section.id %}
            {% elsif section.settings.type == 'promotional' %}
                {% if section.settings.promotional_button_text != blank %}
                    {% render 'button', 
                        button_text: section.settings.promotional_button_text,  
                        button_url: section.settings.promotional_button_url,
                        button_style: section.settings.promotional_button_style,
                        button_target: section.settings.promotional_button_target,
                        button_classes: 'section-popup-content__button'
                    %}
                {% endif %}

            {% endif %}

            {% if section.settings.button_text != blank %}
                {% render 'button', 
                    button_text: section.settings.button_text,  
                    button_url: section.settings.button_url,
                    button_style: section.settings.button_style,
                    button_target: section.settings.button_target,
                    button_classes: 'section-popup-content__button section-popup-button-close'
                %}
            {% endif %}
            </div>
        </div>
        <button class="popup-modal__close">{% render 'icon-close' %}</button>
    </div>
</popup-modal>



