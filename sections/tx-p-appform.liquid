{% comment %} TOOSA inner pages: intro column + an app form block (e.g. Hulk Form Builder) rendered untouched inside a styled panel {% endcomment %}
{%- assign s = section.settings -%}
<section class="txp txp--paper txp-section" id="txp-appform-{{ section.id }}">
  <div class="txp-wrap txp-appform">
    <div class="txp-appform__side">
      <div>
        {%- if s.eyebrow != blank -%}<p class="txp-eyebrow txp-reveal">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="txp-h2 txp-h2--sm txp-reveal" data-delay="1">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.lead != blank -%}<div class="txp-lead txp-reveal" data-delay="2">{{ s.lead }}</div>{%- endif -%}
      </div>
      {%- if s.step1 != blank -%}
        <ol class="txp-steps-mini txp-reveal" data-delay="3">
          {%- for i in (1..4) -%}
            {%- assign key = 'step' | append: i -%}
            {%- assign val = s[key] -%}
            {%- if val != blank -%}
              {%- assign parts = val | split: '::' -%}
              <li><b>{{ i }}</b><div><strong>{{ parts[0] | strip }}</strong>{%- if parts[1] != blank -%}<p>{{ parts[1] | strip }}</p>{%- endif -%}</div></li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      {%- endif -%}
      {%- if s.note != blank -%}<div class="txp-rt txp-reveal" data-delay="4" style="font-size: 15px;">{{ s.note }}</div>{%- endif -%}
    </div>
    <div class="txp-appform__panel txp-reveal" data-delay="1">
      {%- if s.panel_heading != blank -%}<h3 class="txp-h3" style="margin-bottom: 18px;">{{ s.panel_heading }}</h3>{%- endif -%}
      {%- for block in section.blocks -%}
        {%- render block -%}
      {%- endfor -%}
      {%- if section.blocks.size == 0 and s.fallback_email != blank -%}
        <p class="txp-rt">Email your tool list and a photo of the drawer to <a href="mailto:{{ s.fallback_email }}">{{ s.fallback_email }}</a>.</p>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TX App form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "lead", "label": "Lead" },
    { "type": "text", "id": "step1", "label": "Step 1 (Title :: text)" },
    { "type": "text", "id": "step2", "label": "Step 2 (Title :: text)" },
    { "type": "text", "id": "step3", "label": "Step 3 (Title :: text)" },
    { "type": "text", "id": "step4", "label": "Step 4 (Title :: text)" },
    { "type": "richtext", "id": "note", "label": "Note" },
    { "type": "text", "id": "panel_heading", "label": "Panel heading" },
    { "type": "text", "id": "fallback_email", "label": "Fallback email when no form block is added" }
  ],
  "blocks": [ { "type": "@app" } ],
  "presets": [ { "name": "TX App form" } ]
}
{% endschema %}
