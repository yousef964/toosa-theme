
{% style %}
  #shopify-section-{{ section.id }} {

    {% if section.settings.gap %}
      --theme-multicolumns-gap: var(--theme-gap-{{ section.settings.gap_choice }});
      {% else %}
      --theme-multicolumns-gap: 0px;
    {% endif %}
    --theme-multicolumns-count: {{ section.blocks | size }};
  }

  {% for block in section.blocks %}


    #shopify-section-{{ section.id }} .block-{{ block.id }}{
      {% if block.settings.inset %}
        --theme-block-content-padding: var(--theme-block-content-padding-{{ block.settings.inset_choice }});
      {% endif %}

      {% if block.settings.gap %}
      --theme-multicolumn-gap: var(--theme-gap-{{ block.settings.gap_choice }});
      {% endif %}

      --theme-multicolumn-width: {{ block.settings.width | append: '%' }};

    }


    {% for i in (1..3) %}

      {% capture grid_inset_choice %}grid_{{i}}_inset_choice{% endcapture %}
      {% capture grid_aspect_ratio %}grid_{{i}}_aspect_ratio{% endcapture %}
      {% capture grid_text_2_outline %}grid_{{i}}_text_2_outline{% endcapture %}


      #shopify-section-{{ section.id }} .block-{{ block.id }} .section-multicolumn-grid-{{ i }}{

        --theme-multicolumn-grid-aspect-ratio: {{ block.settings[grid_aspect_ratio] }};
        --theme-multicolumn-grid-text-2-outline: {{ block.settings[grid_text_2_outline] }};

        --theme-multicolumn-grid-content-padding: var(--theme-block-content-padding-{{ block.settings[grid_inset_choice] }});
        
      }
    {% endfor %}
    
  {% endfor %}
{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-multicolumns{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if settings.animation_sections
    echo ' has-animation'
  endif
  
%}">
  <div class="section-multicolumns-container section-container">
    {% if section.blocks != blank %}
      {% for block in section.blocks %}
        <div class="section-multicolumn block-{{ block.id }}{% liquid 

          echo ' has-display-style-' | append: block.settings.display_style

        %}" {{ block.shopify_attributes }}>
        {% for i in (1..3) %}
            
          {% assign block_settings_grid_show = true %}
          {% if i != 1 %}
            {% capture grid_show %}grid_{{i}}_show{% endcapture %}
            {% assign block_settings_grid_show = block.settings[grid_show] %}
          {% endif %}

          {% capture grid_color_scheme %}grid_{{i}}_color_scheme{% endcapture %}
          {% capture grid_inset_choice %}grid_{{i}}_inset_choice{% endcapture %}
          {% capture grid_aspect_ratio %}grid_{{i}}_aspect_ratio{% endcapture %}
          {% capture grid_vertical_align %}grid_{{i}}_vertical_align{% endcapture %}
          {% capture grid_use_image %}grid_{{i}}_use_image{% endcapture %}
          {% capture grid_image %}grid_{{i}}_image{% endcapture %}
          {% capture grid_video %}grid_{{i}}_video{% endcapture %}
          {% capture grid_button_1_text %}grid_{{i}}_button_1_text{% endcapture %}
          {% capture grid_button_1_url %}grid_{{i}}_button_1_url{% endcapture %}
          {% capture grid_button_1_target %}grid_{{i}}_button_1_target{% endcapture %}
          {% capture grid_button_1_style %}grid_{{i}}_button_1_style{% endcapture %}
          {% capture grid_button_2_text %}grid_{{i}}_button_2_text{% endcapture %}
          {% capture grid_button_2_url %}grid_{{i}}_button_2_url{% endcapture %}
          {% capture grid_button_2_target %}grid_{{i}}_button_2_target{% endcapture %}
          {% capture grid_button_2_style %}grid_{{i}}_button_2_style{% endcapture %}

          
          {% if block_settings_grid_show %}
          <div class="section-multicolumn-grid{% liquid 

            echo ' section-multicolumn-grid-' | append: i

            echo ' has-vertical-align-' | append: block.settings[grid_vertical_align]

            if block.settings[grid_video] or block.settings[grid_image]
              echo ' has-media'
            endif
            
            
            echo ' ' | append: block.settings[grid_color_scheme]

            echo ' has-block-padding'


          %}">

            {% if block.settings[grid_use_image] %}
              <div class="section-multicolumn-grid__media">
                {% if block.settings[grid_video] %}
                  <div class="section-multicolumn-grid__video video-player has-internal-video">
                    {{ block.settings[grid_video] | video_tag: autoplay: true, loop: true, muted: true }}

                    <div class="section-multicolumn-grid__video-controls section-multicolumn-grid-player-controls">
                      <div class="section-multicolumn-grid__video-controls-play section-multicolumn-grid-player-controls-play video-play">
                        <span class="video-player-icon--play">{% render 'icon-play' %}</span>
                        <span class="video-player-icon--pause">{% render 'icon-pause' %}</span>
                      </div>
                    </div>
                  </div>

                {% elsif block.settings[grid_image] %}
                  <div class="section-multicolumn-grid__image">
                    {% render 'section-image-processor', image: block.settings[grid_image] %}
                  </div>
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder placeholder-multicolumn-grid' }}
                {% endif %}
              </div>
            {% endif %}

            <div class="section-multicolumn-grid__content">
              {% capture grid_text_1 %}grid_{{ i }}_text_1{% endcapture %}
              {% capture grid_text_1_choice %}grid_{{ i }}_text_1_choice{% endcapture %}
              {% capture grid_text_1_size %}grid_{{ i }}_text_1_size{% endcapture %}
              {% capture grid_text_1_url %}grid_{{ i }}_text_1_url{% endcapture %}

              {% capture grid_text_2 %}grid_{{ i }}_text_2{% endcapture %}
              {% capture grid_text_2_outline %}grid_{{ i }}_text_2_outline{% endcapture %}

              {% capture grid_text_3 %}grid_{{ i }}_text_3{% endcapture %}
              {% capture grid_text_3_size %}grid_{{ i }}_text_3_size{% endcapture %}

              {% if block.settings[grid_text_2] != blank %}
                <div class="section-multicolumn-grid__additional-heading{% liquid
                  if block.settings[grid_text_2_outline]
                    echo ' has-outline'
                  endif
                %}">{{ block.settings[grid_text_2] }}</div>
              {% endif %}

              {% if block.settings[grid_text_1] != blank %}
                <h3 class="section-multicolumn-grid__heading {{ block.settings[grid_text_1_choice] }}-size-{{ block.settings[grid_text_1_size] }}">
                  {% if block.settings[grid_text_1_url] != blank %}
                    <a href="{{ block.settings[grid_text_1_url] }}">
                  {% endif %}

                  {{ block.settings[grid_text_1] }}
                    
                  {% if block.settings[grid_text_1_url] != blank %}
                    </a>
                  {% endif %}
                </h3>
              {% endif %}

              {% if block.settings[grid_text_3] != blank %}
                <p class="section-multicolumn-grid__description paragraph-size-{{ block.settings[grid_text_3_size] }}">{{ block.settings[grid_text_3] }}</p>
              {% endif %}

              {% if block.settings[grid_button_1_text] != blank or block.settings[grid_button_2_text] != blank %}
                <div class="section-multicolumn-grid__buttons">
                  {% if block.settings[grid_button_1_text] != blank %}
                    {% render 'button', 
                        button_text: block.settings[grid_button_1_text],  
                        button_url: block.settings[grid_button_1_url],
                        button_style: block.settings[grid_button_1_style],
                        button_target: block.settings[grid_button_1_target],
                        button_classes: 'section-multicolumn-grid__button'
                    %}
                  {% endif %}
                  {% if block.settings[grid_button_2_text] != blank %}
                    {% render 'button', 
                        button_text: block.settings[grid_button_2_text],  
                        button_url: block.settings[grid_button_2_url],
                        button_style: block.settings[grid_button_2_style],
                        button_target: block.settings[grid_button_2_target],
                        button_classes: 'section-multicolumn-grid__button'
                    %}
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
          {% endif %}
        {% endfor %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


