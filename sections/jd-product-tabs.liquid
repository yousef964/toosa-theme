{% liquid
  assign current_product = product

  if current_product == blank
    assign current_product = closest.product
  endif
%}

<section
  id="ProductInfoTabs-{{ section.id }}"
  class="product-info-tabs"
>
  <div class="product-info-tabs__container">

    {% if section.settings.heading != blank %}
      <div class="product-info-tabs__header">

        <h2>
          {{ section.settings.heading }}
        </h2>

        {% if section.settings.description != blank %}
          <div class="product-info-tabs__intro">
            {{ section.settings.description }}
          </div>
        {% endif %}

      </div>
    {% endif %}


    {% comment %}
      ==========================================================
      CHECK HOW MANY TABS HAVE CONTENT
      ==========================================================
    {% endcomment %}

    {% assign tab_count = 0 %}

    {% for block in section.blocks %}

      {% liquid
        assign tab_visible = false
        assign metafield = blank

        if block.settings.source_type == 'product_description'

          if current_product.description != blank
            assign tab_visible = true
          endif

        elsif block.settings.source_type == 'product_metafield'

          if current_product != blank

            assign metafield = current_product.metafields[block.settings.namespace][block.settings.key]

            if metafield != blank
              assign tab_visible = true
            endif

          endif

        elsif block.settings.source_type == 'page_metafield'

          if block.settings.page != blank

            assign metafield = block.settings.page.metafields[block.settings.namespace][block.settings.key]

            if metafield != blank
              assign tab_visible = true
            endif

          endif

        elsif block.settings.source_type == 'manual'

          if block.settings.manual_content != blank
            assign tab_visible = true
          endif

        endif
      %}

      {% if tab_visible %}
        {% assign tab_count = tab_count | plus: 1 %}
      {% endif %}

    {% endfor %}


    {% if tab_count > 0 %}

      {% comment %}
        ========================================================
        TAB NAVIGATION
        ========================================================
      {% endcomment %}

      <div
        class="product-info-tabs__nav"
        role="tablist"
        aria-label="Product information"
      >

        {% assign first_tab = true %}

        {% for block in section.blocks %}

          {% liquid
            assign tab_visible = false
            assign metafield = blank

            if block.settings.source_type == 'product_description'

              if current_product.description != blank
                assign tab_visible = true
              endif

            elsif block.settings.source_type == 'product_metafield'

              if current_product != blank

                assign metafield = current_product.metafields[block.settings.namespace][block.settings.key]

                if metafield != blank
                  assign tab_visible = true
                endif

              endif

            elsif block.settings.source_type == 'page_metafield'

              if block.settings.page != blank

                assign metafield = block.settings.page.metafields[block.settings.namespace][block.settings.key]

                if metafield != blank
                  assign tab_visible = true
                endif

              endif

            elsif block.settings.source_type == 'manual'

              if block.settings.manual_content != blank
                assign tab_visible = true
              endif

            endif
          %}


          {% if tab_visible %}

            <button
              type="button"
              class="product-info-tabs__button{% if first_tab %} active{% endif %}"
              data-tab="tab-{{ section.id }}-{{ block.id }}"
              aria-selected="{% if first_tab %}true{% else %}false{% endif %}"
              role="tab"
            >
              {{ block.settings.tab_title }}
            </button>

            {% assign first_tab = false %}

          {% endif %}

        {% endfor %}

      </div>


      {% comment %}
        ========================================================
        TAB CONTENT
        ========================================================
      {% endcomment %}

      {% assign first_panel = true %}

      <div class="product-info-tabs__content">

        {% for block in section.blocks %}

          {% liquid
            assign tab_visible = false
            assign metafield = blank

            if block.settings.source_type == 'product_description'

              if current_product.description != blank
                assign tab_visible = true
              endif

            elsif block.settings.source_type == 'product_metafield'

              if current_product != blank

                assign metafield = current_product.metafields[block.settings.namespace][block.settings.key]

                if metafield != blank
                  assign tab_visible = true
                endif

              endif

            elsif block.settings.source_type == 'page_metafield'

              if block.settings.page != blank

                assign metafield = block.settings.page.metafields[block.settings.namespace][block.settings.key]

                if metafield != blank
                  assign tab_visible = true
                endif

              endif

            elsif block.settings.source_type == 'manual'

              if block.settings.manual_content != blank
                assign tab_visible = true
              endif

            endif
          %}


          {% if tab_visible %}

            <div
              id="tab-{{ section.id }}-{{ block.id }}"
              class="product-info-tabs__panel{% if first_panel %} active{% endif %}"
              {% unless first_panel %}
                hidden
              {% endunless %}
              role="tabpanel"
            >

              {% if block.settings.content_heading != blank %}

                <h3 class="product-info-tabs__content-heading">
                  {{ block.settings.content_heading }}
                </h3>

              {% endif %}


              {% comment %}
                ==================================================
                PRODUCT DESCRIPTION
                ==================================================
              {% endcomment %}

              {% if block.settings.source_type == 'product_description' %}

                <div class="product-info-tabs__richtext rte">
                  {{ current_product.description }}
                </div>


              {% comment %}
                ==================================================
                MANUAL CONTENT
                ==================================================
              {% endcomment %}

              {% elsif block.settings.source_type == 'manual' %}

                <div class="product-info-tabs__richtext rte">
                  {{ block.settings.manual_content }}
                </div>


              {% comment %}
                ==================================================
                PRODUCT / PAGE METAFIELD
                ==================================================
                {% endcomment %}
              {% elsif block.settings.source_type == 'product_metafield'
                or block.settings.source_type == 'page_metafield'
              %}

                {% assign metafield_type = metafield.type %}


                {% comment %}
                  =================================================
                  SINGLE FILE
                  =================================================
                {% endcomment %}

                {% if metafield_type == 'file_reference' %}

                  {% assign file = metafield.value %}

                  {% if file != blank %}

                    {% comment %}
                      Extract filename from Shopify CDN URL
                    {% endcomment %}

                    {% assign file_url_without_query = file.url | split: '?' | first %}
                    {% assign extracted_file_name = file_url_without_query | split: '/' | last %}
                    {% assign extracted_file_name = extracted_file_name | url_decode %}


                    {% if file.media_type == 'image' %}

                      <div class="product-info-tabs__image">

                        {{
                          file
                          | image_url: width: 2000
                          | image_tag:
                            loading: 'lazy',
                            class: 'product-info-tabs__image-element'
                        }}

                      </div>


                    {% elsif file.media_type == 'video' %}

                      <div class="product-info-tabs__video">

                        <video
                          controls
                          playsinline
                          preload="metadata"
                        >
                          <source
                            src="{{ file.url }}"
                          >
                        </video>

                      </div>


                    {% else %}

                      {% comment %}
                        =========================================
                        PDF / GENERIC FILE
                        =========================================
                      {% endcomment %}

                      <div class="product-info-tabs__document">

                        {% if section.settings.show_pdf_preview %}

                          <div class="product-info-tabs__pdf-preview">

                            <iframe
                              src="{{ file.url }}"
                              title="{{ extracted_file_name | escape }}"
                              loading="lazy"
                            ></iframe>

                          </div>

                        {% endif %}


                        <div class="product-info-tabs__document-card">

                          <div class="product-info-tabs__document-icon">
                            PDF
                          </div>


                          <div class="product-info-tabs__document-info">

                            <strong>
                              {% if extracted_file_name != blank %}
                                {{ extracted_file_name }}
                              {% else %}
                                Product Document
                              {% endif %}
                            </strong>

                            <span>
                              PDF Document
                            </span>

                          </div>


                          <div class="product-info-tabs__document-buttons">

                            <a
                              href="{{ file.url }}"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              View PDF
                            </a>

                            <a
                              href="{{ file.url }}"
                              download
                            >
                              Download
                            </a>

                          </div>

                        </div>

                      </div>

                    {% endif %}

                  {% endif %}


                {% comment %}
                  =================================================
                  MULTIPLE FILES
                  =================================================
                {% endcomment %}

                {% elsif metafield_type == 'list.file_reference' %}

                  <div class="product-info-tabs__documents">

                    {% for file in metafield.value %}

                      {% if file != blank %}

                        {% comment %}
                          Extract actual filename from CDN URL
                        {% endcomment %}

                        {% assign file_url_without_query = file.url | split: '?' | first %}
                        {% assign extracted_file_name = file_url_without_query | split: '/' | last %}
                        {% assign extracted_file_name = extracted_file_name | url_decode %}


                        {% if file.media_type == 'image' %}

                          <div class="product-info-tabs__list-file product-info-tabs__list-file--image">

                            {{
                              file
                              | image_url: width: 1200
                              | image_tag:
                                loading: 'lazy',
                                class: 'product-info-tabs__list-image'
                            }}

                            <div class="product-info-tabs__list-file-name">

                              {% if extracted_file_name != blank %}
                                {{ extracted_file_name }}
                              {% else %}
                                Product Image
                              {% endif %}

                            </div>

                          </div>


                        {% elsif file.media_type == 'video' %}

                          <div class="product-info-tabs__list-file">

                            <video
                              controls
                              playsinline
                              preload="metadata"
                            >
                              <source src="{{ file.url }}">
                            </video>

                            <div class="product-info-tabs__list-file-name">

                              {% if extracted_file_name != blank %}
                                {{ extracted_file_name }}
                              {% else %}
                                Product Video
                              {% endif %}

                            </div>

                          </div>


                        {% else %}

                          <div class="product-info-tabs__document-card">

                            <div class="product-info-tabs__document-icon">
                              PDF
                            </div>


                            <div class="product-info-tabs__document-info">

                              <strong>
                                {% if extracted_file_name != blank %}
                                  {{ extracted_file_name }}
                                {% else %}
                                  Product Document
                                {% endif %}
                              </strong>

                              <span>
                                PDF Document
                              </span>

                            </div>


                            <div class="product-info-tabs__document-buttons">

                              <a
                                href="{{ file.url }}"
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                View PDF
                              </a>

                              <a
                                href="{{ file.url }}"
                                download
                              >
                                Download
                              </a>

                            </div>

                          </div>

                        {% endif %}

                      {% endif %}

                    {% endfor %}

                  </div>


                {% comment %}
                  =================================================
                  RICH TEXT
                  =================================================
                {% endcomment %}

                {% elsif metafield_type == 'rich_text_field' %}

                  <div class="product-info-tabs__richtext rte">
                    {{ metafield | metafield_tag }}
                  </div>


                {% comment %}
                  =================================================
                  MULTI LINE TEXT
                  =================================================
                {% endcomment %}

                {% elsif metafield_type == 'multi_line_text_field' %}

                  <div class="product-info-tabs__text">
                    {{ metafield.value | newline_to_br }}
                  </div>


                {% comment %}
                  =================================================
                  SINGLE LINE TEXT
                  =================================================
                {% endcomment %}

                {% elsif metafield_type == 'single_line_text_field' %}

                  <div class="product-info-tabs__text">
                    {{ metafield.value }}
                  </div>


                {% comment %}
                  =================================================
                  NUMBER
                  =================================================
                {% endcomment %}

                {% elsif metafield_type == 'number_integer'
                  or metafield_type == 'number_decimal'
                %}

                  <div class="product-info-tabs__text">
                    {{ metafield.value }}
                  </div>


                {% comment %}
                  =================================================
                  URL
                  =================================================
                {% endcomment %}

                {% elsif metafield_type == 'url' %}

                  <div class="product-info-tabs__document-card">

                    <div class="product-info-tabs__document-icon">
                      ↗
                    </div>

                    <div class="product-info-tabs__document-info">

                      <strong>
                        External Link
                      </strong>

                      <span>
                        {{ metafield.value }}
                      </span>

                    </div>

                    <div class="product-info-tabs__document-buttons">

                      <a
                        href="{{ metafield.value }}"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Open Link
                      </a>

                    </div>

                  </div>


                {% comment %}
                  =================================================
                  FALLBACK
                  =================================================
                {% endcomment %}

                {% else %}

                  <div class="product-info-tabs__richtext rte">
                    {{ metafield | metafield_tag }}
                  </div>

                {% endif %}

              {% endif %}

            </div>

            {% assign first_panel = false %}

          {% endif %}

        {% endfor %}

      </div>

    {% endif %}

  </div>
</section>


<style>

#ProductInfoTabs-{{ section.id }},
.product-info-tabs {

  width: 100%;

  {% if section.settings.enable_background %}
    background: {{ section.settings.background_color }};
  {% endif %}

  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;

}


.product-info-tabs__container {

  width: calc(100% - 40px);

  max-width: {{ section.settings.max_width }}px;

  margin: 0 auto;

}


/* ==========================================
   HEADER
========================================== */

.product-info-tabs__header {

  text-align: center;

  margin-bottom: 30px;

}


.product-info-tabs__header h2 {

  margin: 0 0 10px;

  font-size: 34px;

  line-height: 1.2;

  color: {{ section.settings.heading_color }};

}


.product-info-tabs__intro {

  max-width: 750px;

  margin: 0 auto;

  color: {{ section.settings.text_color }};

  opacity: .75;

  font-size: 15px;

  line-height: 1.7;

}


/* ==========================================
   TABS
========================================== */

.product-info-tabs__nav {

  display: flex;

  justify-content: center;

  gap: 0;

  border-bottom: 1px solid {{ section.settings.border_color }};

  overflow-x: auto;

  scrollbar-width: none;

}


.product-info-tabs__nav::-webkit-scrollbar {

  display: none;

}


.product-info-tabs__button {

  position: relative;

  flex: 0 0 auto;

  border: 0;

  background: transparent;

  padding: 18px 28px;

  cursor: pointer;

  color: {{ section.settings.text_color }};

  font: inherit;

  font-size: 18px;

  font-weight: 600;

  white-space: nowrap;

}


.product-info-tabs__button::after {

  content: "";

  position: absolute;

  bottom: -1px;

  left: 20px;

  right: 20px;

  height: 2px;

  background: {{ section.settings.active_color }};

  transform: scaleX(0);

  transition: transform .25s ease;

}


.product-info-tabs__button.active {

  color: {{ section.settings.active_color }};

  font-weight: 600;

}


.product-info-tabs__button.active::after {

  transform: scaleX(1);

}


/* ==========================================
   CONTENT
========================================== */

.product-info-tabs__panel {

  padding-top: 35px;

}


.product-info-tabs__panel[hidden] {

  display: none !important;

}


.product-info-tabs__content-heading {

  margin: 0 0 20px;

  color: {{ section.settings.heading_color }};

  font-size: 24px;

  line-height: 1.3;

}


.product-info-tabs__richtext,
.product-info-tabs__text {

  color: {{ section.settings.text_color }};

  font-size: 16px;

  line-height: 1.75;

}


.product-info-tabs__richtext > *:first-child {

  margin-top: 0;

}


.product-info-tabs__richtext > *:last-child {

  margin-bottom: 0;

}


/* ==========================================
   IMAGE
========================================== */

.product-info-tabs__image {

  width: 100%;

  overflow: hidden;

  border-radius: 8px;

}


.product-info-tabs__image-element {

  display: block;

  width: 100%;

  height: auto;

}


/* ==========================================
   VIDEO
========================================== */

.product-info-tabs__video video {

  display: block;

  width: 100%;

  max-width: 100%;

  border-radius: 8px;

}


/* ==========================================
   PDF PREVIEW
========================================== */

.product-info-tabs__pdf-preview {

  width: 100%;

  height: 700px;

  overflow: hidden;

  border: 1px solid {{ section.settings.border_color }};

  border-radius: 8px;

  background: #f7f7f7;

  margin-bottom: 20px;

}


.product-info-tabs__pdf-preview iframe {

  display: block;

  width: 100%;

  height: 100%;

  border: 0;

}


/* ==========================================
   DOCUMENT LIST
========================================== */

.product-info-tabs__documents {

  display: grid;

  gap: 14px;

}


.product-info-tabs__document {

  width: 100%;

}


.product-info-tabs__document-card {

  display: flex;

  align-items: center;

  gap: 18px;

  padding: 18px;

  border: 1px solid {{ section.settings.border_color }};

  border-radius: 8px;

  background: #fff;

}


.product-info-tabs__document-icon {

  flex: 0 0 55px;

  width: 55px;

  height: 55px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 7px;

  background: #ed5b3b;

  color: #fff;

  font-size: 12px;

  font-weight: 700;

}


.product-info-tabs__document-info {

  flex: 1;

  min-width: 0;

}


.product-info-tabs__document-info strong {

  display: block;

  color: {{ section.settings.heading_color }};

  font-size: 15px;

  line-height: 1.45;

  margin-bottom: 5px;

  overflow-wrap: anywhere;

}


.product-info-tabs__document-info span {

  display: block;

  color: {{ section.settings.text_color }};

  opacity: .6;

  font-size: 13px;

}


.product-info-tabs__document-buttons {

  display: flex;

  gap: 10px;

  flex-shrink: 0;

}


.product-info-tabs__document-buttons a {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-height: 42px;

  padding: 10px 17px;

  border-radius: 5px;

  background: {{ section.settings.active_color }};

  color: #fff !important;

  text-decoration: none;

  font-size: 13px;

  font-weight: 600;

  white-space: nowrap;

  transition: opacity .2s ease;

}


.product-info-tabs__document-buttons a:hover {

  opacity: .82;

}


/* ==========================================
   LIST IMAGE
========================================== */

.product-info-tabs__list-file--image {

  border: 1px solid {{ section.settings.border_color }};

  border-radius: 8px;

  overflow: hidden;

}


.product-info-tabs__list-image {

  display: block;

  width: 100%;

  height: auto;

}


.product-info-tabs__list-file-name {

  padding: 12px 15px;

  font-size: 14px;

  font-weight: 600;

  color: {{ section.settings.heading_color }};

  overflow-wrap: anywhere;

}


/* ==========================================
   MOBILE
========================================== */

@media screen and (max-width: 749px) {

  #ProductInfoTabs-{{ section.id }},
  .product-info-tabs {

    padding-top: {{ section.settings.mobile_padding_top }}px;

    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;

  }


  .product-info-tabs__container {

    width: calc(100% - 30px);

  }


  .product-info-tabs__header h2 {

    font-size: 28px;

  }


  .product-info-tabs__intro {

    font-size: 14px;

  }


  .product-info-tabs__nav {

    justify-content: flex-start;

  }


  .product-info-tabs__button {

    padding: 15px 18px;

    font-size: 14px;

  }


  .product-info-tabs__panel {

    padding-top: 25px;

  }


  .product-info-tabs__content-heading {

    font-size: 21px;

  }


  .product-info-tabs__richtext,
  .product-info-tabs__text {

    font-size: 14px;

  }


  .product-info-tabs__pdf-preview {

    height: 500px;

  }


  .product-info-tabs__document-card {

    flex-wrap: wrap;

    gap: 14px;

    padding: 15px;

  }


  .product-info-tabs__document-info {

    width: calc(100% - 70px);

  }


  .product-info-tabs__document-buttons {

    width: 100%;

  }


  .product-info-tabs__document-buttons a {

    flex: 1;

  }

}


@media screen and (max-width: 480px) {

  .product-info-tabs__document-buttons {

    display: grid;

    grid-template-columns: 1fr;

  }

}

</style>


<script>

(function() {

  function initProductTabs(section) {

    if (!section) return;

    const buttons = section.querySelectorAll(
      '.product-info-tabs__button'
    );

    const panels = section.querySelectorAll(
      '.product-info-tabs__panel'
    );


    if (!buttons.length) return;


    buttons.forEach(function(button) {

      button.addEventListener('click', function() {

        const target = button.getAttribute(
          'data-tab'
        );


        buttons.forEach(function(item) {

          item.classList.remove('active');

          item.setAttribute(
            'aria-selected',
            'false'
          );

        });


        panels.forEach(function(panel) {

          panel.hidden = true;

          panel.classList.remove('active');

        });


        button.classList.add('active');

        button.setAttribute(
          'aria-selected',
          'true'
        );


        const targetPanel = section.querySelector(
          '#' + target
        );


        if (targetPanel) {

          targetPanel.hidden = false;

          targetPanel.classList.add('active');

        }

      });

    });

  }


  const section = document.getElementById(
    'ProductInfoTabs-{{ section.id }}'
  );


  initProductTabs(section);


  document.addEventListener(
    'shopify:section:load',
    function(event) {

      if (
        event.target &&
        event.target.id ===
        'ProductInfoTabs-{{ section.id }}'
      ) {

        initProductTabs(event.target);

      }

    }
  );

})();

</script>


{% schema %}

{
  "name": "Product Dynamic Tabs",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Information"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Everything you need to know about this product."
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },

    {
      "type": "checkbox",
      "id": "enable_background",
      "label": "Enable background color",
      "default": true
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },

    {
      "type": "color",
      "id": "active_color",
      "label": "Active color",
      "default": "#ed5b3b"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#dddddd"
    },

    {
      "type": "checkbox",
      "id": "show_pdf_preview",
      "label": "Show PDF preview",
      "default": true
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
