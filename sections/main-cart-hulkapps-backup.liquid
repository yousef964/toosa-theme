<script src="{{ 'cart.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}


{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="main-cart section-cart{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif
      
  echo ' has-alignment-' | append: section.settings.alignment

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif
  
%}">
  <div class="section-main-cart-container section-container">
    <div class="cart-header">
        {% if section.settings.heading != blank %}
            <h2 class="cart-header-title cart-title special-heading-size-{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.count_show %}
          <p class="cart-header-count rte">
            <span class="cart-count">{{ cart.item_count }}</span> 
            {% if cart.item_count > 1 %}
              {{ 'sections.cart.item_count_text_html' | t }}
            {% else %}
              {{ 'sections.cart.item_count_single_text_html' | t }}
            {% endif %}
          </p>
        {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      {% comment %} <form class="cart-form" action="/cart" method="post" novalidate> {% endcomment %}
        {%- form 'cart', cart, class: 'cart-form', novalidate: 'novalidate' -%}
        <div class="cart-contents">
          <table>
            <thead>
              <th colspan="2">{{ 'sections.cart.headings.product' | t }}</th>
              <th>{{ 'sections.cart.headings.price' | t }}</th>
              <th>{{ 'sections.cart.headings.quantity' | t }}</th>
              <th>{{ 'sections.cart.headings.total' | t }}</th>
            </thead>
            <tbody class="cart-contents-products-list cart-products">
              {% for item in cart.items %}
                {% liquid
                  assign product = all_products[settings.cart_upsell_product]
                  assign variant = product.selected_or_first_available_variant
                %}
                <tr class="cart-contents-product cart-product{% liquid
                  if settings.cart_show_upsell
                    if item.id == variant.id
                      echo ' cart-product-upsell'
                    endif
                  endif
                %}" data-item-key="{{ item.key }}" data-item-id="{{ item.id }}">
                  <td class="cart-contents-product__thumbnail cart-product-thumbnail">
                    
                    {% liquid 
                        if item.product.has_only_default_variant == false
                            assign image = item.variant.featured_image

                            if image == blank
                                assign image = item.product.featured_image
                            endif
                        else 
                            assign image = item.product.featured_image
                        endif
                    %}

                    {% if image != blank %}
                        <a href="{{ item.url | within: collections.all }}">
                          {% render 'section-image-processor', image: image, width: 200 %}
                        </a>
                    {% endif %}
                  </td>
                  <td class="cart-contents-product__title">
                    <h3 class="cart-product-title"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                    {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
                      <dl>
                          {%- if item.product.has_only_default_variant == false -%}
                            {%- for option in item.options_with_values -%}
                                <div class="cart-product-variant">
                                    <dt>{{ option.name }}: </dt>
                                    <dd>{{ option.value }}</dd>
                                </div>
                            {%- endfor -%}
                          {%- endif -%}

                          {%- for property in item.properties -%}
                          {%- assign property_first_char = property.first | slice: 0 -%}
                          {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="cart-product-option">
                                  <dt>{{ property.first }}: </dt>
                                  <dd>
                                      {%- if property.last contains '/uploads/' -%}
                                      <a href="{{ property.last }}" class="link" target="_blank">
                                          {{ property.last | split: '/' | last }}
                                      </a>
                                      {%- else -%}
                                      {{ property.last }}
                                      {%- endif -%}
                                  </dd>
                              </div>
                          {%- endif -%}
                          {%- endfor -%}
                      </dl>
                      
                      {% if item.selling_plan_allocation %}
                          <span class="cart-product-selling-plan">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                      {% endif %}
                  {%- endif -%}

                    {% if item.line_level_discount_allocations != blank %}
                      <span class="cart-product-discounts">
                        <ul class="cart-product-discounts-list" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                          {%- for discount_allocation in item.line_level_discount_allocations -%}
                            <li class="cart-product-discounts-list-item">
                              <span class="cart-product-discounts-list-item__title">
                                {%- render 'icon-discount' -%}
                                <span>{{- discount_allocation.discount_application.title }}</span>
                              </span>
                              <span class="cart-product-discounts-list-item__amount">
                                (-{{ discount_allocation.amount | money -}})
                              </span>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </span>
                    {% endif %}
                  </td>
                  <td class="cart-contents-product__price cart-product-price">
                    {{ item.original_price | money }}
                    {% if item.unit_price_measurement %}
                      <span class="product-price-unit">
                          {%- capture unit_price_separator -%}
                          <span aria-hidden="true">/</span>
                          {%- endcapture -%}
                          {%- capture unit_price_base_unit -%}
                          <span class="product-price-unit-base" data-price-unit-base>
                              {%- if item.unit_price_measurement -%}
                                  {%- if item.unit_price_measurement.reference_value != 1 -%}
                                      {{- item.unit_price_measurement.reference_value -}}
                                  {%- endif -%}
                                  {{- item.unit_price_measurement.reference_unit -}}
                              {%- endif -%}
                          </span>
                          {%- endcapture -%}
                          <span class="product-price-unit-price" data-price-unit-price>{{ item.unit_price | money }}</span>{{- unit_price_separator -}}{{- unit_price_base_unit -}}
                      </span>
                    {% endif %}
                  </td>
                  <td class="cart-contents-product__qty cart-product-qty">

                    <label class="visually-hidden" for="ProductQuantityPickerInput-{{ item.key }}">{{ 'sections.cart.product.quantity' | t }}</label>
                    <product-quantity-picker class="product-quantity-picker qty">
                        <span class="product-quantity-picker__minus qty-minus">{% render 'icon-minus' %}</span>
                        <input 
                          id="ProductQuantityPickerInput-{{ item.key }}" 
                          type="number" 
                          id="{{ item.key }}" 
                          class="product-quantity-picker__input product-quantity-picker-input" 
                          name="{{ item.key }}" 
                          value="{{ item.quantity }}" 
                          min="0" 
                          {% liquid 
                            if item.variant.inventory_management != blank and item.variant.inventory_policy != 'continue'
                                echo 'max="' | append: item.variant.inventory_quantity | append: '"'
                            endif 
                          %} 
                          {% liquid 
                            if settings.cart_show_upsell
                              if item.id == variant.id
                                echo ' disabled'
                              endif
                            endif 
                          %} 
                          data-text-variant="{{ item.variant.title }}" 
                          data-text-qty-error="{{ 'products.product.add_to_cart_qty_error' | t: count: '%qty' }}"
                        >
                        <span class="product-quantity-picker__plus qty-plus">{% render 'icon-plus' %}</span>
                    </product-quantity-picker>
                    <a class="cart-contents-product__remove cart-product-remove" href="{{ routes.root_url }}cart/change?line={{ forloop.index }}&amp;quantity=0">
                      {% render 'icon-close' %}
                      <span>{{ 'sections.cart.remove_from_cart' | t }}</span>
                    </a>
                  </td>
                  <td class="cart-contents-product__total cart-product-total">
                    
                    <span class="cart-product-line-price">
                      {% if item.original_line_price != item.final_line_price and item.line_level_discount_allocations != blank %}
                          <span class="cart-product-original-line-price">
                          {{ item.original_line_price | money }}
                          </span>
                      {% endif %}
                      {% if item.discounts == blank %}
                        {{ item.original_line_price | money }}
                      {% else %}
                        {{ item.final_line_price | money }}
                      {% endif %}
                    </span>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if settings.cart_enable_free_shipping %}
            {% liquid
                assign free_shipping_amount_raw = settings.cart_free_shipping_threshold | times: 100 
                assign free_shipping_amount = free_shipping_amount_raw | money 
                assign balance = free_shipping_amount_raw | minus: cart.total_price | money
            %}
            <div class="cart-free-shipping" data-cart-total="{{ cart.total_price }}" data-min-amount="{{ free_shipping_amount_raw }}">
                <div class="cart-free-shipping-text{% liquid
                        unless cart.total_price < free_shipping_amount_raw
                            echo ' has-free-shipping'
                        endunless
                    %}">
                    <span class="cart-free-shipping-text__message">
                        {% if settings.cart_enable_free_shipping_message_type == 'balance' %}
                            {{ 'sections.cart.free_shipping_balance_html' | t: balance: balance }}
                        {% else %}
                            {{ 'sections.cart.free_shipping_html' | t: amount: free_shipping_amount }}
                        {% endif %}
                    </span>
                    <span class="cart-free-shipping-text__greeting">
                        {% render 'icon-set-feather', icon: 'gift' %}<span>{{ 'sections.cart.free_shipping_greeting' | t }}</span>
                    </span>
                </div>

                {% if settings.cart_enable_free_shipping_progress %}
                    {% liquid
                        assign bar_width = 100

                        if cart.total_price < free_shipping_amount_raw
                            assign bar_width = cart.total_price | times: 100.00 | divided_by: free_shipping_amount_raw
                        endif
                        
                    %}
                    <div class="cart-free-shipping-bar" style="--width: {{ bar_width }};">
                        <span></span>
                    </div>
                {% endif %}
            </div>
          {% endif %}
        </div>
        {% if settings.cart_show_upsell and settings.cart_upsell_product != blank  %}
          {% liquid
            assign isUpsellExist = false
            assign upsellQty = cart.item_count
            assign product = all_products[settings.cart_upsell_product]
            assign product_price = product.price | money_with_currency

            assign variant = product.selected_or_first_available_variant


            for item in cart.items
              if item.id == variant.id
                assign isUpsellExist = true
              endif
            endfor

            if isUpsellExist
              assign upsellQty = 0
            endif

          %}
          <div class="cart-upsell" data-item-id="{{ variant.id }}" data-item-qty="{{ upsellQty }}">
              <input 
                  id="cartGiftWrap"
                  type="checkbox" 
                  name="attributes[gift-wrapping]" 
                  {% if isUpsellExist %}
                      checked="checked"
                  {% endif %}
                  value="{{ settings.cart_upsell_product }}"
              >
              <label for="cartGiftWrap">
                <span>{{ settings.cart_upsell_text | append: product_price }}</span>
                {% render 'icon-check' %}
              </label>

          </div>
        {% endif %}
        <div class="cart-additional">
          {% if settings.cart_show_estimate %}
            {% render 'cart-shipping-calc' %}
          {% endif %}

          <div class="cart-totals">
            <h3 class="cart-totals-title">{{ 'sections.cart.cart_totals_title' | t }}</h3>
            {%- if settings.cart_show_order_notes -%}
                <details id="cart-note">
                  <summary class="cart-note__title">
                      <span>{{ 'sections.cart.note' | t }}</span>
                      {% render 'icon-chevron-down' %}
                  </summary>
                  <cart-note class="cart-note__content">
                    <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
                    <textarea id="CartDrawer-Note" class="cart-note__text" name="note">{{ cart.note }}</textarea>
                  </cart-note>
                </details>
            {%- endif -%}
            
            <div class="cart-totals-total">
              <span>{{ "sections.cart.total" | t }}</span>
              <span class="cart-total">{{ cart.original_total_price | money }}</span>
            </div>

            <div class="cart-totals-discounts{% unless cart.total_discount == 0 %} cart-has-discount{% endunless %}">
              <span class="cart-totals-discounts-title">{{ "sections.cart.discount" | t }}</span>
              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <ul class="cart-totals-discounts-list" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <li class="cart-totals-discounts-list-item">
                      {%- render 'icon-discount' -%}
                      <span>{{ discount.title }}</span>
                    </li>
                  {%- endfor -%}
                </ul>
              {% else %}
                  <ul class="cart-totals-discounts-list" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      <li class="cart-totals-discounts-list-item">
                          {% render 'icon-discount' %}
                      </li>
                  </ul>
              {%- endif -%}
              <span class="cart-discount">{{ cart.total_discount | money }}</span>
            </div>
              
            <div class="cart-totals-subtotal">
              <span>{{ "sections.cart.subtotal" | t }}</span>
              <span class="cart-total">{{ cart.total_price | money }}</span>
            </div>
            {{ form | payment_terms }}
            <small class="tax-note caption-large rte">
              {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
              {%- elsif cart.taxes_included -%}
                {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
              {%- elsif shop.shipping_policy.body != blank -%}
                {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
              {%- else -%}
                {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
              {%- endif -%}
            </small>
            <button type="submit" name="update" class="cart-button-update btn-outline-secondary">
              <span data-text="{{ 'sections.cart.update' | t }}">
                <span>
                  {{ 'sections.cart.update' | t }}
                </span>
              </span>
            </button>

            <button type="submit" name="checkout" class="cart-button-checkout btn-fill-secondary">
              <span data-text="{{ 'sections.cart.checkout' | t }}">
                <span>
                  {{ 'sections.cart.checkout' | t }}
                </span>
              </span>
            </button>

            {% if additional_checkout_buttons %}
              {{ content_for_additional_checkout_buttons }}
            {% endif %}

          </div>
        </div>
        {% endform %}
      {% comment %} </form> {% endcomment %}
    {% else %}
      <p>{{ 'sections.cart.empty' | t }}</p>
    {% endif %}
  </div>
</div>
  


{% schema %}
{"name":"t:sections.main_cart.name","settings":[{"type":"header","content":"t:sections.common.settings.header__general.content"},{"type":"checkbox","id":"fullwidth","label":"t:sections.common.settings.fullwidth.label","info":"t:sections.common.settings.fullwidth.info","default":true},{"type":"range","id":"width","min":500,"max":2000,"step":20,"unit":"px","label":"t:sections.common.settings.width.label","default":1320,"info":"t:sections.common.settings.width.info"},{"type":"select","id":"side_margin_choice","label":"t:sections.common.settings.side_margin_choice.label","options":[{"value":"level-0","label":"t:sections.common.settings.side_margin_choice.options.option__0.label"},{"value":"level-1","label":"t:sections.common.settings.side_margin_choice.options.option__1.label"},{"value":"level-2","label":"t:sections.common.settings.side_margin_choice.options.option__2.label"},{"value":"level-3","label":"t:sections.common.settings.side_margin_choice.options.option__3.label"},{"value":"level-4","label":"t:sections.common.settings.side_margin_choice.options.option__4.label"},{"value":"level-5","label":"t:sections.common.settings.side_margin_choice.options.option__5.label"}],"info":"t:sections.common.settings.side_margin_choice.info","default":"level-4"},{"type":"color_scheme","id":"color_scheme","default":"scheme_1","label":"t:sections.common.settings.color_scheme.label"},{"type":"checkbox","id":"inset","label":"t:sections.main_cart.settings.inset.label","default":false},{"type":"select","id":"inset_choice","label":"t:sections.common.settings.inset_choice.label","options":[{"value":"level-1","label":"t:sections.common.settings.inset_choice.options.option__0.label"},{"value":"level-2","label":"t:sections.common.settings.inset_choice.options.option__1.label"},{"value":"level-3","label":"t:sections.common.settings.inset_choice.options.option__2.label"},{"value":"level-4","label":"t:sections.common.settings.inset_choice.options.option__3.label"},{"value":"level-5","label":"t:sections.common.settings.inset_choice.options.option__4.label"}],"default":"level-3"},{"type":"header","content":"t:sections.common.settings.header__cart.content"},{"type":"text","id":"heading","label":"t:sections.main_cart.settings.heading.label","default":"Bag"},{"type":"select","id":"heading_size","label":"t:sections.main_cart.settings.heading_size.label","options":[{"value":"x-small","label":"t:sections.main_cart.settings.heading_size.options.option__0.label"},{"value":"small","label":"t:sections.main_cart.settings.heading_size.options.option__1.label"},{"value":"medium","label":"t:sections.main_cart.settings.heading_size.options.option__2.label"},{"value":"large","label":"t:sections.main_cart.settings.heading_size.options.option__3.label"}],"default":"medium"},{"type":"select","id":"alignment","label":"t:sections.main_cart.settings.alignment.label","options":[{"value":"left","label":"t:sections.main_cart.settings.alignment.options.option__0.label"},{"value":"center","label":"t:sections.main_cart.settings.alignment.options.option__1.label"},{"value":"right","label":"t:sections.main_cart.settings.alignment.options.option__2.label"}],"default":"left"},{"type":"checkbox","id":"count_show","label":"t:sections.main_cart.settings.count_show.label","default":true}],"enabled_on":{"templates":["cart"]}}
{% endschema %}

