{% comment %}
  TOOSA POSITIONING SECTION
  Shopify OS 2.0 / Refine Theme Compatible
  Responsive: Desktop / Laptop / Tablet / Mobile
{% endcomment %}

<section
  id="ToosaPositioning-{{ section.id }}"
  class="toosa-positioning"
  style="
    --tp-bg: {{ section.settings.background_color }};
    --tp-heading: {{ section.settings.heading_color }};
    --tp-text: {{ section.settings.text_color }};
    --tp-accent: {{ section.settings.accent_color }};
    --tp-chart-bg: {{ section.settings.chart_background }};
    --tp-chart-border: {{ section.settings.chart_border }};
    --tp-max-width: {{ section.settings.max_width }}px;
    --tp-content-width: {{ section.settings.content_width }}px;
    --tp-gap: {{ section.settings.column_gap }}px;
    --tp-top-padding: {{ section.settings.desktop_top_padding }}px;
    --tp-bottom-padding: {{ section.settings.desktop_bottom_padding }}px;
    --tp-image-radius: {{ section.settings.image_radius }}px;
  "
>
  <div class="toosa-positioning__inner">

    <!-- LEFT CONTENT -->
    <div class="toosa-positioning__content">

      {% if section.settings.eyebrow != blank %}
        <div class="toosa-positioning__eyebrow">
          <span class="toosa-positioning__eyebrow-line"></span>
          <span>{{ section.settings.eyebrow }}</span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="toosa-positioning__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="toosa-positioning__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>


    <!-- RIGHT IMAGE -->
    <div class="toosa-positioning__visual">

      {% if section.settings.chart_image != blank %}

        <div class="toosa-positioning__image-wrap">

          {{
            section.settings.chart_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1400, 1600',
              sizes: '(max-width: 749px) calc(100vw - 32px), (max-width: 989px) 650px, 48vw',
              class: 'toosa-positioning__image',
              alt: section.settings.chart_image.alt | default: section.settings.heading
          }}

        </div>

      {% else %}

        <!-- Placeholder shown before image is selected -->
        <div class="toosa-positioning__image-wrap toosa-positioning__placeholder">

          <div class="toosa-positioning__placeholder-inner">

            <svg
              width="42"
              height="42"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M4 5.5C4 4.67 4.67 4 5.5 4h13c.83 0 1.5.67 1.5 1.5v13c0 .83-.67 1.5-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-13Z"
                stroke="currentColor"
                stroke-width="1.4"
              />
              <circle
                cx="9"
                cy="9"
                r="1.6"
                stroke="currentColor"
                stroke-width="1.4"
              />
              <path
                d="m5.5 17 4.2-4.1a1 1 0 0 1 1.4 0l2 2 1.5-1.5a1 1 0 0 1 1.4 0l2.5 2.5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <span>Select chart image</span>

          </div>

        </div>

      {% endif %}

    </div>

  </div>


  <!-- FOOTNOTE -->
  {% if section.settings.footnote != blank %}
    <div class="toosa-positioning__footnote">
      {{ section.settings.footnote }}
    </div>
  {% endif %}

</section>


<style>
  /* =========================================================
     TOOSA POSITIONING
     ========================================================= */

  #ToosaPositioning-{{ section.id }} {
    width: 100%;
    display: block;

    background: var(--tp-bg);
    color: var(--tp-text);

    overflow: hidden;

    box-sizing: border-box;
  }


  #ToosaPositioning-{{ section.id }} *,
  #ToosaPositioning-{{ section.id }} *::before,
  #ToosaPositioning-{{ section.id }} *::after {
    box-sizing: border-box;
  }


  /* =========================================================
     MAIN CONTAINER
     ========================================================= */

  #ToosaPositioning-{{ section.id }} .toosa-positioning__inner {
    width: min(
      var(--tp-max-width),
      calc(100% - 80px)
    );

    margin-left: auto;
    margin-right: auto;

    padding-top: var(--tp-top-padding);
    padding-bottom: var(--tp-bottom-padding);

    display: grid;

    grid-template-columns:
      minmax(0, 1.35fr)
      minmax(350px, 0.82fr);

    column-gap: var(--tp-gap);

    align-items: center;
  }


  /* =========================================================
     LEFT CONTENT
     ========================================================= */

  #ToosaPositioning-{{ section.id }} .toosa-positioning__content {
    width: 100%;
    max-width: var(--tp-content-width);

    min-width: 0;
  }


  /* =========================================================
     EYEBROW
     ========================================================= */

  #ToosaPositioning-{{ section.id }} .toosa-positioning__eyebrow {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 20px;
    color: var(--tp-accent);
    font-size: 16px;
    text-transform: uppercase;
  }


  #ToosaPositioning-{{ section.id }} .toosa-positioning__eyebrow-line {
    width: 25px;
    height: 2px;

    flex: 0 0 25px;

    display: block;

    background: var(--tp-accent);
  }


  /* =========================================================
     HEADING
     ========================================================= */

  #ToosaPositioning-{{ section.id }} .toosa-positioning__heading {
    margin: 0 0 15px;
    color: var(--tp-heading);
    font-size: 36px;
    font-weight: 700;
  }


  /* =========================================================
     DESCRIPTION
     ========================================================= */

  #ToosaPositioning-{{ section.id }} .toosa-positioning__description {
    color: var(--tp-text);
    font-size: 18px;
  }


  #ToosaPositioning-{{ section.id }} .toosa-positioning__description p {
    margin: 0;
  }


  #ToosaPositioning-{{ section.id }} .toosa-positioning__description p + p {
    margin-top: 12px;
  }


  /* =========================================================
     RIGHT IMAGE
     ========================================================= */

  #ToosaPositioning-{{ section.id }} .toosa-positioning__visual {
    width: 100%;

    min-width: 0;
  }


  #ToosaPositioning-{{ section.id }} .toosa-positioning__image-wrap {
    position: relative;

    width: 100%;

    overflow: hidden;

    background: var(--tp-chart-bg);

    border: 1px solid var(--tp-chart-border);

    border-radius: var(--tp-image-radius);

    line-height: 0;
  }


  #ToosaPositioning-{{ section.id }} .toosa-positioning__image {
    display: block;

    width: 100%;
    height: auto;

    max-width: 100%;

    object-fit: contain;

    object-position: center;

    margin: 0;
  }


  /* =========================================================
     PLACEHOLDER
     ========================================================= */

  #ToosaPositioning-{{ section.id }} .toosa-positioning__placeholder {
    aspect-ratio: 1.46 / 1;

    display: flex;

    align-items: center;
    justify-content: center;

    color: #89929b;

    background: var(--tp-chart-bg);
  }


  #ToosaPositioning-{{ section.id }} .toosa-positioning__placeholder-inner {
    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 10px;

    color: #89929b;

    font-family: inherit;

    font-size: 13px;

    line-height: 1.3;

    text-align: center;
  }


  /* =========================================================
     FOOTNOTE
     ========================================================= */

  #ToosaPositioning-{{ section.id }} .toosa-positioning__footnote {
    width: min(
      1020px,
      calc(100% - 48px)
    );

    margin-left: auto;
    margin-right: auto;

    padding-bottom: 18px;

    color: #6d7882;

    font-family: inherit;

    font-size: 12px;

    line-height: 1.5;

    font-weight: 400;

    letter-spacing: 0.05px;

    text-align: center;
  }




  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    #ToosaPositioning-{{ section.id }} .toosa-positioning__inner {
      width: calc(100% - 40px);

      grid-template-columns: 1fr;

      row-gap: 27px;

      padding: 30px 10px;

    }


    #ToosaPositioning-{{ section.id }} .toosa-positioning__eyebrow {
      margin-bottom: 15px;
      font-size: 14px;
      gap: 9px;
    }


    #ToosaPositioning-{{ section.id }} .toosa-positioning__eyebrow-line {
      width: 21px;
      flex-basis: 21px;
    }


    #ToosaPositioning-{{ section.id }} .toosa-positioning__heading {
      margin-bottom: 13px;
      font-size: 28px;
    }


    #ToosaPositioning-{{ section.id }} .toosa-positioning__description {
      font-size: 16px;
    }


    #ToosaPositioning-{{ section.id }} .toosa-positioning__image-wrap {
      width: 100%;
    }


    #ToosaPositioning-{{ section.id }} .toosa-positioning__placeholder {
      aspect-ratio: 1.25 / 1;
    }


    #ToosaPositioning-{{ section.id }} .toosa-positioning__footnote {
      width: calc(100% - 32px);

      padding-bottom: 18px;

      font-size: 10px;

      line-height: 1.45;
    }

  }


  /* =========================================================
     ACCESSIBILITY
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    #ToosaPositioning-{{ section.id }} *,
    #ToosaPositioning-{{ section.id }} *::before,
    #ToosaPositioning-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition: none !important;
      animation: none !important;
    }

  }

</style>


{% schema %}
{
  "name": "TOOSA Positioning",
  "tag": "section",
  "class": "section-toosa-positioning",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHERE TOOSA SITS"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Snap-on quality expectations, without the Snap-on invoice"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Positioned the way Canadian workshops actually shop: not the unverified marketplace box, not the premium truck brand — the durable, supported middle that most garages and shops are really looking for.</p>"
    },

    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Illustrative positioning, not to scale — based on published Snap-on features, forum-reported Temu quality issues, and TOOSA's own construction (see sources in the appendix)."
    },


    {
      "type": "header",
      "content": "Right Side Image"
    },

    {
      "type": "image_picker",
      "id": "chart_image",
      "label": "Chart / Right Image"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 800,
      "max": 1600,
      "step": 10,
      "unit": "px",
      "default": 1080
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Left content width",
      "min": 400,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 560
    },

    {
      "type": "range",
      "id": "column_gap",
      "label": "Desktop column gap",
      "min": 20,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 72
    },

    {
      "type": "range",
      "id": "desktop_top_padding",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 42
    },

    {
      "type": "range",
      "id": "desktop_bottom_padding",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    {
      "type": "range",
      "id": "image_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f3f4f5"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#202c3a"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#63717e"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#ff6941"
    },

    {
      "type": "color",
      "id": "chart_background",
      "label": "Image background",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "chart_border",
      "label": "Image border",
      "default": "#dce0e3"
    }

  ],

  "presets": [
    {
      "name": "TOOSA Positioning"
    }
  ]

}
{% endschema %}
