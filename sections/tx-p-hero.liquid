{% comment %} TOOSA inner pages: page hero (image right, background image, or type only) {% endcomment %}
{%- liquid
  assign s = section.settings
  assign title = s.heading | default: page.title
  assign theme_class = 'txp'
  if s.theme == 'light'
    assign theme_class = 'txp txp--paper txp-hero--light'
  endif
  assign img = s.image
  if img == blank and s.product != blank
    assign img = s.product.featured_image
  endif
  assign layout = s.layout
  if img == blank and layout != 'none'
    assign layout = 'none'
  endif
  assign tag = 'h1'
  if s.use_h2
    assign tag = 'h2'
  endif
-%}
<section class="{{ theme_class }} txp-hero txp-hero--{{ layout }}" id="txp-hero-{{ section.id }}">
  {%- if layout == 'bg' and img != blank -%}
    <div class="txp-hero__bg">{{ img | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2400', sizes: '100vw', alt: img.alt | default: title }}</div>
  {%- else -%}
    <div class="txp-hero__grain"></div>
  {%- endif -%}
  <div class="txp-wrap txp-hero__grid">
    <div class="txp-hero__copy">
      {%- if s.show_crumbs -%}
        <nav class="txp-crumbs txp-reveal" aria-label="Breadcrumb"><a href="/">Home</a><span>{{ title }}</span></nav>
      {%- endif -%}
      {%- if s.eyebrow != blank -%}<p class="txp-eyebrow txp-reveal">{{ s.eyebrow }}</p>{%- endif -%}
      <{{ tag }} class="txp-h1 txp-hero__title txp-reveal" data-delay="1">{{ title }}</{{ tag }}>
      {%- if s.lead != blank -%}<div class="txp-lead txp-reveal" data-delay="2">{{ s.lead }}</div>{%- endif -%}
      {%- if s.show_ul -%}<div class="txp-hero__badge txp-reveal" data-delay="3">{% render 'tx-p-ul', size: 'md', text: s.ul_text, tone: 'dark' %}</div>{%- endif -%}
      {%- if s.btn1_text != blank or s.btn2_text != blank -%}
        <div class="txp-actions txp-reveal" data-delay="3">
          {%- if s.btn1_text != blank -%}<a class="txp-btn txp-btn--primary" href="{{ s.btn1_url }}">{{ s.btn1_text }}{% render 'tx-p-icon', name: 'arrow' %}</a>{%- endif -%}
          {%- if s.btn2_text != blank -%}<a class="txp-btn txp-btn--ghost" href="{{ s.btn2_url }}">{{ s.btn2_text }}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="txp-hero__stats txp-reveal" data-delay="4">
          {%- for block in section.blocks -%}
            <div class="txp-hero__stat" {{ block.shopify_attributes }}><b class="txp-count">{{ block.settings.big }}</b><span>{{ block.settings.small }}</span></div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- if layout == 'right' and img != blank -%}
      <div class="txp-hero__media txp-reveal" data-delay="2">
        <div class="txp-hero__glow"></div>
        <div class="txp-hero__frame" data-txp-frame>
          {{ img | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 46vw, 92vw', alt: img.alt | default: title }}
          {%- if s.chip_big != blank -%}<div class="txp-hero__chip"><b>{{ s.chip_big }}</b><span>{{ s.chip_small }}</span></div>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "TX Page hero",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "right", "options": [
      { "value": "right", "label": "Image on the right" },
      { "value": "bg", "label": "Full background image" },
      { "value": "none", "label": "Type only" } ] },
    { "type": "select", "id": "theme", "label": "Colour", "default": "dark", "options": [
      { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light paper" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title" },
    { "type": "checkbox", "id": "use_h2", "label": "Render heading as H2 (when another section holds the H1)", "default": false },
    { "type": "richtext", "id": "lead", "label": "Lead paragraph" },
    { "type": "checkbox", "id": "show_crumbs", "label": "Show breadcrumb", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "product", "id": "product", "label": "Or use a product's featured image" },
    { "type": "text", "id": "chip_big", "label": "Image chip, big text" },
    { "type": "text", "id": "chip_small", "label": "Image chip, small text" },
    { "type": "checkbox", "id": "show_ul", "label": "Show the UL badge", "default": false },
    { "type": "text", "id": "ul_text", "label": "UL badge line" },
    { "type": "text", "id": "btn1_text", "label": "Primary button" },
    { "type": "url", "id": "btn1_url", "label": "Primary link" },
    { "type": "text", "id": "btn2_text", "label": "Secondary button" },
    { "type": "url", "id": "btn2_url", "label": "Secondary link" }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "limit": 3, "settings": [
      { "type": "text", "id": "big", "label": "Big text" },
      { "type": "text", "id": "small", "label": "Small text" } ] }
  ],
  "presets": [ { "name": "TX Page hero" } ]
}
{% endschema %}
