{% style %}
#shopify-section-{{ section.id }} {
  
  --theme-image-with-icon-cards-cards-gap: var(--theme-gap-{{ section.settings.cards_gap_choice }});

  --theme-image-with-icon-cards-image-width: {{ section.settings.image_content_width_split | append: '%' }};
  --theme-image-with-icon-cards-content-width: calc(100% - {{ section.settings.image_content_width_split | append: '%' }});

  --theme-image-with-icon-cards-columns: {{ section.settings.columns_count }};

  {% if section.settings.content_custom_width %}
    --theme-image-with-icon-cards-content-inner-width: {{ section.settings.content_width | append: 'px' }};
  {% endif %}


}
{% endstyle %}

{% style %}
  {% for block in section.blocks %}
  #shopify-section-{{ section.id }} .block-{{ block.id }} {
    --theme-image-with-icon-cards-card-icon-width: {{ block.settings.icon_width | append: 'px' }};

  }
  {% endfor %}
{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

    {% if section.settings.inset %}
      --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
    {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-image-with-icon-cards{% liquid 

  if section.settings.icon_background_show
    echo ' has-icon-background'
  endif

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-image-with-icon-cards-container section-container">
    <div class="section-image-with-icon-cards-image">
      {% if section.settings.image != blank %}
        {% render 'section-image-processor', image: section.settings.image %}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder placeholder-image-with-icon-cards' }}
      {% endif %}
    </div>
    <div class="section-image-with-icon-cards-content{% liquid
    
      echo ' content-text-align-' | append: section.settings.content_text_align
  
    %}">
      <div class="section-image-with-icon-cards-content-inner">
        {% if section.settings.text_1 != blank or section.settings.text_2 != blank %}
            <div class="section-image-with-icon-cards-header">
              {% if section.settings.text_1 != blank %}
                <h2 class="section-image-with-icon-cards-header__heading special-heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
              {% endif %}

              {% if section.settings.text_2 != blank %}
                <p class="section-image-with-icon-cards-header__description paragraph-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</p>
              {% endif %}
            </div>
        {% endif %}
        {% if section.blocks != blank %}
          <div class="section-image-with-icon-cards-list">
          {% for block in section.blocks %}
              <div class="section-image-with-icon-cards-card block-{{ block.id }}" {{ block.shopify_attributes }}>
                  {% if block.settings.icon != blank %}
                    {% if block.settings.icon contains ':' %}
                      {% liquid 
                        assign icon_set_array = block.settings.icon | split: ':' 
                        assign icon_name = icon_set_array[1]
                      %}
                      {% if icon_set_array[0] == 'theme' %}
                        <div class="section-image-with-icon-cards-card__icon">{% render 'icon-set-theme', icon: icon_name %}</div>
                      {% endif %}
                    {% else %}
                      <div class="section-image-with-icon-cards-card__icon">{% render 'icon-set-feather', icon: block.settings.icon %}</div>
                    {% endif %}
                  {% endif %}

                  {% if block.settings.text_1 != blank %}
                    <h3 class="section-image-with-icon-cards-card__heading heading-size-{{ block.settings.text_1_size }}">{{ block.settings.text_1 }}</h3>
                  {% endif %}
                  {% if block.settings.text_2 != blank %}
                      <div class="section-image-with-icon-cards-card__description">{{ block.settings.text_2 }}</div>
                  {% endif %}
                  {% if block.settings.button_text != blank %}
                      {% render 'button', 
                          button_text: block.settings.button_text,  
                          button_url: block.settings.button_url,
                          button_style: block.settings.button_style,
                          button_classes: 'section-image-with-icon-cards-card__button',
                          button_target: block.settings.button_target
                      %}
                  {% endif %}
              </div>
          {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


