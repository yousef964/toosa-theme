<section
  id="CompressorCTA-{{ section.id }}"
  class="compressor-cta-section"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="compressor-cta-section__inner">

    <!-- Eyebrow -->
    <div class="compressor-cta-section__eyebrow">
      <span class="compressor-cta-section__eyebrow-line"></span>
      <span>{{ section.settings.eyebrow }}</span>
    </div>

    <!-- Main Content -->
    <div class="compressor-cta-section__content">

      {% if section.settings.heading != blank %}
        <h2 class="compressor-cta-section__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="compressor-cta-section__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <!-- Buttons -->
      <div class="compressor-cta-section__buttons">

        {% if section.settings.button_1_text != blank %}
          <a
            class="compressor-cta-section__button compressor-cta-section__button--primary"
            href="{{ section.settings.button_1_link | default: '#' }}"
          >
            {{ section.settings.button_1_text }}
          </a>
        {% endif %}

        {% if section.settings.button_2_text != blank %}
          <a
            class="compressor-cta-section__button compressor-cta-section__button--secondary"
            href="{{ section.settings.button_2_link | default: '#' }}"
          >
            {{ section.settings.button_2_text }}
          </a>
        {% endif %}

        {% if section.settings.button_3_text != blank %}
          <a
            class="compressor-cta-section__button compressor-cta-section__button--secondary"
            href="{{ section.settings.button_3_link | default: '#' }}"
          >
            {{ section.settings.button_3_text }}
          </a>
        {% endif %}

      </div>

    </div>
  </div>
</section>


<style>
  /* =========================================================
     COMPRESSOR CTA
     ========================================================= */

  #CompressorCTA-{{ section.id }} {
    width: 100%;
    display: block;
    position: relative;

    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};

    overflow: hidden;

    border-bottom: 3px solid {{ section.settings.bottom_border_color }};
  }

  #CompressorCTA-{{ section.id }},
  #CompressorCTA-{{ section.id }} * {
    box-sizing: border-box;
  }


  /* =========================================================
     INNER
     ========================================================= */

  #CompressorCTA-{{ section.id }} .compressor-cta-section__inner {
    position: relative;
    width: 100%;
    padding: 60px 30px;

    display: block;
  }


  /* =========================================================
     EYEBROW
     ========================================================= */

  #CompressorCTA-{{ section.id }} .compressor-cta-section__eyebrow {
     text-align: center;
    display: flex;
    align-items: center;
    
    gap: 9px;
    margin: 0;
    padding: 0;
    color: {{ section.settings.text_color }};
    font-family: inherit;
    font-size: 16px;
    text-transform: uppercase;
    white-space: nowrap;
        justify-content: center;
    gap: 7px;
  }


  #CompressorCTA-{{ section.id }} .compressor-cta-section__eyebrow-line {
    display: block;

    width: 20px;
    height: 1px;

    flex: 0 0 20px;

    background: currentColor;
  }


  /* =========================================================
     MAIN CONTENT
     ========================================================= */

  #CompressorCTA-{{ section.id }} .compressor-cta-section__content {
    width: 100%;
    max-width: 1024px;

    margin: 0 auto;

    padding-top: 20px;

    text-align: center;
  }


  /* =========================================================
     HEADING
     ========================================================= */

  #CompressorCTA-{{ section.id }} .compressor-cta-section__heading {
    display: block;
    margin: 0;
    padding: 0;
    color: {{ section.settings.text_color }};
    font-size: 36px;
    font-weight: 700;
    text-align: center;
  }


  /* =========================================================
     DESCRIPTION
     ========================================================= */

  #CompressorCTA-{{ section.id }} .compressor-cta-section__description {
    width: 100%;
    margin: 3px auto 0;
    padding: 0;
    color: {{ section.settings.text_color }};
    font-size: 18px;
    text-align: center;
  }


  /* =========================================================
     BUTTON WRAPPER
     ========================================================= */

  #CompressorCTA-{{ section.id }} .compressor-cta-section__buttons {
    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 10px;

    width: 100%;

    margin-top: 24px;
  }


  /* =========================================================
     BUTTON BASE
     ========================================================= */

  #CompressorCTA-{{ section.id }} .compressor-cta-section__button {
       display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 19px;
    border: 1px solid transparent;
    border-radius: 0;
    padding: 12px 22px;
    font-size: 16px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }


  /* =========================================================
     PRIMARY BUTTON
     ========================================================= */

  #CompressorCTA-{{ section.id }} .compressor-cta-section__button--primary {
    background: {{ section.settings.primary_button_color }};
    color: {{ section.settings.primary_button_text_color }};

    border-color: {{ section.settings.primary_button_color }};
  }


  #CompressorCTA-{{ section.id }} .compressor-cta-section__button--primary:hover {
    background: {{ section.settings.primary_button_text_color }};
    color: {{ section.settings.primary_button_color }};

    border-color: {{ section.settings.primary_button_text_color }};

    transform: translateY(-1px);
  }


  /* =========================================================
     SECONDARY BUTTONS
     ========================================================= */

  #CompressorCTA-{{ section.id }} .compressor-cta-section__button--secondary {
    background: transparent;

    color: {{ section.settings.secondary_button_text_color }};

    border-color: {{ section.settings.secondary_button_border_color }};
  }


  #CompressorCTA-{{ section.id }} .compressor-cta-section__button--secondary:hover {
    background: {{ section.settings.secondary_button_text_color }};

    color: {{ section.settings.background_color }};

    border-color: {{ section.settings.secondary_button_text_color }};

    transform: translateY(-1px);
  }


  /* =========================================================
     FOCUS
     ========================================================= */

  #CompressorCTA-{{ section.id }} .compressor-cta-section__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }


  /* =========================================================
     TABLET
     ========================================================= */

  @media screen and (max-width: 989px) {
    #CompressorCTA-{{ section.id }} .compressor-cta-section__eyebrow {
      position: static;

      margin-bottom: 26px;

      justify-content: center;
    }

    #CompressorCTA-{{ section.id }} .compressor-cta-section__content {
      max-width: 760px;

      padding-top: 0;
    }
  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    #CompressorCTA-{{ section.id }} {
      border-bottom-width: 3px;
    }

    #CompressorCTA-{{ section.id }} .compressor-cta-section__inner {
      min-height: auto;

      padding: 60px 30px 60px;
    }


    /* Eyebrow */

    #CompressorCTA-{{ section.id }} .compressor-cta-section__eyebrow {
      position: static;
      width: 100%;
      margin: 0 0 22px;
      justify-content: center;
      font-size: 14px;
    }

    #CompressorCTA-{{ section.id }} .compressor-cta-section__eyebrow-line {
      width: 20px;
      flex-basis: 20px;
    }


    /* Content */

    #CompressorCTA-{{ section.id }} .compressor-cta-section__content {
      width: 100%;
      max-width: 100%;

      padding: 0;
    }


    /* Heading */
 #CompressorCTA-{{ section.id }} .compressor-cta-section__heading {
      font-size: 28px;
    }


    /* Description */

    #CompressorCTA-{{ section.id }} .compressor-cta-section__description {
      margin-top: 12px;
      font-size: 16px;
    }


    /* Buttons */

    #CompressorCTA-{{ section.id }} .compressor-cta-section__buttons {
      width: 100%;

      margin-top: 25px;

      display: flex;
      flex-direction: column;

      gap: 10px;
    }


    #CompressorCTA-{{ section.id }} .compressor-cta-section__button {
          width: 100%;
        font-size: 14px;
        padding: 10px 12px;
    }
  }


  /* =========================================================
     SMALL MOBILE
     ========================================================= */

  @media screen and (max-width: 380px) {
    #CompressorCTA-{{ section.id }} .compressor-cta-section__button {
      min-height: 46px;

      font-size: 13px;
    }
  }


  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    #CompressorCTA-{{ section.id }} .compressor-cta-section__button {
      transition: none;
    }

    #CompressorCTA-{{ section.id }} .compressor-cta-section__button:hover {
      transform: none;
    }
  }
</style>


{% schema %}
{
  "name": "Compressor CTA",
  "tag": "section",
  "class": "section-compressor-cta",
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Compressor call to action"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "READY WHEN YOU ARE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build it your way."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Order the compressor, request a quote for your shop, or come hear it run at the Richmond showroom."
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button text",
      "default": "Buy now — $15,777"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button text",
      "default": "Request a quote"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Button 3"
    },
    {
      "type": "text",
      "id": "button_3_text",
      "label": "Button text",
      "default": "Book a showroom visit"
    },
    {
      "type": "url",
      "id": "button_3_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FF6B3D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "primary_button_color",
      "label": "Primary button color",
      "default": "#182735"
    },
    {
      "type": "color",
      "id": "primary_button_text_color",
      "label": "Primary button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_button_border_color",
      "label": "Secondary button border color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_button_text_color",
      "label": "Secondary button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "bottom_border_color",
      "label": "Bottom border color",
      "default": "#182735"
    }
  ],
  "presets": [
    {
      "name": "Compressor CTA"
    }
  ]
}
{% endschema %}
