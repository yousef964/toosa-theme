{% style %}
#shopify-section-{{ section.id }}{
  {% if section.settings.gap %}
    --theme-image-with-pins-gap: var(--theme-gap-{{ section.settings.gap_choice }});
    {% else %}
      --theme-image-with-pins-gap: 0px;
  {% endif %}


    --theme-image-with-pins-image-width: {{ section.settings.image_content_width_split | append: '%' }};

    --theme-image-with-pins-content-width: calc(100% - {{ section.settings.image_content_width_split | append: '%' }});
}
{% endstyle %}

{% style %}
  {% for block in section.blocks %}
    {% if block.type == 'pin' %}
        #shopify-section-{{ section.id }} .block-{{ block.id }}{
          --theme-image-with-pin-pin-offset-top: {{ block.settings.pin_top_offset | append: '%' }};
          --theme-image-with-pin-pin-offset-left: {{ block.settings.pin_left_offset | append: '%' }};
        }

    {% endif %}

  {% endfor %}
{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}


  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}



<image-pins class="section-image-pins{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-image-pins-container section-container">
    {% if section.settings.text_1 != blank or section.settings.text_2 != blank or section.settings.text_3 != blank or section.settings.button_text != blank  %}
    <div class="section-image-pins-header">
      {% if section.settings.text_1 != blank or section.settings.text_2 != blank or section.settings.text_3 != blank %}
        <div class="section-image-pins-header__texts">

          {% if section.settings.text_2 != blank %}
            <div class="section-image-pins-header__additional-heading heading-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</div>
          {% endif %}

          {% if section.settings.text_1 != blank %}
            <h2 class="section-image-pins-header__heading special-heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
          {% endif %}

          {% if section.settings.text_3 != blank %}
            <p class="section-image-pins-header__description paragraph-size-{{ section.settings.text_3_size }}">{{ section.settings.text_3 }}</p>
          {% endif %}

        </div>
      {% endif %}
      {% if section.settings.button_text != blank %}
        {% render 'button', 
            button_text: section.settings.button_text,  
            button_url: section.settings.button_url,
            button_style: section.settings.button_style,
            button_classes: 'section-image-pins-header__button',
            button_target: section.settings.button_target
        %}
      {% endif %}
    </div>
    {% endif %}
    <div class="section-image-pins-content">
      <div class="section-image-pins-products{% liquid 
        
        echo ' has-image-on-' | append: section.settings.side_image_placement

        echo ' ' | append: section.settings.products_color_scheme

      %}">
        <div class="section-image-pins-products-container">
          <div class="section-image-pins-products-list">
            {% if section.blocks != blank %}
              {% for block in section.blocks %}
                {% liquid 
                  assign placeholder_image = 'product-' | append: forloop.index 

                  assign block_product = block.settings.pin_product_choice
                %}
                <div class="section-image-pins-products-product product">
                  {% if block_product != blank %}
                    {% render 'section-product-processor', product: block_product, section_settings: section.settings, prefix: 'section-image-pins-products-product' %}
                  {% else %}
                    <div class="product__top">
                      <div class="product__image">
                        {{ placeholder_image | placeholder_svg_tag: 'placeholder placeholder-handpicked-products' }}
                      </div>
                    </div>
                    <div class="product__bottom">
                      <h3 class="product__title">
                          {{ 'products.placeholder.title' | t }}
                      </h3>
                      <p class="product__price">
                          <span>{{ 'products.placeholder.price' | t }}</span>
                      </p>
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            {% endif %}
          </div>
          <div class="section-image-pins-products-pagination">
            <button class="section-image-pins-products-pagination__prev prev" aria-label="Previous">{% render 'icon-arrow-right' %}</button>
            <button class="section-image-pins-products-pagination__next next" aria-label="Next">{% render 'icon-arrow-right' %}</button>
          </div>
        </div>
      </div>
      <div class="section-image-pins-pins">
        <div class="section-image-pins-image">
          {% if section.settings.image != blank %}
              {% render 'section-image-processor', image: section.settings.image %}
          {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder placeholder-image-with-pins' }}
          {% endif %}
        </div>
        {% if section.blocks != blank %}
            <div class="section-image-pins-list">
                {% for block in section.blocks %}
                    {% liquid 
                        assign placeholder_image = 'product-' | append: forloop.index

                        assign product_choice = block.settings.pin_product_choice
                        assign product = all_products[product_choice]
                    %}
                    <div class="section-image-pins-list-item block-{{ block.id }}" data-pin-index="{{ forloop.index }}" {{ block.shopify_attributes }}>
                        <span class="section-image-pins-list-item-pin" tabindex="0"></span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
      </div>
    </div>
  </div>
</image-pins>

{% if section.settings.separator %}
  <div class="section-separator{% liquid 
 %}"><hr class="separator"></div>
{% endif %}



