<script>
(function() {
  'use strict';

  const root = document.getElementById('{{ section_id }}');

  if (!root) return;

  /* ==========================================
     TABS
     ========================================== */

  const tabs = root.querySelectorAll('.tt-tab');
  const panels = root.querySelectorAll('.tt-panel');

  tabs.forEach(function(tab) {

    tab.addEventListener('click', function() {

      const target = tab.dataset.tab;

      tabs.forEach(function(item) {
        item.classList.remove('is-active');
        item.setAttribute('aria-selected', 'false');
      });

      panels.forEach(function(panel) {
        panel.classList.remove('is-active');
      });

      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');

      const targetPanel = root.querySelector(
        '[data-panel="' + target + '"]'
      );

      if (targetPanel) {
        targetPanel.classList.add('is-active');
      }

    });

  });


  /* ==========================================
     SLIDER FUNCTION
     ========================================== */

  function initSlider(sliderSelector, prevSelector, nextSelector, dotsSelector) {

    const slider = root.querySelector(sliderSelector);
    const prev = root.querySelector(prevSelector);
    const next = root.querySelector(nextSelector);
    const dots = root.querySelector(dotsSelector);

    if (!slider || !prev || !next) return;

    const slides = Array.from(
      slider.querySelectorAll('.tt-slide')
    );

    if (!slides.length) {
      prev.style.display = 'none';
      next.style.display = 'none';
      return;
    }

    let currentIndex = 0;

    function getStep() {

      if (slides.length < 2) {
        return slider.clientWidth;
      }

      const first = slides[0];
      const second = slides[1];

      return second.offsetLeft - first.offsetLeft;
    }

    function getVisibleCount() {

      const slideWidth = slides[0].getBoundingClientRect().width;
      const gap = parseFloat(
        getComputedStyle(slider).columnGap || 0
      );

      if (!slideWidth) return 1;

      return Math.max(
        1,
        Math.round(
          (slider.clientWidth + gap) /
          (slideWidth + gap)
        )
      );
    }

    function getMaxIndex() {
      return Math.max(
        0,
        slides.length - getVisibleCount()
      );
    }

    function updateDots() {

      if (!dots) return;

      dots.innerHTML = '';

      const maxIndex = getMaxIndex();

      if (maxIndex <= 0) {
        dots.style.display = 'none';
        return;
      }

      dots.style.display = 'flex';

      for (let i = 0; i <= maxIndex; i++) {

        const dot = document.createElement('button');

        dot.type = 'button';
        dot.className = 'tt-dot';

        if (i === currentIndex) {
          dot.classList.add('is-active');
        }

        dot.setAttribute(
          'aria-label',
          'Go to testimonial ' + (i + 1)
        );

        dot.addEventListener('click', function() {
          goTo(i);
        });

        dots.appendChild(dot);
      }

    }

    function updateButtons() {

      const maxIndex = getMaxIndex();

      prev.disabled = currentIndex <= 0;
      next.disabled = currentIndex >= maxIndex;

      if (slides.length <= getVisibleCount()) {
        prev.style.display = 'none';
        next.style.display = 'none';
      } else {
        prev.style.display = '';
        next.style.display = '';
      }

      updateDots();
    }

    function goTo(index) {

      const maxIndex = getMaxIndex();

      currentIndex = Math.max(
        0,
        Math.min(index, maxIndex)
      );

      slider.scrollTo({
        left: getStep() * currentIndex,
        behavior: 'smooth'
      });

      updateButtons();
    }

    prev.addEventListener('click', function() {
      goTo(currentIndex - 1);
    });

    next.addEventListener('click', function() {
      goTo(currentIndex + 1);
    });

    slider.addEventListener('scroll', function() {

      const step = getStep();

      if (!step) return;

      const newIndex = Math.round(
        slider.scrollLeft / step
      );

      if (newIndex !== currentIndex) {
        currentIndex = newIndex;
        updateButtons();
      }

    });

    window.addEventListener('resize', function() {

      const maxIndex = getMaxIndex();

      if (currentIndex > maxIndex) {
        currentIndex = maxIndex;
      }

      updateButtons();

    });

    updateButtons();

  }


  initSlider(
    '.tt-video-slider',
    '.tt-video-prev',
    '.tt-video-next',
    '.tt-video-dots'
  );

  initSlider(
    '.tt-text-slider',
    '.tt-text-prev',
    '.tt-text-next',
    '.tt-text-dots'
  );


  /* ==========================================
     VIDEO MODAL
     ========================================== */

  const modal = root.querySelector('[data-video-modal]');
  const modalVideo = root.querySelector('[data-modal-video]');
  const modalPrev = root.querySelector('[data-modal-prev]');
  const modalNext = root.querySelector('[data-modal-next]');
  const closeButtons = root.querySelectorAll('[data-modal-close]');
  const videoTriggers = root.querySelectorAll('[data-video-trigger]');

  if (!modal || !modalVideo) return;

  const videoData = [];

  {% for block in section.blocks %}
    {% if block.type == 'video_testimonial' and block.settings.video != blank %}

      videoData.push({
        html: {{ block.settings.video | video_tag:
          controls: true,
          autoplay: true,
          loop: false,
          muted: false,
          playsinline: true
        | json }}
      });

    {% endif %}
  {% endfor %}


  let activeVideo = 0;

  function showVideo(index) {

    if (!videoData.length) return;

    if (index < 0) {
      index = videoData.length - 1;
    }

    if (index >= videoData.length) {
      index = 0;
    }

    activeVideo = index;

    modalVideo.innerHTML = videoData[activeVideo].html;

    const video = modalVideo.querySelector('video');

    if (video) {
      video.setAttribute('controls', 'controls');
      video.setAttribute('playsinline', 'playsinline');

      video.play().catch(function() {});
    }

    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');

    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

  }


  function closeModal() {

    const video = modalVideo.querySelector('video');

    if (video) {
      video.pause();
    }

    modalVideo.innerHTML = '';

    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');

    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';

  }


  videoTriggers.forEach(function(trigger) {

    trigger.addEventListener('click', function() {

      const index = parseInt(
        trigger.dataset.videoTrigger,
        10
      );

      /*
        Trigger index is based on all video testimonial
        blocks, so it matches videoData.
      */

      showVideo(index);

    });

  });


  modalPrev.addEventListener('click', function() {
    showVideo(activeVideo - 1);
  });


  modalNext.addEventListener('click', function() {
    showVideo(activeVideo + 1);
  });


  closeButtons.forEach(function(button) {

    button.addEventListener('click', function() {
      closeModal();
    });

  });


  document.addEventListener('keydown', function(event) {

    if (!modal.classList.contains('is-open')) return;

    if (event.key === 'Escape') {
      closeModal();
    }

    if (event.key === 'ArrowLeft') {
      showVideo(activeVideo - 1);
    }

    if (event.key === 'ArrowRight') {
      showVideo(activeVideo + 1);
    }

  });


})();
</script>


