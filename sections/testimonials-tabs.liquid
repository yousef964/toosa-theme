
{% liquid
  assign section_id = 'TestimonialsTabs-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="tt-section"
  data-section-id="{{ section.id }}"
>
  <div class="tt-container">

    {% comment %}
      ============================
      SECTION HEADER
      ============================
    {% endcomment %}

    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="tt-header">
        {% if section.settings.heading != blank %}
          <h2 class="tt-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="tt-description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}


    {% comment %}
      ============================
      TABS
      ============================
    {% endcomment %}

    <div class="tt-tabs" role="tablist">

    

      {% if section.settings.enable_text_tab %}
        <button
          type="button"
          class="tt-tab is-active"
          role="tab"
          aria-selected="true"
          data-tab="text"
        >
          {{ section.settings.text_tab_label }}
        </button>
      {% endif %}
      


        {% if section.settings.enable_video_tab %}
        <button
          type="button"
          class="tt-tab  {% unless section.settings.enable_video_tab %} is-active{% endunless %}"
          role="tab"
          aria-selected="{% if section.settings.enable_video_tab %}false{% else %}true{% endif %}"
          data-tab="video"
        >
          {{ section.settings.video_tab_label }}
        </button>
      {% endif %}
    </div>





    {% comment %}
      ==================================================
      TEXT TESTIMONIALS
      ==================================================
    {% endcomment %}

    {% if section.settings.enable_text_tab %}
      <div
        class="tt-panel tt-text-panel is-active"
        data-panel="text"
        role="tabpanel"
      >

        <div class="tt-slider-wrapper">

          <div
            class="tt-slider tt-text-slider"
            data-slider="text"
          >

            {% assign text_count = 0 %}

            {% for block in section.blocks %}
              {% if block.type == 'text_testimonial' %}

                {% assign text_count = text_count | plus: 1 %}

                <div
                  class="tt-slide"
                  {{ block.shopify_attributes }}
                >

                  <article class="tt-text-card">


 {% if block.settings.client_image != blank %}
  <img
    src="{{ block.settings.client_image | image_url: width: 1200 }}"
    alt="test"
    width="100%"
    height="100%"
    loading="lazy"
    class="tt-product-featured-image"
  >
{% endif %}

                    {% if block.settings.rating > 0 %}
                      <div
                        class="tt-rating"
                        aria-label="{{ block.settings.rating }} out of 5 stars"
                      >
                        {% for i in (1..5) %}
                          <span class="{% if i <= block.settings.rating %}is-filled{% endif %}">
                            ★
                          </span>
                        {% endfor %}
                      </div>
                    {% endif %}


                    {% if block.settings.quote_icon %}
                      <div class="tt-quote-icon">
                        “
                      </div>
                    {% endif %}


                    {% if block.settings.description != blank %}
                      <div class="tt-text-content">
                        {{ block.settings.description }}
                      </div>
                    {% endif %}


                    {% if block.settings.product != blank %}
                      <a
                        href="{{ block.settings.product.url }}"
                        class="tt-product"
                      >

                        {% if block.settings.product.featured_image != blank %}
                          {{
                            block.settings.product.featured_image
                            | image_url: width: 180
                            | image_tag:
                              loading: 'lazy',
                              class: 'tt-product-image',
                              alt: block.settings.product.title
                          }}
                        {% endif %}

                        <span class="tt-product-info">
                          <span class="tt-product-label">
                            {{ block.settings.product_label }}
                          </span>

                          <span class="tt-product-title">
                            {{ block.settings.product.title }}
                          </span>
                        </span>

                      </a>

                    {% elsif block.settings.product_image != blank %}

                      <div class="tt-product">

                        {{
                          block.settings.product_image
                          | image_url: width: 180
                          | image_tag:
                            loading: 'lazy',
                            class: 'tt-product-image',
                            alt: block.settings.product_name
                        }}

                        <span class="tt-product-info">
                          {% if block.settings.product_label != blank %}
                            <span class="tt-product-label">
                              {{ block.settings.product_label }}
                            </span>
                          {% endif %}

                          {% if block.settings.product_name != blank %}
                            <span class="tt-product-title">
                              {{ block.settings.product_name }}
                            </span>
                          {% endif %}
                        </span>

                      </div>

                    {% endif %}


                    {% if block.settings.client_name != blank or block.settings.client_image != blank %}

                      <div class="tt-client">

                        {% if block.settings.client_image != blank %}
                          {{
                            block.settings.client_image
                            | image_url: width: 120
                            | image_tag:
                              loading: 'lazy',
                              class: 'tt-client-image',
                              alt: block.settings.client_name
                          }}
                        {% endif %}

                        {% if block.settings.client_name != blank %}
                          <span class="tt-client-name">
                            {{ block.settings.client_name }}
                          </span>
                        {% endif %}

                      </div>

                    {% endif %}

                  </article>

                </div>

              {% endif %}
            {% endfor %}

          </div>


          <button
            type="button"
            class="tt-arrow tt-arrow-prev tt-text-prev"
            aria-label="Previous text testimonial"
          >
            <svg viewBox="0 0 24 24">
              <path d="M14.7 5.3a1 1 0 0 1 0 1.4L9.41 12l5.29 5.3a1 1 0 0 1 0 1.4l-6-6a1 1 0 0 1 0-1.4l6-6a1 1 0 0 1 1.41 1.4Z"/>
            </svg>
          </button>

          <button
            type="button"
            class="tt-arrow tt-arrow-next tt-text-next"
            aria-label="Next text testimonial"
          >
            <svg viewBox="0 0 24 24">
              <path d="M9.3 5.3a1 1 0 0 0 0 1.4l5.29 5.3-5.29 5.3a1 1 0 1 0 1.41 1.4l6-6a1 1 0 0 0 0-1.4l-6-6a1 1 0 0 0-1.41 1.4Z"/>
            </svg>
          </button>

        </div>

        <div class="tt-dots tt-text-dots"></div>

      </div>
    {% endif %}

  </div>


      {% comment %}
      ==================================================
      VIDEO TESTIMONIALS
      ==================================================
    {% endcomment %}

    {% if section.settings.enable_video_tab %}
      <div
        class="tt-container tt-panel tt-video-panel {% unless section.settings.enable_video_tab %} is-active{% endunless %}"
        data-panel="video"
        role="tabpanel"
      >

        <div class="tt-slider-wrapper">

          <div
            class="tt-slider tt-video-slider"
            data-slider="video"
          >

            {% assign video_count = 0 %}

            {% for block in section.blocks %}
              {% if block.type == 'video_testimonial' %}

                {% assign video_count = video_count | plus: 1 %}

                <div
                  class="tt-slide"
                  data-video-index="{{ video_count | minus: 1 }}"
                  {{ block.shopify_attributes }}
                >

                  <article class="tt-video-card">

                    <button
                      type="button"
                      class="tt-video-trigger"
                      data-video-trigger="{{ video_count | minus: 1 }}"
                      aria-label="Play testimonial video"
                    >

                      {% if block.settings.video != blank %}

                        {% if block.settings.video.preview_image != blank %}
                          {{
                            block.settings.video.preview_image
                            | image_url: width: 1000
                            | image_tag:
                              loading: 'lazy',
                              class: 'tt-video-poster',
                              alt: block.settings.title
                          }}
                        {% else %}
                          <div class="tt-video-placeholder">
                            <span>Video</span>
                          </div>
                        {% endif %}

                      {% elsif block.settings.video_image != blank %}

                        {{
                          block.settings.video_image
                          | image_url: width: 1000
                          | image_tag:
                            loading: 'lazy',
                            class: 'tt-video-poster',
                            alt: block.settings.title
                        }}

                      {% else %}

                        <div class="tt-video-placeholder">
                          <span>Add Video</span>
                        </div>

                      {% endif %}

                      <span class="tt-play-button" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <path d="M8 5.14v13.72a1 1 0 0 0 1.53.85l10.22-6.86a1 1 0 0 0 0-1.7L9.53 4.29A1 1 0 0 0 8 5.14Z"/>
                        </svg>
                      </span>

                    </button>

{% if section.settings.rating_enable_video_tab %}
                    <div class="tt-card-content">

                      {% if block.settings.title != blank %}
                        <h3 class="tt-card-title">
                          {{ block.settings.title }}
                        </h3>
                      {% endif %}

                      {% if block.settings.rating > 0 %}
                        <div
                          class="tt-rating"
                          aria-label="{{ block.settings.rating }} out of 5 stars"
                        >
                          {% for i in (1..5) %}
                            <span class="{% if i <= block.settings.rating %}is-filled{% endif %}">
                              ★
                            </span>
                          {% endfor %}
                        </div>
                      {% endif %}

                      {% if block.settings.description != blank %}
                        <div class="tt-card-description">
                          {{ block.settings.description }}
                        </div>
                      {% endif %}

                    </div>
{% endif %}
                  </article>

                </div>

              {% endif %}
            {% endfor %}

          </div>


          <button
            type="button"
            class="tt-arrow tt-arrow-prev tt-video-prev"
            aria-label="Previous video testimonial"
          >
            <svg viewBox="0 0 24 24">
              <path d="M14.7 5.3a1 1 0 0 1 0 1.4L9.41 12l5.29 5.3a1 1 0 0 1-1.41 1.4l-6-6a1 1 0 0 1 0-1.4l6-6a1 1 0 0 1 1.41 0Z"/>
            </svg>
          </button>

          <button
            type="button"
            class="tt-arrow tt-arrow-next tt-video-next"
            aria-label="Next video testimonial"
          >
            <svg viewBox="0 0 24 24">
              <path d="M9.3 5.3a1 1 0 0 0 0 1.4l5.29 5.3-5.29 5.3a1 1 0 1 0 1.41 1.4l6-6a1 1 0 0 0 0-1.4l-6-6A1 1 0 0 0 9.3 5.3Z"/>
            </svg>
          </button>

        </div>

        <div class="tt-dots tt-video-dots"></div>

      </div>
    {% endif %}


  {% comment %}
    ==================================================
    VIDEO POPUP
    ==================================================
  {% endcomment %}

  <div
    class="tt-modal"
    data-video-modal
    aria-hidden="true"
  >

    <div class="tt-modal-overlay" data-modal-close></div>

    <div
      class="tt-modal-dialog"
      role="dialog"
      aria-modal="true"
      aria-label="Testimonial video"
    >

      <button
        type="button"
        class="tt-modal-close"
        data-modal-close
        aria-label="Close video"
      >
        <svg viewBox="0 0 24 24">
          <path d="M6.7 5.3a1 1 0 0 0-1.4 1.4L10.59 12l-5.29 5.3a1 1 0 0 0 1.4 1.4L12 13.41l5.3 5.29a1 1 0 0 0 1.4-1.4L13.41 12l5.29-5.3a1 1 0 0 0-1.4-1.4L12 10.59 6.7 5.3Z"/>
        </svg>
      </button>


      <button
        type="button"
        class="tt-modal-arrow tt-modal-prev"
        data-modal-prev
        aria-label="Previous video"
      >
        <svg viewBox="0 0 24 24">
          <path d="M14.7 5.3a1 1 0 0 1 0 1.4L9.41 12l5.29 5.3a1 1 0 0 1 0 1.4l-6-6a1 1 0 0 1 0-1.4l6-6a1 1 0 0 1 1.41 1.4Z"/>
        </svg>
      </button>


      <div class="tt-modal-video" data-modal-video></div>


      <button
        type="button"
        class="tt-modal-arrow tt-modal-next"
        data-modal-next
        aria-label="Next video"
      >
        <svg viewBox="0 0 24 24">
          <path d="M9.3 5.3a1 1 0 0 0 0 1.4l5.29 5.3-5.29 5.3a1 1 0 1 0 1.41 1.4l6-6a1 1 0 0 0 0-1.4l-6-6A1 1 0 0 0 9.3 5.3Z"/>
        </svg>
      </button>

    </div>
  </div>

</section>


<style>
  #{{ section_id }} {
    --tt-bg: {{ section.settings.background_color }};
    --tt-card-bg: {{ section.settings.card_background }};
    --tt-text: {{ section.settings.text_color }};
    --tt-accent: {{ section.settings.accent_color }};
    --tt-radius: {{ section.settings.card_radius }}px;
    --tt-gap-desktop: {{ section.settings.desktop_gap }}px;
    --tt-gap-mobile: {{ section.settings.mobile_gap }}px;
    --tt-top-padding: {{ section.settings.padding_top }}px;
    --tt-bottom-padding: {{ section.settings.padding_bottom }}px;
  }

  #{{ section_id }}.tt-section {
    background: var(--tt-bg);
    color: var(--tt-text);
    padding-top: var(--tt-top-padding);
    padding-bottom: var(--tt-bottom-padding);
    overflow: hidden;
  }

  #{{ section_id }} .tt-container {
    width: min(100% - 40px, {{ section.settings.container_width }}px);
    margin: 0 auto;
  }

  #{{ section_id }} .tt-header {
    text-align: {{ section.settings.heading_alignment }};
    max-width: 850px;
    margin: 0 auto 35px;
  }

  #{{ section_id }} .tt-heading {
    margin: 0 0 12px;
    color: var(--tt-text);
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.15;
  }

  #{{ section_id }} .tt-description {
    font-size: 16px;
    line-height: 1.6;
    opacity: .8;
  }

  #{{ section_id }} .tt-description p {
    margin: 0;
  }

  /* TABS */

  #{{ section_id }} .tt-tabs {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-bottom: 35px;
  }

  #{{ section_id }} .tt-tab {
    appearance: none;
    border: 1px solid currentColor;
    background: transparent;
    color: var(--tt-text);
    padding: 12px 28px;
    cursor: pointer;
    font-size:16px;
  }
 #{{ section_id }} .tt-tab:hover {
    background: var(--tt-text);
    border-color: var(--tt-text);
    color: #fff;
  }

  #{{ section_id }} .tt-tab.is-active {
    background: var(--tt-accent);
    border-color: var(--tt-accent);
    color: #fff;
  }

  /* PANELS */

  #{{ section_id }} .tt-panel {
    display: none;
  }

  #{{ section_id }} .tt-panel.is-active {
    display: block;
  }

  /* SLIDER */

  #{{ section_id }} .tt-slider-wrapper {
    position: relative;
    padding: 0 45px;
  }

  #{{ section_id }} .tt-slider {
    display: flex;
    gap: var(--tt-gap-desktop);
    overflow: hidden;
    scroll-behavior: smooth;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  #{{ section_id }} .tt-slider::-webkit-scrollbar {
    display: none;
  }

  #{{ section_id }} .tt-slide {
    flex: 0 0 calc(
      (100% - ({{ section.settings.desktop_columns }} - 1) * var(--tt-gap-desktop))
      / {{ section.settings.desktop_columns }}
    );
    min-width: 0;
    scroll-snap-align: start;
  }

  /* VIDEO CARD */

  #{{ section_id }} .tt-video-card,
  #{{ section_id }} .tt-text-card {
    background: var(--tt-card-bg);
    border-radius: var(--tt-radius);
    overflow: hidden;
    height: 100%;
  }

  #{{ section_id }} .tt-video-trigger {
    width: 100%;
     aspect-ratio: 4 / 5;
    padding: 0;
    border: 0;
    background: #eee;
    display: block;
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  #{{ section_id }} .tt-video-poster {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .35s ease;
  }

  #{{ section_id }} .tt-video-trigger:hover .tt-video-poster {
    transform: scale(1.04);
  }

  #{{ section_id }} .tt-video-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: #e9e9e9;
    color: #555;
  }

  #{{ section_id }} .tt-play-button {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: rgba(255,255,255,.95);
    display: grid;
    place-items: center;
    box-shadow: 0 8px 25px rgba(0,0,0,.15);
  }

  #{{ section_id }} .tt-play-button svg {
    width: 26px;
    height: 26px;
    fill: #000;
    margin-left: -4px;
  }

  /* CARD CONTENT */

  #{{ section_id }} .tt-card-content {
    padding: 20px;
  }

  #{{ section_id }} .tt-card-title {
    margin: 0 0 8px;
    font-size: 18px;
    line-height: 1.3;
  }

  #{{ section_id }} .tt-card-description {
    font-size: 14px;
    line-height: 1.6;
    opacity: .8;
  }

  #{{ section_id }} .tt-card-description p {
    margin: 0;
  }

  /* RATING */

  #{{ section_id }} .tt-rating {
    display: flex;
    gap: 3px;
    margin-bottom: 10px;
    line-height: 1;
  }

  #{{ section_id }} .tt-rating span {
    color: #d6d6d6;
    font-size: 17px;
  }

  #{{ section_id }} .tt-rating span.is-filled {
    color: {{ section.settings.star_color }};
  }

  /* TEXT CARD */

  #{{ section_id }} .tt-text-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
  }

  #{{ section_id }} .tt-text-card .tt-rating {
    margin-bottom: 18px;
  }

  #{{ section_id }} .tt-quote-icon {
    font-size: 50px;
    line-height: .5;
    margin-bottom: 12px;
    color: var(--tt-accent);
  }

  #{{ section_id }} .tt-text-content {
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 22px;
  }

  #{{ section_id }} .tt-text-content p {
    margin: 0 0 10px;
  }

  #{{ section_id }} .tt-text-content p:last-child {
    margin-bottom: 0;
  }

  /* PRODUCT */

  #{{ section_id }} .tt-product {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    margin-top: auto;
    margin-bottom: 20px;
    padding: 10px;
    border: 1px solid rgba(0,0,0,.10);
    border-radius: 10px;
  }

  #{{ section_id }} .tt-product-image {
    width: 58px;
    height: 58px;
    object-fit: cover;
    border-radius: 7px;
    flex: 0 0 58px;
  }

  #{{ section_id }} .tt-product-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  #{{ section_id }} .tt-product-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .08em;
    opacity: .6;
  }

  #{{ section_id }} .tt-product-title {
    font-size: 14px;
    font-weight: 600;
  }

  /* CLIENT */

  #{{ section_id }} .tt-client {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #{{ section_id }} .tt-client-image {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }

  #{{ section_id }} .tt-client-name {
    font-size: 14px;
    font-weight: 600;
  }

  /* ARROWS */

  #{{ section_id }} .tt-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
       max-width: 46px;
      min-width: 46px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,.12);
    background: #fff;
    color: #000;
    display: flex;
   justify-content: center;
   align-items:center;
    cursor: pointer;
    z-index: 4;
    box-shadow: 0 3px 12px rgba(0,0,0,.10);
    transition: .2s ease;
  }

  #{{ section_id }} .tt-arrow:hover {
    transform: translateY(-50%) scale(1.05);
  }

  #{{ section_id }} .tt-arrow svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    max-width: 20px;
      min-width: 20px;
  }

  #{{ section_id }} .tt-arrow-prev {
    left: -16px;
  }

  #{{ section_id }} .tt-arrow-next {
    right: -16px;
  }

  #{{ section_id }} .tt-arrow[disabled] {
    opacity: .35;
    cursor: not-allowed;
  }

  /* DOTS */

  #{{ section_id }} .tt-dots {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin-top: 22px;
  }

  #{{ section_id }} .tt-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #ccc;
    cursor: pointer;
  }

  #{{ section_id }} .tt-dot.is-active {
    background: var(--tt-accent);
  }

  /* MODAL */

  #{{ section_id }} .tt-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
  }

  #{{ section_id }} .tt-modal.is-open {
    display: block;
  }

  #{{ section_id }} .tt-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.82);
  }

  #{{ section_id }} .tt-modal-dialog {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(900px, calc(100% - 100px));
    aspect-ratio: 16 / 9;
    z-index: 2;
  }

  #{{ section_id }} .tt-modal-video {
    width: 100%;
    height: 100%;
    background: #000;
    border-radius: 8px;
    overflow: hidden;
  }

  #{{ section_id }} .tt-modal-video video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #{{ section_id }} .tt-modal-close {
    position: absolute;
    right: -45px;
    top: -45px;
    width: 40px;
    height: 40px;
        min-width: 40px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #000;
    display: flex;
    justify-content: center;
    align-items: center;
    {% comment %} place-items: center; {% endcomment %}
    cursor: pointer;
    z-index: 5;
  }

  #{{ section_id }} .tt-modal-close svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
        min-width: 20px;
  }

  #{{ section_id }} .tt-modal-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
     max-width: 40px;
    min-width: 40px;

    border-radius: 50%;
    border: 0;
    background: #fff;
    color: #000;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    z-index: 5;
    box-shadow: 0 4px 15px rgba(0,0,0,.25);
  }

  #{{ section_id }} .tt-modal-arrow svg {
