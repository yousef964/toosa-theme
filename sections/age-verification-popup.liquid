
{% liquid 

  assign cookie_name = section.settings.cookie_name
  assign popup_expiry = section.settings.expiry
  assign popup_delay = section.settings.delay

%}


<popup-modal class="section-popup section-age-verification popup-modal inactive{% liquid 
    if section.settings.display_position == 'bottom-right'
        echo ' display-in-corner'
    endif 
    if section.settings.image != blank
        echo ' has-image'
    endif 
%}" data-popup-type="onload" data-popup-onload="verification" data-popup-delay="{{ popup_delay }}" data-popup-expiry="{{ popup_expiry }}" data-popup-cookie-name="{{ cookie_name }}" style="display: none;">
    <div class="popup-modal__overlay"></div>
    <div class="popup-modal__inner {{ section.settings.color_scheme }}">
        <div class="popup-modal__content">
            {% if section.settings.image != blank %}
                <div class="section-popup-image">
                    {% render 'section-image-processor', image: section.settings.image %}
                </div>
            {% endif %}
            <div class="section-popup-content">
              {% if section.settings.text_1 != blank %}
                <h2 class="section-popup-content__heading special-heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
              {% endif %}
              {% if section.settings.text_2 != blank %}
                <p class="section-popup-content__description paragraph-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</p>
              {% endif %}
                
              {% if section.settings.accept_button_text != blank or section.settings.decline_button_text != blank %}
                <div class="section-age-verification-buttons">
                  {% if section.settings.accept_button_text != blank %}

                    {% render 'button', 
                        button_text: section.settings.accept_button_text,  
                        button_style: section.settings.accept_button_style,
                        button_classes: 'section-popup-content__button section-age-verification-button confirm-button',
                        button_tag: 'button'
                    %}
                  {% endif %}

                  {% if section.settings.decline_button_text != blank %}

                    {% render 'button', 
                        button_text: section.settings.decline_button_text, 
                        button_url: section.settings.decline_button_url, 
                        button_style: section.settings.decline_button_style, 
                        button_classes: 'section-popup-content__button section-age-verification-button'
                    %}
                  {% endif %}
                </div>
              {% endif %}
            </div>
        </div>
        {% comment %} <button class="popup-modal__close">{% render 'icon-close' %}</button> {% endcomment %}
    </div>
</popup-modal>



