{% comment %} TOOSA inner pages: closing call-to-action band with contact chips {% endcomment %}
{%- liquid
  assign s = section.settings
  assign theme_class = 'txp'
  if s.theme == 'light'
    assign theme_class = 'txp txp--light'
  elsif s.theme == 'paper'
    assign theme_class = 'txp txp--paper'
  endif
  assign tel = s.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', ''
-%}
<section class="{{ theme_class }} txp-section txp-section--tight txp-cta {% if s.orange %}txp-cta--orange{% endif %}" id="txp-cta-{{ section.id }}">
  <div class="txp-wrap">
    <div class="txp-cta__inner txp-reveal">
      <div>
        {%- if s.eyebrow != blank -%}<p class="txp-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="txp-h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.lead != blank -%}<div class="txp-lead">{{ s.lead }}</div>{%- endif -%}
        {%- if s.btn1_text != blank or s.btn2_text != blank -%}
          <div class="txp-actions">
            {%- if s.btn1_text != blank -%}<a class="txp-btn txp-btn--primary" href="{{ s.btn1_url }}">{{ s.btn1_text }}{% render 'tx-p-icon', name: 'arrow' %}</a>{%- endif -%}
            {%- if s.btn2_text != blank -%}<a class="txp-btn txp-btn--ghost" href="{{ s.btn2_url }}">{{ s.btn2_text }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if s.phone != blank or s.email != blank or s.address != blank -%}
        <div class="txp-cta__contacts">
          {%- if s.phone != blank -%}<a href="tel:{{ tel }}"><i>{% render 'tx-p-icon', name: 'phone' %}</i><div><b>Call or text</b><span>{{ s.phone }}</span></div></a>{%- endif -%}
          {%- if s.email != blank -%}<a href="mailto:{{ s.email }}"><i>{% render 'tx-p-icon', name: 'mail' %}</i><div><b>Email</b><span>{{ s.email }}</span></div></a>{%- endif -%}
          {%- if s.address != blank -%}<a href="{{ s.address_url | default: '/pages/contact' }}"><i>{% render 'tx-p-icon', name: 'pin' %}</i><div><b>Showroom</b><span>{{ s.address }}</span></div></a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TX Call to action",
  "settings": [
    { "type": "select", "id": "theme", "label": "Page background", "default": "dark", "options": [
      { "value": "dark", "label": "Dark" }, { "value": "light", "label": "White" }, { "value": "paper", "label": "Paper" } ] },
    { "type": "checkbox", "id": "orange", "label": "Orange band", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "lead", "label": "Lead" },
    { "type": "text", "id": "btn1_text", "label": "Primary button" },
    { "type": "url", "id": "btn1_url", "label": "Primary link" },
    { "type": "text", "id": "btn2_text", "label": "Secondary button" },
    { "type": "url", "id": "btn2_url", "label": "Secondary link" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "address", "label": "Showroom line" },
    { "type": "url", "id": "address_url", "label": "Showroom link" }
  ],
  "presets": [ { "name": "TX Call to action" } ]
}
{% endschema %}
