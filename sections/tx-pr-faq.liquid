{% comment %} TOOSA product pages: FAQ accordion (same keyboard/ARIA pattern as tx-p-faq, driven by tx-pages.js) with a help panel and FAQPage schema. Questions can be limited to products with a rule. {% endcomment %}
{%- liquid
  assign s = section.settings
  assign theme_class = 'txp txp--light'
  if s.theme == 'paper'
    assign theme_class = 'txp txp--paper'
  endif
  assign count = 0
  for block in section.blocks
    capture ok
      render 'tx-pr-match', rule: block.settings.only_for, product: product
    endcapture
    if ok == '1'
      assign count = count | plus: 1
    endif
  endfor
  assign tel = s.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', ''
-%}
{%- if count > 0 -%}
<section class="{{ theme_class }} txpr txpr-section txpr-faq txp-faq" id="txpr-faq-{{ section.id }}" data-txp-faq>
  <div class="txp-wrap txp-faq-layout">
    <div class="txp-faq__side">
      <div>
        {%- if s.eyebrow != blank -%}<p class="txp-eyebrow txp-reveal">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="txp-h2 txp-h2--sm txp-reveal" data-delay="1">{{ s.heading | replace: '[product]', product.title }}</h2>{%- endif -%}
        {%- if s.lead != blank -%}<div class="txp-lead txp-reveal" data-delay="2">{{ s.lead }}</div>{%- endif -%}
      </div>
      {%- if s.help_title != blank -%}
        <div class="txp-faq__help txp-reveal" data-delay="3">
          <h3 class="txp-h4">{{ s.help_title }}</h3>
          {%- if s.help_text != blank -%}<p>{{ s.help_text }}</p>{%- endif -%}
          {%- if s.help_btn != blank -%}<a class="txp-btn txp-btn--primary txp-btn--sm" href="{{ s.help_url | default: '/pages/contact' }}">{{ s.help_btn }}{% render 'tx-p-icon', name: 'arrow' %}</a>{%- endif -%}
          {%- if s.phone != blank -%}<p class="txp-book__talk" style="margin-top:12px">Or call <a href="tel:{{ tel }}">{{ s.phone }}</a></p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="txp-faq__list txp-reveal" data-delay="1">
      <div class="txp-faq__group">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}
          {%- capture ok -%}{%- render 'tx-pr-match', rule: block.settings.only_for, product: product -%}{%- endcapture -%}
          {%- if ok != '1' -%}{%- continue -%}{%- endif -%}
          {%- assign n = n | plus: 1 -%}
          {%- assign open = false -%}
          {%- if s.open_first and n == 1 -%}{%- assign open = true -%}{%- endif -%}
          <div class="txp-faq__item {% if open %}is-open{% endif %}" data-txp-faq-item {{ block.shopify_attributes }}>
            <button type="button" class="txp-faq__q" aria-expanded="{% if open %}true{% else %}false{% endif %}" aria-controls="txpr-faqa-{{ block.id }}" data-txp-faq-q>
              <span data-txp-faq-text>{{ block.settings.question | replace: '[product]', product.title }}</span>
              <span class="txp-faq__ic">{% render 'tx-p-icon', name: 'plus' %}</span>
            </button>
            <div class="txp-faq__a" id="txpr-faqa-{{ block.id }}"><div><div class="txp-rt" data-txp-faq-text>{{ block.settings.answer | replace: '[product]', product.title }}</div></div></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- if s.schema -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign first = true -%}
    {%- for block in section.blocks -%}
      {%- capture ok -%}{%- render 'tx-pr-match', rule: block.settings.only_for, product: product -%}{%- endcapture -%}
      {%- if ok != '1' -%}{%- continue -%}{%- endif -%}
      {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
      { "@type": "Question", "name": {{ block.settings.question | replace: '[product]', product.title | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | replace: '[product]', product.title | strip_html | json }} } }
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "TX Product FAQ",
  "settings": [
    { "type": "select", "id": "theme", "label": "Colour", "default": "light", "options": [ { "value": "light", "label": "White" }, { "value": "paper", "label": "Paper" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading ([product] = product title)", "default": "Questions people ask before they order." },
    { "type": "richtext", "id": "lead", "label": "Lead" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first answer", "default": true },
    { "type": "checkbox", "id": "schema", "label": "Add FAQPage structured data", "default": true },
    { "type": "header", "content": "Help panel" },
    { "type": "text", "id": "help_title", "label": "Title", "default": "Still deciding?" },
    { "type": "text", "id": "help_text", "label": "Text", "default": "Send us your space and the tools you need to store. We reply the same business day." },
    { "type": "text", "id": "help_btn", "label": "Button", "default": "Ask the team" },
    { "type": "url", "id": "help_url", "label": "Button link" },
    { "type": "text", "id": "phone", "label": "Phone" }
  ],
  "blocks": [
    { "type": "q", "name": "Question", "settings": [
      { "type": "text", "id": "only_for", "label": "Only for (rule)", "info": "Handles, tag:…, type:…, template:…, prefix*. Blank = every product. ! excludes." },
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" } ] }
  ],
  "presets": [ { "name": "TX Product FAQ" } ]
}
{% endschema %}
