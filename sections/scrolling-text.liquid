

{% style %}
  #shopify-section-{{ section.id }} {

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  }
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}



{% style %}
  #shopify-section-{{ section.id }} {

    --theme-scrolling-text-speed: {{ section.settings.speed | append: 's' }};

    {% if section.settings.splitter_image != blank %}
      --theme-section-scrolling-text-splitter-width: {{ section.settings.splitter_custom_width | append: 'px' }};
    {% endif %}

    --theme-scrolling-text-gap: var(--theme-gap-{{ section.settings.gap_choice }});
  }
{% endstyle %}


<div class="section-scrolling-text{% liquid 
  
  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif
    
  if section.settings.inset
    echo ' has-section-padding'
  endif

  if section.settings.edge_fade
    echo ' has-edge-fade'
  endif

  echo ' has-direction-' | append: section.settings.direction

  echo ' ' | append: section.settings.color_scheme

%}">
  <div class="section-scrolling-text-container section-container">
    <div class="scrolling-text{% liquid 
        if section.settings.splitter_use_custom_width
            echo ' has-custom-splitter-width'
        endif
    %}">
        {% if section.blocks != blank %}
            {% liquid
              assign blocks_size = section.blocks | size
              assign loop_size = 4
              if blocks_size < 4
                assign loop_size = 12 | divided_by: blocks_size
              endif

            %}
            {% for i in (1..loop_size) %}
                <ul class="scrolling-text-list" {% if i > 1 %} aria-hidden="true" {% endif %}>
                  {% for block in section.blocks %}
                    <li class="scrolling-text-list-item" {{ block.shopify_attributes }}>
                      {% case block.type %}
                        {% when 'special-heading' %}
                          {% if block.settings.special_heading != blank %}
                            <div class="scrolling-text-list-item__text special-heading-size-{{ block.settings.special_heading_size }} block-{{ block.id }}">{{ block.settings.special_heading }}</div>
                          {% endif %}
                        {% when 'heading' %}
                          {% if block.settings.heading != blank %}
                            <div class="scrolling-text-list-item__text heading-size-{{ block.settings.heading_size }} block-{{ block.id }}">{{ block.settings.heading }}</div>
                          {% endif %}
                        {% when 'text' %}
                          {% if block.settings.text != blank %}
                            <p class="scrolling-text-list-item__text paragraph-size-{{ block.settings.text_size }} block-{{ block.id }}">{{ block.settings.text }}</p>
                          {% endif %}
                      {% endcase %}
                      {% if section.settings.splitter_image != blank %}
                          <span>
                              {% render 'section-image-processor', image: section.settings.splitter_image %}
                          </span>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
            {% endfor %}
        {% endif %}
    </div>
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


