{% comment %} TOOSA redesign: designed collection header. H1, lead, fact chips, cover image and category tiles. Works on collection and list-collections templates. {% endcomment %}
{%- liquid
  assign is_coll = false
  if collection != blank and collection.handle != blank
    assign is_coll = true
  endif
  if is_coll
    assign title = collection.title
    assign lead = section.settings.lead
    if lead == blank and collection.description != blank
      assign lead = collection.description | strip_html | strip | truncatewords: 30
    endif
    assign cover = section.settings.image | default: collection.image
    if cover == blank and collection.products.size > 0
      assign cover = collection.products.first.featured_image
    endif
  else
    assign title = section.settings.heading
    assign lead = section.settings.lead
    assign cover = section.settings.image
  endif
  assign cover_alt = cover.alt | default: title
-%}
<section class="txc txc-intro" id="txc-intro-{{ section.id }}">
  <div class="txc__wrap">
    <nav class="txc-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      {% if is_coll %}<a href="{{ routes.collections_url }}">{{ section.settings.crumb_label }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ title }}</span>{% else %}<span aria-current="page">{{ section.settings.crumb_label }}</span>{% endif %}
    </nav>

    <div class="txc-intro__grid">
      <div class="txc-intro__copy">
        {% if section.settings.eyebrow != blank %}<p class="txc-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h1 class="txc-h1">{{ title }}</h1>
        {% if lead != blank %}<p class="txc-lead">{{ lead }}</p>{% endif %}
        {% if section.blocks.size > 0 %}
          <ul class="txc-chips">
            {% for block in section.blocks %}
              {% if block.type == 'chip' %}
                <li class="txc-chip{% if block.settings.icon == 'ul' %} txc-chip--ul{% endif %}" {{ block.shopify_attributes }}>
                  <span class="txc-chip__icon" aria-hidden="true">{% render 'tx-c-icon', name: block.settings.icon %}</span>
                  {{ block.settings.text }}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
      {% if cover != blank %}
        <div class="txc-intro__media">
          {{ cover | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 46vw, 100vw', alt: cover_alt }}
          {% if is_coll and collection.products_count > 0 %}
            <span class="txc-intro__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_categories and section.settings.categories.size > 0 %}
      <div class="txc-cats">
        {% if section.settings.categories_title != blank %}<h2 class="txc-cats__title">{{ section.settings.categories_title }}</h2>{% endif %}
        <ul class="txc-cats__grid">
          {% for cat in section.settings.categories %}
            {%- liquid
              assign tile_img = cat.image
              if tile_img == blank and cat.products.size > 0
                assign tile_img = cat.products.first.featured_image
              endif
              assign icon = 'box'
              if cat.handle contains 'tool-storage' or cat.handle contains 'chest' or cat.handle contains 'cabinet'
                assign icon = 'cabinet'
              elsif cat.handle contains 'air' or cat.handle contains 'compressor'
                assign icon = 'air'
              elsif cat.handle contains 'foam'
                assign icon = 'foam'
              elsif cat.handle contains 'accessor'
                assign icon = 'wrench'
              elsif cat.handle contains 'set' or cat.handle contains 'bundle'
                assign icon = 'grid'
              endif
              assign tile_alt = tile_img.alt | default: cat.title
              assign is_on = false
              if is_coll and cat.handle == collection.handle
                assign is_on = true
              endif
            -%}
            <li>
              <a class="txc-cat{% if is_on %} is-on{% endif %}" href="{{ cat.url }}"{% if is_on %} aria-current="page"{% endif %}>
                <span class="txc-cat__media">
                  {% if tile_img != blank %}{{ tile_img | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 900px) 22vw, 46vw', alt: tile_alt }}{% endif %}
                  <span class="txc-cat__icon" aria-hidden="true">{% render 'tx-c-icon', name: icon %}</span>
                </span>
                <span class="txc-cat__body">
                  <span class="txc-cat__title">{{ cat.title }}</span>
                  {% if cat.description != blank %}<span class="txc-cat__text">{{ cat.description | strip_html | strip | truncatewords: 14 }}</span>{% endif %}
                  <span class="txc-cat__meta">{{ cat.products_count }} {% if cat.products_count == 1 %}product{% else %}products{% endif %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                </span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "TX Collection header",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "crumb_label", "label": "Breadcrumb label", "default": "Shop" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop TOOSA" },
    { "type": "text", "id": "heading", "label": "Heading (used when there is no collection)", "default": "Shop TOOSA workshop solutions" },
    { "type": "textarea", "id": "lead", "label": "Lead text (leave empty to use the start of the collection description)" },
    { "type": "image_picker", "id": "image", "label": "Cover image (defaults to the collection image)" },
    { "type": "checkbox", "id": "show_categories", "label": "Show category tiles", "default": true },
    { "type": "text", "id": "categories_title", "label": "Category tiles title", "default": "Browse by range" },
    { "type": "collection_list", "id": "categories", "label": "Categories", "limit": 6 }
  ],
  "blocks": [
    { "type": "chip", "name": "Fact chip", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
        { "value": "steel", "label": "Steel frame" },
        { "value": "truck", "label": "Delivery" },
        { "value": "card", "label": "Financing" },
        { "value": "pin", "label": "Location" },
        { "value": "ul", "label": "Certification shield" },
        { "value": "leaf", "label": "Maple leaf" },
        { "value": "foam", "label": "Foam" },
        { "value": "air", "label": "Air" },
        { "value": "check", "label": "Check" }
      ] },
      { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $3,000" }
    ] }
  ],
  "presets": [ { "name": "TX Collection header", "blocks": [
    { "type": "chip", "settings": { "icon": "steel", "text": "Welded heavy-gauge steel" } },
    { "type": "chip", "settings": { "icon": "truck", "text": "Free shipping over $3,000" } },
    { "type": "chip", "settings": { "icon": "card", "text": "Pay monthly with RBC" } },
    { "type": "chip", "settings": { "icon": "pin", "text": "Pickup in Richmond and Calgary" } }
  ] } ]
}
{% endschema %}
