{% style %}
#shopify-section-{{ section.id }} {

  {% if section.settings.content_custom_width %}
    --theme-newsletter-content-width: {{ section.settings.content_width | append: 'px' }};
  {% endif %}

  {% if section.settings.form_custom_width %}
    --theme-newsletter-form-width: {{ section.settings.form_width | append: 'px' }};
  {% endif %}

  
  {% if section.settings.background_overlay %}
    --theme-newsletter-overlay-color: {{ section.settings.background_overlay_color }};
    --theme-newsletter-overlay-opacity: {{ section.settings.background_overlay_opacity | append: '%' }};

  {% endif %}

  --theme-newsletter-content-padding: var(--theme-block-content-padding-{{ section.settings.inset_choice }});

}
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% if section.settings.height_mobile != 'auto' %}
      --theme-newsletter-custom-height-mobile: {{ section.settings.height_mobile | append: 'px' }};
    {% endif %}

    {% if section.settings.height != 'auto' %}
      --theme-newsletter-custom-height-desktop: {{ section.settings.height | append: 'px' }};
    {% endif %}

  }
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-newsletter{% liquid

  if section.settings.content_horizontal_align != blank
    echo ' content-horizontal-align-' | append: section.settings.content_horizontal_align
  endif 

  if section.settings.content_vertical_align != blank
    echo ' content-vertical-align-' | append: section.settings.content_vertical_align
  endif 


  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif
  
%}">
  <div class="section-newsletter-container section-container">
    {% if section.settings.use_background_image %}
      <div class="section-newsletter-background">
        
        <div class="section-newsletter-background-media">
          {% if section.settings.background_image != blank or section.settings.background_image_mobile != blank %}
            {% render 'section-image-processor', image: section.settings.background_image, image_mobile: section.settings.background_image_mobile %}
          {% endif %}

          {% if section.settings.background_video != blank %}
            <div class="section-newsletter-background-video">
              {{ section.settings.background_video | video_tag: controls: false, autoplay: true, muted: true, loop: true }}
            </div>
          {% endif %}
          {% if section.settings.background_video == blank and section.settings.background_image == blank and section.settings.background_image_mobile == blank  %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder placeholder-newsletter' }}
          {% endif %}
        </div>
        {% if section.settings.background_overlay %}
          <div class="section-newsletter-background-overlay"></div>
        {% endif %}
        
      </div>
    {% endif %}
    <div class="section-newsletter-content">
      {% if section.blocks != blank %}
        <div class="section-newsletter-content-additional">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'special-heading' %}
                {% if block.settings.newsletter_special_heading != blank %}
                  <h2 class="section-newsletter-special-heading special-heading-size-{{ block.settings.newsletter_special_heading_size }} block-{% echo block.id %}" {{ block.shopify_attributes }}>{{ block.settings.newsletter_special_heading }}</h2>
                {% endif %}
              {% when 'heading' %}
                {% if block.settings.newsletter_heading != blank %}
                  <h3 class="section-newsletter-heading heading-size-{{ block.settings.newsletter_heading_size }} block-{% echo block.id %}" {{ block.shopify_attributes }}>{{ block.settings.newsletter_heading }}</h3>
                {% endif %}
              {% when 'text' %}
                {% if block.settings.newsletter_text != blank %}
                  <p class="section-newsletter-text paragraph-size-{{ block.settings.newsletter_text_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.newsletter_text }}</p>
                {% endif %}
              {% when '@app' %}
                {% render block %}
              {% when 'liquid' %}
                <div class="custom-liquid">
                    {{ block.settings.custom_liquid }}
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}
      <div class="section-newsletter-content-main">
        {% render 'newsletter-form' section_id: section.id %}
        {% if section.settings.button_1_text != blank or section.settings.button_2_text != blank %}
          <div class="section-newsletter-buttons">
            {% if section.settings.button_1_text != blank %}
              {% render 'button', 
                  button_text: section.settings.button_1_text,  
                  button_url: section.settings.button_1_url,
                  button_style: section.settings.button_1_style,
                  button_target: section.settings.button_1_target,
                  button_classes: 'section-newsletter-button'
              %}
            {% endif %}
            {% if section.settings.button_2_text != blank %}
              {% render 'button', 
                  button_text: section.settings.button_2_text,  
                  button_url: section.settings.button_2_url,
                  button_style: section.settings.button_2_style,
                  button_target: section.settings.button_2_target,
                  button_classes: 'section-newsletter-button'
              %}
            {% endif %}
            
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}



