{% liquid 
  assign rtls = 'ar,he,fa,ur,ps,syr,sd,ug,ku,yi,nqo,ckb,dv,mzn' | split: ','
  if rtls contains request.locale.iso_code
    assign rtl_suffix = '-rtl'
  endif 
%}

{% liquid 
    if section.settings.country_selector or section.settings.language_selector
      echo 'country-language-selector' | append: rtl_suffix | append:'.css' | asset_url | stylesheet_tag
    endif

%}

{% if section.settings.country_selector or section.settings.language_selector %}
  <script src="{{ 'country-language-selector.js' | asset_url }}" defer></script>
{% endif %}


{% if section.settings.header_min_height != blank %}

  {% style %}
    #shopify-section-{{ section.id }} {
      --theme-header-min-height: {{ section.settings.header_min_height | append: "px" }};
    }
  {% endstyle %}
{% endif %}

{% if section.settings.logo != blank %}
    {% style %}
        :root{
            --theme-logo-height: {{ section.settings.logo_height | append: "px" }};
        }
    {% endstyle %}
{% endif %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});

  }
{% endstyle %}



<script src="{{ 'header-drawer.js' | asset_url }}" defer></script>

{% liquid
    
    assign show_country_selector = false
    assign show_language_selector = false

    assign menu_card_indexes = ''

    for block in section.blocks
        if block.type == 'menu_card'
            assign menu_card_indexes = menu_card_indexes | append: block.settings.menu_card_parent_index | append: '|'
        endif
    endfor

    assign menu_card_indexes = menu_card_indexes | split: '|' | uniq


    if localization.available_countries.size > 1 and section.settings.country_selector
        assign show_country_selector = true
    endif 


    if localization.available_languages.size > 1 and section.settings.language_selector
        assign show_language_selector = true
    endif 


%}


<div class="section-header{% liquid 
  if show_country_selector or show_language_selector
      echo ' has-localization-selector'
      echo ' has-localization-style-' | append: section.settings.country_language_style
  endif

  if section.settings.header_style
    echo ' has-header-style-' | append: section.settings.header_style
  endif


  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

    echo ' has-section-padding-on-sides'

  
  if section.settings.primary_menu_sticky
    echo ' has-sticky-header'
  endif

  if section.settings.primary_menu_floating
    echo ' has-floating-header'
  endif

  echo ' ' | append: section.settings.color_scheme

%}" 
{% if section.settings.primary_menu_floating %}
  data-floating-color-scheme="{{ section.settings.floating_color_scheme }}"
{% endif %}
>
    <div class="section-header-container section-container">
        <div class="section-header-left">
            
            <a href="{{ routes.root_url }}" class="section-header-root-link">
                {% if section.settings.logo != blank %}
                    {% assign retina_logo_height = section.settings.logo_height | times: 2 | append: "px" %}
                <div class="section-header-logo">
                    {{ section.settings.logo | image_url: height: retina_logo_height | image_tag: widths: '50, 100, 150, 200, 250, 300, 400, 500', loading: 'lazy', alt: shop.name | escape }}
                    {% if section.settings.primary_menu_floating and section.settings.floating_logo %}
                      <span class="floating-logo">{{ section.settings.floating_logo | image_url: height: retina_logo_height | image_tag: widths: '50, 100, 150, 200, 250, 300, 400, 500', loading: 'lazy', alt: shop.name | escape }}</span>
                    {% endif %}
                </div>
                {% else %}
                <div class="section-header-shop-name">
                    {{ shop.name }}
                </div>
                {% endif %}
            </a>
            {% if section.settings.country_language_placement == 'left' and section.settings.header_style == '1' %}
              {% if show_country_selector or show_language_selector %}
                  <div class="section-header-additional-contents">
                      {% if section.settings.country_selector %}
                          <div class="section-header-country-selector">
                              {% render 'country-selector', label_style: section.settings.country_label_style %}
                          </div>
                      {% endif %}
                      {% if section.settings.language_selector %}
                          <div class="section-header-language-selector">
                              {% render 'language-selector', label_style: section.settings.language_label_style %}
                          </div>
                      {% endif %}
                  </div>
              {% endif %}
            {% endif %}

        </div>
        <div class="section-header-center">
            {% render 'header-drawer' %}

            <div class="section-header-menus">
                {% if section.settings.primary_menu != blank %}
                <nav class="section-header-main-menu">
                    <ul class="section-header-main-menu-items">
                        {% for primary_menu_item in section.settings.primary_menu.links %}
                          {% assign has_mega_menu = false %}
                          {% assign primary_menu_for_loop_index = forloop.index %}
                          {% liquid 
                            if section.blocks != blank
                              for block in section.blocks
                                if block.type == 'mega_menu'
                                  if primary_menu_for_loop_index == block.settings.mega_menu_index
                                    assign has_mega_menu = true
                                  endif
                                endif 
                              endfor
                            endif
                          
                          %}
                          <li class="section-header-main-menu-item{% liquid 
                              if primary_menu_item.links != blank 
                                  echo ' has-children'
                              endif 
                              
                              if has_mega_menu
                                echo ' has-megamenu'
                              endif
                              if has_mega_menu and section.settings.tx_compact_index == primary_menu_for_loop_index
                                echo ' tx-has-mega'
                              endif
                              
                              %}">
                              <a href="{{ primary_menu_item.url }}" class="section-header-main-menu-item__link{% liquid 
                                      if primary_menu_item.current 
                                          echo ' current' 
                                      endif 
                                  %}" {% liquid 
                                      if primary_menu_item.current 
                                              echo 'aria-current="page"' 
                                      endif 
                                  %}>
                                  {%liquid
                                  if section.settings.primary_menu_collection_image_display
                                      if primary_menu_item.type == "collection_link" and primary_menu_item.object.image
                                          assign menu_img_alt = primary_menu_item.object.image.alt | default: primary_menu_item.title | escape
                                          echo primary_menu_item.object.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: menu_img_alt
                                      endif
                                  endif
                                  %}
                                  <span class="section-header-main-menu-item-text">{{ primary_menu_item.title | escape }}</span>
                                  {% if primary_menu_item.links != blank or has_mega_menu %}
                                      <span class="section-header-main-menu-item-icon">{% render 'icon-chevron-down' %}</span>
                                  {% endif %}
                              </a>

                              {% if primary_menu_item.links != blank or has_mega_menu %}
                              <ul class="section-header-main-menu-subitems">
                                  {% if has_mega_menu and section.settings.tx_compact_index == primary_menu_for_loop_index %}
                                    {% render 'tx-mega', item: primary_menu_item %}
                                  {% else %}
                                  {% for primary_menu_subitem in primary_menu_item.links %}
                                  <li class="section-header-main-menu-subitem{% liquid 
                                      if primary_menu_subitem.links != blank 
                                          echo ' has-children'
                                      endif 

                                      echo ' ' | append: 'scheme_1'

                                      %}">
                                      <a href="{{ primary_menu_subitem.url }}" class="section-header-main-menu-subitem__link{% liquid 
                                              if primary_menu_subitem.current 
                                                  echo ' current' 
                                              endif 
                                          %}" {% liquid 
                                              if primary_menu_subitem.current 
                                                  echo 'aria-current="page"' 
                                              endif
                                      %}>
                                          {%liquid
                                          if section.settings.primary_menu_collection_image_display
                                          if primary_menu_subitem.type == "collection_link" and primary_menu_subitem.object.image
                                          assign menu_img_alt = primary_menu_subitem.object.image.alt | default: primary_menu_subitem.title | escape
                                          echo primary_menu_subitem.object.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: menu_img_alt
                                          endif
                                          endif
                                          %}
                                            <span class="section-header-main-menu-item-text">{{ primary_menu_subitem.title | escape }}</span>
                                            {% if primary_menu_subitem.links != blank %}
                                                <span class="section-header-main-menu-item-icon">{% render 'icon-chevron-down' %}</span>
                                            {% endif %}
                                      </a>
                                      {% if primary_menu_subitem.links != blank %}
                                      <ul class="section-header-main-menu-subitems">
                                          {% for primary_menu_sub_subitem in primary_menu_subitem.links %}
                                          <li class="section-header-main-menu-subitem{% liquid 
                                                          if primary_menu_sub_subitem.links != blank 
                                                              echo ' has-children'
                                                          endif 
                                                          %}">
                                              <a href="{{ primary_menu_sub_subitem.url }}" class="section-header-main-menu-subitem__link{% liquid 
                                                      if primary_menu_sub_subitem.current 
                                                          echo ' current' 
                                                      endif 
                                                  %}" {% liquid 
                                                      if primary_menu_sub_subitem.current
                                                  echo 'aria-current="page"' 
                                                  endif 
                                              %}>
                                                  {%liquid
                                                      if section.settings.primary_menu_collection_image_display
                                                          if primary_menu_sub_subitem.type == "collection_link" and primary_menu_sub_subitem.object.image
                                                              assign menu_img_alt = primary_menu_sub_subitem.object.image.alt | default: primary_menu_sub_subitem.title | escape
                                          echo primary_menu_sub_subitem.object.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: menu_img_alt
                                                          endif
                                                      endif
                                                  %}
                                                  <span class="section-header-main-menu-item-text">{{ primary_menu_sub_subitem.title | escape }}</span>
                                                  {% if primary_menu_sub_subitem.links != blank %}
                                                      <span class="section-header-main-menu-item-icon">{% render 'icon-chevron-down' %}</span>
                                                  {% endif %}
                                              </a>
                                          </li>
                                          {% endfor %}
                                      </ul>
                                      {% endif %}
                                  </li>
                                  {% endfor %}

                                  {% if section.blocks != blank %}
                                    {% for block in section.blocks %}
                                      {% if block.type == 'mega_menu' %}
                                        {% if primary_menu_for_loop_index == block.settings.mega_menu_index %}
                                            {% for i in (1..3) %}
                                              {% capture mega_menu_card_image %}mega_menu_card_{{ i }}_image{% endcapture %}
                                              {% capture mega_menu_card_text_1 %}mega_menu_card_{{ i }}_text_1{% endcapture %}
                                              {% capture mega_menu_card_text_2 %}mega_menu_card_{{ i }}_text_2{% endcapture %}
                                              {% capture mega_menu_card_link %}mega_menu_card_{{ i }}_link{% endcapture %}
                                              {% capture mega_menu_card_target %}mega_menu_card_{{ i }}_target{% endcapture %}

                                              {% if block.settings[mega_menu_card_image] != blank %}
                                                <li class="section-header-main-menu-subitem section-header-main-menu-subitem-card{% liquid
                                                  echo ' ' | append: 'scheme_1'

                                                  %}">
                                                    <div class="section-header-main-menu-card" {{ block.shopify_attributes }}>
                                                        <div class="section-header-main-menu-card__image">{%- assign card_img_alt = block.settings[mega_menu_card_image].alt | default: block.settings[mega_menu_card_text_1] | default: shop.name | escape -%}{{ block.settings[mega_menu_card_image] | image_url: width: 320 | image_tag: loading: 'lazy', alt: card_img_alt }}</div>
                                                        <div class="section-header-main-menu-card__title">
                                                          {% if block.settings[mega_menu_card_text_1] != blank %}
                                                            {% if block.settings[mega_menu_card_link] != blank %}
                                                              <a class="section-header-main-menu-card__link" href="{{ block.settings[mega_menu_card_link] }}" target="{{ block.settings[mega_menu_card_target] | default: '_self' }}">
                                                            {% endif %}
                                                              {% if block.settings[mega_menu_card_text_1] != blank %}
                                                                <h6 class="section-header-main-menu-card__heading">{{ block.settings[mega_menu_card_text_1] }}</h6>
                                                              {% endif %}
                                                              {% if block.settings[mega_menu_card_text_2] != blank %}
                                                                <div class="section-header-main-menu-card__description">{{ block.settings[mega_menu_card_text_2] }}</div>
                                                              {% endif %}
                                                            {% if block.settings[mega_menu_card_link] != blank %}
                                                              </a>
                                                            {% endif %}
                                                          {% endif %}
                                                        </div>
                                                    </div>
                                                </li>
                                              {% endif %}
                                             
                                            {% endfor %}

                                        {% endif %}
                                      {% endif %}
                                    {% endfor %}
                                  {% endif %}
                                  {% endif %}

                              </ul>

                              {% endif %}
                          </li>

                        {% endfor %}
                    </ul>
                </nav>
                {% endif %}
            </div>

            {% if section.settings.country_language_placement == 'left' and section.settings.header_style == '2' %}
              {% if show_country_selector or show_language_selector %}
                  <div class="section-header-additional-contents">
                      {% if section.settings.country_selector %}
                          <div class="section-header-country-selector">
                              {% render 'country-selector', label_style: section.settings.country_label_style %}
                          </div>
                      {% endif %}
                      {% if section.settings.language_selector %}
                          <div class="section-header-language-selector">
                              {% render 'language-selector', label_style: section.settings.language_label_style %}
                          </div>
                      {% endif %}
                  </div>
              {% endif %}
            {% endif %}
        </div>
        <div class="section-header-right">
            <div class="section-header-icons">

                {% if section.settings.search_icon %}
                    {% render 'search-dropdown' %}
                {% endif %}

                {% if shop.customer_accounts_enabled %}
                  {% if section.settings.account_icon or section.settings.account_label %}
                    <div class="section-header-icons__account">
                        {% if customer %}
                            <a href="{{ routes.account_url }}" class="section-header-icons__account--account">
                              {% if section.settings.account_icon %}
                                <span class="section-header-icons-account-icon">{% render 'icon-user' %}</span>
                              {% endif %}
                              {% if section.settings.account_label %}
                                <span>{{ 'customer.account_fallback' | t }}</span>
                              {% endif %}
                            </a>
                        {% else %}
                            <a href="{{ routes.account_login_url }}" class="section-header-icons__account--login">
                              {% if section.settings.account_icon %}
                                <span class="section-header-icons-account-icon">{% render 'icon-user' %}</span>
                              {% endif %}
                              {% if section.settings.account_label %}
                                <span>{{ 'customer.log_in' | t }}</span>
                              {% endif %}
                            </a>
                        {% endif %} 
                    </div>
                  {% endif %}
                {% endif %}

                {% if section.settings.cart_icon or section.settings.cart_label %}
                    <div class="section-header-icons__cart">
                        <a href="{{ routes.cart_url }}" class="section-header-cart-drawer-toggle">
                            {% if section.settings.cart_icon %}
                              <span class="section-header-icons-cart-icon">{% render 'icon-cart' %}</span>
                            {% endif %}
                            <span>
                              {% if section.settings.cart_label %}
                                <span>{{ 'sections.header.icons.cart' | t }}</span>
                              {% endif %}
                              <span class="cart-count">{{ cart.item_count }}</span>
                            </span>
                        </a>
                    </div>
                {% endif %}


                {% if section.settings.country_language_placement == 'right' %}
                  {% if show_country_selector or show_language_selector %}
                      <div class="section-header-additional-contents">
                          {% if section.settings.country_selector %}
                              <div class="section-header-country-selector">
                                {% render 'country-selector', label_style: section.settings.country_label_style %}
                              </div>
                          {% endif %}
                          {% if section.settings.language_selector %}
                              <div class="section-header-language-selector">
                                {% render 'language-selector', label_style: section.settings.language_label_style %}
                              </div>
                          {% endif %}
                      </div>
                  {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
      "logo": {{ section.settings.logo | image_url: width: section.settings.logo.width | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }},
       {{ settings.social_linkedin_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}


{% schema %}
