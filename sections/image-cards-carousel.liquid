
{% style %}
#shopify-section-{{ section.id }} {

  --theme-image-cards-carousel-vertcial-alignment: {{ section.settings.vertical_align }};

  {% if section.settings.gap %}
    --theme-image-cards-carousel-gap: var(--theme-gap-{{ section.settings.gap_choice }});
  {% else %}
    --theme-image-cards-carousel-gap: 0px;
  {% endif %}

  --theme-image-cards-carousel-columns-count: {{ section.settings.columns_count }};

}

{% for block in section.blocks %}
  #shopify-section-{{ section.id }} .block-{{ block.id }} {

    --theme-image-cards-carousel-card-aspect-ratio: {{ block.settings.image_aspect_ratio }};
    
    {% if block.settings.image_custom_width %}
      --theme-image-cards-carousel-card-image-width: {{ block.settings.image_width | append: 'px' }};
    {% endif %}

    {% if block.settings.content_custom_width %}
      --theme-image-cards-carousel-card-content-width: {{ block.settings.content_width | append: 'px' }};
    {% endif %}

  }
{% endfor %}

{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


{% liquid 
  
  assign columns_count = section.settings.columns_count | plus: 0
  
  assign section_blocks_size = section.blocks.size


  if section_blocks_size > columns_count and section.settings.carousel
    assign has_carousel = true
  endif

  if section_blocks_size == blank
    assign has_carousel = true
  endif

%}

<div class="section-image-cards-carousel{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-image-cards-carousel-container section-container">
    {% if section.settings.text_1 != blank or section.settings.text_2 != blank or section.settings.button_text != blank %}
      <div class="section-image-cards-carousel-header">
        {% if section.settings.text_1 != blank or section.settings.text_2 != blank %}
          <div class="section-image-cards-carousel-header__left">
            {% if section.settings.text_1 != blank %}
              <h2 class="section-image-cards-carousel-header__heading heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
            {% endif %}

            {% if section.settings.text_2 != blank %}
              <p class="section-image-cards-carousel-header__description paragraph-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</p>
            {% endif %}
          </div>
        {% endif %}
        {% if section.settings.button_text != blank %}
          {% render 'button', 
              button_text: section.settings.button_text,  
              button_url: section.settings.button_url,
              button_style: section.settings.button_style,
              button_classes: 'section-image-cards-carousel-button',
              button_target: section.settings.button_target
          %}
        {% endif %}
      </div>
    {% endif %}
    <div class="section-image-cards-carousel-cards{% liquid 
        if section.settings.columns_offset
          echo ' has-carousel-columns-offset'
        endif

        if has_carousel
          echo ' has-carousel splide'
        endif
        %}" {% liquid 
        if has_carousel 

          assign carousel_columns_count = columns_count
          if section.settings.columns_offset
            assign carousel_columns_count = columns_count | minus: 1
          endif

          assign data_carousel_offset = 'data-columns-offset="' | append: section.settings.columns_offset | append: '"'

          echo data_carousel_offset

          assign data_options = 'data-options={'
            
          assign data_options = data_options | append: '"rewind":' | append: section.settings.loop | append: ','
          assign data_options = data_options | append: '"perMove":' | append: section.settings.per_move | append: ','
          assign data_options = data_options | append: '"perPage":' | append: carousel_columns_count | append: ','

          if section.settings.speed != blank
            assign data_options = data_options | append: '"speed":"' | append: section.settings.speed | append: '",'
          endif 
          if section.settings.interval != blank
            assign data_options = data_options | append: '"interval":"' | append: section.settings.interval | append: '",'
          endif 
          
          assign data_options = data_options | append: '"autoplay":' | append: section.settings.autoplay | append: ','
          assign data_options = data_options | append: '"drag":' | append: section.settings.mouse_drag | append: ','
          assign data_options = data_options | append: '"arrows":' | append: section.settings.arrows | append: ','
          assign data_options = data_options | append: '"pagination":' | append: section.settings.dots | append: ','

          assign data_options = data_options | append: '"gap":' | append: '"var(--theme-image-cards-carousel-gap)"' | append: ','
          
          assign data_options = data_options | append: '"breakpoints":{'
          assign data_options = data_options | append: '"768":{'
          assign data_options = data_options | append: '"perPage":' | append: 2
          assign data_options = data_options | append: '}'
          assign data_options = data_options | append: '}' | append: ','

          assign data_options_count = data_options | size | minus: 1
          assign data_options = data_options | slice: 0, data_options_count
          assign data_options = data_options | append: '}'

          echo data_options

          
        endif

      
      %}>

        {% if has_carousel %}
          {% if section.settings.progress_bar %}
            <div class="splide__progress">
              <div class="splide__progress-bar"></div>
            </div>
          {% endif %}
          <div class="splide__arrows">
            <button class="splide__arrow splide__arrow--prev">
              {% render 'icon-arrow-right' %}
            </button>
            <button class="splide__arrow splide__arrow--next">
              {% render 'icon-arrow-right' %}
            </button>
          </div>
          <div class="splide__track">
              <ul class="splide__list">
        {% endif %}
      {% if section.blocks != blank %}
        {% for block in section.blocks %}
            {% liquid 
              assign tag = 'div'
              if has_carousel
                assign tag = 'li' 
              endif 
            %}
          <{{ tag }} class="section-image-cards-carousel-card{% liquid 
              if has_carousel
                echo ' splide__slide'
              endif 

              %} block-{{ block.id }}" {{ block.shopify_attributes }}>
            
            <div class="section-image-cards-carousel-card__image">
            {% if block.settings.image_link %}
                <a href="{{ block.settings.image_link }}" title="{{ block.settings.text_1 }}">
            {% endif %}
              {% if block.settings.image != blank %}
                {% render 'section-image-processor', image: block.settings.image %}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder placeholder-image-cards' }}
              {% endif %}
            {% if block.settings.image_link %}
                </a>
            {% endif %}
            </div>
            
            <div class="section-image-cards-carousel-card__content">
              {% if block.settings.text_1 != blank %}
                <h3 class="section-image-cards-carousel-card__heading special-heading-size-{{ block.settings.text_1_size }}">{{ block.settings.text_1 }}</h3>
              {% endif %}
              {% if block.settings.text_2 != blank %}
                <div class="section-image-cards-carousel-card__additional-heading heading-size-{{ block.settings.text_2_size }}">{{ block.settings.text_2 }}</div>
              {% endif %}
              {% if block.settings.text_3 != blank %}
                <p class="section-image-cards-carousel-card__description paragraph-size-{{ block.settings.text_3_size }}">{{ block.settings.text_3 }}</p>
              {% endif %}

              {% if block.settings.button_text != blank %}
                {% render 'button', 
                    button_text: block.settings.button_text,  
                    button_url: block.settings.button_url,
                    button_style: block.settings.button_style,
                    button_classes: 'section-image-cards-carousel-card__button',
                    button_target: block.settings.button_target
                %}
              {% endif %}
            </div>
        </{{ tag }}>
        {% endfor %}
      {% endif %}
      {% if has_carousel %}
          </ul>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}



