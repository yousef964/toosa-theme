


{% style %}
#shopify-section-{{ section.id }} {

  
  {% if section.settings.background_overlay %}
    --theme-image-banner-overlay-color: {{ section.settings.background_overlay_color }};
    --theme-image-banner-overlay-opacity: {{ section.settings.background_overlay_opacity | append: '%' }};

  {% endif %}

}
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% if section.settings.height_mobile != 'auto' %}
      --theme-image-banner-custom-height-mobile: {{ section.settings.height_mobile | append: 'px' }};
    {% endif %}

    {% if section.settings.height != 'auto' %}
      --theme-image-banner-custom-height-desktop: {{ section.settings.height | append: 'px' }};
    {% endif %}
  }
{% endstyle %}




{% style %}
  #shopify-section-{{ section.id }} {

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


{% liquid 

  
  assign products_choice = section.settings.products_choice


  assign products_count = 3 



%}


<div class="section-image-banner-products{% liquid
  if section.settings.toggle_position != blank
    echo ' toggle-position-' | append: section.settings.toggle_position
  endif 

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif
  
  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-image-banner-products-background">
    <div class="section-image-banner-products-background-media">
      {% if section.settings.background_image != blank or section.settings.background_image_mobile != blank %}
        {% render 'section-image-processor', image: section.settings.background_image, image_mobile: section.settings.background_image_mobile %}
      {% endif %}

      {% if section.settings.background_video != blank %}
        <div class="section-image-banner-products-background-video">
          {{ section.settings.background_video | video_tag: controls: false, autoplay: true, muted: true, loop: true }}
        </div>
      {% endif %}
      {% if section.settings.background_video == blank and section.settings.background_image == blank and section.settings.background_image_mobile == blank %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder placeholder-image-banner' }}
      {% endif %}
    </div>
    {% if section.settings.background_overlay %}
      <div class="section-image-banner-products-background-overlay"></div>
    {% endif %}
  </div>
    <div class="section-image-banner-products-content section-container">
        <buton class="section-image-banner-products-toggle{% liquid 
            echo ' btn-' | append: section.settings.button_style
        %}">
            {% render 'icon-cart' %}
            <span>{{ section.settings.toggle_text }}</span>
        </buton>
        <div class="section-image-banner-products-toggle-content{% liquid
            if section.settings.toggle_active
                echo ' active'
            endif
        %}">
            <div class="section-image-banner-products-toggle-content-header">
                <span class="section-image-banner-products-toggle-content-header__close">
                {% render 'icon-close' %}
                </span>
            </div>
            <div class="section-image-banner-products-list has-product-size-small">
                {% if section.settings.products_choice != blank %}
                    {% for product in section.settings.products_choice %}
                    <div class="section-image-banner-products-product product">
                        {% render 'section-product-processor', product: product, section_settings: section.settings, prefix: 'section-image-banner-products-product', display_style: 'small' %}
                    </div>
                    {% endfor %}
                {% else %}
                    {% for i in (1..3) %}
                    {% assign placeholder_image = 'product-' | append: forloop.index %}
                    <div class="section-image-banner-products-product product">
                        <div class="product__top">
                          <div class="product__image">
                          {{ placeholder_image | placeholder_svg_tag: 'placeholder placeholder-handpicked-products' }}
                          </div>
                        </div>
                        <div class="product__bottom">
                          <h3 class="product__title">
                              {{ 'products.placeholder.title' | t }}
                          </h3>
                          <p class="product__price">
                              <span>{{ 'products.placeholder.price' | t }}</span>
                          </p>
                        </div>
                    </div>
                    {% endfor %}
                {% endif %}
            </div>
            {% if section.settings.button_text != blank %}
                {% render 'button', 
                    button_text: section.settings.button_text,  
                    button_url: section.settings.button_url,
                    button_style: section.settings.button_style,
                    button_classes: 'section-image-banner-products-button'
                %}
            {% endif %}
        </div>
    </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


