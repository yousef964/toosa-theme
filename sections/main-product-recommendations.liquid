
{% style %}
#shopify-section-{{ section.id }} {

  {% if section.settings.gap %}
    --theme-products-recommendations-gap: var(--theme-gap-{{ section.settings.gap_choice }});
    {% else %}
      --theme-products-recommendations-gap: 0px;
  {% endif %}
}
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});

  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}

{% liquid

  assign section_padding_classname = 'has-section-padding'
  assign color_scheme = section.settings.color_scheme

  for scheme in settings.color_schemes
    if color_scheme == scheme and scheme.settings.background == blank
      if scheme.settings.background == blank
       assign section_padding_classname = 'has-section-padding-on-sides'
      endif
    endif
  endfor

%}

<div class="section-product-recommendations{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  echo ' ' | append: section_padding_classname

  echo ' ' | append: section.settings.color_scheme

%}">
    <div class="section-product-recommendations-container section-container">
    {% if section.settings.heading != blank %}
        <div class="section-product-recommendations-header">
            <h2 class="section-product-recommendations-header__heading special-heading-size-{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        </div>
    {% endif %}
    <product-recommendations class="product-recommendations" 
        data-product-id="{{ product.id }}" 
        data-intent="related" 
        data-columns-count="4"
        data-limit="{{ section.settings.total_count }}" 
        data-carousel="{{ section.settings.carousel }}" 
        data-columns-offset="{{ section.settings.columns_offset }}"
        {% liquid 

        assign data_options = 'data-options={'
          
        assign data_options = data_options | append: '"rewind":' | append: section.settings.loop | append: ','
        assign data_options = data_options | append: '"perMove":"' | append: section.settings.per_move | append: '",'
        assign data_options = data_options | append: '"perPage":"' | append: 4 | append: '",'

        if section.settings.speed != blank
          assign data_options = data_options | append: '"speed":"' | append: section.settings.speed | append: '",'
        endif 
        if section.settings.interval != blank
          assign data_options = data_options | append: '"interval":"' | append: section.settings.interval | append: '",'
        endif 
        
        assign data_options = data_options | append: '"autoplay":' | append: section.settings.autoplay | append: ','
        assign data_options = data_options | append: '"drag":' | append: section.settings.mouse_drag | append: ','
        assign data_options = data_options | append: '"arrows":' | append: section.settings.arrows | append: ','
        assign data_options = data_options | append: '"pagination":' | append: section.settings.dots | append: ','

        assign data_options = data_options | append: '"gap":' | append: '"var(--theme-products-recommendations-gap)"' | append: ','
      
        assign data_options = data_options | append: '"breakpoints":{'
        assign data_options = data_options | append: '"1700":{'
        assign data_options = data_options | append: '"perPage":' | append: 3
        assign data_options = data_options | append: '},'
        assign data_options = data_options | append: '"768":{'
        assign data_options = data_options | append: '"perPage":' | append: 2
        assign data_options = data_options | append: '}'
        assign data_options = data_options | append: '}' | append: ','

        assign data_options_count = data_options | size | minus: 1
        assign data_options = data_options | slice: 0, data_options_count
        assign data_options = data_options | append: '}'


        echo data_options
    
    %}>
    {% if section.settings.progress_bar %}
      <div class="splide__progress">
        <div class="splide__progress-bar"></div>
      </div>
    {% endif %}
    <div class="splide__arrows">
        <button class="splide__arrow splide__arrow--prev">
        {% render 'icon-arrow-right' %}
        </button>
        <button class="splide__arrow splide__arrow--next">
        {% render 'icon-arrow-right' %}
        </button>
    </div>
    </product-recommendations>
</div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


{% schema %}
{"name":"t:sections.product_recommendations.name","limit":1,"settings":[{"type":"header","content":"t:sections.common.settings.header__general.content"},{"type":"checkbox","id":"fullwidth","label":"t:sections.common.settings.fullwidth.label","info":"t:sections.common.settings.fullwidth.info","default":true},{"type":"range","id":"width","min":500,"max":2000,"step":20,"unit":"px","label":"t:sections.common.settings.width.label","default":1320,"info":"t:sections.common.settings.width.info"},{"type":"color_scheme","id":"color_scheme","default":"scheme_1","label":"t:sections.common.settings.color_scheme.label"},{"type":"select","id":"inset_choice","label":"t:sections.common.settings.inset_choice.label","options":[{"value":"level-1","label":"t:sections.common.settings.inset_choice.options.option__0.label"},{"value":"level-2","label":"t:sections.common.settings.inset_choice.options.option__1.label"},{"value":"level-3","label":"t:sections.common.settings.inset_choice.options.option__2.label"},{"value":"level-4","label":"t:sections.common.settings.inset_choice.options.option__3.label"},{"value":"level-5","label":"t:sections.common.settings.inset_choice.options.option__4.label"}],"default":"level-4"},{"type":"header","content":"t:sections.common.settings.header__heading.content"},{"type":"text","id":"heading","label":"t:sections.product_recommendations.settings.heading.label","default":"You may also like"},{"type":"select","id":"heading_size","label":"t:sections.product_recommendations.settings.heading_size.label","options":[{"value":"x-small","label":"t:sections.product_recommendations.settings.heading_size.options.option__0.label"},{"value":"small","label":"t:sections.product_recommendations.settings.heading_size.options.option__1.label"},{"value":"medium","label":"t:sections.product_recommendations.settings.heading_size.options.option__2.label"},{"value":"large","label":"t:sections.product_recommendations.settings.heading_size.options.option__3.label"}],"default":"small"},{"type":"header","content":"t:sections.common.settings.header__products.content"},{"type":"checkbox","id":"columns_offset","label":"t:sections.product_recommendations.settings.columns_offset.label","info":"t:sections.product_recommendations.settings.columns_offset.info","default":true},{"type":"number","id":"total_count","label":"t:sections.product_recommendations.settings.total_count.label","default":6},{"type":"checkbox","id":"gap","label":"t:sections.product_recommendations.settings.gap.label","info":"t:sections.product_recommendations.settings.gap.info","default":true},{"type":"select","id":"gap_choice","label":"t:sections.common.settings.gap_choice.label","options":[{"value":"level-1","label":"t:sections.common.settings.gap_choice.options.option__0.label"},{"value":"level-2","label":"t:sections.common.settings.gap_choice.options.option__1.label"},{"value":"level-3","label":"t:sections.common.settings.gap_choice.options.option__2.label"},{"value":"level-4","label":"t:sections.common.settings.gap_choice.options.option__3.label"},{"value":"level-5","label":"t:sections.common.settings.gap_choice.options.option__4.label"},{"value":"level-6","label":"t:sections.common.settings.gap_choice.options.option__5.label"},{"value":"level-7","label":"t:sections.common.settings.gap_choice.options.option__6.label"}],"default":"level-4","info":"t:sections.common.settings.gap_choice.info"},{"type":"header","content":"t:sections.common.settings.header__carousel_settings.content"},{"type":"checkbox","id":"carousel","label":"t:sections.common.settings.carousel.label","default":true},{"type":"range","id":"per_move","min":1,"max":4,"step":1,"label":"t:sections.common.settings.per_move.label","info":"t:sections.common.settings.per_move.info","default":1},{"type":"checkbox","id":"autoplay","label":"t:sections.common.settings.autoplay.label","default":true},{"type":"range","id":"interval","min":1000,"max":9000,"step":100,"unit":"ms","label":"t:sections.common.settings.interval.label","def