
{% style %}
#shopify-section-{{ section.id }} {
  --theme-image-cards-slider-cards-aspect-ratio: {{ section.settings.cards_aspect_ratio }}
}
{% endstyle %}

{% style %}
  {% for block in section.blocks %}
    #shopify-section-{{ section.id }} .block-{{ block.id }} {

      --theme-image-cards-slider-card-aspect-ratio: {{ block.settings.image_aspect_ratio }};

      {% if block.settings.content_custom_width %}
        --theme-image-cards-slider-card-content-width: {{ block.settings.content_width | append: 'px' }};
      {% endif %}
      
      --theme-block-content-padding: var(--theme-block-content-padding-{{ block.settings.inset_choice }});
      

    }
  {% endfor %}

{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }} {

    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
    --theme-section-side-margin-overflow: var(--theme-section-side-margin-overflow-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-image-cards-slider{% liquid 

    echo ' has-section-padding-on-top-bottom-left'

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-image-cards-slider-container section-container">
    <image-cards-slider class="section-image-cards-slider-content">
        {% if section.settings.page_number %}
          <div class="cards-pagination">
              <div class="cards-pagination-content">
                  <span class="cards-pagination-current">1</span>
                  <span>/</span>
                  <span class="cards-pagination-total">{{ section.blocks | size }}</span>
              </div>
          </div>
        {% endif %}
        <div class="cards-main-carousel">
          <div class="cards-main-carousel-container">
            {% if section.blocks != blank %}
              {% if section.blocks.size > 1 %}
                <div class="cards-main-carousel-navigation">
                    <button class="cards-main-carousel-navigation__prev prev" aria-disabled="true">{% render 'icon-arrow-right' %}</button>
                    <button class="cards-main-carousel-navigation__next next" aria-disabled="true">{% render 'icon-arrow-right' %}</button>
                </div>
              {% endif %}
              <ul class="cards-main-carousel-list">
                {% for block in section.blocks %}
                  <li class="cards-main-carousel-list-item block-{{ block.id }}{% liquid
                  
                    echo ' ' | append: block.settings.color_scheme
                  %}" {{ block.shopify_attributes }}>
                    <div class="cards-main-carousel-list-item__image">
                      {% if block.settings.image != blank %}
                        {% render 'section-image-processor', image: block.settings.image %}
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'placeholder placeholder-image-cards-slider' }}
                      {% endif %}
                    </div>
                    <div class="cards-main-carousel-list-item__details">
                      <div class="cards-main-carousel-list-item__details-inner">
                        {% if block.settings.text_1 != blank %}
                          <h3 class="cards-main-carousel-list-item__heading special-heading-size-{{ block.settings.text_1_size }}"><span>{{ block.settings.text_1 }}</span></h3>
                        {% endif %}

                        {% if block.settings.text_2 != blank %}
                          <p class="cards-main-carousel-list-item__description paragraph-size-{{ block.settings.text_2_size }}"><span>{{ block.settings.text_2 }}</span></p>
                        {% endif %}
            
                        {% if block.settings.button_text != blank %}
                            {% render 'button', 
                                button_text: block.settings.button_text,  
                                button_url: block.settings.button_url,
                                button_style: block.settings.button_style,
                                button_classes: 'cards-main-carousel-list-item__button',
                                button_target: block.settings.button_target
                            %}
                        {% endif %}
                      </div>
                    </div>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
        <div class="cards-secondary-carousel-list">
          {% if section.blocks != blank %}
            <ul class="">
              {% for block in section.blocks %}
                <li class="block-{{ block.id }}">
                  {% if block.settings.image != blank %}
                    {% render 'section-image-processor', image: block.settings.image %}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder placeholder-image-cards-slider' }}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
    </image-cards-slider>
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
 %}"><hr class="separator"></div>
{% endif %}


