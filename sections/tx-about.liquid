{% comment %} TOOSA redesign: "designed by people who understand workshops" with photo, fact tiles and a short story {% endcomment %}
{%- liquid
  assign about_alt = section.settings.image_alt | default: 'The TOOSA team in the Richmond, BC showroom'
-%}
<section class="tx tx--light tx-about" id="tx-about-{{ section.id }}">
  <div class="tx-wrap">
    <div class="tx-about__grid">
      <div class="tx-about__media tx-reveal">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 50vw, 100vw', alt: about_alt }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'tx-about__placeholder' }}
        {% endif %}
        {% if section.settings.photo_chip != blank %}
          <div class="tx-about__chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            <span>{{ section.settings.photo_chip }}</span>
          </div>
        {% endif %}
      </div>
      <div class="tx-about__copy">
        {% if section.settings.eyebrow != blank %}<p class="tx-eyebrow tx-reveal">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 class="tx-h2 tx-reveal" data-delay="1">{{ section.settings.heading }}</h2>
        {% if section.settings.lead != blank %}<p class="tx-lead tx-reveal" data-delay="2">{{ section.settings.lead }}</p>{% endif %}
        {% if section.blocks.size > 0 %}
          <ul class="tx-about__facts tx-reveal" data-delay="3">
            {% for block in section.blocks %}
              <li class="tx-about__fact" {{ block.shopify_attributes }}>
                <b>{{ block.settings.big }}</b>
                <span>{{ block.settings.small }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
        <div class="tx-actions tx-reveal" data-delay="4">
          {% if section.settings.button_1_text != blank %}<a class="tx-btn tx-btn--primary" href="{{ section.settings.button_1_link | default: '/pages/our-story' }}">{{ section.settings.button_1_text }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{% endif %}
          {% if section.settings.button_2_text != blank %}<a class="tx-btn tx-btn--ghost" href="{{ section.settings.button_2_link | default: '/pages/why-toosa' }}">{{ section.settings.button_2_text }}</a>{% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TX About",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_alt", "label": "Photo description", "default": "The TOOSA founders in front of a black Mega Max workstation" },
    { "type": "text", "id": "photo_chip", "label": "Chip on the photo", "default": "Richmond, BC" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Who we are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed by people who understand workshops." },
    { "type": "textarea", "id": "lead", "label": "Lead text", "default": "TOOSA was founded in 2023 by two engineers with backgrounds in metallurgy and mechatronics, after years in precision machining, manufacturing, automotive components and 3D printing. The idea was simple: tool storage that looks professional and works hard, without choosing between quality, organization and value." },
    { "type": "text", "id": "button_1_text", "label": "Primary button", "default": "Our story" },
    { "type": "url", "id": "button_1_link", "label": "Primary link" },
    { "type": "text", "id": "button_2_text", "label": "Secondary button", "default": "Why TOOSA" },
    { "type": "url", "id": "button_2_link", "label": "Secondary link" }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "settings": [
      { "type": "text", "id": "big", "label": "Big text", "default": "2023" },
      { "type": "text", "id": "small", "label": "Small text", "default": "founded in Richmond, BC" }
    ] }
  ],
  "presets": [ { "name": "TX About", "blocks": [
    { "type": "fact", "settings": { "big": "2 engineers", "small": "metallurgy and mechatronics, friends for 18+ years" } },
    { "type": "fact", "settings": { "big": "Est. 2023", "small": "designed and supported in Richmond, BC" } },
    { "type": "fact", "settings": { "big": "1,000+", "small": "Canadian workshops run on TOOSA" } },
    { "type": "fact", "settings": { "big": "UL certified", "small": "TS-20 compressor package with UL inverter" } }
  ] } ]
}
{% endschema %}
