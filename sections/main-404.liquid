
{% style %}
  #shopify-section-{{ section.id }} {
    {% if section.settings.height_mobile != 'auto' %}
      --theme-404-content-height-mobile: {{ section.settings.height_mobile | append: 'px' }};
    {% endif %}

    {% if section.settings.height != 'auto' %}
      --theme-404-content-height-desktop: {{ section.settings.height | append: 'px' }};
    {% endif %}
  }
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% for block in section.blocks %}
  {% if block.type == 'text' %}

  {% elsif block.type == 'button' %}

    {% style %}
      #shopify-section-{{ section.id }} .block-{{ block.id }}{
        --theme-404-button-width: {{ block.settings.banner_button_width | append: 'px' }};
      }
    {% endstyle %}
    
  {% endif %}
{% endfor %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-404{% liquid
  
  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif

    echo ' ' | append: section.settings.color_scheme
  %}">
  <div class="section-404-container section-container">
    <div class="section-404-content">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'special-heading' %}
            <h2 class="section-404-content__special-heading special-heading-size-{{ block.settings.text_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {% when 'heading' %}
            <h3 class="section-404-content__heading heading-size-{{ block.settings.text_size }} block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h3>
        {% when 'richtext' %}
          <div class="section-404-content__richtext block-{{ block.id }}" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {% when 'button' %}
          {% if block.settings.button_text != blank %}
            <div class="section-404-content__button block-{% echo block.id %}" {{ block.shopify_attributes }}>
              {% render 'button', 
                  button_text: block.settings.button_text,  
                  button_url: block.settings.button_url,
                  button_style: block.settings.button_style,
                  button_custom_width: block.settings.button_custom_width,
                  button_classes: 'section-404-button'
              %}
            </div>
          {% endif %}
        {% when '@app' %}
          {% render block %}
        {% when 'liquid' %}
          <div class="custom-liquid">
              {{ block.settings.custom_liquid }}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
  </div>
</div>


