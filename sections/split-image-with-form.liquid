
{% style %}
#shopify-section-{{ section.id }} {
  
  {% if section.settings.gap %}
    --theme-split-image-and-form-gap: var(--theme-gap-{{ section.settings.gap_choice }});
    {% else %}
      --theme-split-image-and-form-gap: 0px;
  {% endif %}

}
{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }}{
    --theme-split-image-and-form-image-width: {{ section.settings.image_content_width_split | append: '%' }};

    --theme-split-image-and-form-content-width: calc(100% - {{ section.settings.image_content_width_split | append: '%' }});

    
    {% if section.settings.form_custom_width %}
      --theme-split-image-and-form-content-contact-form-width: {{ section.settings.form_width | append: 'px' }};
    {% endif %}

}
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-split-image-and-form{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  echo ' has-placement-style-' | append: section.settings.image_content_placement

  if settings.animation_sections
    echo ' has-animation'
  endif
  
%}">
<div class="section-split-image-and-form-container section-container">
  <div class="section-split-image-and-form-image">
        {% liquid 
          if section.settings.image != blank
            render 'section-image-processor', image: section.settings.image
          else 
            echo 'image' | placeholder_svg_tag: 'placeholder placeholder-image-with-text'
          endif
        %}
  </div>
  <div class="section-split-image-and-form-content {% liquid

    echo ' content-horizontal-align-' | append: section.settings.content_horizontal_align


    echo ' has-content-padding'

    echo ' ' | append: section.settings.color_scheme

  %}">
  {% if section.settings.text_1 != blank or section.settings.text_2 != blank %}
      <div class="section-split-image-and-form-content-header">
        {% if section.settings.text_1 != blank %}
          <h2 class="section-split-image-and-form-content-header__heading special-heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
        {% endif %}
        {% if section.settings.text_2 != blank %}
          <p class="section-split-image-and-form-content-header__description paragraph-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="section-split-image-and-form-content-contact-form">
      {% render 'contact-form' section: section %}
    </div>

  </div>
</div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


