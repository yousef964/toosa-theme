
{% style %}
#shopify-section-{{ section.id }} {
    {% if section.settings.height_mobile != 'auto' %}
      --theme-image-slideshow-custom-height-mobile: {{ section.settings.height_mobile | append: 'px' }};
    {% endif %}

    {% if section.settings.height != 'auto' %}
      --theme-image-slideshow-custom-height: {{ section.settings.height | append: 'px' }};
    {% endif %}

}

{% for block in section.blocks %}
  #shopify-section-{{ section.id }} .block-{{ block.id }} {

    --theme-image-slideshow-card-content-padding: var(--theme-section-content-padding-{{ block.settings.inset_choice }});
    
    

  }
{% endfor %}

{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-image-slideshow{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-image-slideshow-container section-container">
    <image-slideshow class="section-image-slideshow-content">
        {% if section.blocks.size > 1 %}
          <div class="image-slideshow-bottom">
              <div class="image-slideshow-navigation">
                  <button class="image-slideshow-navigation__prev prev" aria-disabled="true" aria-label="Previous">{% render 'icon-arrow-right' %}</button>
                  <button class="image-slideshow-navigation__next next" aria-disabled="true" aria-label="Next">{% render 'icon-arrow-right' %}</button>
              </div>
              <div class="image-slideshow-pagination">
                  <div class="image-slideshow-pagination-content">
                      <span class="image-slideshow-pagination-current">1</span>
                      <span>/</span>
                      <span class="image-slideshow-pagination-total">{{ section.blocks | size }}</span>
                  </div>
              </div>
          </div>
        {% endif %}
        <div class="image-slideshow-main-carousel">
            <div class="image-slideshow-main-carousel-container">
              {% if section.blocks != blank %}
                <ul class="image-slideshow-main-carousel-list">
                    {% for block in section.blocks %}
                      <li class="image-slideshow-main-carousel-list-item block-{{ block.id }}{% liquid
                        echo ' ' | append: block.settings.color_scheme
                      %}">
                        <div class="image-slideshow-main-carousel-list-item__image">
                        {% if block.settings.image != blank %}
                          {% render 'section-image-processor', image: block.settings.image %}
                        {% else %}
                          {{ 'image' | placeholder_svg_tag: 'placeholder placeholder-image-slideshow' }}
                        {% endif %}
                        </div>
                        <div class="image-slideshow-main-carousel-list-item__details">
                          {% if block.settings.text_1 != blank %}
                            <h3 class="image-slideshow-main-carousel-list-item__heading special-heading-size-{{ block.settings.text_1_size }}"><span>{{ block.settings.text_1 }}</span></h3>
                          {% endif %}

                          {% if block.settings.text_2 != blank %}
                            <p class="image-slideshow-main-carousel-list-item__description paragraph-size-{{ block.settings.text_2_size }}"><span>{{ block.settings.text_2 }}</span></p>
                          
                          {% endif %}
                          {% if block.settings.button_text != blank %}
                            {% render 'button', 
                                button_text: block.settings.button_text,  
                                button_url: block.settings.button_url,
                                button_style: block.settings.button_style,
                                button_classes: 'image-slideshow-main-carousel-list-item__button',
                                button_target: block.settings.button_target
                            %}
                          {% endif %}
                        </div>
                      </li>
                    {% endfor %}
                </ul>
              {% endif %}
            </div>
        </div>
        <div class="image-slideshow-secondary-carousel-list">
          {% if section.blocks != blank %}
            <ul class="">
              {% for block in section.blocks %}
                <li class="">
                    {% if block.settings.image != blank %}
                      {% render 'section-image-processor', image: block.settings.image %}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'placeholder placeholder-image-slideshow-slide' }}
                    {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
    </image-slideshow>
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
 %}"><hr class="separator"></div>
{% endif %}


