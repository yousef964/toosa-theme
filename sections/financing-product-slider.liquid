{% comment %}
  Financing Product Slider
  Refresh Theme compatible
  - Collection based products
  - Optional random 10 products
  - Responsive
  - Left / Right content position
  - No external JS/CSS libraries
{% endcomment %}

<section
  id="FinancingProductSlider-{{ section.id }}"
  class="fps-section"
  style="
    --fps-bg: {{ section.settings.background_color }};
    --fps-text: {{ section.settings.text_color }};
    --fps-accent: {{ section.settings.accent_color }};
    --fps-border: {{ section.settings.border_color }};
  "
>
  <div class="fps-container">

    <div class="fps-layout fps-layout--{{ section.settings.content_position }}">

      <!-- LEFT / CONTENT AREA -->
      <div class="fps-content">

        {% if section.settings.eyebrow != blank %}
          <div class="fps-eyebrow">
            <span></span>
            {{ section.settings.eyebrow | escape }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="fps-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="fps-description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a
            class="fps-button"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.button_text | escape }}
          </a>
        {% endif %}

      </div>

      <!-- PRODUCT SLIDER -->
      <div class="fps-products-area">

        {% assign selected_collection = section.settings.collection %}

        {% if selected_collection != blank and selected_collection.products_count > 0 %}

          <div class="fps-slider-header">
            {% if section.settings.product_heading != blank %}
              <h3 class="fps-product-heading">
                {{ section.settings.product_heading | escape }}
              </h3>
            {% endif %}

            <div class="fps-arrows">
              <button
                type="button"
                class="fps-arrow fps-arrow--prev"
                aria-label="Previous products"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M15 18l-6-6 6-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"/>
                </svg>
              </button>

              <button
                type="button"
                class="fps-arrow fps-arrow--next"
                aria-label="Next products"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 18l6-6-6-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>

          <div
            class="fps-slider"
            data-random="{{ section.settings.random_products }}"
            data-limit="{{ section.settings.product_limit }}"
          >

            <div class="fps-track">

              {% comment %}
                Render up to 50 products.
                JavaScript will randomly choose the requested number.
              {% endcomment %}

              {% for product in selected_collection.products limit: 50 %}

                {% assign first_variant = product.selected_or_first_available_variant %}
                {% assign product_price = first_variant.price %}
                {% assign months = section.settings.payment_months %}

                {% if months > 0 %}
                  {% assign monthly_price = product_price | divided_by: months %}
                {% else %}
                  {% assign monthly_price = product_price %}
                {% endif %}

                <article
                  class="fps-product"
                  data-product-index="{{ forloop.index0 }}"
                  data-product-id="{{ product.id }}"
                >

                  <a
                    href="{{ product.url }}"
                    class="fps-product-link"
                    aria-label="{{ product.title | escape }}"
                  >

                    <div class="fps-product-image">

                      {% if product.featured_image != blank %}

                        {{
                          product.featured_image
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            widths: '300, 500, 700, 800',
                            sizes: '(min-width: 990px) 360px, 80vw',
                            alt: product.featured_image.alt | default: product.title
                        }}

                      {% else %}

                        <div class="fps-no-image">
                          {{ 'product-1' | placeholder_svg_tag }}
                        </div>

                      {% endif %}

                    </div>

                    <div class="fps-product-info">

                      <div class="fps-product-title">
                        {{ product.title | escape }}
                      </div>

                      {% if section.settings.show_monthly %}
                        <div class="fps-monthly">

                          {{ monthly_price | money }}
                          <span>{{ section.settings.monthly_suffix | escape }}</span>

                        </div>

                        <div class="fps-payment-detail">

                          {{ section.settings.payment_prefix | escape }}
                          {{ months }}
                          {{ section.settings.payment_middle | escape }}
                          {{ product_price | money }}

                        </div>

                      {% else %}

                        <div class="fps-product-price">
                          {{ product_price | money }}
                        </div>

                      {% endif %}

                    </div>

                  </a>

                </article>

              {% endfor %}

            </div>
          </div>

          {% if section.settings.show_collection_link %}

            <a
              href="{{ selected_collection.url }}"
              class="fps-collection-link"
            >
              {{ section.settings.collection_link_text | escape }}
              <span aria-hidden="true">→</span>
            </a>

          {% endif %}

        {% else %}

          <div class="fps-empty">

            <div class="fps-empty-title">
              Select a collection
            </div>

            <div class="fps-empty-text">
              Choose a Shopify collection from the section settings.
            </div>

          </div>

        {% endif %}

      </div>

    </div>
  </div>
</section>

<style>
  #FinancingProductSlider-{{ section.id }} {
    background: var(--fps-bg);
    color: var(--fps-text);
    width: 100%;
    overflow: hidden;
  }

  #FinancingProductSlider-{{ section.id }} *,
  #FinancingProductSlider-{{ section.id }} *::before,
  #FinancingProductSlider-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #FinancingProductSlider-{{ section.id }} .fps-container {
    width: min(100% - 80px, 1400px);
    margin: 0 auto;
  }

  #FinancingProductSlider-{{ section.id }} .fps-layout {
    display: grid;
    grid-template-columns: minmax(320px, 0.9fr) minmax(600px, 1.1fr);
    align-items: center;
    gap: 80px;
    padding: 30px 0 30px;
  }

  /*
    Normal:
    Content left / products right

    Reverse:
    Products left / content right
  */
  #FinancingProductSlider-{{ section.id }} .fps-layout--right {
    grid-template-columns: minmax(600px, 1.1fr) minmax(320px, 0.9fr);
  }

  #FinancingProductSlider-{{ section.id }} .fps-layout--right .fps-content {
    order: 2;
  }

  #FinancingProductSlider-{{ section.id }} .fps-layout--right .fps-products-area {
    order: 1;
  }

  /* EYEBROW */

  #FinancingProductSlider-{{ section.id }} .fps-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--fps-accent);
    font-size: 16px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  #FinancingProductSlider-{{ section.id }} .fps-eyebrow span {
    display: block;
    width: 25px;
    height: 3px;
    flex: 0 0 25px;
    background: var(--fps-accent);
  }

  /* HEADING */

  #FinancingProductSlider-{{ section.id }} .fps-heading {
    margin: 0;
    color: var(--fps-text);
    font-size:36px;
    max-width: 700px;
  }

  /* DESCRIPTION */

  #FinancingProductSlider-{{ section.id }} .fps-description {
    margin-top: 16px;
    max-width: 650px;
    color: var(--fps-text);
    font-size: 18px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-description p {
    margin: 0 0 8px;
  }

  /* BUTTON */

  #FinancingProductSlider-{{ section.id }} .fps-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
    padding: 12px 22px;
    background: var(--fps-accent);
    color: #ffffff;
    border :1px solid var(--fps-accent);
    text-decoration: none;
    font-size: 16px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-button:hover {
    background: transparent;
    color:#fff;
    border :1px solid #fff;
  }

  /* PRODUCTS */

  #FinancingProductSlider-{{ section.id }} .fps-products-area {
    min-width: 0;
    width: 100%;
  }

  #FinancingProductSlider-{{ section.id }} .fps-slider-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-product-heading {
    margin: 0;
    color: var(--fps-text);
    font-size: 20px;
    line-height: 1.2;
    font-weight: 500;
  }

  /* ARROWS */

  #FinancingProductSlider-{{ section.id }} .fps-arrows {
    display: flex;
    gap: 8px;
    flex: 0 0 auto;
  }

  #FinancingProductSlider-{{ section.id }} .fps-arrow {
    width: 44px;
    height: 44px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--fps-border);
    color: var(--fps-text);
    cursor: pointer;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  #FinancingProductSlider-{{ section.id }} .fps-arrow:hover {
    background: var(--fps-accent);
    color: #ffffff;
    border-color: var(--fps-accent);
  }

  #FinancingProductSlider-{{ section.id }} .fps-arrow svg {
    width: 20px;
    height: 20px;
  }

  /* SLIDER */

  #FinancingProductSlider-{{ section.id }} .fps-slider {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  #FinancingProductSlider-{{ section.id }} .fps-track {
    display: flex;
    gap: 16px;
    width: max-content;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
        padding-bottom: 30px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-product {
    width: 350px;
    flex: 0 0 350px;
    border: 1px solid var(--fps-border);
    background: rgba(255,255,255,0.015);
    overflow: hidden;
  }

  #FinancingProductSlider-{{ section.id }} .fps-product-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* IMAGE */

  #FinancingProductSlider-{{ section.id }} .fps-product-image {
    width: 100%;
    height: 170px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d0d0d;
    overflow: hidden;
  }

  #FinancingProductSlider-{{ section.id }} .fps-product-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 300ms ease;
  }

  #FinancingProductSlider-{{ section.id }} .fps-product:hover img {
    transform: scale(1.04);
  }

  #FinancingProductSlider-{{ section.id }} .fps-no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.5;
  }

  #FinancingProductSlider-{{ section.id }} .fps-no-image svg {
    width: 90px;
    height: 90px;
  }

  /* PRODUCT INFO */

  #FinancingProductSlider-{{ section.id }} .fps-product-info {
    min-height: 135px;
    padding: 20px 22px 22px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-product-title {
    color: var(--fps-text);
    font-size: 18px;
    font-weight: 500;
    margin-bottom: 12px;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #FinancingProductSlider-{{ section.id }} .fps-monthly {
    color: var(--fps-accent);
    font-size: 18px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-monthly span {
    color: var(--fps-text);
    font-size: 18px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-payment-detail {
    color: var(--fps-text);
    font-size: 14px;
    margin-top: 7px;

  }

  #FinancingProductSlider-{{ section.id }} .fps-product-price {
    color: var(--fps-text);
    font-size: 18px;
    font-weight: 500;
  }

  /* COLLECTION LINK */

  #FinancingProductSlider-{{ section.id }} .fps-collection-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    color: var(--fps-text);
    text-decoration: none;
    font-size: 15px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-collection-link:hover {
    color: var(--fps-accent);
  }

  #FinancingProductSlider-{{ section.id }} .fps-empty {
    min-height: 250px;
    border: 1px solid var(--fps-border);
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #FinancingProductSlider-{{ section.id }} .fps-empty-title {
    font-size: 22px;
    margin-bottom: 8px;
  }

  #FinancingProductSlider-{{ section.id }} .fps-empty-text {
    opacity: 0.7;
  }

  /* TABLET */

  @media screen and (max-width: 1100px) {

    #FinancingProductSlider-{{ section.id }} .fps-layout,
    #FinancingProductSlider-{{ section.id }} .fps-layout--right {
      grid-template-columns: 1fr 1fr;
      gap: 35px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-product {
      width: 310px;
      flex-basis: 310px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-product-image {
      height: 150px;
    }

  }

  /* MOBILE */

  @media screen and (max-width: 749px) {

    #FinancingProductSlider-{{ section.id }} .fps-container {
      width: min(100% - 40px);
              padding: 0px 10px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-layout,
    #FinancingProductSlider-{{ section.id }} .fps-layout--right {
      display: flex;
      flex-direction: column;
      gap: 34px;
      padding: 42px 0 38px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-content,
    #FinancingProductSlider-{{ section.id }} .fps-products-area {
      order: initial !important;
      width: 100%;
    }

    #FinancingProductSlider-{{ section.id }} .fps-eyebrow {
      margin-bottom: 20px;
      font-size: 14px;
      gap: 10px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-eyebrow span {
      width: 20px;
      flex-basis: 20px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-heading {
      font-size: 28px;
    
    }

    #FinancingProductSlider-{{ section.id }} .fps-description {
      margin-top: 18px;
      font-size: 16px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-button {
      width: 100%;
          padding: 10px 12px;
      font-size: 14px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-slider-header {
      margin-bottom: 12px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-product-heading {
      font-size: 17px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-arrow {
      width: 40px;
      height: 40px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-slider {
      overflow: hidden;
      margin-right: -16px;
      width: calc(100% + 16px);
    }

    #FinancingProductSlider-{{ section.id }} .fps-track {
      gap: 12px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-product {
      width: calc(100vw - 55px);
      flex-basis: calc(100vw - 55px);
    }

    #FinancingProductSlider-{{ section.id }} .fps-product-image {
      height: 155px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-product-info {
      min-height: 125px;
      padding: 17px 18px 20px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-product-title {
      font-size: 16px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-monthly {
      font-size: 14px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-payment-detail {
      font-size: 14px;
    }

  }

  /* SMALL MOBILE */

  @media screen and (max-width: 380px) {

    #FinancingProductSlider-{{ section.id }} .fps-layout,
    #FinancingProductSlider-{{ section.id }} .fps-layout--right {
      padding-top: 34px;
      padding-bottom: 32px;
    }

    #FinancingProductSlider-{{ section.id }} .fps-product {
      width: calc(100vw - 40px);
      flex-basis: calc(100vw - 40px);
    }

  }
</style>

<script>
(function () {
  'use strict';

  var sectionId = 'FinancingProductSlider-{{ section.id }}';

  function initFinancingSlider() {

    var section = document.getElementById(sectionId);

    if (!section) return;

    var slider = section.querySelector('.fps-slider');
    var track = section.querySelector('.fps-track');
    var products = Array.prototype.slice.call(
      section.querySelectorAll('.fps-product')
    );

    var prevButton = section.querySelector('.fps-arrow--prev');
    var nextButton = section.querySelector('.fps-arrow--next');

    if (!slider || !track || !products.length) return;

    var randomProducts = slider.dataset.random === 'true';

    var limit = parseInt(slider.dataset.limit, 10);

    if (!limit || limit < 1) {
      limit = 10;
    }

    /*
      Random product selection
      ------------------------
      Fisher-Yates shuffle ensures that every page load can
      produce a different selection.
    */
    if (randomProducts && products.length > limit) {

      for (var i = products.length - 1; i > 0; i--) {

        var randomIndex = Math.floor(Math.random() * (i + 1));

        var temp = products[i];

        products[i] = products[randomIndex];
        products[randomIndex] = temp;
      }

    }

    /*
      Keep only requested number of products.
    */
    products.forEach(function (product, index) {

      if (index >= limit) {
        product.remove();
      }

    });

    products = Array.prototype.slice.call(
      section.querySelectorAll('.fps-product')
    );

    if (!products.length) return;

    var currentIndex = 0;

    function getVisibleProducts() {

      var width = window.innerWidth;

      if (width <= 749) {
        return 1;
      }

      if (width <= 1100) {
        return 1;
      }

      return 1;
    }

    function getStep() {

      var product = products[0];

      if (!product) return 0;

      var productWidth = product.getBoundingClientRect().width;

      var computed = window.getComputedStyle(track);

      var gap = parseFloat(computed.columnGap || computed.gap || 0);

      return productWidth + gap;
    }

    function getMaxIndex() {

      var visible = getVisibleProducts();

      return Math.max(0, products.length - visible);
    }

    function updateSlider() {

      var maxIndex = getMaxIndex();

      if (currentIndex > maxIndex) {
        currentIndex = maxIndex;
      }

      if (currentIndex < 0) {
        currentIndex = 0;
      }

      var step = getStep();

      track.style.transform =
        'translate3d(' + (-currentIndex * step) + 'px, 0, 0)';

      if (prevButton) {
        prevButton.disabled = currentIndex <= 0;
        prevButton.style.opacity = currentIndex <= 0 ? '0.2' : '1';
      }

      if (nextButton) {
        nextButton.disabled = currentIndex >= maxIndex;
        nextButton.style.opacity =
          currentIndex >= maxIndex ? '0.2' : '1';
      }
    }

    if (prevButton) {

      prevButton.addEventListener('click', function () {

        currentIndex--;

        updateSlider();

      });

    }

    if (nextButton) {

      nextButton.addEventListener('click', function () {

        currentIndex++;

        updateSlider();

      });

    }

    /*
      Touch / swipe support
    */
    var startX = 0;
    var endX = 0;

    slider.addEventListener(
      'touchstart',
      function (event) {

        if (!event.touches || !event.touches.length) return;

        startX = event.touches[0].clientX;

      },
      { passive: true }
    );

    slider.addEventListener(
      'touchend',
      function (event) {

        if (!event.changedTouches || !event.changedTouches.length) return;

        endX = event.changedTouches[0].clientX;

        var difference = startX - endX;

        if (Math.abs(difference) < 40) return;

        if (difference > 0) {
          currentIndex++;
        } else {
          currentIndex--;
        }

        updateSlider();

      },
      { passive: true }
    );

    window.addEventListener(
      'resize',
      function () {
        updateSlider();
      }
    );

    updateSlider();
  }

  /*
    Normal page load
  */
  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initFinancingSlider
    );

  } else {

    initFinancingSlider();

  }

  /*
    Shopify Theme Editor support
  */
  document.addEventListener(
    'shopify:section:load',
    function (event) {

      if (
        event.detail &&
        event.detail.sectionId === '{{ section.id }}'
      ) {
        initFinancingSlider();
      }

    }
  );

})();
</script>

{% schema %}
{
  "name": "Financing product slider",
  "tag": "section",
  "class": "section-financing-product-slider",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FINANCING"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Own it now. Pay monthly."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>TOOSA has partnered with RBC to offer simple monthly payment plans on tool storage and compressors.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Buy now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "random_products",
      "label": "Randomize products",
      "default": true
    },
    {
      "type": "text",
      "id": "product_heading",
      "label": "Product heading",
      "default": "Available financing"
    },

    {
      "type": "header",
      "content": "Payment display"
    },
    {
      "type": "checkbox",
      "id": "show_monthly",
      "label": "Show monthly payment",
      "default": true
    },
    {
      "type": "range",
      "id": "payment_months",
      "label": "Payment months",
      "min": 3,
      "max": 60,
      "step": 1,
      "default": 24
    },
    {
      "type": "text",
      "id": "monthly_suffix",
      "label": "Monthly suffix",
