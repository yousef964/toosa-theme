
{% style %}
  #shopify-section-{{ section.id }} {
    {% unless section.settings.fullwidth %}
      --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
    {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}
  
  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}
  }
{% endstyle %}


{% style %}
  #shopify-section-{{ section.id }} {
    {% if section.settings.product_background_overlay %}
        --theme-featured-product-banner-overlay-color: {{ section.settings.product_background_overlay_color }};
        --theme-featured-product-banner-overlay-gradient: {{ section.settings.product_background_gradient_overlay }};
        --theme-featured-product-banner-overlay-opacity: {{ section.settings.product_background_overlay_opacity | append: '%' }};

    {% endif %}
  }
{% endstyle %}

{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}

{% if section.blocks != blank %}
    {% for block in section.blocks %}
        {% case block.type %}
            {% when 'complementary' %}
                {% style %}
                    #shopify-section-{{ section.id }} .block-{{ block.id }}{


                      {% if block.settings.products_gap %}
                        --theme-product-complementary-gap: var(--theme-gap-{{ block.settings.products_gap_choice }});
                        {% else %}
                          --theme-product-complementary-gap: 0px;
                      {% endif %}

                      {% if block.settings.inset %}
                        --theme-product-complementary-padding: var(--theme-block-content-padding-{{ block.settings.inset_choice }});
                      {% endif %}  
                    }
                {% endstyle %}
            {% when 'separator' %}
                {% style %}
                    #shopify-section-{{ section.id }} .block-{{ block.id }}{
                        --theme-separator-width: {{ block.settings.width | append: '%' }};
                        --theme-separator-height: {{ block.settings.height | append: 'px' }};
                    }
                {% endstyle %}
            {% when 'spacer' %}
                {% style %}
                    #shopify-section-{{ section.id }} .block-{{ block.id }}{
                        --theme-spacer-height: {{ block.settings.height | append: 'px' }};    
                    }
                {% endstyle %}
        {% endcase %}
    {% endfor %}
{% endif %}



{% liquid 

    assign product = all_products[section.settings.product_choice]
    assign current_variant = product.selected_or_first_available_variant
    assign featured_image = current_variant.featured_image | default: product.featured_image 
    assign pick_up_availabilities = current_variant.store_availabilities | where: 'pick_up_enabled', true


    assign product_gallery_slider = true
    assign product_image_count = product.images | size

    if product_image_count > 1 and product_gallery_slider == true
        assign has_slider = true
    endif
%}



<div class="section-featured-product section-featured-product-banner product{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif

%}">
  <div class="section-featured-product-banner-container section-container">
    {% if product != blank %}
        {% if product.images %}
            <div class="section-featured-product-banner-background">
                <div class="section-featured-product-banner-background-media">
                    {% for image in product.images limit: 2 %}
                        {% render 'section-image-processor', image: image  %}
                    {% endfor %}
                </div>

                {% if section.settings.product_background_overlay %}
                    <div class="section-featured-product-banner-background-overlay"></div>
                {% endif %}
            </div>
        {% endif %}
        <div class="section-featured-product-banner-product-details">
            <h2 class="section-featured-product-banner-product-title special-heading-size-medium">{{ product.title }}</h2>
            <div class="section-featured-product-banner-product-price paragraph-size-large">
                {% if product.compare_at_price and product.compare_at_price > product.price %}
                    <span data-price-compare>{{ product.compare_at_price | money }}</span>
                {% endif %}
                <span data-price>{{ product.price | money }}</span>
            </div>
            <div class="section-featured-product-banner-product-description">{{ product.description | truncatewords: 50 }}</div>
            {% if section.settings.product_button_text != blank %}
                <a href="{{ product.url }}" class="section-featured-product-banner-product-more btn-{{ section.settings.product_button_style }}">{{ section.settings.product_button_text }}</a>
            {% endif %}
        </div>
    {% else %}
        <div class="section-featured-product-banner-background">
            <div class="section-featured-product-banner-background-media">
                {% for i in (1..2) %}
                    {% assign placeholder_image = 'product-' | append: forloop.index %}
                    {{ placeholder_image | placeholder_svg_tag: 'placeholder placeholder-featured-product-banner' }}
                {% endfor %}
            </div>

            {% if section.settings.product_background_overlay %}
                <div class="section-featured-product-banner-background-overlay"></div>
            {% endif %}
        </div>
        <div class="section-featured-product-banner-product-details">
            <h2 class="section-featured-product-banner-product-title special-heading-size-medium">{{ 'products.placeholder.title' | t }}</h2>
            <div class="section-featured-product-banner-product-price paragraph-size-large">
                <span data-price>{{ 'products.placeholder.price' | t }}</span>
            </div>
            <div class="section-featured-product-banner-product-description"><p>{{ 'products.placeholder.description' | t }}</p></div>
            {% if section.settings.product_button_text != blank %}
                <a href="{{ routes.root_url }}" class="section-featured-product-banner-product-more btn-{{ section.settings.product_button_style }}">{{ section.settings.product_button_text }}</a>
            {% endif %}
        </div>
    {% endif %}
  </div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}





