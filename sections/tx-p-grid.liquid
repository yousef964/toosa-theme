{% comment %} TOOSA inner pages: heading + grid of cards (features, steps, values, notes, strip) {% endcomment %}
{%- liquid
  assign s = section.settings
  assign theme_class = 'txp txp--light'
  if s.theme == 'paper'
    assign theme_class = 'txp txp--paper'
  elsif s.theme == 'dark'
    assign theme_class = 'txp'
  elsif s.theme == 'graphite'
    assign theme_class = 'txp txp--graphite'
  endif
  assign grid_class = 'txp-grid'
  if s.columns == '2'
    assign grid_class = grid_class | append: ' txp-grid--2'
  elsif s.columns == '4'
    assign grid_class = grid_class | append: ' txp-grid--4'
  elsif s.columns == '5'
    assign grid_class = grid_class | append: ' txp-grid--5'
  endif
  if s.style == 'strip'
    assign grid_class = grid_class | append: ' txp-grid--strip'
  elsif s.style == 'list'
    assign grid_class = grid_class | append: ' txp-grid--list'
  elsif s.style == 'check'
    assign grid_class = grid_class | append: ' txp-grid--check'
  elsif s.style == 'tiles'
    assign grid_class = grid_class | append: ' txp-grid--tiles'
  endif
  assign pad_class = 'txp-section'
  if s.style == 'strip'
    assign pad_class = 'txp-section txp-section--tight'
  endif
-%}
<section class="{{ theme_class }} {{ pad_class }}" id="txp-grid-{{ section.id }}">
  <div class="txp-wrap">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="txp-head {% if s.center %}txp-head--center{% endif %} {% if s.link_text != blank %}txp-head--row{% endif %}">
        <div>
          {%- if s.eyebrow != blank -%}<p class="txp-eyebrow txp-reveal">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="txp-h2 txp-reveal" data-delay="1">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.lead != blank -%}<div class="txp-lead txp-reveal" data-delay="2">{{ s.lead }}</div>{%- endif -%}
        </div>
        {%- if s.link_text != blank -%}<a class="txp-btn txp-btn--ghost txp-btn--sm txp-reveal" data-delay="2" href="{{ s.link_url }}">{{ s.link_text }}{% render 'tx-p-icon', name: 'arrow' %}</a>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="{{ grid_class }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign card_class = 'txp-card txp-reveal'
          if b.image != blank
            assign card_class = card_class | append: ' txp-card--media'
          endif
          if b.tone == 'accent'
            assign card_class = card_class | append: ' txp-card--accent'
          elsif b.tone == 'orange'
            assign card_class = card_class | append: ' txp-card--orange'
          endif
          if s.style == 'notes'
            assign card_class = card_class | append: ' txp-card--note'
          endif
          assign delay = forloop.index0 | modulo: 4
          assign el = 'div'
          if b.link_url != blank and b.link_text == blank
            assign el = 'a'
          endif
        -%}
        <{{ el }} class="{{ card_class }}" data-delay="{{ delay }}" {% if el == 'a' %}href="{{ b.link_url }}"{% endif %} {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            <div class="txp-card__media">{{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 30vw, (min-width: 600px) 46vw, 92vw', alt: b.image.alt | default: b.title }}</div>
          {%- endif -%}
          {%- if s.style == 'steps' -%}
            <div class="txp-card__num">{{ b.kicker | default: forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          {%- elsif s.style == 'check' -%}
            <div class="txp-card__icon txp-card__icon--check">{% render 'tx-p-icon', name: 'check' %}</div>
            {%- if b.kicker != blank -%}<div class="txp-kicker">{{ b.kicker }}</div>{%- endif -%}
          {%- elsif b.icon != blank and b.icon != 'none' -%}
            <div class="txp-card__icon">{% render 'tx-p-icon', name: b.icon %}</div>
            {%- if b.kicker != blank -%}<div class="txp-kicker">{{ b.kicker }}</div>{%- endif -%}
          {%- elsif b.kicker != blank -%}
            <div class="txp-kicker">{{ b.kicker }}</div>
          {%- endif -%}
          {%- if s.style == 'list' or s.style == 'check' -%}<div class="txp-card__body">{%- endif -%}
          {%- if b.title != blank -%}<h3 class="txp-h3">{{ b.title }}</h3>{%- endif -%}
          {%- if b.text != blank -%}<div class="txp-card__text">{{ b.text }}</div>{%- endif -%}
          {%- if b.show_ul -%}<div class="txp-card__badge">{% render 'tx-p-ul', size: 'sm', text: b.ul_text %}</div>{%- endif -%}
          {%- if b.link_text != blank -%}<a class="txp-link txp-card__link" href="{{ b.link_url }}">{{ b.link_text }}{% render 'tx-p-icon', name: 'arrow' %}</a>{%- endif -%}
          {%- if b.foot != blank -%}<div class="txp-card__foot">{{ b.foot }}</div>{%- endif -%}
          {%- if s.style == 'list' or s.style == 'check' -%}</div>{%- endif -%}
        </{{ el }}>
      {%- endfor -%}
    </div>
    {%- if s.note != blank -%}<div class="txp-table__note txp-reveal">{{ s.note }}</div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "TX Card grid",
  "settings": [
    { "type": "select", "id": "theme", "label": "Colour", "default": "paper", "options": [
      { "value": "light", "label": "White" }, { "value": "paper", "label": "Paper" }, { "value": "dark", "label": "Dark" }, { "value": "graphite", "label": "Graphite" } ] },
    { "type": "select", "id": "style", "label": "Style", "default": "cards", "options": [
      { "value": "cards", "label": "Cards" }, { "value": "steps", "label": "Numbered steps" }, { "value": "strip", "label": "Hairline strip" }, { "value": "notes", "label": "Notes / quotes" }, { "value": "list", "label": "Compact icon rows" }, { "value": "check", "label": "Checklist" }, { "value": "tiles", "label": "Small tiles" } ] },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "lead", "label": "Lead" },
    { "type": "checkbox", "id": "center", "label": "Centre the heading", "default": false },
    { "type": "text", "id": "link_text", "label": "Heading link text" },
    { "type": "url", "id": "link_url", "label": "Heading link" },
    { "type": "richtext", "id": "note", "label": "Footnote" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image (optional)" },
      { "type": "select", "id": "icon", "label": "Icon", "default": "none", "options": [
        { "value": "none", "label": "None" }, { "value": "check", "label": "Check" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "box", "label": "Box" }, { "value": "wrench", "label": "Wrench" }, { "value": "card", "label": "Card" }, { "value": "bolt", "label": "Bolt" }, { "value": "layers", "label": "Layers" }, { "value": "chat", "label": "Chat" }, { "value": "eye", "label": "Eye" }, { "value": "pin", "label": "Pin" }, { "value": "clock", "label": "Clock" }, { "value": "calendar", "label": "Calendar" }, { "value": "phone", "label": "Phone" }, { "value": "mail", "label": "Mail" }, { "value": "star", "label": "Star" }, { "value": "map", "label": "Map" }, { "value": "home", "label": "Home" }, { "value": "gauge", "label": "Gauge" }, { "value": "droplet", "label": "Droplet" }, { "value": "fan", "label": "Fan" }, { "value": "volume", "label": "Volume" }, { "value": "plug", "label": "Plug" }, { "value": "ruler", "label": "Ruler" }, { "value": "thermo", "label": "Thermometer" }, { "value": "filter", "label": "Filter" }, { "value": "tank", "label": "Tank" }, { "value": "factory", "label": "Factory" }, { "value": "garage", "label": "Garage" }, { "value": "building", "label": "Building" }, { "value": "award", "label": "Award" }, { "value": "users", "label": "People" }, { "value": "tag", "label": "Tag" }, { "value": "hammer", "label": "Hammer" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "refresh", "label": "Refresh" }, { "value": "lock", "label": "Lock" }, { "value": "grid", "label": "Grid" }, { "value": "warning", "label": "Warning" }, { "value": "drawer", "label": "Drawer" }, { "value": "cog", "label": "Cog" }, { "value": "spray", "label": "Spray gun" }, { "value": "dollar", "label": "Dollar" }, { "value": "undo", "label": "Return" }, { "value": "camera", "label": "Camera" }, { "value": "forklift", "label": "Forklift" } ] },
      { "type": "text", "id": "kicker", "label": "Kicker / step number" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "text", "id": "foot", "label": "Footnote / source" },
      { "type": "checkbox", "id": "show_ul", "label": "Show the UL badge", "default": false },
      { "type": "text", "id": "ul_text", "label": "UL badge line" },
      { "type": "text", "id": "link_text", "label": "Link text" },
      { "type": "url", "id": "link_url", "label": "Link" },
      { "type": "select", "id": "tone", "label": "Tone", "default": "plain", "options": [
        { "value": "plain", "label": "Plain" }, { "value": "accent", "label": "Ink" }, { "value": "orange", "label": "Orange" } ] } ] }
  ],
  "presets": [ { "name": "TX Card grid" } ]
}
{% endschema %}
