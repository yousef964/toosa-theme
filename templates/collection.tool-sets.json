imensions.<\/p>\n    <ul>\n      <li>33-3\/4 x 15-1\/2 x 13\/16<\/li>\n      <li>14-3\/4 x 15-1\/2 x 13\/16<\/li>\n      <li>7-3\/8 x 15-1\/2 x 13\/16<\/li>\n      <li>7-3\/8 x 7-3\/4 x 13\/16<\/li>\n    <\/ul>\n    <h2 style=\"font-size: 28px; font-weight: 900; margin: 20px 0;\">HOW IT WORKS:<\/h2>\n    <ul>\n      <li><strong>Customize Your Layout<\/strong> – Combine different sizes to create a tailored tool storage setup.<\/li>\n      <li><strong>Maximize Space<\/strong> – Fractional sizing eliminates wasted space while keeping tools easily accessible.<\/li>\n      <li><strong>Stay Flexible<\/strong> – Modular design lets you reorganize or expand your setup as your tool collection grows.<\/li>\n    <\/ul>\n  <\/div>\n\n  <!-- Middle Chart Section -->\n  <div style=\"flex: 1; text-align: center;\">\n    <h2 style=\"color: #002147; font-weight: bold; margin-bottom: 10px;\">EVA FOAM SIZING OPTIONS<\/h2>\n    <img src=\"https:\/\/static.wixstatic.com\/media\/7893f7_068a6876886a404f958078e90a96efc7~mv2.png\" alt=\"Foam Sets\" style=\"width: 100%; height: auto;\">\n  <\/div>\n\n  <!-- Right Product Images Section -->\n  <div style=\"flex: 1; text-align: center;\">\n    <!-- Product images can go here -->\n  <\/div>\n\n<\/div>"}},"rich_text_cjXYeT":{"type":"rich-text","blocks":{"special_heading_6dbPPH":{"type":"special-heading","settings":{"text":"Custom Foam Inserts","text_size":"x-small","text_custom_width":false,"text_width":450}},"text_8QeFb9":{"type":"text","settings":{"text":"Have a specific layout in mind? We can make it happen. Send us your own design, tool layout, or dimensions, and our team will create a precision-cut EVA foam insert tailored to your exact needs. Perfect for professionals who want every wrench, socket, or specialty tool to have its own spot.","text_size":"medium","text_custom_width":false,"text_width":450}},"buttons_hrFPYU":{"type":"buttons","settings":{"button_1_text":"Custom Foam Insert Form","button_1_url":"shopify:\/\/pages\/custom-foam-in