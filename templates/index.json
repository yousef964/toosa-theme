://shop_images/zytsddrpJ3.webp","rating":5,"customer_name":"Terry M.","review":"<p>Best purchase ever! The team at Toosa was fantastic. 100% would recommend them. One of the easiest and smoothest online purchase and delivery I have ever had, especially considering it was delivered to Vancouver Island.</p>"}},"image_erHCeY":{"type":"image","settings":{"image":"shopify://shop_images/645579106_1886673896056266_872765453306288593_n_1.jpg","rating":5,"customer_name":"Jay M.","review":"<p>Insane amount of storage & heavy duty built was a no brainer at this price point. Very happy with my purchase &&nbsp;the support from TOOSA, answering all of my questions & concerns regarding the purchase.&nbsp;</p>"}},"video_zzJaGR":{"type":"video","settings":{"video":"shopify://files/videos/Copy of 10.1 Louie Toosa reel 01-.mp4","image":"shopify://shop_images/568a41e3f0bf460bbc0f4304497f2a9c.thumbnail.0000000000.webp","rating":5,"customer_name":"Cloud E-Bikes","review":"<p>Having a professional tool box in our retail store makes our store look more presentable, builds more trust with our clients & saves time for our service team which in turn saves us money! Highly Recommend TOOSA for retail.&nbsp;</p>"}},"video_4jdfaF":{"type":"video","settings":{"video":"shopify://files/videos/Copy of Desy Testimonial Toosa_f80135a8-cf99-4804-97b0-9200872390be.mp4","image":"shopify://shop_images/95ce318214334d41a663d8e45afad947.thumbnail.0000000000.webp","rating":5,"customer_name":"Desy B.","review":"<p>Organize all your tools & gear with the heavy-duty, professional-grade TOOSA Mega Max Rolling Tool Box. The soft-close feature on this unit is so satisfying & gives it such a premium feel. Would recommend adding the lighting kit.&nbsp;</p>"}},"image_rbxyNg":{"type":"image","settings":{"image":"shopify://shop_images/5e53c105-509f-4715-a85a-3620fa1ed2fb.jpg","rating":5,"customer_name":"David K.","review":"<p>This tool cabinet transformed my workshop completely! It's nice to know exactly where my tools are and being able to lock them away securely in a shared work space. Great communication from the TOOSA team from start to fininsh.</p>"}},"image_4hLjcm":{"type":"image","settings":{"image":"shopify://shop_images/091e6c608c43bdfbb6c805773649d863.jpg","rating":5,"customer_name":"Tay J.","review":"<p>Excellent guys to deal with !<br/><br/>Very happy with the tool cabinet and a very reasonable price compared to others.</p>"}},"video_fX47AA":{"type":"video","settings":{"video":"shopify://files/videos/Copy of 10.4 Louie Toosa reel 04.mp4","image":"shopify://shop_images/1320dae550e348a58066a91aa294fb27.thumbnail.0000000000.webp","rating":5,"customer_name":"Cloud E-Bikes","review":"<p>TOOSA's tool cabinets have been a game changer for our service teams. They help us maintain a smooth workflow and quickly access tools to serve customers faster.&nbsp;</p>"}},"image_KyA3pM":{"type":"image","settings":{"image":"shopify://shop_images/IMG_1425.heic","rating":5,"customer_name":"Sarah P.","review":"<p>Perfect addition to my workspace. The product is as described and top quality.</p>"}},"image_kL7ykK":{"type":"image","settings":{"image":"shopify://shop_images/367B5BpG5B.webp","rating":5,"customer_name":"James R.","review":"<p>I recently ordered a toolbox from Toosa, and I\u2019m seriously impressed. &nbsp;I expected the quality to be similar to the cheaper Husky floor models you see at Home Depot, but the Toosa box completely blew me away.&nbsp;</p>"}},"video_hrNCVJ":{"type":"video","settings":{"video":"shopify://files/videos/Copy of 10.3 Louie Toosa reel 03.mp4","image":"shopify://shop_images/0c589830e1f64d7e973c3fa1e0ef960e.thumbnail.0000000000.webp","rating":5,"customer_name":"Coud E-Bikes","review":"<p>TOOSA's adjustable lighting kit is the perfect addition to the existing high quality work top.&nbsp;</p><p>Work faster and see clearly at night with integrated, high-visibility toolbox lights.</p>"}},"image_hkcBYf":{"type":"image","settings":{"image":"shopify://shop_images/Glossy_Red_Workshop_Tool_Cabinet.png","rating":5,"customer_name":"Arian F.","review":"<p>Just rolled in our new tool cabinet</p>"}},"image_qAbUnr":{"type":"image","settings":{"image":"shopify://shop_images/c3c2751d-a315-4bcc-a88e-e85541c4c6d8.jpg","rating":5,"customer_name":"Bilal N.","review":"<p>This product has completely changed my experience. I highly recommend TOOSA is awesome! They really know how to make a workspace both efficient and stylish.</p>"}}},"block_order":["image_iVenJk","image_erHCeY","video_zzJaGR","video_4jdfaF","image_rbxyNg","image_4hLjcm","video_fX47AA","image_KyA3pM","image_kL7ykK","video_hrNCVJ","image_hkcBYf","image_qAbUnr"],"name":"JD Testimonial Slider","settings":{"heading":"What Our Customers Say","subheading":"","heading_alignment":"center","desktop_columns":4,"mobile_columns":"1","card_gap":20,"show_dots":true,"background_color":"rgba(0,0,0,0)","card_background":"#eeeeee","text_color":"#000000","star_color":"#f5a623","card_radius":12,"container_width":1400,"padding_top":40,"padding_bottom":40,"mobile_padding_top":30,"mobile_padding_bottom":30}},"tx_drawer":{"type":"tx-drawer","blocks":{"d1":{"type":"spec","settings":{"value":"150","unit":"lb","label":"per pair of slides, fully extended, no sag"}},"d2":{"type":"spec","settings":{"value":"100","unit":"%","label":"full-extension ball-bearing slides on every drawer"}},"d3":{"type":"spec","settings":{"value":"Welded","unit":"","label":"heavy-gauge steel frame, not folded panels and bolts"}},"d4":{"type":"spec","settings":{"value":"Powder","unit":"coat","label":"textured, solvent-resistant finish that shrugs off knocks"}}},"block_order":["d1","d2","d3","d4"],"settings":{"eyebrow":"Built like it should be","heading":"Open a drawer. Feel the difference.","lead":"The cheap box feels fine in the store. It's the thousandth open, fully loaded, that tells you what you bought. TOOSA drawers ride on full-extension ball-bearing slides and latch shut with a real click.","tag":"Scroll to open the drawer","b