cial_heading_DLTD4H","text_PnYrHR"],"name":"t:sections.rich_text.presets.rich_text.name","settings":{"fullwidth":true,"width":1320,"side_margin_choice":"level-0","color_scheme":"","inset_choice":"level-4","alignment":"center","gap":true,"gap_choice":"level-4","separator":false,"separator_width":100,"separator_use_custom_color":false,"separator_custom_color":"#cccccc","spacing":true,"spacing_choice":"level-3","spacing_placement":"1"}},"custom_liquid_Y77Mdg":{"type":"custom-liquid","custom_css":[".service-btn {display: inline-block; padding: 10px 20px; background: #001f54; color: #fff; \/* 👈 This makes the button text white *\/ text-decoration: none; border-radius: 5px; font-weight: 600;}"],"name":"t:sections.custom_liquid.presets.custom_liquid.name","settings":{"custom_liquid":"<div class=\"services-section\">\n  <div class=\"services-container\">\n    \n    <!-- Service 1 -->\n    <div class=\"service-box\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0918\/8193\/1117\/files\/teamwork.avif?v=1755338472\" alt=\"Assembly Services\" class=\"service-icon\">\n      <h3 class=\"service-title\">ASSEMBLY SERVICES<\/h3>\n      <p class=\"service-desc\">\n        Let us handle the heavy lifting! Our team offers professional assembly\n        services for all our products, ensuring your workbench or tool chest is set up\n        quickly and correctly, so you can start using it right away.\n      <\/p>\n      <a href=\"https:\/\/toosa.ca\/products\/assembly-services\" class=\"service-btn\">Add to cart<\/a>\n    <\/div>\n    \n    <!-- Service 2 -->\n    <div class=\"service-box\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0918\/8193\/1117\/files\/laser-cutting-machine.avif?v=1755338469\" alt=\"Laser Engraving\" class=\"service-icon\">\n      <h3 class=\"service-title\">LASER ENGRAVING<\/h3>\n      <p class=\"service-desc\">\n        Personalize your product with precision. Whether it’s your company logo, name, or\n        custom branding, our state-of-the-art laser engraving service adds a professional\n        touch to your toolbox or workbench.\n      <\/p>\n      <a href=\"https:\/\/ugjm0f-7c.myshopify.com\/pages\/laser-engraving-form\" class=\"service-btn\">Send Your Design<\/a>\n    <\/div>\n    \n    <!-- Service 3 -->\n    <div class=\"service-box\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0918\/8193\/1117\/files\/inbox.avif?v=1755338467\" alt=\"Custom Foam Inserts\" class=\"service-icon\">\n      <h3 class=\"service-title\">CUSTOM FOAM INSERTS<\/h3>\n      <p class=\"service-desc\">\n        Keep your tools and equipment organized and protected. We create CNC foam inserts\n        designed to fit your tools and gear perfectly, ensuring everything stays secure and\n        easily accessible inside your drawer or case.\n      <\/p>\n      <a href=\"https:\/\/ugjm0f-7c.myshopify.com\/pages\/custom-foam-inquiry-1\" class=\"service-btn\">Custom Foam Inquiry<\/a>\n    <\/div>\n    \n  <\/div>\n<\/div>\n\n<style>\n.services-section {\n  background: #fff; \/* White background like your screenshot *\/\n  padding: 40px 20px;\n  text-align: center;\n}\n.services-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 30px;\n  max-width: 1100px;\n  margin: 0 auto;\n}\n.service-box {\n  background: #fff;\n  padding: 25px 20px;\n  border-radius: 10px;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.08);\n}\n.service-icon {\n  width: 60px;\n  margin-bottom: 15px;\n}\n.service-title {\n  font-size: 18px;\n  font-weight: 700;\n  text-transform: uppercase;\n  margin-bottom: 10px;\n  color: #001f54;\n}\n.service-desc {\n  font-size: 15px;\n  color: #333;\n  margin-bottom: 20px;\n  line-height: 1.6;\n}\n.service-btn {\n  display: inline-block;\n  padding: 10px 20px;\n  background: #001f54;\n  color: #fff;\n  text-decoration: none;\n  border-radius: 5px;\n  font-weight: 600;\n}\n.service-btn:hover {\n  background: #003080;\n}\n<\/style>"}}},"order":["otsb_text_column_with_images_5_htVKfB","rich_text_dAnWQn","custom_liquid_Y77Mdg"]}